; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdToHtml.rgr — the AST as HTML, byte for byte the way the spec wants it.
; ============================================================================
;
; This exporter is not how the viewer draws anything: the viewer lays boxes
; out and paints them, and never builds a string of tags. It exists because
; HTML is the only form of the answer a specification can check, and
; CommonMark's 652 examples are 652 pairs of (markdown, expected HTML)
; compared as exact strings.
;
; So this file is the parser's test surface. Everything it gets wrong is a
; parser bug that would otherwise be found by looking at a page and
; squinting — the whitespace after a `<li>`, whether a tight list's item has
; a `<p>` in it, whether an empty destination is `href=""` — and each of
; those is a real difference in the tree.
;
; Raw HTML is passed through, which is what the specification says a renderer
; may do and what makes 44 of those examples pass. The VIEWER does not obey
; it — a canvas has no DOM to hand a `<div>` to, so it shows the markup as
; what it is. Two different answers to one question, on purpose: this one is
; scored, the other one is drawn.
; ============================================================================

Import "MdNode.rgr"
Import "MdChar.rgr"
Import "MdAnchor.rgr"
Import "MdAttrs.rgr"
Import "MdGallery.rgr"
Import "../../math/src/MathRender.rgr"
Import "../../vfs/src/Vfs.rgr"

class MdToHtml {
    ; A tight list's items hold their paragraphs' contents without the <p>.
    def tight:boolean false
    def out:string ""

    ; --- a page someone opens, not a spec answer --------------------------
    ;
    ; Off, the output is the specification's, byte for byte. A document
    ; export turns these on:
    ;   `standalone` — the file is opened by whoever it is sent to, so raw
    ;     HTML is shown as text (as the viewer shows it) and a link or
    ;     picture that would run script (`javascript:`, `vbscript:`,
    ;     `data:` other than a picture) loses its address; headings get
    ;     ids (`{#id}` or the GitHub slug) so in-page links land.
    ;   `setImages` — a picture the store has is written into the page as a
    ;     data: URL, so the one file carries its pictures.
    def standalone:boolean false
    def images:Vfs (new Vfs())
    def haveImages:boolean false
    def docDir:string ""
    def ids:[string]
    ; pictures written in, and pictures asked for that the store lacked
    def pictures:int 0
    def missedPictures:int 0

    Constructor () {
    }

    fn setImages:void (v:Vfs dir:string) {
        images = v
        haveImages = true
        docDir = dir
    }

    ; One block (or a whole document) with this renderer's settings; the
    ; heading ids it handed out are remembered, so a later block's same
    ; heading gets another.
    fn node:string (n:MdNode) {
        out = ""
        tight = false
        if (n.kind == "document") {
            this.walkChildren(n)
            this.footnotes(n)
        } {
            this.walk(n)
        }
        return out
    }

    sfn render:string (doc:MdNode) {
        def r:MdToHtml (new MdToHtml())
        r.walkChildren(doc)
        r.footnotes(doc)
        return r.out
    }

    ; ------------------------------------------------------------------
    ; The output buffer, and the one rule that makes a list come out right.
    ; ------------------------------------------------------------------
    ;
    ; `cr` is a newline THAT IS NOT WRITTEN when there is already one at the
    ; end. Every block puts one before and after itself and lets this decide,
    ; which is how `<li>` ends up hugging its text in a tight list —
    ; `<li>foo` — and on its own line when the item opens with a block —
    ; `<li>\n<pre>`. Writing "\n" unconditionally gives the first shape
    ; everywhere and quietly fails 14 examples that all look like whitespace.
    fn lit:void (v:string) {
        out = (out + v)
    }

    fn cr:void () {
        def n:int (strlen out)
        if (n == 0) { return }
        def last:int (charAt out (n - 1))
        if (last == 10) { return }
        out = (out + "\n")
    }

    fn walkChildren:void (node:MdNode) {
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def c:MdNode (node.childAt(i))
            this.walk(c)
            i = (i + 1)
        }
    }

    fn walk:void (node:MdNode) {
        def kind:string node.kind

        if (kind == "text") {
            this.lit((MdToHtml.escape(node.literal)))
            return
        }
        if (kind == "softbreak") {
            this.lit("\n")
            return
        }
        if (kind == "linebreak") {
            this.lit("<br />")
            this.cr()
            return
        }
        if (kind == "code") {
            this.lit("<code>")
            this.lit((MdToHtml.escape(node.literal)))
            this.lit("</code>")
            return
        }
        if (kind == "math") {
            this.lit(("<span class=\"math\" title=\"" + (MdToHtml.escape(node.literal)) + "\">"))
            this.lit((MathRender.svgEm(node.literal (node.info == "display"))))
            this.lit("</span>")
            return
        }
        if (kind == "math_block") {
            this.cr()
            this.lit(("<div class=\"math-display\" style=\"text-align:center;margin:0.6em 0\" title=\"" + (MdToHtml.escape(node.literal)) + "\">"))
            this.lit((MathRender.svgEm(node.literal true)))
            this.lit("</div>")
            this.cr()
            return
        }
        if (kind == "html_inline") {
            if standalone {
                this.lit((MdToHtml.escape(node.literal)))
                return
            }
            this.lit(node.literal)
            return
        }
        if (kind == "emph") {
            this.lit("<em>")
            this.walkChildren(node)
            this.lit("</em>")
            return
        }
        if (kind == "strong") {
            this.lit("<strong>")
            this.walkChildren(node)
            this.lit("</strong>")
            return
        }
        if (kind == "strike") {
            this.lit("<del>")
            this.walkChildren(node)
            this.lit("</del>")
            return
        }
        ; markdown-it's plugins, as markdown-it writes them
        if ((((kind == "sub") || (kind == "sup")) || (kind == "ins")) || (kind == "mark")) {
            this.lit((("<" + kind) + ">"))
            this.walkChildren(node)
            this.lit((("</" + kind) + ">"))
            return
        }
        if (kind == "abbr") {
            this.lit((("<abbr title=\"" + (MdToHtml.escape(node.title))) + "\">"))
            this.walkChildren(node)
            this.lit("</abbr>")
            return
        }
        if (kind == "link") {
            if (standalone && (MdToHtml.runsScript(node.destination false))) {
                this.lit("<a>")
                this.walkChildren(node)
                this.lit("</a>")
                return
            }
            def href:string (MdToHtml.escapeUrl(node.destination))
            this.lit((("<a href=\"" + href) + "\""))
            def tlen:int (strlen node.title)
            if (tlen > 0) {
                this.lit(((" title=\"" + (MdToHtml.escape(node.title))) + "\""))
            }
            this.lit(">")
            this.walkChildren(node)
            this.lit("</a>")
            return
        }
        if (kind == "image") {
            def src:string (MdToHtml.escapeUrl(node.destination))
            def inlined:string (this.dataUrl(node.destination))
            if ((strlen inlined) > 0) {
                src = inlined
            } {
                if (standalone && (MdToHtml.runsScript(node.destination true))) {
                    src = ""
                }
            }
            def alt:string (node.plainText())
            this.lit((((("<img src=\"" + src) + "\" alt=\"") + (MdToHtml.escape(alt))) + "\""))
            def tlen2:int (strlen node.title)
            if (tlen2 > 0) {
                this.lit(((" title=\"" + (MdToHtml.escape(node.title))) + "\""))
            }
            this.lit(" />")
            return
        }

        if (kind == "paragraph") {
            if tight {
                this.walkChildren(node)
                return
            }
            this.cr()
            this.lit("<p>")
            this.walkChildren(node)
            this.lit("</p>")
            this.cr()
            return
        }
        if (kind == "heading") {
            def lv:string (to_string node.level)
            this.cr()
            if standalone {
                ; `{heading=hidden}`: kept for a screen reader and the
                ; contents, out of sight (the page's `.visually-hidden`)
                def hid:string ""
                if (MdAttrs.headingHidden(node)) {
                    hid = " class=\"visually-hidden\""
                }
                this.lit(((((("<h" + lv) + " id=\"") + (MdToHtml.escape((this.headingId(node))))) + "\"" + hid) + ">"))
            } {
                this.lit((("<h" + lv) + ">"))
            }
            this.walkChildren(node)
            this.lit((("</h" + lv) + ">"))
            this.cr()
            return
        }
        if (kind == "thematic_break") {
            this.cr()
            this.lit("<hr />")
            this.cr()
            return
        }
        if (kind == "html_block") {
            this.cr()
            if standalone {
                this.lit((("<pre>" + (MdToHtml.escape(node.literal))) + "</pre>"))
            } {
                this.lit(node.literal)
            }
            this.cr()
            return
        }
        if (kind == "front_matter") {
            return
        }
        if (standalone && (MdGallery.isGallery(node))) {
            this.gallery(node)
            return
        }
        if ((kind == "code_block") || (kind == "embed")) {
            def cls:string ""
            def lang:string (MdToHtml.firstWord(node.info))
            def llen:int (strlen lang)
            if (llen > 0) {
                cls = ((" class=\"language-" + (MdToHtml.escape(lang))) + "\"")
            }
            this.cr()
            this.lit((("<pre><code" + cls) + ">"))
            this.lit((MdToHtml.escape(node.literal)))
            this.lit("</code></pre>")
            this.cr()
            return
        }
        if (kind == "block_quote") {
            def wasTight:boolean tight
            tight = false
            this.cr()
            this.lit("<blockquote>")
            this.cr()
            this.walkChildren(node)
            this.cr()
            this.lit("</blockquote>")
            this.cr()
            tight = wasTight
            return
        }
        if (kind == "list") {
            def wasTight2:boolean tight
            tight = node.listTight
            def open:string "<ul>"
            def close:string "</ul>"
            if node.listOrdered {
                def startAttr:string ""
                if (node.listStart != 1) {
                    startAttr = ((" start=\"" + (to_string node.listStart)) + "\"")
                }
                open = (("<ol" + startAttr) + ">")
                close = "</ol>"
            }
            this.cr()
            this.lit(open)
            this.cr()
            this.walkChildren(node)
            this.cr()
            this.lit(close)
            this.cr()
            tight = wasTight2
            return
        }
        if (kind == "item") {
            this.lit("<li>")
            if (node.taskState >= 0) {
                def checked:string (? (node.taskState == 1) " checked=\"\"" "")
                this.lit((("<input" + checked) + " disabled=\"\" type=\"checkbox\" /> "))
            }
            this.walkChildren(node)
            this.lit("</li>")
            this.cr()
            return
        }

        if (kind == "table") {
            this.walkTable(node)
            return
        }
        ; --- markdown-it's plugins, as they render ---------------------
        if (kind == "footnote_ref") {
            def fnId:string (to_string node.noteNumber)
            def refId:string fnId
            if (node.noteSub > 0) {
                refId = (fnId + ":" + (to_string node.noteSub))
            }
            this.lit(("<sup class=\"footnote-ref\"><a href=\"#fn" + fnId + "\" id=\"fnref" + refId + "\">[" + refId + "]</a></sup>"))
            return
        }
        ; drawn with the others at the end (`footnotes`), not where it stands
        if (kind == "footnote_def") {
            return
        }
        if (kind == "dl") {
            def wasTight3:boolean tight
            this.cr()
            this.lit("<dl>")
            this.cr()
            def di:int 0
            while (di < (node.childCount())) {
                tight = node.listTight
                this.walk((node.childAt(di)))
                di = (di + 1)
            }
            tight = wasTight3
            this.cr()
            this.lit("</dl>")
            this.cr()
            return
        }
        if (kind == "dt") {
            this.cr()
            this.lit("<dt>")
            this.walkChildren(node)
            this.lit("</dt>")
            this.cr()
            return
        }
        if (kind == "dd") {
            this.cr()
            this.lit("<dd>")
            this.walkChildren(node)
            this.lit("</dd>")
            this.cr()
            return
        }
        if (kind == "container") {
            def wasTight4:boolean tight
            tight = false
            this.cr()
            this.lit(("<div class=\"" + (MdToHtml.escape(node.info)) + "\">"))
            this.cr()
            if ((strlen node.title) > 0) {
                this.lit(("<p class=\"container-title\"><strong>" + (MdToHtml.escape(node.title)) + "</strong></p>"))
                this.cr()
            }
            this.walkChildren(node)
            this.cr()
            this.lit("</div>")
            this.cr()
            tight = wasTight4
            return
        }
        this.walkChildren(node)
    }

    ; The footnotes, after the document, in number order — markdown-it-
    ; footnote's own markup: a rule, then a list whose items each end with a
    ; link back to every reference made to them.
    fn footnotes:void (doc:MdNode) {
        def n:int (doc.noteCount())
        if (n == 0) { return }
        def wasTight:boolean tight
        tight = false
        this.cr()
        this.lit("<hr class=\"footnotes-sep\" />")
        this.cr()
        this.lit("<section class=\"footnotes\">")
        this.cr()
        this.lit("<ol class=\"footnotes-list\">")
        this.cr()
        def i:int 1
        while (i <= n) {
            def fd:MdNode (doc.noteAt(i))
            def id:string (to_string i)
            this.lit(("<li id=\"fn" + id + "\" class=\"footnote-item\">"))
            def back:string ""
            def k:int 0
            while (k < fd.noteRefs) {
                def rid:string id
                if (k > 0) {
                    rid = (id + ":" + (to_string k))
                }
                ; ↩ and the text-style selector, so iOS does not draw an emoji
                back = (back + " <a href=\"#fnref" + rid + "\" class=\"footnote-backref\">" + (MdChar.fromCode(8617)) + (MdChar.fromCode(65038)) + "</a>")
                k = (k + 1)
            }
            ; the back-links go inside the last paragraph, as the plugin
            ; puts them, and after the note when it ends in something else
            def kids:int (fd.childCount())
            def c:int 0
            while (c < kids) {
                def b:MdNode (fd.childAt(c))
                if (b.kind == "paragraph") {
                    ; the first one hugs the <li>, as markdown-it writes it
                    if (c > 0) {
                        this.cr()
                    }
                    this.lit("<p>")
                    this.walkChildren(b)
                    if (c == (kids - 1)) {
                        this.lit(back)
                        back = ""
                    }
                    this.lit("</p>")
                    this.cr()
                } {
                    this.walk(b)
                }
                c = (c + 1)
            }
            this.lit(back)
            this.lit("</li>")
            this.cr()
            i = (i + 1)
        }
        this.lit("</ol>")
        this.cr()
        this.lit("</section>")
        this.cr()
        tight = wasTight
    }

    ; A gallery as figures: `<figure class="gallery">` holding one figure
    ; per picture (its caption a `figcaption`) and a paragraph per text
    ; cell, each with the classes a sheet names them by (`cell`, `text`,
    ; the fence's own). The page lays them out as a grid.
    fn gallery:void (node:MdNode) {
        def g:MdGallery (MdGallery.of(node))
        def cls:string ("gallery layout-" + g.layout + " fit-" + g.fit + " caption-" + g.caption)
        def ci:int 0
        while (ci < (array_length g.classes)) {
            cls = (cls + " " + (MdToHtml.escape((itemAt g.classes ci))))
            ci = (ci + 1)
        }
        this.cr()
        this.lit(("<figure class=\"" + cls + "\">"))
        this.cr()
        def i:int 0
        while (i < (array_length g.items)) {
            def it:MdGalleryItem (itemAt g.items i)
            def own:string ""
            def k:int 0
            while (k < (array_length it.classes)) {
                own = (own + " " + (MdToHtml.escape((itemAt it.classes k))))
                k = (k + 1)
            }
            def span:string ""
            if (it.span > 1) {
                span = (" style=\"grid-column: span " + (to_string it.span) + "\"")
            }
            if it.isText {
                this.lit(("<p class=\"cell text" + own + "\"" + span + ">" + (MdToHtml.escape(it.text)) + "</p>"))
            } {
                def src:string (MdToHtml.escapeUrl(it.src))
                def inlined:string (this.dataUrl(it.src))
                if ((strlen inlined) > 0) {
                    src = inlined
                } {
                    if (MdToHtml.runsScript(it.src true)) {
                        src = ""
                    }
                }
                def pos:string ((to_string (to_int ((it.focusX * 100.0) + 0.5))) + "% " + (to_string (to_int ((it.focusY * 100.0) + 0.5))) + "%")
                this.lit(("<figure class=\"cell" + own + "\"" + span + ">"))
                this.lit(("<img src=\"" + src + "\" alt=\"" + (MdToHtml.escape(it.caption)) + "\" style=\"object-position: " + pos + "\" />"))
                if (((strlen it.caption) > 0) && (g.caption != "none")) {
                    this.lit(("<figcaption>" + (MdToHtml.escape(it.caption)) + "</figcaption>"))
                }
                this.lit("</figure>")
            }
            this.cr()
            i = (i + 1)
        }
        this.lit("</figure>")
        this.cr()
    }

    fn walkTable:void (node:MdNode) {
        def rows:int (node.childCount())
        this.cr()
        this.lit("<table>")
        this.cr()
        if (rows == 0) {
            this.lit("</table>")
            this.cr()
            return
        }
        def head:MdNode (node.childAt(0))
        this.lit("<thead>")
        this.cr()
        this.lit("<tr>")
        this.cr()
        def cells:int (head.childCount())
        def i:int 0
        while (i < cells) {
            def cell:MdNode (head.childAt(i))
            this.walkCell(cell "th")
            i = (i + 1)
        }
        this.lit("</tr>")
        this.cr()
        this.lit("</thead>")
        this.cr()
        if (rows > 1) {
            this.lit("<tbody>")
            this.cr()
            def r:int 1
            while (r < rows) {
                def row:MdNode (node.childAt(r))
                this.lit("<tr>")
                this.cr()
                def c:int 0
                def rc:int (row.childCount())
                while (c < rc) {
                    def cell2:MdNode (row.childAt(c))
                    this.walkCell(cell2 "td")
                    c = (c + 1)
                }
                this.lit("</tr>")
                this.cr()
                r = (r + 1)
            }
            this.lit("</tbody>")
            this.cr()
        }
        this.lit("</table>")
        this.cr()
    }

    fn walkCell:void (cell:MdNode tag:string) {
        def attr:string ""
        def alen:int (strlen cell.align)
        if (alen > 0) {
            attr = ((" align=\"" + cell.align) + "\"")
        }
        this.lit(((("<" + tag) + attr) + ">"))
        this.walkChildren(cell)
        this.lit((("</" + tag) + ">"))
        this.cr()
    }

    ; `{#id}` when the heading has one, else the slug of its words; a name
    ; already given gets -2, -3, … so every heading can be linked to.
    fn headingId:string (h:MdNode) {
        def base:string (trim h.nodeId)
        if ((strlen base) == 0) {
            base = (MdAnchor.slug((h.plainText())))
        }
        if ((strlen base) == 0) {
            base = "section"
        }
        def id:string base
        def k:int 2
        while ((indexOf ids id) >= 0) {
            id = ((base + "-") + (to_string k))
            k = (k + 1)
        }
        push ids id
        return id
    }

    ; The picture as a data: URL when the store has it, else "".
    fn dataUrl:string (dest:string) {
        if (! haveImages) {
            return ""
        }
        def path:string (images.resolve(dest docDir))
        if ((strlen path) == 0) {
            missedPictures = (missedPictures + 1)
            return ""
        }
        def st:VfsStat (images.stat(path))
        if (! st.found) {
            missedPictures = (missedPictures + 1)
            return ""
        }
        def type:string st.contentType
        if ((strlen type) == 0) {
            type = "application/octet-stream"
        }
        pictures = (pictures + 1)
        return ((("data:" + type) + ";base64,") + (MdToHtml.base64((images.read(path)))))
    }

    ; Would following this address run script? `javascript:` and `vbscript:`
    ; always; `data:` unless a picture is asked for and it is one. Browsers ignore case and leading blanks and controls, so this does.
    sfn runsScript:boolean (dest:string picture:boolean) {
        def d:string ""
        def i:int 0
        def n:int (strlen dest)
        while (i < n) {
            def c:int (charAt dest i)
            if (c > 32) {
                d = (d + (substring dest i (i + 1)))
            }
            i = (i + 1)
        }
        d = (MdChar.lower(d))
        if (((indexOf d "javascript:") == 0) || ((indexOf d "vbscript:") == 0)) {
            return true
        }
        if ((indexOf d "data:") == 0) {
            ; a picture's own script does not run inside <img>
            return ((picture && ((indexOf d "data:image/") == 0)) == false)
        }
        return false
    }

    ; Bytes as base64, in short pieces joined once: one long string grown a
    ; character at a time costs its length squared on targets that copy.
    sfn base64:string (b:buffer) {
        def abc:string "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
        def parts:[string]
        def piece:string ""
        def n:int (buffer_length b)
        def i:int 0
        while (i < n) {
            def b0:int (buffer_get b i)
            def b1:int 0
            def b2:int 0
            if ((i + 1) < n) {
                b1 = (buffer_get b (i + 1))
            }
            if ((i + 2) < n) {
                b2 = (buffer_get b (i + 2))
            }
            def c0:int (idiv b0 4)
            def c1:int (((b0 % 4) * 16) + (idiv b1 16))
            def c2:int (((b1 % 16) * 4) + (idiv b2 64))
            def c3:int (b2 % 64)
            piece = (piece + (substring abc c0 (c0 + 1)) + (substring abc c1 (c1 + 1)))
            if ((i + 1) < n) {
                piece = (piece + (substring abc c2 (c2 + 1)))
            } {
                piece = (piece + "=")
            }
            if ((i + 2) < n) {
                piece = (piece + (substring abc c3 (c3 + 1)))
            } {
                piece = (piece + "=")
            }
            if ((strlen piece) >= 64) {
                push parts piece
                piece = ""
            }
            i = (i + 3)
        }
        push parts piece
        return (join parts "")
    }

    sfn firstWord:string (info:string) {
        def n:int (strlen info)
        def i:int 0
        while (i < n) {
            def c:int (charAt info i)
            if (MdChar.isUnicodeWhitespace(c)) {
                return (substring info 0 i)
            }
            i = (i + 1)
        }
        return info
    }

    sfn escape:string (v:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen v)
        while (i < n) {
            def c:int (charAt v i)
            if (c == 38) {
                out = (out + "&amp;")
            } {
                if (c == 60) {
                    out = (out + "&lt;")
                } {
                    if (c == 62) {
                        out = (out + "&gt;")
                    } {
                        if (c == 34) {
                            out = (out + "&quot;")
                        } {
                            out = (out + (substring v i (i + 1)))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; A destination, the way a browser would take it: percent-encoded where
    ; it has to be, left alone where it is already, and then XML-escaped.
    ;
    ; The two-step matters. `/a?b&c` has to come out as `/a?b&amp;c` — the
    ; `&` is legal in a URL and illegal in an attribute — and `/a b` has to
    ; come out as `/a%20b`, which is not an escaping question at all.
    sfn escapeUrl:string (v:string) {
        def enc:string (MdToHtml.percentEncode(v))
        return (MdToHtml.escape(enc))
    }

    sfn percentEncode:string (v:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen v)
        while (i < n) {
            def c:int (charAt v i)
            if (MdToHtml.isUrlSafe(c)) {
                out = (out + (substring v i (i + 1)))
                i = (i + 1)
            } {
                if (c == 37) {
                    ; An existing escape stays one rather than becoming %25.
                    def h1:int -1
                    def h2:int -1
                    if ((i + 2) < n) {
                        h1 = (charAt v (i + 1))
                        h2 = (charAt v (i + 2))
                    }
                    if ((MdChar.isHexDigit(h1)) && (MdChar.isHexDigit(h2))) {
                        out = (out + (substring v i (i + 3)))
                        i = (i + 3)
                    } {
                        out = (out + "%25")
                        i = (i + 1)
                    }
                } {
                    def cp:int (MdToHtml.codePointAt(v i))
                    def units:int (MdToHtml.unitsAt(v i))
                    out = (out + (MdToHtml.encodeUtf8Percent(cp)))
                    i = (i + units)
                }
            }
        }
        return out
    }

    ; What `encodeURI` leaves alone.
    sfn isUrlSafe:boolean (c:int) {
        if (MdChar.isAlnum(c)) { return true }
        if (c == 59) { return true }
        if (c == 44) { return true }
        if (c == 47) { return true }
        if (c == 63) { return true }
        if (c == 58) { return true }
        if (c == 64) { return true }
        if (c == 38) { return true }
        if (c == 61) { return true }
        if (c == 43) { return true }
        if (c == 36) { return true }
        if (c == 45) { return true }
        if (c == 95) { return true }
        if (c == 46) { return true }
        if (c == 33) { return true }
        if (c == 126) { return true }
        if (c == 42) { return true }
        if (c == 39) { return true }
        if (c == 40) { return true }
        if (c == 41) { return true }
        if (c == 35) { return true }
        return false
    }

    sfn codePointAt:int (v:string i:int) {
        def u:int (charAt v i)
        if ((u >= 55296) && (u <= 56319)) {
            def n:int (strlen v)
            if ((i + 1) < n) {
                def lo:int (charAt v (i + 1))
                if ((lo >= 56320) && (lo <= 57343)) {
                    return ((((u - 55296) * 1024) + (lo - 56320)) + 65536)
                }
            }
        }
        return u
    }

    sfn unitsAt:int (v:string i:int) {
        def u:int (charAt v i)
        if ((u >= 55296) && (u <= 56319)) {
            def n:int (strlen v)
            if ((i + 1) < n) {
                def lo:int (charAt v (i + 1))
                if ((lo >= 56320) && (lo <= 57343)) {
                    return 2
                }
            }
        }
        return 1
    }

    sfn encodeUtf8Percent:string (cp:int) {
        if (cp < 128) {
            return (MdToHtml.pct(cp))
        }
        if (cp < 2048) {
            def b1:int (192 + (idiv cp 64))
            def b2:int (128 + (cp % 64))
            return ((MdToHtml.pct(b1)) + (MdToHtml.pct(b2)))
        }
        if (cp < 65536) {
            def c1:int (224 + (idiv cp 4096))
            def c2:int (128 + ((idiv cp 64) % 64))
            def c3:int (128 + (cp % 64))
            return (((MdToHtml.pct(c1)) + (MdToHtml.pct(c2))) + (MdToHtml.pct(c3)))
        }
        def d1:int (240 + (idiv cp 262144))
        def d2:int (128 + ((idiv cp 4096) % 64))
        def d3:int (128 + ((idiv cp 64) % 64))
        def d4:int (128 + (cp % 64))
        return ((((MdToHtml.pct(d1)) + (MdToHtml.pct(d2))) + (MdToHtml.pct(d3))) + (MdToHtml.pct(d4)))
    }

    sfn pct:string (b:int) {
        def digits:string "0123456789ABCDEF"
        def hi:int (idiv b 16)
        def lo:int (b % 16)
        return (("%" + (substring digits hi (hi + 1))) + (substring digits lo (lo + 1)))
    }
}
