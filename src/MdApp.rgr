; ============================================================================
; MdApp.rgr — a program on a slide: what the ```app fence says.
; ============================================================================
;
; ````markdown
; ```app
; src: apps/scaffold.tsx      # a TSX file of the deck; its .tsx.css beside it
; size: 640x480               # the program's own units, scaled to the box
; allow: deck.data, slide.nav # what it may ask of the deck
; ```
; ````
;
; The program itself (TypeScript + JSX run by CErXes, laid out by EVG) is
; the host's business: here the fence only reserves a box of the program's
; shape and leaves in it what a printed page, a PowerPoint file or a deck
; whose host runs no programs shows — a plate with the program's name.
; The host paints the running program over the same box.
;
; The fence's lines are `key: value`; `#` starts a comment. A line that is
; not a key, or a key this does not know, is said in `warnings` rather than
; ignored, the way a chart's field that its data does not have is.
; ============================================================================

Import "pkg:evg/EVGElement.rgr"
Import "pkg:evg/EVGUnit.rgr"
Import "pkg:evg/EVGColor.rgr"

class MdAppSpec {
    ; the program's file, as the deck names it ("apps/scaffold.tsx")
    def src:string ""
    ; its stylesheet: `css:`, else the program's name with ".css" after it
    def css:string ""
    ; the program's own size, which its view() lays out in
    def width:double 640.0
    def height:double 480.0
    ; what it may ask of the deck ("deck.data", "slide.nav", "slide.style",
    ; "machine", "3d": a 3-D world drawn by the host in a <scene3d> element,
    ; "code": the host's source code viewer while presenting, "sound": sounds
    ; the host synthesizes):
    ; anything else it asks is refused and reported
    def allow:[string]
    def warnings:[string]

    Constructor () {
    }

    fn allows:boolean (what:string) {
        return ((indexOf allow what) >= 0)
    }

    ; width / height
    fn aspect:double () {
        if (height <= 0.0) {
            return 1.0
        }
        return (width / height)
    }

    ; The name a plate shows: the file's own, without its folder.
    fn name:string () {
        def n:int (strlen src)
        def i:int (n - 1)
        while (i >= 0) {
            if ((charAt src i) == 47) {
                return (substring src (i + 1) n)
            }
            i = (i - 1)
        }
        return src
    }
}

class MdApp {
    ; The words a program may be allowed, in the order a guide lists them.
    sfn grants:[string] () {
        return ([] _:string ("deck.data" "slide.nav" "slide.style" "machine" "3d" "code" "sound"))
    }

    sfn read:MdAppSpec (text:string) {
        def spec:MdAppSpec (new MdAppSpec())
        def lines:[string] (strsplit text (strfromcode 10))
        def li:int 0
        while (li < (array_length lines)) {
            def line:string (MdApp.uncomment((itemAt lines li)))
            li = (li + 1)
            if ((strlen line) == 0) {
                continue
            }
            def c:int (indexOf line ":")
            if (c <= 0) {
                push spec.warnings ("app: line " + (to_string li) + " is not \"key: value\": " + line)
                continue
            }
            def key:string (trim (substring line 0 c))
            def value:string (trim (substring line (c + 1) (strlen line)))
            if (key == "src") {
                spec.src = value
                continue
            }
            if (key == "css") {
                spec.css = value
                continue
            }
            if (key == "size") {
                MdApp.readSize(spec value)
                continue
            }
            if (key == "allow") {
                MdApp.readAllow(spec value)
                continue
            }
            push spec.warnings ("app: unknown key \"" + key + "\" (src, css, size, allow)")
        }
        if ((strlen spec.src) == 0) {
            push spec.warnings "app: no src: (the program's .tsx file)"
        }
        if (((strlen spec.css) == 0) && ((strlen spec.src) > 0)) {
            spec.css = (spec.src + ".css")
        }
        return spec
    }

    sfn uncomment:string (line:string) {
        def h:int (indexOf line "#")
        if (h >= 0) {
            return (trim (substring line 0 h))
        }
        return (trim line)
    }

    ; "640x480" (or 640×480, 640 x 480)
    sfn readSize:void (spec:MdAppSpec value:string) {
        def v:string (MdApp.replaceAll(value "×" "x"))
        v = (MdApp.replaceAll(v "X" "x"))
        def x:int (indexOf v "x")
        if (x <= 0) {
            push spec.warnings ("app: size \"" + value + "\" is not WIDTHxHEIGHT")
            return
        }
        def w@(optional):double (str2double (trim (substring v 0 x)))
        def h@(optional):double (str2double (trim (substring v (x + 1) (strlen v))))
        def ww:double (?? w 0.0)
        def hh:double (?? h 0.0)
        if ((ww < 16.0) || (hh < 16.0)) {
            push spec.warnings ("app: size \"" + value + "\" is too small (16x16 at least)")
            return
        }
        if ((ww > 4096.0) || (hh > 4096.0)) {
            push spec.warnings ("app: size \"" + value + "\" is too large (4096 at most)")
            return
        }
        spec.width = ww
        spec.height = hh
    }

    sfn readAllow:void (spec:MdAppSpec value:string) {
        def known:[string] (MdApp.grants())
        def parts:[string] (strsplit (MdApp.replaceAll(value "," " ")) " ")
        def i:int 0
        while (i < (array_length parts)) {
            def p:string (trim (itemAt parts i))
            i = (i + 1)
            if ((strlen p) == 0) {
                continue
            }
            if ((indexOf known p) < 0) {
                push spec.warnings ("app: allow \"" + p + "\" is not one of " + (join known ", "))
                continue
            }
            if ((indexOf spec.allow p) < 0) {
                push spec.allow p
            }
        }
    }

    sfn replaceAll:string (text:string what:string with:string) {
        def out:string ""
        def rest:string text
        def wn:int (strlen what)
        def at:int (indexOf rest what)
        while (at >= 0) {
            out = (out + (substring rest 0 at) + with)
            rest = (substring rest (at + wn) (strlen rest))
            at = (indexOf rest what)
        }
        return (out + rest)
    }

    ; The box a program takes in a column `width` wide with `room` of height
    ; (0 for any): its own shape, as large as both allow. [w, h]
    sfn boxSize:[double] (spec:MdAppSpec width:double room:double) {
        def w:double width
        def h:double (w / (spec.aspect()))
        if ((room > 0.0) && (h > room)) {
            h = room
            w = (h * (spec.aspect()))
        }
        return ([] _:double (w h))
    }

    ; What stands in the box where the program does not run: a quiet plate
    ; with a play mark and the program's name.
    sfn placeholder:EVGElement (spec:MdAppSpec w:double h:double) {
        return (MdApp.plateIn(spec w h (new MdAppPlate())))
    }

    ; The plate with why the program is not running under its name (its
    ; syntax error, what it threw, a frame that was no element tree), ""
    ; for none: said where the program was to be, not only in a console.
    sfn plate:EVGElement (spec:MdAppSpec w:double h:double note:string) {
        def look (new MdAppPlate())
        look.note = note
        return (MdApp.plateIn(spec w h look))
    }

    ; The plate as `look` says: drawn in its ink (the slide's text colour,
    ; so it reads on a light slide and on a dark one alike), a round badge
    ; with a play mark — or "!" when there is a note — the program's name,
    ; the caption under it and the note in a warning colour. A box too small
    ; for the badge keeps the name with "▶" before it.
    sfn plateIn:EVGElement (spec:MdAppSpec w:double h:double look:MdAppPlate) {
        def ink:EVGColor (EVGColor.parse((look.inkOr())))
        def alert:EVGColor (EVGColor.parse((look.alertOr())))
        def stopped:boolean ((strlen look.note) > 0)
        def root:EVGElement (EVGElement.createDiv())
        root.width = (EVGUnit.px(w))
        root.height = (EVGUnit.px(h))
        root.pageWidth = w
        root.pageHeight = h
        root.position = "relative"
        root.backgroundColor = (ink.withAlpha(0.06))
        root.setAttribute("border-width" "1px")
        root.borderColor = (ink.withAlpha(0.22))
        root.setAttribute("border-radius" "10px")
        def nameSize:double (MdApp.clampTo((h * 0.07) 10.0 20.0))
        def small:double (MdApp.most(9.0 (nameSize * 0.72)))
        def badge:boolean ((h >= 90.0) && (w >= 120.0))
        def d:double (MdApp.clampTo(((MdApp.least(w h)) * 0.2) 28.0 64.0))
        def note:string (MdApp.shortNote(look.note))
        def noteLines:int 0
        if stopped {
            def perLine:double (MdApp.most(1.0 ((w * 0.84) / (small * 0.55))))
            noteLines = (ceil ((to_double (strlen note)) / perLine))
            if (noteLines > 3) {
                noteLines = 3
            }
            if (noteLines < 1) {
                noteLines = 1
            }
        }
        def total:double (nameSize * 1.25)
        if badge {
            total = (total + d + (nameSize * 0.6))
        }
        if ((strlen look.caption) > 0) {
            total = (total + (small * 1.8))
        }
        if stopped {
            total = (total + (small * 0.5) + ((to_double noteLines) * small * 1.3))
        }
        def y:double ((h - total) * 0.5)
        if badge {
            def tint:EVGColor ink
            if stopped {
                tint = alert
            }
            def b:EVGElement (EVGElement.createDiv())
            b.position = "absolute"
            b.left = (EVGUnit.px(((w - d) * 0.5)))
            b.top = (EVGUnit.px(y))
            b.width = (EVGUnit.px(d))
            b.height = (EVGUnit.px(d))
            b.backgroundColor = (tint.withAlpha(0.1))
            b.setAttribute("border-width" "1.5px")
            b.borderColor = (tint.withAlpha(0.4))
            b.setAttribute("border-radius" ((to_string (d * 0.5)) + "px"))
            root.addChild(b)
            def markSize:double (d * 0.42)
            def m:EVGElement (MdApp.line((? stopped "!" "▶") markSize (tint.withAlpha(0.85))))
            ; the triangle's weight sits left of its box: moved a little right
            def nudge:double (? stopped 0.0 (d * 0.05))
            m.left = (EVGUnit.px(((w - d) * 0.5) + nudge))
            m.top = (EVGUnit.px((y + ((d - (markSize * 1.25)) * 0.5))))
            m.width = (EVGUnit.px(d))
            root.addChild(m)
            y = (y + d + (nameSize * 0.6))
        }
        def name:string (spec.name())
        if (badge == false) {
            name = ("▶ " + name)
        }
        def t:EVGElement (MdApp.line(name nameSize (ink.withAlpha(0.88))))
        t.top = (EVGUnit.px(y))
        t.left = (EVGUnit.px((w * 0.05)))
        t.width = (EVGUnit.px((w * 0.9)))
        root.addChild(t)
        y = (y + (nameSize * 1.25))
        if ((strlen look.caption) > 0) {
            y = (y + (small * 0.5))
            def c:EVGElement (MdApp.line(look.caption small (ink.withAlpha(0.6))))
            c.top = (EVGUnit.px(y))
            c.left = (EVGUnit.px((w * 0.05)))
            c.width = (EVGUnit.px((w * 0.9)))
            root.addChild(c)
            y = (y + (small * 1.3))
        }
        if stopped {
            y = (y + (small * 0.5))
            def n:EVGElement (MdApp.line(note small alert))
            n.top = (EVGUnit.px(y))
            n.left = (EVGUnit.px((w * 0.08)))
            n.width = (EVGUnit.px((w * 0.84)))
            n.lineHeight = 1.3
            root.addChild(n)
        }
        return root
    }

    ; A centred line of text at `size` in `colour`, placed by the caller.
    sfn line:EVGElement (text:string size:double colour:EVGColor) {
        def t:EVGElement (EVGElement.createSpan())
        t.tagName = "text"
        t.position = "absolute"
        t.textContent = text
        t.fontSize = (EVGUnit.px(size))
        t.lineHeight = 1.25
        t.color = colour
        t.textAlign = "center"
        return t
    }

    ; A note kept to what a plate can show: its first line, 140 characters.
    sfn shortNote:string (note:string) {
        def s:string (trim note)
        def nl:int (indexOf s (strfromcode 10))
        if (nl > 0) {
            s = (trim (substring s 0 nl))
        }
        if ((strlen s) > 140) {
            s = ((substring s 0 139) + "…")
        }
        return s
    }

    sfn clampTo:double (v:double lo:double hi:double) {
        return (MdApp.least((MdApp.most(v lo)) hi))
    }

    sfn most:double (a:double b:double) {
        if (a > b) {
            return a
        }
        return b
    }

    sfn least:double (a:double b:double) {
        if (a < b) {
            return a
        }
        return b
    }
}

; How a program's plate looks and what it says (MdApp.plateIn). The host
; fills it in: a deck that runs programs knows its slide's text colour and
; whether the program is still starting.
class MdAppPlate {
    ; the slide's text colour; "" for a grey that reads on light and dark
    def ink:string ""
    ; why the program is not running ("" for nothing wrong): said under the
    ; name in `alert`, with "!" in the badge
    def note:string ""
    ; a quiet line under the name ("Loading…"), "" for none
    def caption:string ""
    ; the note's colour; "" for a red that reads on light and dark
    def alert:string ""

    fn inkOr:string () {
        if ((strlen (trim ink)) == 0) {
            return "#7d8597"
        }
        return ink
    }

    fn alertOr:string () {
        if ((strlen (trim alert)) == 0) {
            return "#e5484d"
        }
        return alert
    }
}
