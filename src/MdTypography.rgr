            i = (i + 1)
        }
        return items
    }

    ; A group's cells as markdown-it's tokens would be: text, an emoji, the
    ; inside of an abbreviation one level down.
    fn expandGroup:void (g:MdTypoGroup items:[MdQuoteItem]) {
        def n:int (g.cellCount())
        def cur:MdQuoteItem (MdQuoteItem.make(0 g.level ""))
        def curAbbr:int -1
        def open:boolean false
        def i:int 0
        while (i < n) {
            def c:MdTypoCell (g.cellAt(i))
            if (c.abbr != curAbbr) {
                if open {
                    push items cur
                    open = false
                }
                if (curAbbr >= 0) {
                    push items (MdQuoteItem.make(3 g.level ""))
                }
                if (c.abbr >= 0) {
                    push items (MdQuoteItem.make(3 g.level ""))
                }
                curAbbr = c.abbr
            }
            def lv:int g.level
            if (curAbbr >= 0) { lv = (g.level + 1) }
            if (c.kind == 0) {
                if (! open) {
                    cur = (MdQuoteItem.make(0 lv ""))
                    open = true
                }
                cur.text = (cur.text + c.text)
                push cur.cells c
            } {
                if open {
                    push items cur
                    open = false
                }
                push items (MdQuoteItem.make(1 lv c.text))
            }
            i = (i + 1)
        }
        if open { push items cur }
        if (curAbbr >= 0) {
            push items (MdQuoteItem.make(3 g.level ""))
        }
    }

    sfn isPunct:boolean (c:int) {
        return (MdChar.isUnicodePunct(c))
    }

    sfn isSpace:boolean (c:int) {
        return (MdChar.isUnicodeWhitespace(c))
    }

    fn quotePass:void () {
