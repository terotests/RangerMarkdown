        if (MdChar.isUnicodeWhitespace(c)) { return true }
        return (MdChar.isUnicodePunct(c))
    }

    fn abbrPass:void (g:MdTypoGroup) {
        if (! (opts.hasAbbreviations())) { return }
        def n:int (g.cellCount())
        def m:int (array_length opts.abbrLabels)
        def i:int 0
        while (i < n) {
            def took:int 0
            def prevOk:boolean true
            if (i > 0) {
                def pc:MdTypoCell (g.cellAt((i - 1)))
                if (pc.kind == 0) {
                    prevOk = (MdTypography.isAbbrEdge((pc.last())))
                }
            }
            if prevOk {
                def k:int 0
                while ((took == 0) && (k < m)) {
                    def label:string (itemAt opts.abbrLabels k)
                    def len:int (strlen label)
                    if ((this.plainText(g i len)) == label) {
                        def nextOk:boolean true
                        if ((i + len) < n) {
                            def nc:MdTypoCell (g.cellAt((i + len)))
                            if (nc.kind == 0) {
                                nextOk = (MdTypography.isAbbrEdge((nc.first())))
                            }
                        }
                        if nextOk {
                            push g.titles (opts.abbrTitle(label))
                            def id:int ((array_length g.titles) - 1)
                            def q:int i
                            while (q < (i + len)) {
