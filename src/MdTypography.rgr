        def n:int (strlen t)
        def i:int 1
        while (i < n) {
            def a:int (charAt t (i - 1))
            def b:int (charAt t i)
            if (((a == 63) || (a == 33)) && ((b == 63) || (b == 33))) { return true }
            i = (i + 1)
