    fn flushStretch:[MdTypoCell] (g:MdTypoGroup out:[MdTypoCell] seg:[MdTypoCell]) {
        def n0:int (array_length seg)
        if (n0 == 0) { return out }
        def s:[MdTypoCell] seg
        def t:string (MdTypography.textOf(s))
        if (MdTypography.contains(t "(")) {
            s = (MdTypography.scoped(s))
        }
        if (MdTypography.contains(t "+-")) {
            s = (MdTypography.pair(s "+" "-" (strfromcode 177)))
        }
        if (MdTypography.contains(t "..")) {
            s = (MdTypography.dots(s))
        }
        if ((MdTypography.contains(t "..")) || (MdTypography.contains(t (strfromcode 8230)))) {
            s = (MdTypography.dotsAfterMark(s))
        }
        if (MdTypography.marksIn(t)) {
