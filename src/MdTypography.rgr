                def isSingle:boolean (q == 39)
                def lastChar:int 32
                if (at > 0) {
                    lastChar = (charAt text (at - 1))
                } {
                    lastChar = (this.neighbour(items idx -1))
                }
                def nextChar:int 32
                if ((at + 1) < max) {
                    nextChar = (charAt text (at + 1))
                } {
                    nextChar = (this.neighbour(items idx 1))
                }
                def lastPunct:boolean (MdTypography.isPunct(lastChar))
                def nextPunct:boolean (MdTypography.isPunct(nextChar))
                def lastWs:boolean (MdTypography.isSpace(lastChar))
                def nextWs:boolean (MdTypography.isSpace(nextChar))
                def canOpen:boolean true
                def canClose:boolean true
                if nextWs {
                    canOpen = false
                } {
                    if nextPunct {
                        if (! (lastWs || lastPunct)) { canOpen = false }
                    }
                }
                if lastWs {
                    canClose = false
                } {
                    if lastPunct {
                        if (! (nextWs || nextPunct)) { canClose = false }
                    }
