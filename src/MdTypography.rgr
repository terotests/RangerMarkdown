; ============================================================================
; MdTypography.rgr — what markdown-it does to a line's TEXT after parsing it.
; ============================================================================
;
;   (c) (tm) (r) +-  ...  ?.....  !!!!!!  ,,  --  ---      © ™ ® ± … ?.. !!! , – —
;   "Smartypants" and 'single quotes', it's                “…” ‘…’ ’
;   :wink: :cry:  :-)  8-)  ;)                             😉 😢 😃 😎 😉
;   HTML, with `*[HTML]: Hyper Text Markup Language`      <abbr title="…">HTML</abbr>
;
; markdown-it's `typographer` (its core rules `replacements` and
; `smartquotes`), markdown-it-emoji and markdown-it-abbr. All four are core
; rules there — they run after the inline pass, over the text tokens it left —
; and they are a pass after the inline parse here for the same reason: a code
; span, a link's address, an autolink and a piece of raw HTML have to have
; taken their characters first, because none of those may be touched. Neither
; may a bare address in the text (`https://a--b.example`) or an attribute
; block (`{data-x="y"}`) left in a line; those are fenced off before anything
; else looks.
;
; **What a replacement does to the source map.** A text node maps character
; for character to the file, and the layout's caret arithmetic depends on it.
; `©` is one character standing for three, so it cannot sit in such a node.
; Every replacement that changes the length becomes a text node of its own,
; flagged `subst`, whose span is the WHOLE source it came from — a click on
; `©` lands on `(c)`, before it or after it, and never in its middle. A curly
; quote is one character for one, so it stays where it was and the map stays
; exact.
;
; **The unit of work** is a GROUP: a run of sibling text nodes that are
; verbatim (their span is as long as their text) and contiguous in the file —
; what markdown-it would have as one text token. CommonMark's parser splits
; text at every `!` and `[`, and `!!!!!!` has to be seen as one run. Inside a
; group the text is a list of CELLS, one per character to begin with, each
; carrying its source span; a replacement merges cells, an abbreviation tags
; them, and at the end each group is written back as nodes — unchanged groups
; are left exactly as the parser made them.
; ============================================================================

Import "MdNode.rgr"
Import "MdChar.rgr"
Import "MdAttrs.rgr"
Import "MdEmoji.rgr"
Import "MdFrontMatter.rgr"

; What a document reads beyond CommonMark, and what it defined.
class MdInlineOptions {
    ; markdown-it's plugins: sub, sup, ins, mark, emoji, abbr
    def extensions:boolean true
    ; markdown-it's `typographer`: the replacements and the quotes
    def typographer:boolean true
    ; set by `commonMarkOnly`: the front matter may not switch anything on
    def locked:boolean false
    ; the quotes, as code points: double open, double close, single open,
    ; single close — English by default, ” ” ’ ’ for Finnish and Swedish
    def dq1:int 8220
    def dq2:int 8221
    def sq1:int 8216
    def sq2:int 8217
    ; abbreviations, longest label first (which is the order they are
    ; tried in), and the title of each
    def abbrLabels:[string]
    def abbrTitles:[string:string]

    Constructor () {
    }

    fn commonMarkOnly:void () {
        extensions = false
        typographer = false
        locked = true
    }

    ; `typographer: false` and `lang: fi` in the front matter.
    fn readMeta:void (meta:MdMeta) {
        if locked { return }
        typographer = (meta.flag("typographer" true))
        def lang:string (MdChar.lower((trim (meta.get("lang" "")))))
        def two:string lang
        if ((strlen lang) > 2) {
            def sep:int (charAt lang 2)
            if ((sep == 45) || (sep == 95)) {
                two = (substring lang 0 2)
            }
        }
        if ((two == "fi") || (two == "sv")) {
            dq1 = 8221
            dq2 = 8221
            sq1 = 8217
            sq2 = 8217
        }
    }

    ; Everything above as one string: two documents read with the same one
    ; read the same block source to the same nodes.
    fn signature:string () {
        def sig:string "x"
        if extensions { sig = "e" }
        if typographer { sig = (sig + "t") }
        sig = (((((((sig + ":") + (to_string dq1)) + ",") + (to_string dq2)) + ",") + (to_string sq1)) + ",")
        sig = (sig + (to_string sq2))
        def i:int 0
        def n:int (array_length abbrLabels)
        while (i < n) {
            def l:string (itemAt abbrLabels i)
            def t:string (?? (get abbrTitles l) "")
            sig = ((((((sig + "|") + (to_string (strlen l))) + ":") + l) + "=") + t)
            i = (i + 1)
        }
        return sig
    }

    fn defineAbbreviation:void (label:string title:string) {
        if (has abbrTitles label) { return }
        set abbrTitles label title
        def len:int (strlen label)
        def out:[string]
        def placed:boolean false
        def i:int 0
        def n:int (array_length abbrLabels)
        while (i < n) {
            def l:string (itemAt abbrLabels i)
            if ((! placed) && ((strlen l) < len)) {
                push out label
                placed = true
            }
            push out l
            i = (i + 1)
        }
        if (! placed) { push out label }
        abbrLabels = out
    }

    ; One table for the process: it is 1900 names, and a document is parsed
    ; again on every keystroke.
    fn emoji:MdEmoji () {
        return (MdEmoji.__singleton())
    }

    fn abbrTitle:string (label:string) {
        return (?? (get abbrTitles label) "")
    }

    fn hasAbbreviations:boolean () {
        return ((array_length abbrLabels) > 0)
    }
}

; One character of a group, or what a replacement made of several.
class MdTypoCell {
    def text:string ""
    ; its source, [a, b)
    def a:int 0
    def b:int 0
    ; 0 a character as typed, 1 an emoji, 2 a typographic replacement,
    ; 3 a character no rule may touch (an address, an attribute block)
    def kind:int 0
    ; the abbreviation it is part of, an index into the group's titles, or -1
    def abbr:int -1

    Constructor () {
    }

    sfn make:MdTypoCell (text:string a:int b:int kind:int abbr:int) {
        def c:MdTypoCell (new MdTypoCell())
        c.text = text
        c.a = a
        c.b = b
        c.kind = kind
        c.abbr = abbr
        return c
    }

    fn first:int () {
        if ((strlen text) == 0) { return 32 }
        return (charAt text 0)
    }

    fn last:int () {
        def n:int (strlen text)
        if (n == 0) { return 32 }
        return (charAt text (n - 1))
    }
}

; A run of sibling text nodes markdown-it would have read as one text token.
class MdTypoGroup {
    def parent:MdNode (new MdNode())
    def first:int 0
    def count:int 0
    def text:string ""
    def base:int 0
    def level:int 0
    def cells:[MdTypoCell]
    def hasCells:boolean false
    def changed:boolean false
    def titles:[string]

    Constructor () {
    }

    fn ensureCells:void () {
        if hasCells { return }
        hasCells = true
        def n:int (strlen text)
        def i:int 0
        while (i < n) {
            push cells (MdTypoCell.make((substring text i (i + 1)) (base + i) ((base + i) + 1) 0 -1))
            i = (i + 1)
        }
    }

    fn cellCount:int () {
        return (array_length cells)
    }

    fn cellAt:MdTypoCell (i:int) {
        return (itemAt cells i)
    }
}

; One step of the quote pass's walk: a text a quote may be in, a piece of
; content that is only context, a line break, or a tag's edge.
class MdQuoteItem {
    ; 0 text, 1 other content, 2 break, 3 tag
    def kind:int 0
    def level:int 0
    def text:string ""
    def cells:[MdTypoCell]
    ; a group that no rule but the quotes touched has no cells: its quotes
    ; are put straight into its nodes, at offsets into `text`
    def direct:boolean false
    def group:MdTypoGroup (new MdTypoGroup())

    Constructor () {
    }

    sfn make:MdQuoteItem (kind:int level:int text:string) {
        def q:MdQuoteItem (new MdQuoteItem())
        q.kind = kind
        q.level = level
        q.text = text
        return q
    }
}

; A quote waiting for its partner.
class MdQuoteOpen {
    def item:int 0
    def pos:int 0
    def single:boolean false
    def level:int 0

    Constructor () {
    }
}

class MdTypography {
    def opts:MdInlineOptions (new MdInlineOptions())
    def groups:[MdTypoGroup]
    ; the walk in document order: a group (by index), or a quote item
    def walkGroup:[int]
    def walkItem:[MdQuoteItem]
    ; the walk is for the quotes, and only kept when there are any
    def walking:boolean true

    Constructor () {
    }

    ; Everything, on one block's inlines.
    ; `raw` is the text the block's inlines were parsed from: a block with
    ; nothing in it any rule could take is not walked at all, which is most
    ; of them.
    sfn apply:void (block:MdNode raw:string o:MdInlineOptions) {
        if ((! o.extensions) && (! o.typographer)) { return }
        if (o.typographer && (MdTypography.hasQuote(raw))) {
        } {
            if (! (MdTypography.wantsText(raw o))) { return }
        }
        def t:MdTypography (new MdTypography())
        t.opts = o
        t.walking = (o.typographer && (MdTypography.hasQuote(raw)))
        t.run(block)
    }

    fn run:void (block:MdNode) {
        this.collect(block 0)
        def n:int (array_length groups)
        if (n == 0) { return }
        def quotes:boolean false
        if (! walking) { quotes = true }
        def i:int 0
        while (i < n) {
            def g:MdTypoGroup (itemAt groups i)
            if (opts.typographer && (! quotes)) {
                quotes = (MdTypography.hasQuote(g.text))
            }
            if (this.wants(g.text)) {
                g.ensureCells()
                this.protect(g)
                if opts.extensions {
                    this.emojiPass(g)
                    this.abbrPass(g)
                }
                if opts.typographer {
                    this.replacePass(g)
                }
            }
            i = (i + 1)
        }
        if (walking && quotes) {
            this.quotePass()
        }
        ; written back last to first, so a group's child indices are still
        ; the ones it was found at
        def j:int (n - 1)
        while (j >= 0) {
            def g2:MdTypoGroup (itemAt groups j)
            if g2.changed {
                this.rebuild(g2)
            }
            j = (j - 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; The walk
    ; ----------------------------------------------------------------------

    ; A text node whose span is its text, character for character.
    sfn verbatim:boolean (n:MdNode) {
        if (n.kind != "text") { return false }
        if n.subst { return false }
        if (n.srcStart < 0) { return false }
        return ((n.srcEnd - n.srcStart) == (strlen n.literal))
    }

    fn pushItem:void (q:MdQuoteItem) {
        if (! walking) { return }
        push walkGroup -1
        push walkItem q
    }

    fn collect:void (parent:MdNode level:int) {
        def i:int 0
        def n:int (parent.childCount())
        while (i < n) {
            def c:MdNode (parent.childAt(i))
            if (MdTypography.verbatim(c)) {
                def g:MdTypoGroup (new MdTypoGroup())
                g.parent = parent
                g.first = i
                g.level = level
                g.base = c.srcStart
                def text:string c.literal
                def end:int c.srcEnd
                def j:int (i + 1)
                def going:boolean true
                while (going && (j < n)) {
                    def d:MdNode (parent.childAt(j))
                    if ((MdTypography.verbatim(d)) && (d.srcStart == end)) {
                        text = (text + d.literal)
                        end = d.srcEnd
                        j = (j + 1)
                    } {
                        going = false
                    }
                }
                g.count = (j - i)
                g.text = text
                push groups g
                if walking {
                    push walkGroup ((array_length groups) - 1)
                    push walkItem (MdQuoteItem.make(0 level ""))
                }
                i = j
            } {
                this.collectOne(c level)
                i = (i + 1)
            }
        }
    }

    fn collectOne:void (c:MdNode level:int) {
        def k:string c.kind
        if ((k == "softbreak") || (k == "linebreak")) {
            this.pushItem((MdQuoteItem.make(2 level "")))
            return
        }
        def container:boolean false
        if ((k == "emph") || (k == "strong")) { container = true }
        if ((k == "strike") || (k == "ins")) { container = true }
        if ((k == "mark") || (k == "sub")) { container = true }
        if ((k == "sup") || (k == "abbr")) { container = true }
        ; a link's text, but not an autolink's, which IS its address
        if ((k == "link") && (c.info != "auto")) { container = true }
        if container {
            this.pushItem((MdQuoteItem.make(3 level "")))
            this.collect(c (level + 1))
            this.pushItem((MdQuoteItem.make(3 level "")))
            return
        }
        ; code, math, raw HTML, an entity, an escape, a picture's alt text:
        ; context for a quote beside it, and nothing to change
        if (! walking) { return }
        def content:string c.literal
        if ((k != "text") && (k != "code") && (k != "math") && (k != "html_inline")) {
            content = (c.plainText())
        }
        this.pushItem((MdQuoteItem.make(1 level content)))
    }

    sfn hasQuote:boolean (text:string) {
        def n:int (strlen text)
        def i:int 0
        while (i < n) {
            def c:int (charAt text i)
            if ((c == 34) || (c == 39)) { return true }
            i = (i + 1)
        }
        return false
    }

    ; Is there anything in this text a rule other than the quotes could
    ; take? Asked of every run of text in the document, so it looks at a
    ; character and the one after it and builds nothing: most prose has
    ; none of these and is left exactly as the parser made it.
    fn wants:boolean (text:string) {
        return (MdTypography.wantsText(text opts))
    }

    sfn wantsText:boolean (text:string opts:MdInlineOptions) {
        def n:int (strlen text)
        def i:int 0
        while (i < n) {
            def c:int (charAt text i)
            ; letters and spaces are most of any text and start nothing,
            ; but for the B, x and X of an emoticon
            def look:boolean ((c < 65) && (c != 32))
            if ((((c == 66) || (c == 120)) || (c == 88)) || (c == 8230)) { look = true }
            if (((c >= 91) && (c <= 96)) || ((c >= 123) && (c <= 127))) { look = true }
            if look {
            def d:int -1
            if ((i + 1) < n) { d = (charAt text (i + 1)) }
            if opts.typographer {
                if (c == 40) {
                    def lc:int (MdChar.foldCase(d))
                    if (((lc == 99) || (lc == 114)) || (lc == 116)) { return true }
                }
                if ((c == 43) && (d == 45)) { return true }
                if ((c == 46) && (d == 46)) { return true }
                if ((c == 44) && (d == 44)) { return true }
                if ((c == 45) && (d == 45)) { return true }
                if (((c == 63) || (c == 33)) && ((d == 63) || (d == 33))) { return true }
                if (c == 8230) { return true }
            }
            if opts.extensions {
                if ((c == 58) && (d >= 0)) {
                    ; a shortcode, or an emoticon's eyes
                    if (MdTypography.isNameChar(d)) { return true }
                    if (MdTypography.emoticonMouth(d)) { return true }
                }
                if ((c == 59) && (((d == 41) || (d == 40)) || (d == 45))) { return true }
                if ((c == 60) && (((d == 51) || (d == 47)) || (d == 92))) { return true }
                if ((d == 45) && ((((c == 56) || (c == 66)) || (c == 120)) || (c == 88))) { return true }
            }
            }
            i = (i + 1)
        }
        if (opts.extensions && (opts.hasAbbreviations())) {
            def k:int 0
            def m:int (array_length opts.abbrLabels)
            while (k < m) {
                if (MdTypography.contains(text (itemAt opts.abbrLabels k))) { return true }
                k = (k + 1)
            }
        }
        return false
    }

    ; What may follow the `:` of an emoticon: `:)` `:-)` `:'(` `:,)` `:"(`
    ; `:|` `:*` `:/` `:@` `:$` and the letters, which isNameChar has.
    sfn emoticonMouth:boolean (d:int) {
        if (((d == 41) || (d == 40)) || ((d == 45) || (d == 39))) { return true }
        if (((d == 44) || (d == 34)) || ((d == 124) || (d == 42))) { return true }
        return (((d == 47) || (d == 64)) || (d == 36))
    }

    ; Could there be an address or an attribute block in this text at all?
    sfn mayFence:boolean (t:string) {
        def n:int (strlen t)
        def i:int 0
        while (i < n) {
            def c:int (charAt t i)
            if (c == 123) { return true }
            if ((c == 58) && ((i + 2) < n)) {
                if (((charAt t (i + 1)) == 47) && ((charAt t (i + 2)) == 47)) { return true }
            }
            if (((c == 46) && (i >= 3)) && ((MdChar.foldCase((charAt t (i - 1)))) == 119)) {
                if ((MdChar.lower((substring t (i - 3) i))) == "www") { return true }
            }
            i = (i + 1)
        }
        return false
    }

    sfn contains:boolean (v:string needle:string) {
        def n:int (strlen needle)
        def m:int (strlen v)
        if (n == 0) { return false }
        def i:int 0
        while ((i + n) <= m) {
            if ((substring v i (i + n)) == needle) { return true }
            i = (i + 1)
        }
        return false
    }

    ; ----------------------------------------------------------------------
    ; What no rule may touch
    ; ----------------------------------------------------------------------
    ;
    ; A bare address (`https://…`, `www.…`) up to the next space, and a
    ; `{…}` that reads as an attribute block. markdown-it's linkify would
    ; have made the first a link; the second is an instruction, not prose.
    fn protect:void (g:MdTypoGroup) {
        def t:string g.text
        if (! (MdTypography.mayFence(t))) { return }
        def n:int (strlen t)
        def i:int 0
        while (i < n) {
            def stop:int (MdTypography.addressEnd(t i))
            if (stop < 0) {
                stop = (MdTypography.attrEnd(t i))
            }
            if (stop > i) {
                def k:int i
                while (k < stop) {
                    def cell:MdTypoCell (g.cellAt(k))
                    cell.kind = 3
                    k = (k + 1)
                }
                i = stop
            } {
                i = (i + 1)
            }
        }
    }

    ; Where an address that starts at `i` ends, or -1.
    sfn addressEnd:int (t:string i:int) {
        def n:int (strlen t)
        if (i > 0) {
            if (MdChar.isAlnum((charAt t (i - 1)))) { return -1 }
        }
        def j:int i
        def scheme:boolean false
        while ((j < n) && (MdChar.isLetter((charAt t j)))) {
            j = (j + 1)
        }
        if ((j > i) && ((j + 2) < n)) {
            if ((substring t j (j + 3)) == "://") { scheme = true }
        }
        if (! scheme) {
            if ((i + 4) > n) { return -1 }
            if ((MdChar.lower((substring t i (i + 4)))) != "www.") { return -1 }
        }
        def k:int i
        while (k < n) {
            if (MdChar.isUnicodeWhitespace((charAt t k))) { return k }
            k = (k + 1)
        }
        return n
    }

    sfn attrEnd:int (t:string i:int) {
        if ((charAt t i) != 123) { return -1 }
        def n:int (strlen t)
        def k:int (i + 1)
        while (k < n) {
            def c:int (charAt t k)
            if (c == 125) {
                if (MdAttrs.isBlock((substring t i (k + 1)))) { return (k + 1) }
                return -1
            }
            if (c == 123) { return -1 }
            k = (k + 1)
        }
        return -1
    }

    ; ----------------------------------------------------------------------
    ; Emoji (markdown-it-emoji)
    ; ----------------------------------------------------------------------
    ;
    ; `:name:` for any name in the table; an emoticon only where it is not
    ; glued to a letter on either side — so `http://` keeps its `:/`.
    sfn isZPCc:boolean (c:int) {
        if (c < 32) { return true }
        if (c == 127) { return true }
        if (MdChar.isUnicodeWhitespace(c)) { return true }
        ; Unicode's punctuation, not its symbols: `$+<=>^`|~` are symbols
        if ((((c == 36) || (c == 43)) || ((c == 60) || (c == 61))) || (c == 62)) { return false }
        if (((c == 94) || (c == 96)) || ((c == 124) || (c == 126))) { return false }
        return (MdChar.isUnicodePunct(c))
    }

    ; The characters a shortcode or an emoticon can begin with.
    sfn emojiStart:boolean (c:int) {
        if (((c == 58) || (c == 59)) || ((c == 60) || (c == 62))) { return true }
        if (((c == 93) || (c == 44)) || ((c == 56) || (c == 66))) { return true }
        if (((c == 120) || (c == 88)) || ((c == 111) || (c == 79))) { return true }
        return (c == 48)
    }

    sfn isNameChar:boolean (c:int) {
        if (MdChar.isAlnum(c)) { return true }
        if ((c == 95) || (c == 43)) { return true }
        return (c == 45)
    }

    ; The text of cells [i, i+len) when they are all characters as typed,
    ; else "".
    fn plainText:string (g:MdTypoGroup i:int len:int) {
        def n:int (g.cellCount())
        if ((i + len) > n) { return "" }
        def out:string ""
        def k:int i
        while (k < (i + len)) {
            def c:MdTypoCell (g.cellAt(k))
            if ((c.kind != 0) || (c.abbr >= 0)) { return "" }
            out = (out + c.text)
            k = (k + 1)
        }
        return out
    }

    fn charOf:int (g:MdTypoGroup i:int) {
        if (i < 0) { return -1 }
        if (i >= (g.cellCount())) { return -1 }
        def c:MdTypoCell (g.cellAt(i))
        return (c.first())
    }

    fn emojiPass:void (g:MdTypoGroup) {
        def out:[MdTypoCell]
        def n:int (g.cellCount())
        def scCount:int ((opts.emoji()).shortcutCount())
        def i:int 0
        while (i < n) {
            def cell:MdTypoCell (g.cellAt(i))
            def took:int 0
            if ((cell.kind == 0) && (MdTypography.emojiStart((cell.first())))) {
                if (cell.text == ":") {
                    def j:int (i + 1)
                    while ((j < n) && (MdTypography.isNameChar((this.charOf(g j))))) {
                        j = (j + 1)
                    }
                    if ((j > (i + 1)) && ((this.charOf(g j)) == 58)) {
                        def name:string (this.plainText(g (i + 1) ((j - i) - 1)))
                        def v:string ((opts.emoji()).lookup(name))
                        if ((strlen v) > 0) {
                            def last:MdTypoCell (g.cellAt(j))
                            push out (MdTypoCell.make(v cell.a last.b 1 -1))
                            took = ((j - i) + 1)
                        }
                    }
                }
                def k:int 0
                while ((took == 0) && (k < scCount)) {
                    def sc:string ((opts.emoji()).shortcutAt(k))
                    def len:int (strlen sc)
                    if ((this.plainText(g i len)) == sc) {
                        ; A match glued to a letter is not an emoticon, and the
                        ; scan goes on after it as markdown-it's does.
                        def before:int (this.charOf(g (i - 1)))
                        def after:int (this.charOf(g (i + len)))
                        def okBefore:boolean ((i == 0) || (MdTypography.isZPCc(before)))
                        def okAfter:boolean (((i + len) >= n) || (MdTypography.isZPCc(after)))
                        if (okBefore && okAfter) {
                            def v2:string ((opts.emoji()).lookup(((opts.emoji()).shortcutName(k))))
                            def lastc:MdTypoCell (g.cellAt(((i + len) - 1)))
                            push out (MdTypoCell.make(v2 cell.a lastc.b 1 -1))
                        } {
                            def q:int i
