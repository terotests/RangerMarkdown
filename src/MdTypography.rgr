        return false
    }

    sfn textOf:string (s:[MdTypoCell]) {
        def out:string ""
        def i:int 0
        def n:int (array_length s)
        while (i < n) {
            def c:MdTypoCell (itemAt s i)
            out = (out + c.text)
            i = (i + 1)
        }
        return out
    }

    sfn is:boolean (s:[MdTypoCell] i:int ch:string) {
        if (i < 0) { return false }
        if (i >= (array_length s)) { return false }
        def c:MdTypoCell (itemAt s i)
        if (c.kind != 0) { return false }
        return (c.text == ch)
    }

    sfn isFold:boolean (s:[MdTypoCell] i:int lower:string) {
        if (i < 0) { return false }
        if (i >= (array_length s)) { return false }
        def c:MdTypoCell (itemAt s i)
