    ; The character beside item `idx` in direction `dir`: a space at a line
    ; break or at the end, and tags have no characters.
    fn neighbour:int (items:[MdQuoteItem] idx:int dir:int) {
        def n:int (array_length items)
        def j:int (idx + dir)
        while ((j >= 0) && (j < n)) {
            def it:MdQuoteItem (itemAt items j)
            if (it.kind == 2) { return 32 }
            def len:int (strlen it.text)
            if (len > 0) {
                if (dir < 0) { return (charAt it.text (len - 1)) }
                return (charAt it.text 0)
            }
            j = (j + dir)
        }
        return 32
    }

    fn setQuote:void (it:MdQuoteItem at:int code:int) {
        if it.direct {
