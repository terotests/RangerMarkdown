    ; place: one character for one, so every span stays as it was. Not in a
    ; bare address or an attribute block.
    ;
    ; `at` counts in the text as parsed. A target whose strings count bytes
    ; (Go, C++) holds a curly quote in three, so a quote put in before this
    ; one in the same node has moved what follows it: the place in the node
    ; is found by walking the text as parsed beside the node as it is now.
    fn setDirect:void (g:MdTypoGroup at:int code:int) {
        if (MdTypography.isFenced(g.text at)) { return }
        def k:int g.first
        def off:int 0
        while (k < (g.first + g.count)) {
            def nd:MdNode (g.parent.childAt(k))
            ; the node's length as parsed: a verbatim node's span
            def len:int (nd.srcEnd - nd.srcStart)
            if ((at >= off) && (at < (off + len))) {
                def was:string (substring g.text off (off + len))
                def p:int (this.livePos(was nd.literal (at - off)))
                nd.literal = (((substring nd.literal 0 p) + (MdChar.fromCode(code))) + (substring nd.literal (p + 1) (strlen nd.literal)))
                return
            }
            off = (off + len)
            k = (k + 1)
        }
    }

    ; Where offset `p` of `was` (a node's text as parsed) is in `now` (the
    ; same text with some quotes already curly).
    fn livePos:int (was:string now:string p:int) {
        def i:int 0
        def j:int 0
        while ((i < p) && (j < (strlen now))) {
            if ((substring now j (j + 1)) == (substring was i (i + 1))) {
                i = (i + 1)
                j = (j + 1)
            } {
                j = (j + (this.quoteWidth(now j)))
                i = (i + 1)
            }
        }
        return j
    }

    ; how long the curly quote at `j` of `s` is in this target's strings
    fn quoteWidth:int (s:string j:int) {
        def codes:[int] ([] _:int (opts.dq1 opts.dq2 opts.sq1 opts.sq2))
        for codes code:int ci {
            def q:string (MdChar.fromCode(code))
            def w:int (strlen q)
            if (((j + w) <= (strlen s)) && ((substring s j (j + w)) == q)) {
                return w
            }
        }
        return 1
    }

    ; Is offset `at` inside a bare address or an attribute block?
    sfn isFenced:boolean (t:string at:int) {
        if (! (MdTypography.mayFence(t))) { return false }
        def i:int 0
        while (i <= at) {
            def stop:int (MdTypography.addressEnd(t i))
            if (stop < 0) {
                stop = (MdTypography.attrEnd(t i))
            }
            if (stop > i) {
                if (at < stop) { return true }
                i = stop
            } {
                i = (i + 1)
            }
        }
        return false
    }

    fn markChanged:void (c:MdTypoCell) {
        def n:int (array_length groups)
        def i:int 0
        while (i < n) {
            def g:MdTypoGroup (itemAt groups i)
            if (g.hasCells && ((c.a >= g.base) && (c.a < (g.base + (strlen g.text))))) {
                g.changed = true
                return
            }
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; Back into nodes
    ; ----------------------------------------------------------------------
    fn rebuild:void (g:MdTypoGroup) {
        def made:[MdNode]
        def n:int (g.cellCount())
        def i:int 0
        while (i < n) {
            def c:MdTypoCell (g.cellAt(i))
            if (c.abbr >= 0) {
                def j:int i
                while ((j < n) && ((MdTypography.abbrOf(g j)) == c.abbr)) {
                    j = (j + 1)
                }
                def ab:MdNode (MdNode.create("abbr"))
                ab.title = (itemAt g.titles c.abbr)
                def endCell:MdTypoCell (g.cellAt((j - 1)))
                ab.srcStart = c.a
                ab.srcEnd = endCell.b
                ab.srcKnown = true
                def inner:[MdNode] (this.nodesOf(g i j))
                def k:int 0
                while (k < (array_length inner)) {
                    ab.add((itemAt inner k))
                    k = (k + 1)
                }
                push made ab
                i = j
            } {
                def j2:int i
                while ((j2 < n) && ((MdTypography.abbrOf(g j2)) < 0)) {
                    j2 = (j2 + 1)
                }
                def plain:[MdNode] (this.nodesOf(g i j2))
                def k2:int 0
                while (k2 < (array_length plain)) {
                    push made (itemAt plain k2)
                    k2 = (k2 + 1)
                }
                i = j2
            }
        }
        ; the group's nodes out, these in
        def parent:MdNode g.parent
        def kids:[MdNode]
        def total:int (parent.childCount())
        def p:int 0
        while (p < total) {
            if (p == g.first) {
                def m:int 0
                while (m < (array_length made)) {
                    push kids (itemAt made m)
                    m = (m + 1)
                }
            }
            if ((p < g.first) || (p >= (g.first + g.count))) {
                push kids (parent.childAt(p))
            }
            p = (p + 1)
        }
        parent.children = kids
    }

    sfn abbrOf:int (g:MdTypoGroup i:int) {
        def c:MdTypoCell (g.cellAt(i))
        return c.abbr
    }

    ; Cells [from, to) as text nodes: characters as typed run together, each
    ; replacement on its own.
    fn nodesOf:[MdNode] (g:MdTypoGroup from:int to:int) {
        def out:[MdNode]
        def i:int from
        while (i < to) {
            def c:MdTypoCell (g.cellAt(i))
            if ((c.kind == 1) || (c.kind == 2)) {
                def t:MdNode (MdNode.text(c.text))
                t.srcStart = c.a
                t.srcEnd = c.b
                t.srcKnown = true
                t.subst = true
                push out t
                i = (i + 1)
            } {
                def j:int i
                def lit:string ""
                def going:boolean true
                while (going && (j < to)) {
                    def d:MdTypoCell (g.cellAt(j))
                    if ((d.kind == 0) || (d.kind == 3)) {
                        lit = (lit + d.text)
                        j = (j + 1)
                    } {
                        going = false
                    }
                }
                def last:MdTypoCell (g.cellAt((j - 1)))
                def t2:MdNode (MdNode.text(lit))
                t2.srcStart = c.a
                t2.srcEnd = last.b
                t2.srcKnown = true
                push out t2
                i = j
            }
        }
        return out
    }
}
