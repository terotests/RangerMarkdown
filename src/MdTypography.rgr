    fn replacePass:void (g:MdTypoGroup) {
        def out:[MdTypoCell]
        def seg:[MdTypoCell]
        def segAbbr:int -2
        def n:int (g.cellCount())
        def i:int 0
        while (i < n) {
            def c:MdTypoCell (g.cellAt(i))
            def inStretch:boolean ((c.kind == 0) || (c.kind == 2))
            if (inStretch && ((c.abbr == segAbbr) || ((array_length seg) == 0))) {
                segAbbr = c.abbr
                push seg c
            } {
                out = (this.flushStretch(g out seg))
                seg = (this.emptyCells())
                segAbbr = -2
                if inStretch {
                    segAbbr = c.abbr
                    push seg c
                } {
                    push out c
                }
            }
            i = (i + 1)
        }
        out = (this.flushStretch(g out seg))
        g.cells = out
