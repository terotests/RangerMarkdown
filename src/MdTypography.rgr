        def i:int 0
        while (i < n1) {
            def c:MdTypoCell (itemAt s i)
            if (c.kind == 2) { g.changed = true }
            push out c
            i = (i + 1)
        }
        return out
    }

    ; `?` or `!` twice running: where a run of four could be
