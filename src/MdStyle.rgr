; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdStyle.rgr — the values a stylesheet sets, in one place.
; ============================================================================
;
; Every number the layout uses lives here and nowhere else, so that the layout
; never has one written into it. That was true when this was a class at the
; top of `MdLayout.rgr`; it is a file of its own now for one reason:
; `MdCss` resolves a stylesheet ONTO it, and the layout asks `MdCss` what a
; block's `{.classes}` mean. Both directions through one file would be a
; cycle; the style in the middle is what breaks it.
;
;   MdStyle.rgr   ── the fields
;        ↑
;   MdCss.rgr     ── what a sheet's properties mean, over gallery/css
;        ↑
;   MdLayout.rgr  ── asks the sheet about a block, lays it out
;
; Nothing moved. This is the same class, in its own file.
; ============================================================================

class MdStyle {
    def bodyFamily:string "Open Sans"
    ; There is no monospace face in `gallery/pdf_writer/assets/fonts`, so
    ; code is set in the sans face that is there. It is measured and painted
    ; with the same one, which is what keeps the geometry honest; it is not
    ; monospaced, which is a missing asset and not a layout decision.
    def monoFamily:string "Noto Sans"
    def headingFamily:string "Open Sans"

    def bodySize:double 11.0
    def lineHeight:double 1.45
    def paraSpacing:double 9.0

    def h1Size:double 24.0
    def h2Size:double 19.0
    def h3Size:double 15.5
    def h4Size:double 13.0
    def h5Size:double 11.5
    def h6Size:double 11.0
    ; A heading's colour: per level, then `heading`, then the text's ("" =
    ; not set, fall through).
    def headingColor:string ""
    def h1Color:string ""
    def h2Color:string ""
    def h3Color:string ""
    def h4Color:string ""
    def h5Color:string ""
    def h6Color:string ""
    def headingSpaceBefore:double 16.0
    def headingSpaceAfter:double 7.0

    def codeSize:double 9.5
    def codeLineHeight:double 1.42
    def codePadding:double 9.0
    def codeBackground:string "#f6f8fa"
    ; <mark>: the highlight behind the text, and the text on it
    def markBackground:string "#ffe766"
    def markColor:string "#1f2328"
    ; <kbd>: a key cap's face and edge; "" follows `code`
    def kbdBackground:string ""
    def kbdBorder:string ""
    def codeBorder:string "#e2e6ea"
    ; The five colours a listing is read with. Not a theme yet — the values a
    ; stylesheet will set, in one place.
    def codeKeyword:string "#cf222e"
    def codeString:string "#0a3069"
    def codeComment:string "#57606a"
    def codeNumber:string "#0550ae"
    def codePlain:string "#1f2328"
    def highlightCode:boolean true

    def textColor:string "#1f2328"
    ; The page's own ground, and a picture on it.
    ;
    ; `background-color` was already here three times — for code, for a table
    ; head, for a blockquote — and nowhere for the PAGE, which is the one a
    ; reader notices first and the one a company template is mostly made of.
    ; `background-image` names a picture in the byte store; it is drawn behind
    ; everything and is never the reason a page has no text on it.
    def pageBackground:string ""
    def pageBackgroundImage:string ""
    def mutedColor:string "#57606a"
    def linkColor:string "#0969da"
    def ruleColor:string "#d8dee4"

    def quoteBarColor:string "#d0d7de"
    def quoteBarWidth:double 3.0
    def quoteIndent:double 16.0
    ; The space inside the bar, above the first line and below the last.
    ;
    ; Without it the bar began exactly at the top of the first line's box and
    ; ended exactly where the next block started — flush against the text at
    ; one end and dangling past it at the other, because what it was measuring
    ; at the bottom was the last paragraph's trailing space rather than the
    ; paragraph. A quote is a block with an inside; this is the inside.
    def quotePadY:double 6.0
    ; Quoted text is set in the muted colour, which is what every markdown
    ; style does and what says "this is somebody else's sentence" without a
    ; box around it. A link, a code span or a heading inside the quote keeps
    ; its own colour: this is the colour of ordinary text in there, not a wash
    ; over everything.
    def quoteColor:string "#57606a"
    ; `blockquote { background-color }`: a band under the quote, "" for none
    def quoteBackground:string ""

    ; `{container=box}` / `{container=bubble}`: the theme's plate,
    ; `container { background-color; border-radius }`. "" / negative leave it
    ; to `MdContainer.plan` (the page's colour, a radius from the text size).
    def containerBackground:string ""
    def containerRadius:double -1.0
    ; `container { box-shadow: 0 6pt 18pt rgba(…) }`: the colour of a soft
    ; shadow under the plate, "" for none
    def containerShadow:string ""
    ; `container { padding; border }`: the room inside the plate and a line
    ; round it, -1 / "" to leave them to `MdContainer.plan`
    def containerPadX:double -1.0
    def containerPadY:double -1.0
    def containerBorder:string ""
    def containerBorderWidth:double -1.0

    def listIndent:double 22.0
    def markerGap:double 8.0
    ; The colour of a list's bullets and numbers: `list { color }`. Empty
    ; follows the muted colour, which is what a marker was before a sheet
    ; could say anything about it.
    def markerColor:string ""
    ; What separates two items of a TIGHT list — one with no blank line
    ; between its items.
    ;
    ; CommonMark's whole definition of tightness is that such an item's text
    ; is not a paragraph, and a paragraph's spacing is what was being charged:
    ; a five-item shopping list was set with the same air between the items as
    ; between two paragraphs of prose, which is what a LOOSE list is for. The
    ; distinction is in the parser, was on the node, and only the two extra
    ; points a loose list adds were ever read.
    def listTightSpacing:double 3.0

    def tableBorder:string "#d0d7de"
    def tableHeadBackground:string "#f6f8fa"
    ; `th { color }`: the header row's text, "" for the table's own
    def tableHeadColor:string ""
    def cellPadX:double 7.0
    def cellPadY:double 5.0
    ; the size a table's text is set at, 0 for the body's
    ; (`table { font-size }`)
    def tableSize:double 0.0
    ; `table { cell-tones: "Done=green Late=red" }`: cells coloured by their
    ; text in every table (`MdCellTones`), "" for none
    def tableCellTones:string ""

    def pageWidth:double 595.28
    def pageHeight:double 841.89
    def margin:double 56.0

    ; PRINT (`@media print { page { bleed; safe-area } deck { crop-marks } }`,
    ; set by `MdCss.applyPrint` only when the layout is for paper). `bleed`:
    ; how far a picture that reaches the page's edge runs past it, for the
    ; cut; `safeArea`: how far in from the edge text has to stay (the layout
    ; report checks it); `cropMarks`: the PDF draws the cut lines. On a
    ; screen all three are 0 / off and nothing moves.
    def forPrint:boolean false
    def bleed:double 0.0
    def safeArea:double 0.0
    def cropMarks:boolean false

    ; Page furniture. All off by default: a document that said nothing about
    ; itself gets a plain page, which is what a README wants.
    def title:string ""
    ; "" | "title" | "h1"
    def runningHead:string ""
    ; "" | "bottom-center" | "bottom-right" | "bottom-outer"
    def pageNumbers:string ""
    def wantToc:boolean false
    def breakOnH1:boolean false
    def furnitureSize:double 8.5
    ; What every page says at its top and its bottom (`header { content }`,
    ; `footer { … }`, or `header:` / `footer:` in the front matter), with a
    ; picture beside it (`background-image: url(logo.png)`). {page}, {pages}
    ; and {title} are filled in per page.
    def headerText:string ""
    def headerImage:string ""
    def headerAlign:string "start"
    def headerSize:double 0.0
    def headerColor:string ""
    def headerImageH:double 22.0
    def footerText:string ""
    def footerImage:string ""
    def footerAlign:string "start"
    def footerSize:double 0.0
    def footerColor:string ""
    def footerImageH:double 22.0
    ; Three places on each edge, beside the one above: `header-left`,
    ; `header-center`, `header-right` (and the footer's). A place may hold a
    ; picture written as in the text, `![](media/logo.png) ACME`.
    def headerLeft:string ""
    def headerCenter:string ""
    def headerRight:string ""
    def footerLeft:string ""
    def footerCenter:string ""
    def footerRight:string ""
    ; How the edge is set: bold text, a band of colour behind it reaching the
    ; sheet's edge, a hairline between it and the content.
    def headerBold:boolean false
    def headerBackground:string ""
    def headerRule:string ""
    def footerBold:boolean false
    def footerBackground:string ""
    def footerRule:string ""
    ; The sheets an edge is left off: "first", "last", page numbers, or any
    ; of them together (`header-skip: first last`).
    def headerSkip:string ""
    def footerSkip:string ""
    ; Pictures (`img { }`): where a picture narrower than the column sits
    ; ("" the start, "center", "end"; a slide centres unless told) and how
    ; tall one may be (0: as tall as the room).
    def imgAlign:string ""
    def imgMaxHeight:double 0.0

    ; An embedded diagram that is wider than the column is scaled down to it,
    ; never up: a three-node flowchart should not become a poster.
    def embedSpacing:double 12.0

    ; `font-weight`, `font-style`, `text-transform` and `letter-spacing` for
    ; the elements a sheet names them for (`h1`, `heading`, `document`, `p`,
    ; `li`, `blockquote`), by element name (`MdTypo`, `typoFor`)
    def typoTags:[string]
    def typoList:[MdTypo]

    Constructor () {
    }

    ; The typography a sheet gave `tag`, created empty on first ask.
    fn typoAt:MdTypo (tag:string) {
        def i:int 0
        while (i < (array_length typoTags)) {
            if ((itemAt typoTags i) == tag) {
                return (itemAt typoList i)
            }
            i = (i + 1)
        }
        def t:MdTypo (new MdTypo())
        push typoTags tag
        push typoList t
        return t
    }

    ; …and what holds for a block written as `tag`: the document's, then
    ; `heading`'s for a heading, then the tag's own — each over the last.
    fn typoFor:MdTypo (tag:string) {
        def out:MdTypo (new MdTypo())
        if ((array_length typoTags) == 0) {
            return out
        }
        out.over((this.typoOf("document")))
        if (((strlen tag) == 2) && ((charAt tag 0) == 104)) {
            out.over((this.typoOf("heading")))
        }
        out.over((this.typoOf(tag)))
        return out
    }

    fn typoOf:MdTypo (tag:string) {
        def i:int 0
        while (i < (array_length typoTags)) {
            if ((itemAt typoTags i) == tag) {
                return (itemAt typoList i)
            }
            i = (i + 1)
        }
        return (new MdTypo())
    }

    fn typoText:string () {
        def out:string ""
        def i:int 0
        while (i < (array_length typoTags)) {
            def t:MdTypo (itemAt typoList i)
            out = (out + (itemAt typoTags i) + "=" + (t.text()) + ";")
            i = (i + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; The look, without the sizes
    ; ----------------------------------------------------------------------
    ;
    ; Every colour, face, picture and typography the style holds, as a list,
    ; and the same list put back. A slide's own rules (`#id h2 { color }`,
    ; `.dark page { background-color }`) are laid over the style while that
    ; slide is laid out and taken off again after (`MdLayout.enterScope`);
    ; sizes are not in it, because a slide that is shrunk to fit scales the
    ; style's sizes in place and a second copy of them would undo that.
    ;
    ; **A colour added above and not added here stays the same on every
    ; slide** — that is the cost of the list; `MdCssTest` checks a few.
    fn look:[string] () {
        def v:[string] ([] _:string (bodyFamily monoFamily headingFamily headingColor h1Color h2Color h3Color h4Color h5Color h6Color))
        push v codeBackground
        push v markBackground
        push v markColor
        push v kbdBackground
        push v kbdBorder
        push v codeBorder
        push v codeKeyword
        push v codeString
        push v codeComment
        push v codeNumber
        push v codePlain
        push v textColor
        push v pageBackground
        push v pageBackgroundImage
        push v mutedColor
        push v linkColor
        push v ruleColor
        push v quoteBarColor
        push v quoteColor
        push v quoteBackground
        push v containerBackground
        push v containerShadow
        push v markerColor
        push v tableBorder
        push v tableHeadBackground
        push v tableHeadColor
        push v tableCellTones
        push v headerColor
        push v footerColor
        push v headerBackground
        push v footerBackground
        push v headerRule
        push v footerRule
        push v imgAlign
        push v (this.typoText())
        push v containerBorder
        return v
    }

    fn setLook:void (v:[string]) {
        if ((array_length v) < 46) {
            return
        }
        bodyFamily = (itemAt v 0)
        monoFamily = (itemAt v 1)
        headingFamily = (itemAt v 2)
        headingColor = (itemAt v 3)
        h1Color = (itemAt v 4)
        h2Color = (itemAt v 5)
        h3Color = (itemAt v 6)
        h4Color = (itemAt v 7)
        h5Color = (itemAt v 8)
        h6Color = (itemAt v 9)
        codeBackground = (itemAt v 10)
        markBackground = (itemAt v 11)
        markColor = (itemAt v 12)
        kbdBackground = (itemAt v 13)
        kbdBorder = (itemAt v 14)
        codeBorder = (itemAt v 15)
        codeKeyword = (itemAt v 16)
        codeString = (itemAt v 17)
        codeComment = (itemAt v 18)
        codeNumber = (itemAt v 19)
        codePlain = (itemAt v 20)
        textColor = (itemAt v 21)
        pageBackground = (itemAt v 22)
        pageBackgroundImage = (itemAt v 23)
        mutedColor = (itemAt v 24)
        linkColor = (itemAt v 25)
        ruleColor = (itemAt v 26)
        quoteBarColor = (itemAt v 27)
        quoteColor = (itemAt v 28)
        quoteBackground = (itemAt v 29)
        containerBackground = (itemAt v 30)
        containerShadow = (itemAt v 31)
        markerColor = (itemAt v 32)
        tableBorder = (itemAt v 33)
        tableHeadBackground = (itemAt v 34)
        tableHeadColor = (itemAt v 35)
        tableCellTones = (itemAt v 36)
        headerColor = (itemAt v 37)
        footerColor = (itemAt v 38)
        headerBackground = (itemAt v 39)
        footerBackground = (itemAt v 40)
        headerRule = (itemAt v 41)
        footerRule = (itemAt v 42)
        imgAlign = (itemAt v 43)
        this.setTypoText((itemAt v 44))
        containerBorder = (itemAt v 45)
    }

    fn setTypoText:void (text:string) {
        def tags:[string]
        def list:[MdTypo]
        def parts:[string] (strsplit text ";")
        def i:int 0
        while (i < (array_length parts)) {
            def part:string (itemAt parts i)
            def eq:int (indexOf part "=")
            if (eq > 0) {
                push tags (substring part 0 eq)
                push list (MdTypo.parse((substring part (eq + 1) (strlen part))))
            }
            i = (i + 1)
        }
        typoTags = tags
        typoList = list
    }

    ; Every field of this style, as one string.
    ;
    ; Two uses, and they are the same question asked twice. The LAYOUT CACHE
    ; keys a block's boxes under the source that made them — and under this,
    ; because the same source set 4pt larger is different boxes. Without it,
    ; switching the company template redrew a paragraph at the new size on
    ; the positions measured at the old one, and the second half of a wrapped
    ; line sat on top of the first. `MdCssTest` reads it too, to ask whether
    ; a sheet changed anything it should not have.
    ;
    ; Colours are in it as well as sizes. They do not move a box, but they
    ; are ON one — a template that changes only the link colour must not
    ; replay the last one's.
    ;
    ; **A field added above and not added here is a field the cache cannot
    ; see.** That is the cost of the list, and it is why the test compares
    ; whole fingerprints rather than the three fields somebody remembered.
    fn fingerprint:string () {
        def out:string ""
        out = ((((out + "body ") + bodyFamily) + "/") + (to_string bodySize))
        out = ((((out + "/") + (to_string lineHeight)) + "/") + (to_string paraSpacing))
        out = ((((out + " head ") + headingFamily) + "/") + (to_string h1Size))
        out = ((((out + "/") + (to_string h2Size)) + "/") + (to_string h3Size))
        out = ((((out + "/") + (to_string h4Size)) + "/") + (to_string h5Size))
        out = ((((out + "/") + (to_string h6Size)) + "/") + (to_string headingSpaceBefore))
        out = ((out + "/") + (to_string headingSpaceAfter))
        out = (out + " hc " + headingColor + "/" + h1Color + "/" + h2Color + "/" + h3Color + "/" + h4Color + "/" + h5Color + "/" + h6Color)
        out = ((((out + " code ") + monoFamily) + "/") + (to_string codeSize))
        out = ((((out + "/") + (to_string codeLineHeight)) + "/") + (to_string codePadding))
        out = ((((out + "/") + codeBackground) + "/") + codeBorder)
        out = ((((out + "/") + codeKeyword) + "/") + codeString)
        out = ((((out + "/") + codeComment) + "/") + codeNumber)
        out = ((out + "/") + codePlain)
        out = (out + " mark " + markBackground + "/" + markColor + " kbd " + kbdBackground + "/" + kbdBorder)
        if highlightCode { out = (out + "/hi") }
        out = ((((out + " ink ") + textColor) + "/") + mutedColor)
        out = ((((out + "/") + linkColor) + "/") + ruleColor)
        out = ((((out + " quote ") + quoteColor) + "/") + quoteBarColor)
        out = ((((out + "/") + (to_string quoteBarWidth)) + "/") + (to_string quoteIndent))
        out = ((out + "/") + (to_string quotePadY))
        out = ((((out + " container ") + containerBackground) + "/") + (to_string containerRadius))
        out = ((out + "/") + containerShadow)
        out = ((((out + " list ") + (to_string listIndent)) + "/") + (to_string markerGap))
        out = ((out + "/") + (to_string listTightSpacing))
        out = ((out + "/") + markerColor)
        out = ((((out + " table ") + tableBorder) + "/") + tableHeadBackground)
        out = ((((out + "/") + (to_string cellPadX)) + "/") + (to_string cellPadY))
        out = ((out + "/") + (to_string tableSize))
        out = ((out + "/") + tableCellTones)
        out = ((((out + " page ") + (to_string pageWidth)) + "/") + (to_string pageHeight))
        out = ((out + "/") + (to_string margin))
        if forPrint {
            out = (out + " print " + (to_string bleed) + "/" + (to_string safeArea))
        }
        out = ((((out + "/") + pageBackground) + "/") + pageBackgroundImage)
        out = ((((out + " furniture ") + title) + "/") + runningHead)
        out = ((out + "/") + pageNumbers)
        if wantToc { out = (out + "/toc") }
        if breakOnH1 { out = (out + "/h1") }
        out = ((out + "/") + (to_string furnitureSize))
        out = (out + " head " + headerText + "/" + headerImage + "/" + headerAlign + "/" + (to_string headerSize) + "/" + headerColor + "/" + (to_string headerImageH))
        out = (out + " foot " + footerText + "/" + footerImage + "/" + footerAlign + "/" + (to_string footerSize) + "/" + footerColor + "/" + (to_string footerImageH))
        out = (out + " slots " + headerLeft + "/" + headerCenter + "/" + headerRight + "/" + footerLeft + "/" + footerCenter + "/" + footerRight)
        out = (out + " edge " + headerBackground + "/" + headerRule + "/" + footerBackground + "/" + footerRule + "/" + headerSkip + "/" + footerSkip)
        if headerBold { out = (out + "/hb") }
        if footerBold { out = (out + "/fb") }
        out = (out + " img " + imgAlign + "/" + (to_string imgMaxHeight))
        out = (out + " quote+ " + quoteBackground + " th " + tableHeadColor)
        out = (out + " plate " + (to_string containerPadX) + "/" + (to_string containerPadY) + "/" + containerBorder + "/" + (to_string containerBorderWidth))
        out = (out + " typo " + (this.typoText()))
        out = ((out + " embed ") + (to_string embedSpacing))
        return out
    }

    ; The colour a token of that kind is set in.
    fn codeColor:string (kind:int) {
        if (kind == 1) { return codeKeyword }
        if (kind == 2) { return codeString }
        if (kind == 3) { return codeComment }
        if (kind == 4) { return codeNumber }
        return codePlain
    }

    fn headingInk:string (level:int) {
        def c:string h6Color
        if (level == 1) { c = h1Color }
        if (level == 2) { c = h2Color }
        if (level == 3) { c = h3Color }
        if (level == 4) { c = h4Color }
        if (level == 5) { c = h5Color }
        if ((strlen c) > 0) { return c }
        if ((strlen headingColor) > 0) { return headingColor }
        return textColor
    }

    fn headingSize:double (level:int) {
        if (level == 1) { return h1Size }
        if (level == 2) { return h2Size }
        if (level == 3) { return h3Size }
        if (level == 4) { return h4Size }
        if (level == 5) { return h5Size }
        return h6Size
    }

    ; The face, by the convention the font manager and the measurer share:
    ; the weight is a `-Bold` suffix and the slant is part of the family name.
    fn faceFor:string (family:string bold:boolean italic:boolean) {
        if (bold && italic) { return (family + "-BoldItalic") }
        if italic { return (family + "-Italic") }
        if bold { return (family + "-Bold") }
        return family
    }
}

; One piece of inline text with one look.

; `font-weight`, `font-style`, `text-transform` and `letter-spacing` as a
; block's text takes them. -1 / "" / unset is "not said", so one rule can be
; laid over another (`over`) the way the cascade inherits them.
class MdTypo {
    ; 1 bold, 0 normal, -1 not said
    def weight:int -1
    ; 1 italic, 0 normal, -1 not said
    def italic:int -1
    ; "uppercase" / "lowercase" / "capitalize" / "none", "" for not said
    def transform:string ""
    ; in points; `spacingSet` false for not said
    def spacing:double 0.0
    def spacingSet:boolean false

    Constructor () {
    }

    fn copy:MdTypo () {
        def t:MdTypo (new MdTypo())
        t.over(this)
        return t
    }

    fn isEmpty:boolean () {
        return ((((weight < 0) && (italic < 0)) && ((strlen transform) == 0)) && (spacingSet == false))
    }

    ; what `top` says, over what this says
    fn over:void (top:MdTypo) {
        if (top.weight >= 0) { weight = top.weight }
        if (top.italic >= 0) { italic = top.italic }
        if ((strlen top.transform) > 0) { transform = top.transform }
        if top.spacingSet {
            spacing = top.spacing
            spacingSet = true
        }
    }

    fn text:string () {
        def sp:string ""
        if spacingSet { sp = (to_string spacing) }
        return ((to_string weight) + "," + (to_string italic) + "," + transform + "," + sp)
    }

    sfn parse:MdTypo (t:string) {
        def out:MdTypo (new MdTypo())
        def parts:[string] (strsplit t ",")
        if ((array_length parts) < 4) {
            return out
        }
        def w@(optional):int (str2int (itemAt parts 0))
        out.weight = (?? w -1)
        def it@(optional):int (str2int (itemAt parts 1))
        out.italic = (?? it -1)
        out.transform = (itemAt parts 2)
        def sp:string (itemAt parts 3)
        if ((strlen sp) > 0) {
            def d@(optional):double (to_double sp)
            out.spacing = (?? d 0.0)
            out.spacingSet = true
        }
        return out
    }

    ; `text` as `text-transform` says to set it. Letters only change case;
    ; `capitalize` raises the first letter of each word.
    sfn apply:string (mode:string text:string) {
        if (mode == "uppercase") { return (to_uppercase text) }
        if (mode == "lowercase") { return (to_lowercase text) }
        if (mode == "capitalize") {
            def out:string ""
            def start:boolean true
            def n:int (strlen text)
            def i:int 0
            while (i < n) {
                def c:int (charAt text i)
                def ch:string (strfromcode c)
                if ((c == 32) || ((c == 9) || ((c == 10) || (c == 45)))) {
                    start = true
                    out = (out + ch)
                } {
                    if start {
                        out = (out + (to_uppercase ch))
                    } {
                        out = (out + ch)
                    }
                    start = false
                }
                i = (i + 1)
            }
            return out
        }
        return text
    }
}
