; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdCss.rgr — a company template, as a stylesheet over a markdown document.
; ============================================================================
;
; ```css
; page   { width: 13.333in; height: 7.5in; padding: 0.65in; }
; document { font-family: Inter; font-size: 18pt; color: #1f2328; }
; h1     { font-size: 42pt; }
; h2     { font-size: 28pt; }
; heading { font-family: Inter; margin-top: 24pt; margin-bottom: 12pt; }
; .lead  { font-size: 22pt; }
; .c3    { column-count: 3; column-gap: 28pt; }
; ```
;
; Two companies are then two files, and the same markdown previews as either
; without being touched — which is a better thing than a PowerPoint template,
; because a master slide positions BOXES and this says what a level-two
; heading IS.
;
; ============================================================================
; WHAT THIS FILE DECIDES, AND WHAT CssCore DECIDED ALREADY
; ============================================================================
;
; The same split `PptxCss` draws, and this is the third binding rather than
; the third engine — `PLAN_SLIDES.md` §5 and §7.
;
; `CssCore` read the text, matched the selectors, ranked them by specificity
; and handed back the properties that apply. It has no idea what any of them
; MEAN. Everything below is the meaning:
;
;   * which element names a markdown selector may use — `document`, `page`,
;     `deck`, `p`, `h1`…`h6`, `heading`, `a`, `code`, `pre`, `ul`, `ol`,
;     `list`, `li`, `table`, `blockquote`, `hr`, `slide`;
;   * where each property lands in `MdStyle`;
;   * and which ones this layout cannot honour, which are NAMED and counted
;     rather than dropped in a silence that reads as "applied".
;
; **`page` and `deck`, not `@page` and `@deck`.** The plan wrote the at-rule
; spelling; `CssCore` deliberately does not read at-rules — it records them as
; "not read here" so a consumer cannot silently apply what is inside one — and
; teaching it to would change what every existing consumer sees. An element
; name costs one character in the sheet and no change to the engine. Recorded
; here rather than quietly settled.
;
; **A document with no sheet is byte-identical.** `MdStyle`'s field
; initialisers are still the defaults; a sheet only ever overwrites what it
; names. That is what makes this safe to add underneath a layout that is
; already gated on its own numbers.
;
; **Per-block classes are resolved separately.** `resolve` answers "what does
; the sheet say about THIS node", which is what columns and `{.lead}` need; it
; is a different question from "what is the document set in", and mixing them
; is how a stylesheet ends up with two cascades.
; ============================================================================

Import "MdContainer.rgr"
Import "MdCssSupport.rgr"
Import "MdNode.rgr"
Import "MdStyle.rgr"
Import "../../css/CssCore.rgr"

class MdCss {
    def sheet:CssSheet (new CssSheet())
    ; The text the sheet was parsed from, kept so a caller that has the
    ; resolved sheet can hand the same text to something else — the LAYOUT
    ; needs it, because it asks the sheet a different question and parses its
    ; own copy.
    def source:string ""
    ; Property names the sheet used that this layout cannot honour, each once.
    def unsupported:[string]
    ; How many declarations landed, and how many selectors were asked.
    def applied:int 0
    def asked:int 0

    ; What the deck-level rules said. Read by the slide layout rather than by
    ; `MdStyle`, because they are not about how a page looks.
    def splitLevel:int 0
    def overflow:string ""
    def aspect:string ""

    ; What a sheet can say, per selector (`MdCssSupport`): the lint reads
    ; against it and the guide lists it. A host adds the elements it reads
    ; itself (Sliqtly's `chart`, `diagram`, `figure`).
    def support:MdCssSupport (new MdCssSupport())
    ; `--name=value` for the variables every sheet so far declared in
    ; `:root` (or `document`, `page`); `var(--name)` in a later sheet sees
    ; them, so a theme's brand colour is the author's to use
    def vars:[string]
    ; what the lint said about the sheets added, in order
    def notes:[MdCssNote]

    Constructor () {
    }

    fn text:string () {
        return source
    }

    ; Which medium the sheet is read for: "screen" (the stage, the
    ; thumbnails, the PPTX) or "print" (the PDF for a printing house). A
    ; sheet's `@media print { … }` rules count only for print, where they
    ; come after the rest and so win; `@media screen { … }` only on a
    ; screen. `CssCore` reads no at-rules (see its banner), so the blocks
    ; are taken apart here, before it parses what is left.
    def media:string "screen"
    ; the `@media print` rules alone: what the print page says (its size,
    ; `bleed`, `safe-area`) is read from them and from nothing else
    def printSheet:CssSheet (new CssSheet())
    def printText:string ""

    ; The medium to read the sheet for, parsed again from its text when it
    ; changes.
    fn setMedia:void (m:string) {
        if (m == media) { return }
        media = m
        def was:string source
        source = ""
        printText = ""
        sheet = (new CssSheet())
        printSheet = (new CssSheet())
        clear unsupported
        def noVars:[string]
        vars = noVars
        def noNotes:[MdCssNote]
        notes = noNotes
        this.addStyleSheet(was)
    }

    fn hasPrint:boolean () {
        return ((strlen printText) > 0)
    }

    fn addStyleSheet:void (raw:string) {
        source = (source + raw)
        def said:[MdCssNote] (support.lint(raw vars))
        for said nt:MdCssNote nti {
            push notes nt
        }
        ; `var(--brand)` becomes the colour it names before anything reads
        ; the text: every reader after this sees plain values
        def own:[string] (MdCssSupport.varPairs(raw))
        for own vp:string vpi {
            push vars vp
        }
        def css:string (MdCssSupport.substitute(raw vars))
        def parts:[string] (MdCss.splitMedia(css))
        def screenText:string (MdCss.desugar((itemAt parts 0)))
        def printPart:string (MdCss.desugar((itemAt parts 1)))
        def screenOnly:string (MdCss.desugar((itemAt parts 2)))
        printText = (printText + printPart)
        printSheet.parse(printPart)
        sheet.parse(screenText)
        if (media == "print") {
            sheet.parse(printPart)
        } {
            sheet.parse(screenOnly)
        }
        ; The deck rules are read here rather than in `applyTo`, because they
        ; are not about how a page LOOKS and a caller that only wants the
        ; slide rules should not have to resolve a style to get them.
        this.readDeck()
    }

    fn readDeck:void () {
        this.deck((this.forTag("deck")))
    }

    fn errorCount:int () {
        return (sheet.errorCount())
    }

    fn errorAt:string (i:int) {
        return (sheet.errorAt(i))
    }

    ; What the lint says about `css` were it added now: the notes for an
    ; editor's gutter, with offsets into `css` itself.
    fn lintText:[MdCssNote] (css:string) {
        return (support.lint(css vars))
    }

    fn noteCount:int () {
        return (array_length notes)
    }

    fn noteAt:string (i:int) {
        def n:MdCssNote (itemAt notes i)
        return n.message
    }

    fn unsupportedCount:int () {
        return (array_length unsupported)
    }

    fn unsupportedAt:string (i:int) {
        return (itemAt unsupported i)
    }

    fn note:void (name:string) {
        def i:int 0
        while (i < (array_length unsupported)) {
            if ((itemAt unsupported i) == name) { return }
            i = (i + 1)
        }
        push unsupported name
    }

    ; ----------------------------------------------------------------------
    ; The document's own style
    ; ----------------------------------------------------------------------
    ;
    ; Each element name is asked once and what it said is written into the
    ; fields it is about. The order is the order a reader would expect a
    ; cascade to run in: the page, then the document's text, then the things
    ; inside it.
    fn applyTo:void (style:MdStyle) {
        applied = 0
        asked = 0
        this.page(style (this.forTag("page")))
        this.body(style (this.forTag("document")))
        ; `body` says the same thing, because that is what somebody who has
        ; written CSS before types — and a rule that is silently ignored is
        ; worse than one that is refused by name: the page simply looks
        ; unchanged and there is nothing to read about why. Second, so it
        ; wins where a sheet says both.
        this.body(style (this.forTag("body")))
        this.para(style (this.forTag("p")))
        this.headings(style)
        this.code(style (this.forTag("code")))
        this.mark(style (this.forTag("mark")))
        this.kbd(style (this.forTag("kbd")))
        this.link(style (this.forTag("a")))
        this.rule(style (this.forTag("hr")))
        this.quote(style (this.forTag("blockquote")))
        this.container(style (this.forTag("container")))
        this.list(style (this.forTag("list")))
        this.item(style (this.forTag("li")))
        this.table(style (this.forTag("table")))
        this.tableHead(style (this.forTag("th")))
        this.picture(style (this.forTag("img")))
        this.furniture(style (this.forTag("header")) true)
        this.furniture(style (this.forTag("footer")) false)
        this.deck((this.forTag("deck")))
    }

    fn forTag:CssComputed (tag:string) {
        def n (new CssNode())
        n.tag = tag
        asked = (asked + 1)
        return (CssCascade.resolve(sheet n))
    }

    ; What the sheet says about one block of the document — its element name,
    ; its `{.classes}` and its `{#id}`. This is the question columns and
    ; `{.lead}` ask; the answer is handed back rather than written anywhere,
    ; because a block's style belongs to the block.
    fn resolve:CssComputed (node:MdNode) {
        def n (new CssNode())
        n.tag = (MdCss.tagOf(node))
        n.id = node.nodeId
        def i:int 0
        while (i < (node.classCount())) {
            n.addClass((node.classAt(i)))
            i = (i + 1)
        }
        asked = (asked + 1)
        return (CssCascade.resolve(sheet n))
    }

    ; The element name a node is written as in a sheet. A heading is `h2` AND
    ; `heading`, and both have to match — a sheet says `h1 { font-size }` and
    ; `heading { font-family }` — so the level-specific name is the tag and
    ; the generic one is carried as a class. That is a lie about the DOM and
    ; the truth about what the sheet's author meant.
    sfn tagOf:string (node:MdNode) {
        def k:string node.kind
        if (k == "heading") { return ("h" + (to_string node.level)) }
        if (k == "paragraph") { return "p" }
        if (k == "code_block") { return "pre" }
        if (k == "block_quote") { return "blockquote" }
        if (k == "thematic_break") { return "hr" }
        if (k == "item") { return "li" }
        if (k == "table") { return "table" }
        if (k == "list") {
            if node.listOrdered { return "ol" }
            return "ul"
        }
        return k
    }

    ; ----------------------------------------------------------------------
    ; …and what each property means
    ; ----------------------------------------------------------------------

    fn page:void (style:MdStyle got:CssComputed) {
        style.pageWidth = (this.len(got "width" style.pageWidth))
        style.pageHeight = (this.len(got "height" style.pageHeight))
        style.margin = (this.len(got "padding" style.margin))
        style.pageBackground = (this.color(got "background-color" style.pageBackground))
        ; `url(logo.png)` — the name of a picture in the byte store, not a
        ; path on anybody's disk. `Vfs.resolve` decides what it means, the
        ; same function that answers for `![](x)` and `r:embed`, because four
        ; copies of that arithmetic would be four answers to what `../` means.
        style.pageBackgroundImage = (MdCss.urlOf((this.raw(got "background-image"))))
        this.rest(got "width,height,padding,background-color,background-image,bleed,safe-area")
    }

    ; The inside of a `url(...)`, unquoted. Anything else is left alone: a
    ; gradient or a `none` is not a picture and is better ignored than
    ; half-understood.
    sfn urlOf:string (value:string) {
        def v:string (trim value)
        def n:int (strlen v)
        if (n < 6) { return "" }
        if ((substring v 0 4) != "url(") { return "" }
        if ((charAt v (n - 1)) != 41) { return "" }
        def inner:string (trim (substring v 4 (n - 1)))
        def m:int (strlen inner)
        if (m < 2) { return "" }
        def q:int (charAt inner 0)
        if ((q == 34) || (q == 39)) {
            if ((charAt inner (m - 1)) == q) {
                return (substring inner 1 (m - 1))
            }
        }
        return inner
    }

    fn body:void (style:MdStyle got:CssComputed) {
        style.bodyFamily = (this.family(got "font-family" style.bodyFamily))
        style.bodySize = (this.size(got "font-size" style.bodySize))
        style.lineHeight = (this.ratio(got "line-height" style.lineHeight))
        style.textColor = (this.color(got "color" style.textColor))
        this.typo(style "document" got)
        this.rest(got ("font-family,font-size,line-height,color," + (MdCssSupport.TYPO())))
    }

    fn para:void (style:MdStyle got:CssComputed) {
        style.paraSpacing = (this.len(got "margin-bottom" style.paraSpacing))
        this.typo(style "p" got)
        this.rest(got ("margin-bottom,text-align," + (MdCssSupport.TYPO())))
    }

    ; `font-weight`, `font-style`, `text-transform`, `letter-spacing` for
    ; the blocks written as `tag` (MdStyle.typoAt), when the rule says any
    fn typo:void (style:MdStyle tag:string got:CssComputed) {
        def t:MdTypo (MdCss.typoOf(got))
        if (t.isEmpty()) {
            return
        }
        applied = (applied + 1)
        def into:MdTypo (style.typoAt(tag))
        into.over(t)
    }

    ; The typography one rule says, unset where it says nothing.
    sfn typoOf:MdTypo (got:CssComputed) {
        def t:MdTypo (new MdTypo())
        if (got.has("font-weight")) {
            def w:string (CssSheet.lower((CssSheet.tidy((got.get("font-weight"))))))
            if ((w == "normal") || ((w == "lighter") || ((w == "400") || ((w == "300") || ((w == "100") || ((w == "200") || (w == "500"))))))) {
                t.weight = 0
            }
            if (CssValue.isBold(w)) {
                t.weight = 1
            }
        }
        if (got.has("font-style")) {
            def fs:string (CssSheet.lower((CssSheet.tidy((got.get("font-style"))))))
            if (CssValue.isItalic(fs)) {
                t.italic = 1
            }
            if (fs == "normal") {
                t.italic = 0
            }
        }
        if (got.has("text-transform")) {
            def tt:string (CssSheet.lower((CssSheet.tidy((got.get("text-transform"))))))
            if ((tt == "uppercase") || ((tt == "lowercase") || ((tt == "capitalize") || (tt == "none")))) {
                t.transform = tt
            }
        }
        if (got.has("letter-spacing")) {
            def ls:string (CssSheet.lower((CssSheet.tidy((got.get("letter-spacing"))))))
            if (ls == "normal") {
                t.spacing = 0.0
                t.spacingSet = true
            } {
                def em:int (indexOf ls "em")
                if ((em > 0) && (em == ((strlen ls) - 2))) {
                    ; `0.1em`: a share of the size, kept negative so the
                    ; layout knows to multiply (MdLayout.spacingFor)
                    def d@(optional):double (to_double (trim (substring ls 0 em)))
                    if (!null? d) {
                        t.spacing = (0.0 - (unwrap d))
                        t.spacingSet = true
                    }
                } {
                    def pts:double (CssValue.fontPoints(ls -9999.0))
                    if (pts > -9999.0) {
                        t.spacing = (MdCss.atLeastZero(pts))
                        t.spacingSet = true
                    }
                }
            }
        }
        return t
    }

    ; letter-spacing in points is kept zero or more: a negative number in the
    ; field means `em` (see typoOf)
    sfn atLeastZero:double (v:double) {
        if (v < 0.0) {
            return 0.0
        }
        return v
    }

    ; The six levels have six sizes and ONE family and ONE pair of margins, so
    ; a per-level `margin-top` is a property this layout cannot honour and
    ; says so. `heading` is where a sheet states the shared ones.
    fn headings:void (style:MdStyle) {
        def shared:CssComputed (this.forTag("heading"))
        style.headingFamily = (this.family(shared "font-family" style.headingFamily))
        style.headingSpaceBefore = (this.len(shared "margin-top" style.headingSpaceBefore))
        style.headingSpaceAfter = (this.len(shared "margin-bottom" style.headingSpaceAfter))
        style.h1Size = (this.size(shared "font-size" style.h1Size))
        style.headingColor = (this.color(shared "color" style.headingColor))
        this.typo(style "heading" shared)
        this.rest(shared ("font-family,font-size,margin-top,margin-bottom,color,text-align," + (MdCssSupport.TYPO())))

        def h1:CssComputed (this.forTag("h1"))
        style.h1Size = (this.size(h1 "font-size" style.h1Size))
        style.h1Color = (this.color(h1 "color" style.h1Color))
        this.typo(style "h1" h1)
        this.rest(h1 ("font-size,color,text-align," + (MdCssSupport.TYPO())))
        def h2:CssComputed (this.forTag("h2"))
        style.h2Size = (this.size(h2 "font-size" style.h2Size))
        style.h2Color = (this.color(h2 "color" style.h2Color))
        this.typo(style "h2" h2)
        this.rest(h2 ("font-size,color,text-align," + (MdCssSupport.TYPO())))
        def h3:CssComputed (this.forTag("h3"))
        style.h3Size = (this.size(h3 "font-size" style.h3Size))
        style.h3Color = (this.color(h3 "color" style.h3Color))
        this.typo(style "h3" h3)
        this.rest(h3 ("font-size,color,text-align," + (MdCssSupport.TYPO())))
        def h4:CssComputed (this.forTag("h4"))
        style.h4Size = (this.size(h4 "font-size" style.h4Size))
        style.h4Color = (this.color(h4 "color" style.h4Color))
        this.typo(style "h4" h4)
        this.rest(h4 ("font-size,color,text-align," + (MdCssSupport.TYPO())))
        def h5:CssComputed (this.forTag("h5"))
        style.h5Size = (this.size(h5 "font-size" style.h5Size))
        style.h5Color = (this.color(h5 "color" style.h5Color))
        this.typo(style "h5" h5)
        this.rest(h5 ("font-size,color,text-align," + (MdCssSupport.TYPO())))
        def h6:CssComputed (this.forTag("h6"))
        style.h6Size = (this.size(h6 "font-size" style.h6Size))
        style.h6Color = (this.color(h6 "color" style.h6Color))
        this.typo(style "h6" h6)
        this.rest(h6 ("font-size,color,text-align," + (MdCssSupport.TYPO())))
    }

    fn code:void (style:MdStyle got:CssComputed) {
        style.monoFamily = (this.family(got "font-family" style.monoFamily))
        style.codeSize = (this.size(got "font-size" style.codeSize))
        style.codeLineHeight = (this.ratio(got "line-height" style.codeLineHeight))
        style.codePadding = (this.len(got "padding" style.codePadding))
        style.codeBackground = (this.color(got "background-color" style.codeBackground))
        style.codeBorder = (this.color(got "border-color" style.codeBorder))
        ; the text of a listing that is not a keyword, string, comment or
        ; number — and code in a sentence
        style.codePlain = (this.color(got "color" style.codePlain))
        this.rest(got "font-family,font-size,line-height,padding,color,background-color,border-color")
    }

    fn mark:void (style:MdStyle got:CssComputed) {
        style.markBackground = (this.color(got "background-color" style.markBackground))
        style.markColor = (this.color(got "color" style.markColor))
        this.rest(got "background-color,color")
    }

    fn kbd:void (style:MdStyle got:CssComputed) {
        style.kbdBackground = (this.color(got "background-color" style.kbdBackground))
        style.kbdBorder = (this.color(got "border-color" style.kbdBorder))
        this.rest(got "background-color,border-color")
    }

    fn link:void (style:MdStyle got:CssComputed) {
        style.linkColor = (this.color(got "color" style.linkColor))
        this.rest(got "color")
    }

    fn rule:void (style:MdStyle got:CssComputed) {
        style.ruleColor = (this.color(got "color" style.ruleColor))
        this.rest(got "color")
    }

    fn quote:void (style:MdStyle got:CssComputed) {
        style.quoteColor = (this.color(got "color" style.quoteColor))
        style.quoteBarColor = (this.color(got "border-color" style.quoteBarColor))
        style.quoteBarWidth = (this.len(got "border-width" style.quoteBarWidth))
        style.quoteIndent = (this.len(got "padding-left" style.quoteIndent))
        style.quotePadY = (this.len(got "padding-top" style.quotePadY))
        style.quoteBackground = (this.color(got "background" style.quoteBackground))
        style.quoteBackground = (this.color(got "background-color" style.quoteBackground))
        this.typo(style "blockquote" got)
        this.rest(got ("color,border-color,border-width,padding-left,padding-top,background,background-color," + (MdCssSupport.TYPO())))
    }

    ; the plate under a `{container=…}` block
    fn container:void (style:MdStyle got:CssComputed) {
        style.containerBackground = (this.color(got "background" style.containerBackground))
        style.containerBackground = (this.color(got "background-color" style.containerBackground))
        style.containerRadius = (this.len(got "border-radius" style.containerRadius))
        if (got.has("box-shadow")) {
            style.containerShadow = (MdContainer.shadowColour((this.raw(got "box-shadow"))))
        }
        def pads:[double] (MdCss.padding(got))
        if ((itemAt pads 0) >= 0.0) {
            style.containerPadY = (itemAt pads 0)
            applied = (applied + 1)
        }
        if ((itemAt pads 3) >= 0.0) {
            style.containerPadX = (itemAt pads 3)
        }
        def bc:string (MdCss.borderColour(got))
        if ((strlen bc) > 0) {
            style.containerBorder = bc
            style.containerBorderWidth = (MdCss.borderWidth(got 1.0))
            applied = (applied + 1)
        }
        this.rest(got "background,background-color,border-radius,box-shadow,padding,padding-top,padding-right,padding-bottom,padding-left,border,border-color,border-width,border-style")
    }

    ; `padding` (one to four lengths) and `padding-top` … `-left`, as
    ; [top, right, bottom, left] in points; -1 where nothing was said
    sfn padding:[double] (got:CssComputed) {
        def out:[double] ([] _:double (-1.0 -1.0 -1.0 -1.0))
        if (got.has("padding")) {
            def words:[string] (CssSheet.splitWhitespace((CssSheet.tidy((got.get("padding"))))))
            def n:int (array_length words)
            if (n > 0) {
                def a:double (CssValue.fontPoints((itemAt words 0) -1.0))
                def b:double a
                def c:double a
                def d:double a
                if (n >= 2) {
                    b = (CssValue.fontPoints((itemAt words 1) -1.0))
                    d = b
                }
                if (n >= 3) {
                    c = (CssValue.fontPoints((itemAt words 2) -1.0))
                }
                if (n >= 4) {
                    d = (CssValue.fontPoints((itemAt words 3) -1.0))
                }
                out = ([] _:double (a b c d))
            }
        }
        def sides:[string] ([] _:string ("padding-top" "padding-right" "padding-bottom" "padding-left"))
        def i:int 0
        while (i < 4) {
            def name:string (itemAt sides i)
            if (got.has(name)) {
                set_at out i (CssValue.fontPoints((got.get(name)) (itemAt out i)))
            }
            i = (i + 1)
        }
        return out
    }

    ; a border's colour from `border-color` or `border: 2pt solid #7ee0ff`,
    ; "" for none (`border: none`, or nothing said)
    sfn borderColour:string (got:CssComputed) {
        if (got.has("border-color")) {
            def c:EVGColor (CssValue.color((got.get("border-color"))))
            if c.isSet {
                return (MdCss.hexOf(c))
            }
        }
        if (got.has("border")) {
            def words:[string] (CssSheet.splitWhitespace((CssSheet.tidy((got.get("border"))))))
            for words w:string wi {
                def c2:EVGColor (CssValue.color(w))
                if c2.isSet {
                    return (MdCss.hexOf(c2))
                }
            }
            def low:string (CssSheet.lower((CssSheet.tidy((got.get("border"))))))
            if ((low != "none") && (low != "0")) {
                return "#000000"
            }
        }
        return ""
    }

    ; …and its width: `border-width`, the length in `border`, else `fallback`
    sfn borderWidth:double (got:CssComputed fallback:double) {
        if (got.has("border-width")) {
            return (CssValue.fontPoints((got.get("border-width")) fallback))
        }
        if (got.has("border")) {
            def words:[string] (CssSheet.splitWhitespace((CssSheet.tidy((got.get("border"))))))
            for words w:string wi {
                def first:int (charAt w 0)
                if (((first >= 48) && (first <= 57)) || (first == 46)) {
                    return (CssValue.fontPoints(w fallback))
                }
            }
        }
        return fallback
    }

    fn list:void (style:MdStyle got:CssComputed) {
        style.listIndent = (this.len(got "padding-left" style.listIndent))
        style.markerGap = (this.len(got "margin-left" style.markerGap))
        style.markerColor = (this.color(got "color" style.markerColor))
        this.rest(got "padding-left,margin-left,color")
    }

    fn item:void (style:MdStyle got:CssComputed) {
        style.listTightSpacing = (this.len(got "margin-bottom" style.listTightSpacing))
        this.typo(style "li" got)
        this.rest(got ("margin-bottom," + (MdCssSupport.TYPO())))
    }

    ; `th { background-color; color }`: the header row. `table {
    ; background-color }` says the same for the row, and `th` wins.
    fn tableHead:void (style:MdStyle got:CssComputed) {
        style.tableHeadBackground = (this.color(got "background-color" style.tableHeadBackground))
        style.tableHeadColor = (this.color(got "color" style.tableHeadColor))
        this.rest(got "background-color,color")
    }

    fn table:void (style:MdStyle got:CssComputed) {
        style.tableBorder = (this.color(got "border-color" style.tableBorder))
        style.tableHeadBackground = (this.color(got "background-color" style.tableHeadBackground))
        style.cellPadX = (this.len(got "padding-left" style.cellPadX))
        style.cellPadY = (this.len(got "padding-top" style.cellPadY))
        style.tableSize = (this.size(got "font-size" style.tableSize))
        ; cells coloured by their text, `MdCellTones`' mapping
        if (got.has("cell-tones")) {
            style.tableCellTones = (trim (this.raw(got "cell-tones")))
        }
        this.rest(got "border-color,background-color,padding-left,padding-top,font-size,cell-tones")
    }

    ; `img { justify-content: center; max-height: 300px }`
    fn picture:void (style:MdStyle got:CssComputed) {
        def a:string (MdCss.alignWord((this.raw(got "justify-content"))))
        if ((strlen a) == 0) {
            a = (MdCss.alignWord((this.raw(got "text-align"))))
        }
        if ((strlen a) > 0) {
            style.imgAlign = a
        }
        style.imgMaxHeight = (this.len(got "max-height" style.imgMaxHeight))
        this.rest(got "justify-content,text-align,max-height")
    }

    ; "center" / "end" / "start" from what CSS says about it; "" for nothing.
    sfn alignWord:string (v:string) {
        def t:string (CssSheet.lower((CssSheet.tidy(v))))
        if ((strlen t) == 0) { return "" }
        if ((t == "center") || (t == "centre")) { return "center" }
        if (((t == "right") || (t == "end")) || (t == "flex-end")) { return "end" }
        return "start"
    }

    ; `header { content: "ACME · {page}/{pages}"; background-image:
    ; url(logo.png); text-align: right; font-size: 10pt; color: #777;
    ; height: 24px }` — and `footer` the same.
    fn furniture:void (style:MdStyle got:CssComputed top:boolean) {
        def text:string (MdCss.unquote((this.raw(got "content"))))
        def img:string (MdCss.urlOf((this.raw(got "background-image"))))
        def al:string (MdCss.alignWord((this.raw(got "text-align"))))
        if (top) {
            if ((strlen text) > 0) { style.headerText = text }
            if ((strlen img) > 0) { style.headerImage = img }
            if ((strlen al) > 0) { style.headerAlign = al }
            style.headerSize = (this.len(got "font-size" style.headerSize))
            style.headerColor = (this.color(got "color" style.headerColor))
            style.headerImageH = (this.len(got "height" style.headerImageH))
            style.headerLeft = (this.slot(got "content-left" style.headerLeft))
            style.headerCenter = (this.slot(got "content-center" style.headerCenter))
            style.headerRight = (this.slot(got "content-right" style.headerRight))
            style.headerBold = (this.boldOf(got style.headerBold))
            style.headerBackground = (this.color(got "background-color" style.headerBackground))
            style.headerRule = (this.color(got "border-color" style.headerRule))
        } {
            if ((strlen text) > 0) { style.footerText = text }
            if ((strlen img) > 0) { style.footerImage = img }
            if ((strlen al) > 0) { style.footerAlign = al }
            style.footerSize = (this.len(got "font-size" style.footerSize))
            style.footerColor = (this.color(got "color" style.footerColor))
            style.footerImageH = (this.len(got "height" style.footerImageH))
            style.footerLeft = (this.slot(got "content-left" style.footerLeft))
            style.footerCenter = (this.slot(got "content-center" style.footerCenter))
            style.footerRight = (this.slot(got "content-right" style.footerRight))
            style.footerBold = (this.boldOf(got style.footerBold))
            style.footerBackground = (this.color(got "background-color" style.footerBackground))
            style.footerRule = (this.color(got "border-color" style.footerRule))
        }
        this.rest(got "content,content-left,content-center,content-right,background-image,background-color,border-color,font-weight,text-align,font-size,color,height")
    }

    ; `content-left: "ACME"` — one of an edge's three places.
    fn slot:string (got:CssComputed name:string fallback:string) {
        if (! (got.has(name))) { return fallback }
        return (MdCss.unquote((this.raw(got name))))
    }

    ; `font-weight: bold` (or 600 and over) for an edge's text.
    fn boldOf:boolean (got:CssComputed fallback:boolean) {
        if (! (got.has("font-weight"))) { return fallback }
        def w:string (CssSheet.lower((CssSheet.tidy((this.raw(got "font-weight"))))))
        if ((w == "bold") || (w == "bolder")) { return true }
        def n@(optional):int (str2int w)
        if (!null? n) { return ((unwrap n) >= 600) }
        return false
    }

    ; `"text"` or `'text'` as text; anything else as it was written.
    sfn unquote:string (v:string) {
        def t:string (trim v)
        def n:int (strlen t)
        if (n >= 2) {
            def q:int (charAt t 0)
            if (((q == 34) || (q == 39)) && ((charAt t (n - 1)) == q)) {
                return (substring t 1 (n - 1))
            }
        }
        if (t == "none") { return "" }
        return t
    }

    ; `deck { split-level: 2; overflow: split; aspect-ratio: 16 / 9 }` —
    ; carried, not applied. The slide layout reads these; a page does not
    ; have them and `MdStyle` should not grow fields it never uses.
    fn deck:void (got:CssComputed) {
        if (got.has("split-level")) {
            def v:string (got.get("split-level"))
            def n@(optional):int (str2int (CssSheet.tidy(v)))
            splitLevel = (?? n 0)
            applied = (applied + 1)
        }
        if (got.has("overflow")) {
            overflow = (CssSheet.lower((CssSheet.tidy((got.get("overflow"))))))
            applied = (applied + 1)
        }
        if (got.has("aspect-ratio")) {
            aspect = (CssSheet.tidy((got.get("aspect-ratio"))))
            applied = (applied + 1)
        }
        this.rest(got "split-level,overflow,aspect-ratio,crop-marks")
    }

    ; ----------------------------------------------------------------------
    ; Reading one value, and counting what was read
    ; ----------------------------------------------------------------------

    fn len:double (got:CssComputed name:string fallback:double) {
        if (! (got.has(name))) { return fallback }
        applied = (applied + 1)
        return (CssValue.fontPoints((got.get(name)) fallback))
    }

    fn size:double (got:CssComputed name:string fallback:double) {
        return (this.len(got name fallback))
    }

    ; `line-height: 1.45` is a ratio and `line-height: 16pt` is a length. Both
    ; are written; the field is a ratio, so a length is divided by the size it
    ; was stated against — which this layer does not know, so a length here is
    ; the one thing reported rather than guessed.
    fn ratio:double (got:CssComputed name:string fallback:double) {
        if (! (got.has(name))) { return fallback }
        def v:string (CssSheet.tidy((got.get(name))))
        if (CssValue.isBareNumber(v)) {
            applied = (applied + 1)
            def d@(optional):double (to_double v)
            return (?? d fallback)
        }
        this.note((name + " as a length"))
        return fallback
    }

    fn family:string (got:CssComputed name:string fallback:string) {
        if (! (got.has(name))) { return fallback }
        def f:string (CssValue.firstFamily((got.get(name))))
        if ((strlen f) == 0) { return fallback }
        applied = (applied + 1)
        return f
    }

    ; The declaration as it was WRITTEN, for the properties this file has to
    ; read itself. Everything else goes through `CssValue`, which knows about
    ; lengths and colours and nothing about `url(...)`.
    fn raw:string (got:CssComputed name:string) {
        if (! (got.has(name))) { return "" }
        applied = (applied + 1)
        return (got.get(name))
    }

    fn color:string (got:CssComputed name:string fallback:string) {
        if (! (got.has(name))) { return fallback }
        def word:string (CssSheet.lower((CssSheet.tidy((got.get(name))))))
        if ((word == "none") || (word == "transparent")) {
            applied = (applied + 1)
            return "transparent"
        }
        def c:EVGColor (CssValue.color((got.get(name))))
        if (! c.isSet) { return fallback }
        applied = (applied + 1)
        return (MdCss.hexOf(c))
    }

    ; `#RRGGBB`, or `#RRGGBBAA` when the colour lets what is behind it show
    ; through — `#151c4833` kept its alpha nowhere before this.
    sfn hexOf:string (c:EVGColor) {
        def hex:string (c.toHexString())
        def a:double (c.alpha())
        if (a >= 0.999) {
            return hex
        }
        def digits:string "0123456789ABCDEF"
        def v:int (to_int ((a * 255.0) + 0.5))
        def hi:int (idiv v 16)
        def lo:int (v % 16)
        return (hex + (strfromcode (charAt digits hi)) + (strfromcode (charAt digits lo)))
    }

    ; Every property of a rule this layout did not just read. Named once each,
    ; so a template author is told which of their lines did nothing rather
    ; than being left to wonder — `PLAN_SLIDES.md` §8.4, and the problem
    ; `PptxCss` already had and answered.
    fn rest:void (got:CssComputed known:string) {
        def i:int 0
        while (i < (got.count())) {
            def name:string (itemAt got.names i)
            if (! (MdCss.listed(known name))) {
                this.note(name)
            }
            i = (i + 1)
        }
    }

    sfn listed:boolean (csv:string name:string) {
        def parts:[string] (strsplit csv ",")
        def i:int 0
        while (i < (array_length parts)) {
            if ((itemAt parts i) == name) { return true }
            i = (i + 1)
        }
        return false
    }

    ; ----------------------------------------------------------------------
    ; @media, and `:nth(n)`
    ; ----------------------------------------------------------------------

    ; The sheet in three: [everything outside an `@media` block, the inside
    ; of every `@media print` block, the inside of every `@media screen`
    ; block]. Another medium's block (`@media (max-width…)`) is left in the
    ; first part, where `CssCore` reports it as an at-rule it does not read.
    sfn splitMedia:[string] (css:string) {
        def src:string (CssSheet.stripComments(css))
        def rest:string ""
        def onPrint:string ""
        def onScreen:string ""
        def n:int (strlen src)
        def i:int 0
        def from:int 0
        while (i < n) {
            def c:int (charAt src i)
            if (c == 64) {
                def open:int (CssSheet.findChar(src i 123))
                if (open < 0) {
                    i = n
                } {
                    def head:string (CssSheet.lower((CssSheet.tidy((substring src i open)))))
                    def close:int (CssSheet.matchingBrace(src open))
                    def which:string ""
                    if ((indexOf head "@media") == 0) {
                        def q:string (trim (substring head 6 (strlen head)))
                        if (q == "print") { which = "print" }
                        if (q == "screen") { which = "screen" }
                    }
                    if ((strlen which) > 0) {
                        rest = (rest + (substring src from i))
                        def end:int close
                        if (end < 0) { end = n }
                        def inner:string (substring src (open + 1) end)
                        if (which == "print") {
                            onPrint = (onPrint + inner + "\n")
                        } {
                            onScreen = (onScreen + inner + "\n")
                        }
                        if (close < 0) {
                            i = n
                        } {
                            i = (close + 1)
                        }
                        from = i
                    } {
                        ; another at-rule: skip its block whole, so a `{`
                        ; inside it is not taken for the next rule's
                        if (close < 0) {
                            i = n
                        } {
                            i = (close + 1)
                        }
                    }
                }
            } {
                if (c == 123) {
                    def close2:int (CssSheet.matchingBrace(src i))
                    if (close2 < 0) {
                        i = n
                    } {
                        i = (close2 + 1)
                    }
                } {
                    i = (i + 1)
                }
            }
        }
        if (from < n) {
            rest = (rest + (substring src from n))
        }
        def out:[string]
        push out rest
        push out onPrint
        push out onScreen
        return out
    }

    ; `cell:nth(3)` — the third cell of a gallery — is read as the class
    ; `MdCss.nthClass(3)`, which every gallery cell carries for its own
    ; place. A pseudo-class weighs what a class weighs in CSS, so the
    ; cascade ranks it exactly as it would rank `:nth-child(3)`. Only in
    ; selectors: a declaration's value is left as it was written.
    sfn desugar:string (css:string) {
        if ((indexOf css ":nth(") < 0) { return css }
        def out:string ""
        def n:int (strlen css)
        def depth:int 0
        def i:int 0
        while (i < n) {
            def c:int (charAt css i)
            if (c == 123) { depth = (depth + 1) }
            if (c == 125) { depth = (depth - 1) }
            def took:boolean false
            if ((depth == 0) && ((c == 58) && ((i + 5) < n))) {
                if ((substring css i (i + 5)) == ":nth(") {
                    def close:int (CssSheet.findChar(css (i + 5) 41))
                    if (close > 0) {
                        def arg:string (trim (substring css (i + 5) close))
                        def num@(optional):int (str2int arg)
                        if (!null? num) {
                            out = (out + "." + (MdCss.nthClass((unwrap num))))
                            i = (close + 1)
                            took = true
                        }
                    }
                }
            }
            if (took == false) {
                out = (out + (strfromcode c))
                i = (i + 1)
            }
        }
        return out
    }

    ; The class a gallery's `n`th cell (from 1) carries for `cell:nth(n)`.
    sfn nthClass:string (n:int) {
        return ("nth--" + (to_string n))
    }

    ; ----------------------------------------------------------------------
    ; The print page
    ; ----------------------------------------------------------------------
    ;
    ; `@media print { page { width: 297mm; height: 210mm; bleed: 3mm;
    ; safe-area: 8mm } deck { crop-marks: on } }`. Applied after
    ; everything else that sets the page (the theme, `page:` in the front
    ; matter, the reader's choice), because paper is paper: the printing
    ; house's size is the size. A sheet with no print rules leaves the style
    ; as it was, apart from saying it is for print.
    fn applyPrint:void (style:MdStyle) {
        style.forPrint = true
        def pn (new CssNode())
        pn.tag = "page"
        def pg:CssComputed (CssCascade.resolve(printSheet pn))
        style.pageWidth = (this.len(pg "width" style.pageWidth))
        style.pageHeight = (this.len(pg "height" style.pageHeight))
        style.margin = (this.len(pg "padding" style.margin))
        style.bleed = (this.len(pg "bleed" style.bleed))
        style.safeArea = (this.len(pg "safe-area" style.safeArea))
        def dn (new CssNode())
        dn.tag = "deck"
        def dk:CssComputed (CssCascade.resolve(printSheet dn))
        if (dk.has("crop-marks")) {
            def v:string (CssSheet.lower((CssSheet.tidy((dk.get("crop-marks"))))))
            style.cropMarks = (((v == "on") || (v == "true")) || (v == "yes"))
            applied = (applied + 1)
        }
    }
}
