; ============================================================================
; MdSlideMeta.rgr — a slide's own data in its heading: `{jira=ABC-123}`
; ============================================================================
;
; ````markdown
; ## Revenue {jira=ACME-412 owner=Tero status=review}
; ## Costs {meta-width=wide}
; ````
;
; `MdAttrs` already reads `key=value` off a heading; what was missing is a
; rule for which keys MEAN something to the engine and which are the
; document's own business. This file is that rule, and it is the only place
; the engine's key list is written down:
;
;   a key the engine knows (`transition`, `bg`, `fx-density`, …)  ──► engine
;   anything else (`jira`, `owner`, `epic`, `status`, …)          ──► metadata
;   `meta-<key>`                                                 ──► metadata
;
; The prefix is not needed for `jira`, and is the way to carry a key the
; engine would otherwise claim — `{meta-width=wide}` is data, `{width=wide}`
; is a layout. Keys are lowercased; the value is the text as written.
;
; Metadata is drawn NOWHERE by itself. It travels with the slide, it can be
; read back (an assistant asking which slide carries a ticket), and it fills
; a `{jira}` placeholder in a header or a footer the same way `{page}` does.
;
; A misspelt engine key would otherwise become metadata in silence —
; `{transtion=fade}` is a key the engine does not know, and no slide would
; fade. So a metadata key one character away from an engine key is named in
; `warnings`, and still kept: the report says what happened rather than the
; slide quietly losing its transition.
; ============================================================================

Import "MdNode.rgr"
Import "MdChar.rgr"

class MdSlideMeta {
    def keys:[string]
    def values:[string]
    ; metadata keys that are one character from an engine key, as
    ; "transtion~transition" — the report's business, not the layout's
    def suspect:[string]

    Constructor () {
        def k:[string]
        keys = k
        def v:[string]
        values = v
        def s:[string]
        suspect = s
    }

    fn count:int () {
        return (array_length keys)
    }

    fn has:boolean (k:string) {
        def want:string (MdChar.lower((trim k)))
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == want) { return true }
            i = (i + 1)
        }
        return false
    }

    fn value:string (k:string) {
        def want:string (MdChar.lower((trim k)))
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == want) { return (itemAt values i) }
            i = (i + 1)
        }
        return ""
    }

    ; Last one wins, as an attribute block does.
    fn put:void (k:string v:string) {
        def key:string (MdChar.lower((trim k)))
        if ((strlen key) == 0) { return }
        def i:int 0
        while (i < (array_length keys)) {
            if ((itemAt keys i) == key) {
                set_at values i v
                return
            }
            i = (i + 1)
        }
        push keys key
        push values v
    }

    ; `jira=ACME-412 owner=Tero`, in the order they were written.
    fn asText:string () {
        def parts:[string]
        def i:int 0
        while (i < (array_length keys)) {
            push parts ((itemAt keys i) + "=" + (itemAt values i))
            i = (i + 1)
        }
        return (join parts " ")
    }

    ; ----------------------------------------------------------------------
    ; The engine's keys
    ; ----------------------------------------------------------------------
    ;
    ; Everything a heading's attribute block means to the layout, the deck or
    ; a figure. Longhand on purpose: a list is readable and a new key added
    ; to the engine without a line here shows up as metadata in the report,
    ; which is a louder failure than a silent one.

    sfn engineKeys:[string] () {
        return ([] _:string ("align" "anim" "art" "art-seed" "background" "ball" "bg" "bg-dim" "caption" "cells" "chart-style" "choose" "colors" "container" "diagram" "duration" "fit" "float" "focus" "footer" "furniture" "fx" "header" "heading" "height" "hold" "layout" "lines" "list-style" "numbers" "padding" "radius" "seconds" "span" "step" "style" "tour" "transition" "valign" "width" "widths" "zoom"))
    }

    sfn isEngineKey:boolean (k0:string) {
        def k:string (MdChar.lower((trim k0)))
        ; `fx-density`, `fx-speed`, … all belong to the effect named by `fx`
        if ((MdSlideMeta.startsWith(k "fx-")) == true) { return true }
        def all:[string] (MdSlideMeta.engineKeys())
        def i:int 0
        while (i < (array_length all)) {
            if ((itemAt all i) == k) { return true }
            i = (i + 1)
        }
        return false
    }

    sfn startsWith:boolean (text:string what:string) {
        def n:int (strlen what)
        if ((strlen text) < n) { return false }
        return ((substring text 0 n) == what)
    }

    ; The engine key this is one character away from, or "".
    sfn nearEngineKey:string (k0:string) {
        def k:string (MdChar.lower((trim k0)))
        return (MdSlideMeta.nearIn(k (MdSlideMeta.engineKeys())))
    }

    ; One substitution, insertion, deletion or swap of two neighbours apart —
    ; the four ways a key is mistyped (`tilte`). Not a general edit
    ; distance: two differences are two words, and `owner` is not a misspelt
    ; `order`.
    sfn oneApart:boolean (a:string b:string) {
        def la:int (strlen a)
        def lb:int (strlen b)
        if (a == b) { return false }
        if (la == lb) {
            def diff:int 0
            def first:int -1
            def i:int 0
            while (i < la) {
                if ((charAt a i) != (charAt b i)) {
                    if (diff == 0) { first = i }
                    diff = (diff + 1)
                }
                i = (i + 1)
            }
            if (diff == 1) { return true }
            if ((diff == 2) && ((first + 1) < la)) {
                return (((charAt a first) == (charAt b (first + 1))) && ((charAt a (first + 1)) == (charAt b first)))
            }
            return false
        }
        if (la == (lb + 1)) { return (MdSlideMeta.oneLonger(a b)) }
        if (lb == (la + 1)) { return (MdSlideMeta.oneLonger(b a)) }
        return false
    }

    ; `long` is `short` with one character inserted.
    sfn oneLonger:boolean (long:string short:string) {
        def i:int 0
        def n:int (strlen short)
        while (i < n) {
            if ((charAt long i) != (charAt short i)) { break }
            i = (i + 1)
        }
        def j:int i
        while (j < n) {
            if ((charAt long (j + 1)) != (charAt short j)) { return false }
            j = (j + 1)
        }
        return true
    }

    ; ----------------------------------------------------------------------
    ; The deck's own data: the front matter
    ; ----------------------------------------------------------------------
    ;
    ; ````yaml
    ; ---
    ; title: Q3 review
    ; lang: fi
    ; jira: ACME-400
    ; owner: Tero
    ; ---
    ; ````
    ;
    ; The same rule one level up: a front matter key the engine reads is the
    ; engine's (`title`, `lang`, `theme`, the header's and footer's, …),
    ; anything else is the deck's own data, and `meta-<key>` is data whatever
    ; it is called. A slide's own value goes over the deck's: `{jira}` in a
    ; footer prints the slide's ticket where it has one and the deck's where
    ; it has none.

    sfn frontMatterKeys:[string] () {
        return ([] _:string ("art" "art-seed" "book-start" "breakonh1" "chart-style" "diagram-style" "footer" "fx" "header" "highlight" "hold" "lang" "margin" "margin-bottom" "margin-inside" "margin-outside" "margin-top" "mode" "orientation" "page" "pagenumbers" "render" "runninghead" "seconds" "slide-grow" "slide-overflow" "slide-split-level" "step" "style" "theme" "title" "toc" "transition" "typographer" "valign"))
    }

    sfn isFrontMatterKey:boolean (k0:string) {
        def k:string (MdChar.lower((trim k0)))
        if ((MdSlideMeta.startsWith(k "fx-")) == true) { return true }
        ; every `header-…` and `footer-…` belongs to the edges (MdLayout)
        if ((MdSlideMeta.startsWith(k "header-")) == true) { return true }
        if ((MdSlideMeta.startsWith(k "footer-")) == true) { return true }
        def all:[string] (MdSlideMeta.frontMatterKeys())
        def i:int 0
        while (i < (array_length all)) {
            if ((itemAt all i) == k) { return true }
            i = (i + 1)
        }
        return false
    }

    ; Whether a front matter key, as written, is the deck's data.
    sfn isDeckDataKey:boolean (k0:string) {
        def k:string (MdChar.lower((trim k0)))
        if ((strlen k) == 0) { return false }
        if (MdSlideMeta.startsWith(k "meta-")) { return ((strlen k) > 5) }
        return ((MdSlideMeta.isFrontMatterKey(k)) == false)
    }

    ; The deck's data from its front matter's keys and values.
    sfn ofFrontMatter:MdSlideMeta (keys:[string] values:[string]) {
        def out:MdSlideMeta (new MdSlideMeta())
        def i:int 0
        while (i < (array_length keys)) {
            def key:string (MdChar.lower((trim (itemAt keys i))))
            if (MdSlideMeta.isDeckDataKey(key)) {
                if (MdSlideMeta.startsWith(key "meta-")) {
                    out.put((substring key 5 (strlen key)) (itemAt values i))
                } {
                    out.put(key (itemAt values i))
                    def near:string (MdSlideMeta.nearIn(key (MdSlideMeta.frontMatterKeys())))
                    if ((strlen near) > 0) {
                        push out.suspect (key + "~" + near)
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }

    ; The key in `all` this one is one character away from, or "".
    sfn nearIn:string (k:string all:[string]) {
        if ((strlen k) < 3) { return "" }
        def i:int 0
        while (i < (array_length all)) {
            def cand:string (itemAt all i)
            if (MdSlideMeta.oneApart(k cand)) { return cand }
            i = (i + 1)
        }
        return ""
    }

    ; ----------------------------------------------------------------------
    ; Reading one off a heading
    ; ----------------------------------------------------------------------

    sfn of:MdSlideMeta (node:MdNode) {
        def out:MdSlideMeta (new MdSlideMeta())
        def n:int (node.attrCount())
        def i:int 0
        while (i < n) {
            def key:string (MdChar.lower((trim (itemAt node.attrKeys i))))
            def val:string (itemAt node.attrVals i)
            if (MdSlideMeta.startsWith(key "meta-")) {
                out.put((substring key 5 (strlen key)) val)
            } {
                if ((MdSlideMeta.isEngineKey(key)) == false) {
                    out.put(key val)
                    def near:string (MdSlideMeta.nearEngineKey(key))
                    if ((strlen near) > 0) {
                        push out.suspect (key + "~" + near)
                    }
                }
            }
            i = (i + 1)
        }
        return out
    }
}
