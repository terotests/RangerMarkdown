; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdToDocx.rgr — a markdown document, as a Word document.
; ============================================================================
;
; The other destination of `../PLAN_DOCUMENT_MODES.md` §5. `MdToPptx` builds a
; deck; this builds a `RichDocument`, which is the model `DocxEditController`
; edits and `DocxView` draws — the Word editor this repository already has,
; with its own suites, rather than a second one inside the markdown page.
;
;   markdown ──► MdToDocx ──► RichDocument ──► DocxEditController owns it
;
; **Paragraphs, not boxes.** The deck exporter has two roads — a text box a
; reader can edit, or a drawing — because a slide is a canvas. A Word document
; is a stream of paragraphs, so there is one road and the question is only
; which paragraph a block becomes. That makes this smaller than `MdToPptx` and
; and it used to make it lossier in a different place: a diagram was a
; paragraph with its name in it, because a `RichDocument` had no shapes. It
; has a DRAWING now — the diagram's own element tree, the same one the
; preview draws and the slide is built from — so the picture is geometry here
; too. A fence nothing has drawn yet still goes in as its name, and is
; counted.
;
; **What it costs is counted, not hidden.** The same rule the deck exporter is
; written to: a document that quietly lost its table is worse than one that
; says it could not carry it.
; ============================================================================

Import "MdNode.rgr"
Import "MdGallery.rgr"
Import "MdStyle.rgr"
Import "MdEmbedKinds.rgr"
Import "MdEmbed.rgr"
Import "../../docx_viewer/src/RichDocument.rgr"
Import "../../vfs/src/Vfs.rgr"
Import "MdDocSync.rgr"
Import "../../math/src/MathRender.rgr"
Import "../../math/src/MathOmml.rgr"

class MdDocResult {
    def paragraphs:int 0
    def headings:int 0
    def listItems:int 0
    def codeBlocks:int 0
    def quotes:int 0
    ; Tables, as Word tables: a row per row, a cell per cell, the header row
    ; shaded and bold, each column aligned as the markdown said.
    def tables:int 0
    ; Blocks a stream of paragraphs has no shape for. Named rather than
    ; dropped: a reader who cannot see that has lost a drawing without being
    ; told.
    def drawingsAsText:int 0
    ; Diagrams carried as drawings — geometry, the same tree the preview
    ; draws.
    def drawings:int 0
    ; Pictures carried as pictures, and pictures that stayed alt text because
    ; the byte store had nothing under that name. The same two numbers the
    ; deck exporter keeps, for the same reason: a picture that silently
    ; became italic text is a picture the reader lost without being told.
    def pictures:int 0
    def missedPictures:int 0
    def notes:[string]

    Constructor () {
    }

    fn note:void (m:string) {
        push notes m
    }

    fn noteCount:int () {
        return (array_length notes)
    }

    fn noteAt:string (i:int) {
        return (itemAt notes i)
    }

    fn describe:string () {
        def out:string ((to_string paragraphs) + " paragraph(s), " + (to_string headings) + " heading(s)")
        out = (out + ", " + (to_string listItems) + " list item(s)")
        if (codeBlocks > 0) {
            out = (out + ", " + (to_string codeBlocks) + " code block(s)")
        }
        if (quotes > 0) {
            out = (out + ", " + (to_string quotes) + " quote(s)")
        }
        if (tables > 0) {
            out = (out + ", " + (to_string tables) + " table(s)")
        }
        if (drawings > 0) {
            out = (out + " — " + (to_string drawings) + " drawing(s) placed")
        }
        if (drawingsAsText > 0) {
            out = (out + " — " + (to_string drawingsAsText) + " drawing(s) as their name")
        }
        if (pictures > 0) {
            out = (out + " — " + (to_string pictures) + " picture(s) placed")
        }
        if (missedPictures > 0) {
            out = (out + " — " + (to_string missedPictures) + " picture(s) named but not carried")
        }
        return out
    }
}

class MdToDocx {
    def style:MdStyle (new MdStyle())
    def result:MdDocResult (new MdDocResult())
    def doc:RichDocument (new RichDocument())

    ; The bytes behind `![alt](src)`. The same store the layout reads, so the
    ; preview and the Word document cannot be missing DIFFERENT pictures —
    ; `MdLayout.pictureBlock` asks these same three questions and a picture it
    ; drew is a picture this carries.
    def images:Vfs (new Vfs())
    def haveImages:boolean false
    def docDir:string "/"
    ; The diagrams, already drawn. The layout prepared every fenced diagram
    ; before it laid the page out (`MdDiagram.prepare`), and the cache it
    ; filled is what this reads — the same trees the preview paints and the
    ; deck exporter turns into shapes, so the three views cannot disagree
    ; about what a fence looks like. Without one, a fence is its name.
    def embeds:MdEmbedCache (new MdEmbedCache())
    def haveEmbeds:boolean false

    Constructor () {
    }

    fn setImages:void (v:Vfs dir:string) {
        images = v
        haveImages = true
        docDir = dir
    }

    fn setEmbeds:void (cache:MdEmbedCache) {
        embeds = cache
        haveEmbeds = true
    }

    fn build:RichDocument (root:MdNode s:MdStyle) {
        style = s
        result = (new MdDocResult())
        doc = (new RichDocument())
        doc.title = s.title
        ; The page the markdown was laid out for, in the units Word keeps.
        ; Without this a document keeps `RichDocument`'s Letter default and a
        ; reader who set A4 in their template gets a different page.
        def sec:DocSection doc.section
        sec.pageWTwips = (to_int (s.pageWidth * 20.0))
        sec.pageHTwips = (to_int (s.pageHeight * 20.0))
        def m:int (to_int (s.margin * 20.0))
        sec.marginTopTwips = m
        sec.marginRightTwips = m
        sec.marginBottomTwips = m
        sec.marginLeftTwips = m

        this.blocks(root 0 0)
        ; …and say that something changed.
        ;
        ; `DocxLayout.layoutIfNeeded` compares its own `laidRevision` with the
        ; document's, and a document built and never touched sits at revision
        ; zero — which a fresh layout also does, so it decided it had already
        ; laid this document out and produced NO PAGES. A blank canvas, from a
        ; model that was entirely correct.
        doc.touch()
        return doc
    }

    fn blocks:void (parent:MdNode listKind:int level:int) {
        def i:int 0
        def n:int (parent.childCount())
        while (i < n) {
            def c:MdNode (parent.childAt(i))
            this.block(c listKind level)
            i = (i + 1)
        }
    }

    fn block:void (node:MdNode listKind:int level:int) {
        def kind:string node.kind
        if (kind == "front_matter") { return }
        if (kind == "heading") {
            def p:Paragraph (doc.addParagraph())
            p.styleId = ("Heading" + (to_string node.level))
            p.spaceBeforePt = style.headingSpaceBefore
            p.spaceAfterPt = style.headingSpaceAfter
            def base:TextSpan (this.spanFor(false false false ""))
            base.fontFamily = style.headingFamily
            base.fontSizePt = (style.headingSize(node.level))
            base.bold = true
            base.colorHex = (MdToDocx.hexOf((style.headingInk(node.level))))
            this.inline(node p base)
            MdDocSync.stamp(p node)
            result.headings = (result.headings + 1)
            return
        }
        if (kind == "paragraph") {
            def p:Paragraph (doc.addParagraph())
            p.spaceAfterPt = style.paraSpacing
            p.lineSpacing = style.lineHeight
            if (listKind > 0) {
                p.listKind = listKind
                p.listLevel = level
                p.listNumId = 1
                p.indentLeftPt = (style.listIndent * (to_double (level + 1)))
                p.spaceAfterPt = style.listTightSpacing
                result.listItems = (result.listItems + 1)
            } {
                result.paragraphs = (result.paragraphs + 1)
            }
            def base:TextSpan (this.spanFor(false false false ""))
            this.inline(node p base)
            if (listKind == 0) {
                MdDocSync.stamp(p node)
            }
            return
        }
        if (kind == "list") {
            def ordered:int 1
            if node.listOrdered { ordered = 2 }
            ; A list INSIDE an item is one level deeper. Markdown nests a list
            ; under an item; Word has no nesting and says the depth on the
            ; paragraph instead, so the depth has to be carried down rather
            ; than read back off the tree.
            def deeper:int level
            if (listKind > 0) { deeper = (level + 1) }
            this.blocks(node ordered deeper)
            return
        }
        if (kind == "item") {
            this.blocks(node listKind level)
            return
        }
        if (kind == "block_quote") {
            ; A quote is an indented paragraph, which is what Word means by
            ; one. The bar down the side is a border and is a cost this does
            ; not pay yet.
            def before:int result.paragraphs
            this.blocks(node 0 level)
            def made:int (result.paragraphs - before)
            def qi:int 0
            def total:int (array_length doc.paragraphs)
            while (qi < made) {
                def qp:Paragraph (itemAt doc.paragraphs ((total - made) + qi))
                qp.indentLeftPt = (qp.indentLeftPt + style.quoteIndent)
                qp.styleId = "Quote"
                qi = (qi + 1)
            }
            result.quotes = (result.quotes + 1)
            return
        }
        if (MdGallery.isGallery(node)) {
            this.gallery(node)
            return
        }
        if ((kind == "code_block") || (kind == "html_block")) {
            def lines:[string] (strsplit node.literal "\n")
            def li:int 0
            def ln:int (array_length lines)
            ; A trailing newline is not an empty last line of code.
            if (ln > 1) {
                if ((strlen (itemAt lines (ln - 1))) == 0) { ln = (ln - 1) }
            }
            while (li < ln) {
                def cp:Paragraph (doc.addParagraph())
                cp.styleId = "Code"
                cp.spaceAfterPt = 0.0
                cp.lineSpacing = style.codeLineHeight
                def cs:TextSpan (this.spanFor(false false true ""))
                cp.appendText((itemAt lines li) cs)
                li = (li + 1)
            }
            result.codeBlocks = (result.codeBlocks + 1)
            return
        }
        if (kind == "table") {
            this.table(node)
            return
        }
        if (kind == "embed") {
            def word:string (MdEmbedKinds.firstWord(node.info))
            if (this.drawing(node word)) { return }
            def dp:Paragraph (doc.addParagraph())
            def ds:TextSpan (this.spanFor(false true false ""))
            ds.colorHex = "57606A"
            dp.appendText((("[" + word) + " diagram]") ds)
            result.drawingsAsText = (result.drawingsAsText + 1)
            result.note((("a " + word) + " diagram went in as its name: a Word document is a stream of paragraphs and has no shapes"))
            return
        }
        if (kind == "math_block") {
            ; drawn, as a diagram is: Word's own equations are a different
            ; language (OMML) and this converter does not write it
            def mb:MathBox (MathLayout.layout(node.literal true))
            def px:double (style.bodySize * 1.21)
            def mw:double (mb.w * px)
            def mh:double ((mb.h + mb.d) * px)
            if ((mw > 0.0) && (mh > 0.0)) {
                def dr:DocDrawing (doc.addDrawing())
                dr.root = (MathRender.boxElement(mb px style.textColor))
                dr.naturalW = mw
                dr.naturalH = mh
                dr.widthPx = (to_int (((mw * 96.0) / 72.0) + 0.5))
                dr.heightPx = (to_int (((mh * 96.0) / 72.0) + 0.5))
                dr.notation = "tex"
                dr.source = node.literal
                dr.name = "Formula"
                dr.altText = node.literal
                result.drawings = (result.drawings + 1)
            }
            return
        }
        if (kind == "thematic_break") {
            def hp:Paragraph (doc.addParagraph())
            def hs:TextSpan (this.spanFor(false false false ""))
            hp.appendText("———" hs)
            result.paragraphs = (result.paragraphs + 1)
            return
        }
        ; Anything with children and no rule of its own: walk into it.
        if ((node.childCount()) > 0) {
            this.blocks(node listKind level)
        }
    }

    ; A markdown table, as a Word table. The columns share the text column
    ; evenly — markdown says nothing about widths, and Word re-fits them when
    ; a reader drags a border. The header row is bold on the style's header
    ; shade, and every cell keeps its column's alignment (`:--:`, `--:`).
    fn table:void (node:MdNode) {
        def cols:int 0
        def r:int 0
        while (r < (node.childCount())) {
            def rn:int ((node.childAt(r)).childCount())
            if (rn > cols) { cols = rn }
            r = (r + 1)
        }
        if (cols < 1) { return }
        def t:DocumentTable (doc.addTable())
        def sec:DocSection doc.section
        def text:int ((sec.pageWTwips - sec.marginLeftTwips) - sec.marginRightTwips)
        def colW:int (idiv text cols)
        def ci:int 0
        while (ci < cols) {
            push t.colWidthsTwips colW
            ci = (ci + 1)
        }
        def line:string (MdToDocx.hexOf(style.tableBorder))
        t.borderColor = line
        def shade:string (MdToDocx.hexOf(style.tableHeadBackground))
        r = 0
        while (r < (node.childCount())) {
            def rowNode:MdNode (node.childAt(r))
            def row (new DocTableRow())
            def c:int 0
            while (c < cols) {
                def cell (new DocTableCell())
                cell.borderTop.colorHex = line
                cell.borderLeft.colorHex = line
                cell.borderBottom.colorHex = line
                cell.borderRight.colorHex = line
                if rowNode.isHeader {
                    cell.fillHex = shade
                }
                def p:Paragraph (doc.addParagraphOnly())
                p.spaceBeforePt = 0.0
                p.spaceAfterPt = 0.0
                p.lineSpacing = 1.0
                def base:TextSpan (this.spanFor(rowNode.isHeader false false ""))
                ; a short row leaves its last cells empty rather than shifting
                if (c < (rowNode.childCount())) {
                    def cellNode:MdNode (rowNode.childAt(c))
                    p.align = (MdToDocx.alignOf(cellNode.align))
                    this.inline(cellNode p base)
                }
                push cell.paragraphs p
                push row.cells cell
                c = (c + 1)
            }
            push t.rows row
            r = (r + 1)
        }
        result.tables = (result.tables + 1)
    }

    ; a table column's markdown alignment, as `Paragraph.align`
    sfn alignOf:int (a:string) {
        if (a == "center") { return 1 }
        if (a == "right") { return 2 }
        return 0
    }

    ; The inline tree, flattened into spans. One span per run of one format,
    ; which `Paragraph.appendText` merges for itself when two neighbours
    ; agree.
    fn inline:void (node:MdNode p:Paragraph base:TextSpan) {
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def c:MdNode (node.childAt(i))
            def kind:string c.kind
            if (kind == "text") {
                p.appendText(c.literal base)
            }
            if (kind == "math") {
                ; a formula in a line: an equation a writer can make Word's
                ; own (`TextSpan.math`), drawn meanwhile as one line of
                ; Unicode rather than as its TeX source
                def ms:TextSpan (base.copy())
                ms.math = c.literal
                p.appendText((MathOmml.linear(c.literal)) ms)
            }
            if (kind == "code") {
                def cs:TextSpan (base.copy())
                cs.fontFamily = style.monoFamily
                p.appendText(c.literal cs)
            }
            if ((kind == "softbreak") || (kind == "linebreak")) {
                p.appendText(" " base)
            }
            if (kind == "strong") {
                def bs:TextSpan (base.copy())
                bs.bold = true
                this.inline(c p bs)
            }
            if (kind == "emph") {
                def is:TextSpan (base.copy())
                is.italic = true
                this.inline(c p is)
            }
            if (kind == "strike") {
                def ss:TextSpan (base.copy())
                ss.colorHex = "57606A"
                this.inline(c p ss)
            }
            ; markdown-it's spans. `++ins++` is underlined, as Word's own
            ; inserted text is; a TextSpan has no baseline shift and no
            ; highlight, so `^sup^`, `~sub~` and `==mark==` keep their text in
            ; the style around them — never dropped — and an abbreviation is
            ; its text.
            if (kind == "ins") {
                def us:TextSpan (base.copy())
                us.underline = true
                this.inline(c p us)
            }
            if ((((kind == "sub") || (kind == "sup")) || (kind == "mark")) || (kind == "abbr")) {
                this.inline(c p base)
            }
            if (kind == "link") {
                def ls:TextSpan (base.copy())
                ls.hyperlink = c.destination
                ls.underline = true
                ls.colorHex = "0969DA"
                this.inline(c p ls)
            }
            if (kind == "image") {
                def alt:string (c.plainText())
                def carried:boolean (this.picture(c p alt))
                if (! carried) {
                    def ims:TextSpan (base.copy())
                    ims.italic = true
                    ims.colorHex = "57606A"
                    p.appendText((("[" + alt) + "]") ims)
                }
            }
            i = (i + 1)
        }
    }

    ; A diagram, as a drawing. The tree comes out of the embed cache the
    ; layout filled, at whatever width it was drawn — the Word page has its
    ; own column and `DocxLayout` fits the drawing to it, height following.
    ;
    ; Sizes: the same 72→96 the picture road does, so a diagram is the same
    ; FRACTION of the page here as in the preview, which is what a reader
    ; compares.
    ;
    ; `false` when nothing has drawn this fence — no cache, or a fence the
    ; reader refused — and the caller writes the name instead and counts it.
    fn drawing:boolean (node:MdNode word:string) {
        if (! haveEmbeds) { return false }
        def idx:int (this.embedAtAnyWidth(word node.literal))
        if (idx < 0) { return false }
        def e:MdEmbedEntry (embeds.entryAt(idx))
        if (! e.ok) { return false }
        if (null? e.root) { return false }
        if ((e.width <= 0.0) || (e.height <= 0.0)) { return false }
        def dr:DocDrawing (doc.addDrawing())
        dr.root = e.root
        dr.naturalW = e.width
        dr.naturalH = e.height
        def wpx:double ((e.width * 96.0) / 72.0)
        def hpx:double ((e.height * 96.0) / 72.0)
        dr.widthPx = (to_int (wpx + 0.5))
        dr.heightPx = (to_int (hpx + 0.5))
        if (dr.widthPx < 1) { dr.widthPx = 1 }
        if (dr.heightPx < 1) { dr.heightPx = 1 }
        dr.notation = (MdEmbedKinds.notationOf(word))
        dr.source = node.literal
        dr.name = ((MdToDocx.notationWord(word)) + " diagram")
        dr.altText = dr.name
        result.drawings = (result.drawings + 1)
        return true
    }

    fn embedAtAnyWidth:int (kind:string source:string) {
        def i:int 0
        while (i < (embeds.count())) {
            def e:MdEmbedEntry (embeds.entryAt(i))
            if ((e.kind == kind) && (e.source == source)) { return i }
            i = (i + 1)
        }
        return -1
    }

    sfn notationWord:string (word:string) {
        return (MdEmbedKinds.notationWord(word))
    }

    ; A picture, as a picture. `DocImage` is what a Word document holds and
    ; `DocxLayout` already lays one out, so this only has to NAME the part and
    ; say how big it is — the bytes ride along for a writer that needs them,
    ; and the display-list painter fetches the part by name exactly as it does
    ; for the preview.
    ;
    ; Sizes: the store says PIXELS, the markdown layout draws those as POINTS,
    ; and `DocxLayout` works in CSS pixels at 96/inch. Converting 72→96 here
    ; is what makes the picture the same FRACTION of the page in both views,
    ; which is the thing a reader compares.
    fn picture:boolean (img:MdNode p:Paragraph alt:string) {
        if (! haveImages) { return false }
        def path:string (images.resolve(img.destination docDir))
        if ((strlen path) == 0) {
            result.missedPictures = (result.missedPictures + 1)
            return false
        }
        def st:VfsStat (images.stat(path))
        if (! st.found) {
            result.missedPictures = (result.missedPictures + 1)
            return false
        }
        if (st.pixelW < 1) {
            result.missedPictures = (result.missedPictures + 1)
            return false
        }
        def di:DocImage (new DocImage())
        di.relId = path
        di.partPath = path
        di.altText = alt
        di.bytes = (images.read(path))
        di.format = st.contentType
        def wpx:double (((to_double st.pixelW) * 96.0) / 72.0)
        def hpx:double (((to_double st.pixelH) * 96.0) / 72.0)
        di.widthPx = (to_int (wpx + 0.5))
        di.heightPx = (to_int (hpx + 0.5))
        if (di.widthPx < 1) { di.widthPx = 1 }
        if (di.heightPx < 1) { di.heightPx = 1 }
        di.widthEmu = (di.widthPx * 9525)
        di.heightEmu = (di.heightPx * 9525)
        di.ok = true
        push p.images di
        result.pictures = (result.pictures + 1)
        return true
    }

    ; A gallery in a document: each picture at its own size with its
    ; caption under it in italics, a text cell as a paragraph. A page of
    ; Word has no grid to put them in that the reader can still edit.
    fn gallery:void (node:MdNode) {
        def g:MdGallery (MdGallery.of(node))
        def i:int 0
        while (i < (array_length g.items)) {
            def it:MdGalleryItem (itemAt g.items i)
            if it.isText {
                def tp:Paragraph (doc.addParagraph())
                tp.appendText(it.text (this.spanFor(false false false "")))
                result.paragraphs = (result.paragraphs + 1)
            } {
                def pp:Paragraph (doc.addParagraph())
                def img:MdNode (MdNode.create("image"))
                img.destination = it.src
                def alt:string it.caption
                if ((strlen alt) == 0) {
                    alt = it.src
                }
                if ((this.picture(img pp alt)) == false) {
                    pp.appendText(("[" + alt + "]") (this.spanFor(false true false "")))
                }
                if (((strlen it.caption) > 0) && (g.caption != "none")) {
                    def cp:Paragraph (doc.addParagraph())
                    cp.appendText(it.caption (this.spanFor(false true false "")))
                    result.paragraphs = (result.paragraphs + 1)
                }
            }
            i = (i + 1)
        }
    }

    fn spanFor:TextSpan (bold:boolean italic:boolean mono:boolean link:string) {
        def s (new TextSpan())
        s.bold = bold
        s.italic = italic
        s.fontFamily = style.bodyFamily
        s.fontSizePt = style.bodySize
        if mono {
            s.fontFamily = style.monoFamily
            s.fontSizePt = style.codeSize
        }
        s.colorHex = (MdToDocx.hexOf(style.textColor))
        if ((strlen link) > 0) {
            s.hyperlink = link
            s.underline = true
        }
        return s
    }

    ; `#1f2328` → `1F2328`. A `RichDocument` colour has no hash on it, and a
    ; hash that survived would be drawn as a character by a reader that did
    ; not strip it.
    sfn hexOf:string (c:string) {
        def v:string (trim c)
        if ((strlen v) == 0) { return "000000" }
        if ((charAt v 0) == 35) { return (substring v 1 (strlen v)) }
        return v
    }
}
