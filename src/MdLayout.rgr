; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdLayout.rgr — the AST, laid out. Boxes with coordinates, and nothing drawn.
; ============================================================================
;
; This is the half the viewer actually uses. `MdToHtml` exists so the parser
; can be scored against a specification; this exists so the document can be
; PRINTED and DRAWN, which is a different problem with a different answer:
; there is no DOM under it, so the position of every line is decided here.
;
;   MdNode tree ──► MdLayout ──► [MdBox] ──► MdToEvg ──► EVGElement
;                                                          │
;                                        ┌─────────────────┴───────────────┐
;                                        ▼                                 ▼
;                                EVGPDFRenderer                   EVGDisplayList
;                                    → PDF                          → WebGL
;
; **The one thing EVG could not already do.** `EVGTextEngine.breakLines`
; breaks a paragraph of ONE font at ONE size. A markdown paragraph is
;
;     some **bold** words and `code` and *italic*
;
; — one line, four faces, and the break has to be found across all of them.
; `breakRuns` below is that: the same greedy algorithm, with the accumulator
; carrying a change of face instead of only a width, and each SEGMENT
; measured whole so the real advance of a space inside a run is included
; rather than guessed. A line's height and baseline are the maximum over its
; segments, so a 9pt code span inside 11pt prose sits on the right baseline
; instead of half a line up.
;
; Everything is in POINTS, because the output that cannot be re-flowed later
; is the PDF. The screen scales; the page does not.
; ============================================================================

Import "MdNode.rgr"
Import "MdStyle.rgr"
Import "MdChar.rgr"
Import "MdEmbed.rgr"
Import "MdEmbedKinds.rgr"
Import "../../vfs/src/Vfs.rgr"
Import "MdCodeHighlight.rgr"
Import "MdCodeLines.rgr"
Import "MdFrontMatter.rgr"
Import "MdCss.rgr"
Import "MdGallery.rgr"
Import "MdBook.rgr"
Import "MdCssLimits.rgr"
Import "pkg:evg/EVGTextEngine.rgr"
Import "../../math/src/MathLayout.rgr"
Import "MdHtml.rgr"
Import "MdHtmlMd.rgr"
Import "MdSvg.rgr"
Import "MdUrl.rgr"
Import "MdBlock.rgr"
Import "MdTableSplit.rgr"
Import "MdContainer.rgr"
Import "MdColumns.rgr"
Import "MdSlideLayout.rgr"
Import "MdCellTones.rgr"

; ----------------------------------------------------------------------------
; What the document looks like. Not a stylesheet yet — the values a stylesheet
; will set, in one place, so the layout never has a number written into it.
; ----------------------------------------------------------------------------
class MdRun {
    def text:string ""
    def family:string ""
    def size:double 11.0
    def bold:boolean false
    def italic:boolean false
    def color:string "#1f2328"
    ; inline code gets a tinted box behind it
    def code:boolean false
    ; a link's destination, kept so the viewer can hit-test it later
    def link:string ""
    ; a forced break — two spaces at the end of a line, or a backslash
    def hardBreak:boolean false
    ; Where this run's text came from, in the document — the span of the
    ; inline node it was made from. -1 when the node had none to give.
    ;
    ; It is carried rather than looked up because the run is where the text
    ; and the source stop being the same length: `&amp;` is one character of
    ; run text and five of source, so an offset INSIDE a run is exact only
    ; where the run is verbatim, and `srcEnd` is what stops an inexact one
    ; running off the end of the node it belongs to.
    def srcStart:int -1
    def srcEnd:int -1
    ; The run stands for its whole span rather than spelling it — `©` for
    ; `(c)`, 😉 for `:wink:` (`MdNode.subst`). Its offsets are the two ends
    ; of the span and nothing between. Not a style, so not copied.
    def atom:boolean false
    ; TeX math (`$…$`): the run is one unbreakable formula, its text a
    ; placeholder character, and `math` the source it is set from.
    def math:string ""
    def mathDisplay:boolean false
    ; What inline HTML (and ~~ ~~) asks of a run beyond its face: a line under
    ; or through it, a highlight or key cap behind it, and a shift off the
    ; baseline for <sub> / <sup> (-1 / +1) measured against `shiftOf`, the
    ; size of the text it sits in.
    def underline:boolean false
    def strike:boolean false
    ; drawn muted on purpose: the stand-in for a picture with no bytes
    def quiet:boolean false
    def mark:boolean false
    def kbd:boolean false
    def shift:int 0
    def shiftOf:double 0.0
    ; `letter-spacing`, in points: added after every character
    def spacing:double 0.0
    ; a colour behind the text (`<span style="background-color">`), "" none
    def fill:string ""
    ; A footnote reference: the number it draws. Not part of the style, so
    ; not copied with it.
    def noteRef:int 0

    Constructor () {
    }

    ; The source span is NOT copied: a style is inherited by a child run and
    ; a position is not. Copying it is how `*a* b` would have had both runs
    ; claiming the same character.
    fn copyStyle:MdRun () {
        def r:MdRun (new MdRun())
        r.family = family
        r.size = size
        r.bold = bold
        r.italic = italic
        r.color = color
        r.code = code
        r.link = link
        r.underline = underline
        r.strike = strike
        r.quiet = quiet
        r.mark = mark
        r.kbd = kbd
        r.shift = shift
        r.shiftOf = shiftOf
        r.spacing = spacing
        r.fill = fill
        return r
    }
}

; A run, placed.
class MdSeg {
    def text:string ""
    def family:string ""
    def size:double 11.0
    def bold:boolean false
    def italic:boolean false
    def color:string "#1f2328"
    def code:boolean false
    def link:string ""
    def x:double 0.0
    def w:double 0.0
    ; Where this placed piece of text starts in the document, and how much of
    ; the document it covers. This is the finest thing the layout knows, and
    ; it is what a click turns into a caret.
    def srcStart:int -1
    def srcLen:int 0
    ; from an atom run: the text covers srcLen characters as one
    def atom:boolean false
    def math:string ""
    def mathDisplay:boolean false
    def underline:boolean false
    def strike:boolean false
    ; drawn muted on purpose: the stand-in for a picture with no bytes
    def quiet:boolean false
    def mark:boolean false
    def kbd:boolean false
    def shift:int 0
    def shiftOf:double 0.0
    def fill:string ""
    def noteRef:int 0
    def spacing:double 0.0

    Constructor () {
    }
}

class MdLine {
    def segs:[MdSeg]
    def width:double 0.0
    def height:double 0.0
    def ascent:double 0.0
    ; Room made above the text for a formula that rises past the line: the
    ; text moves down by this much and the line is that much taller.
    def extraTop:double 0.0

    Constructor () {
    }
}

; A picture in a header or footer place, as the byte store has it.
class MdSlotPic {
    def path:string ""
    def w:double 0.0
    def h:double 0.0
    def natW:int 0
    def natH:int 0

    Constructor () {
    }
}

; One thing to draw. The layout produces a flat list of these and the EVG
; bridge turns each into an element; nothing above this file knows about
; markdown and nothing below it knows about layout.
class MdBox {
    ; 0 text, 1 filled rectangle, 2 rectangle outline, 3 an embed's slot,
    ; 4 a picture, 5 a TeX formula: `embedSource` its source, `embedKind`
    ; "math" or "math-display", `size` the pixels per em it is set at
    def kind:int 0
    def x:double 0.0
    def y:double 0.0
    def w:double 0.0
    def h:double 0.0
    def text:string ""
    def family:string "Open Sans"
    def size:double 11.0
    def bold:boolean false
    ; `letter-spacing` in points, after every character
    def spacing:double 0.0
    def italic:boolean false
    def color:string "#1f2328"
    def fill:string ""
    def stroke:string ""
    def strokeWidth:double 0.0
    def link:string ""
    ; the source of an embed, for whoever can draw it
    def embedKind:string ""
    def embedSource:string ""
    ; why an embed is not drawn (a box with the reason written in it), ""
    ; when it is drawn
    def embedNote:string ""
    ; A PICTURE (kind 4): where its bytes are in the byte store, and how big
    ; they are in their own pixels. The layout names the picture and does not
    ; carry it, exactly as a display list does — whoever draws it asks the
    ; same `Vfs` the layout asked.
    def imagePath:string ""
    def imageAlt:string ""
    def imageNaturalW:int 0
    def imageNaturalH:int 0
    def page:int 0
    ; The character this box's block began at, in the source text. Stamped by
    ; the layout, not by the author: it is what lets a click on a drawing find
    ; a caret in the text a reader typed.
    def srcStart:int -1
    ; …and the character THIS BOX begins at, which is a different question.
    ; `srcStart` names the block, so every box of a paragraph carries the same
    ; one and a click could name the paragraph and nothing smaller. `segSrc`
    ; is the placed run's own start, so a click inside the box can be turned
    ; into an offset by measuring across it.
    def segSrc:int -1
    def segLen:int 0
    ; The box's text stands for all of segSrc..segSrc+segLen at once (a
    ; typographic replacement, an emoji): a caret is at one end of it or the
    ; other, never at a character inside.
    def segAtom:boolean false
    ; the slide's title said again on a continuation (`emitSlideTitle`):
    ; laid out while a block was, but not part of it, so the plate around
    ; a box and the extent text floats beside leave it out
    def retold:boolean false
    ; 1 a header's, 2 a footer's: page furniture, not the document's text;
    ; 3 the footnotes at the foot of a page, which ARE the document's text
    ; but are placed by the page rather than where they were written
    def furniture:int 0
    ; text struck through (`~~…~~`, `<s>`, `<del>`): drawn muted on purpose,
    ; so a contrast check leaves it alone
    def strike:boolean false
    ; drawn muted on purpose for another reason: the "[alt]" standing in for
    ; a picture the layout has no bytes for (the missing picture is the
    ; thing to report, not its stand-in's contrast), and a code block's
    ; line numbers in the gutter (`.numbers`), dim beside the code they count
    def quiet:boolean false
    ; a line set centred or to the right ("center" / "right"; "" at the
    ; left) in the column alignX..alignX+alignW, so an export can say so
    ; instead of placing the text where this layout happened to put it
    def align:string ""
    def alignX:double 0.0
    def alignW:double 0.0
    ; a code block's highlight that a build step reveals (`lines=3-5|8`
    ; with `{.build}`): the step among the block's own, 0 = with the block
    def buildStep:int 0
    ; A PICTURE shown in part (a gallery's `fit=cover`): the part of its
    ; pixels, 0..1, that fills the box. A RECTANGLE's or a picture's corner
    ; radius (`cell { border-radius }`).
    def hasCrop:boolean false
    def cropX:double 0.0
    def cropY:double 0.0
    def cropW:double 1.0
    def cropH:double 1.0
    def radius:double 0.0
    ; drawn past the page's edge on purpose, into the print bleed: a
    ; full-page picture, its background, an overlay band at the page's foot
    def bleeds:boolean false
    ; a `{container=bubble}` plate's tail: how far it hangs below the
    ; bottom edge, near the left
    def tail:double 0.0
    ; a footnote reference's number drawn here (the superscript), 0 for none.
    ; The footnotes themselves are drawn as page furniture (`furniture` 3).
    def noteRef:int 0
    ; set in a corner of the slide (`{float=top-right}`), out of the flow:
    ; a slide's content centred later does not move it
    def pinned:boolean false
    ; a text box: the right edge of the column it was set in (0: not known)
    def colRight:double 0.0

    Constructor () {
    }

    fn copy:MdBox () {
        def b:MdBox (new MdBox())
        b.kind = kind
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.text = text
        b.family = family
        b.size = size
        b.bold = bold
        b.italic = italic
        b.color = color
        b.fill = fill
        b.stroke = stroke
        b.strokeWidth = strokeWidth
        b.link = link
        b.embedKind = embedKind
        b.embedSource = embedSource
        b.imagePath = imagePath
        b.imageAlt = imageAlt
        b.imageNaturalW = imageNaturalW
        b.imageNaturalH = imageNaturalH
        b.page = page
        b.srcStart = srcStart
        b.segSrc = segSrc
        b.segLen = segLen
        b.segAtom = segAtom
        b.retold = retold
        b.furniture = furniture
        b.strike = strike
        b.quiet = quiet
        b.align = align
        b.alignX = alignX
        b.alignW = alignW
        b.buildStep = buildStep
        b.hasCrop = hasCrop
        b.cropX = cropX
        b.cropY = cropY
        b.cropW = cropW
        b.cropH = cropH
        b.radius = radius
        b.bleeds = bleeds
        b.tail = tail
        b.noteRef = noteRef
        b.pinned = pinned
        b.colRight = colRight
        return b
    }

    sfn text:MdBox (t:string x:double y:double w:double h:double) {
        def b:MdBox (new MdBox())
        b.kind = 0
        b.text = t
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        return b
    }

    sfn rect:MdBox (x:double y:double w:double h:double fill:string) {
        def b:MdBox (new MdBox())
        b.kind = 1
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.fill = fill
        return b
    }

    sfn outline:MdBox (x:double y:double w:double h:double stroke:string width:double) {
        def b:MdBox (new MdBox())
        b.kind = 2
        b.x = x
        b.y = y
        b.w = w
        b.h = h
        b.stroke = stroke
        b.strokeWidth = width
        return b
    }
}

class MdLayout {
    def style:MdStyle (new MdStyle())
    ; Built once per layout by `buildBoxIndex`: the first box of each block,
    ; by that block's source offset.
    def boxIndexAt:[string:int]
    def boxIndexReady:boolean false
    ; Built on the first `boxesOnPage` after a layout: the boxes' indexes in
    ; page order (box order within a page), and where each page's run starts
    ; in it. A host that asks for every page's boxes then walks each box
    ; once, not once per page (seconds for a 200-slide deck). A host that
    ; moves a box to another page after the layout calls `forgetPages`.
    def pageOrder:[int]
    def pageFrom:[int]
    def pageIndexReady:boolean false
    def pageIndexBoxes:int -1

    ; --- the per-block layout cache -------------------------------------------
    ;
    ; A keystroke changes ONE block and the other four hundred are laid out
    ; again for nothing. `markdown:bench` puts this repository's README at
    ; 22.7 ms to parse and 117.5 ms to lay out, so the parse is not the
    ; problem: measuring text is. The parse stays whole — it is cheap, and an
    ; incremental block parser is a second parser to keep in step with the
    ; first — and the LAYOUT is what remembers.
    ;
    ; A block's boxes are kept under the exact source text that produced them.
    ; An edit changes that text for one block and no other, so every other
    ; block hits, and a hit is an array copy with two numbers added to it: the
    ; y it now sits at, and how far its source moved.
    ;
    ; WHAT IT DOES NOT DO, stated rather than discovered:
    ;   * paged layout. A block's boxes there depend on where the page break
    ;     falls, which is not a property of the block. `armCache` refuses.
    ;   * documents with a table of contents. That is a two-pass layout whose
    ;     first pass exists to move the second, and a cache would serve the
    ;     first pass's answers to the second.
    ;   * anything below a top-level block. A list is one entry, not one per
    ;     item: the win is in the hundreds of blocks a long document has, and
    ;     the bookkeeping for nesting buys nothing on top of that.
    def cacheOn:boolean false
    def cacheKey:[string]
    ; …and the same keys as a map. A scan over the keys is O(blocks) per
    ; block, which is O(blocks²) per layout: fine for the thirteen a fixture
    ; has and 1.1 million string compares for the thousand in ISSUES.md,
    ; where it cost more than the layout it was saving.
    def cacheAt:[string:int]
    def cacheSrc:[int]
    def cacheTop:[double]
    def cacheHeight:[double]
    def cacheFrom:[int]
    def cacheCount:[int]
    def cacheBoxes:[MdBox]
    def cacheHits:int 0
    def cacheMisses:int 0
    ; Lay every block out BOTH ways and compare. A cache that disagrees with
    ; the layout it is caching shows a stale picture, which is the worst thing
    ; this feature can do and the one failure a screenshot cannot catch — so
    ; there is a mode that checks rather than trusts, and the edit suite runs
    ; with it on.
    def cacheAudit:boolean false
    def cacheFaults:int 0
    ; How many blocks the audit actually compared. Without it a suite that
    ; never reached the cache at all reports a clean audit, which is the
    ; §6 trap: a check that counts the wrong noun says the failure is fine.
    def cacheAudited:int 0
    def cacheFirstFault:string ""
    ; The text the tree was parsed from. The cache keys off each block's slice
    ; of it, so the layout has to be told: a tree does not carry the string it
    ; came from, only the offsets into it.
    def docSource:string ""
    ; The width every cached entry was measured at. A different one makes all
    ; of them wrong, and the cheap total answer is to throw the lot away.
    def cacheWidth:double (0.0 - 1.0)
    ; …and the style the cached boxes were measured with. A block's boxes are
    ; a function of its source AND of the style, and only the first was ever
    ; in the key — so switching the company template replayed boxes measured
    ; at the previous font size and drew the new one on top of them.
    def cacheStyleKey:string ""
    ; …and how the document was READ: the typographer, the quotes its
    ; language takes, the abbreviations it defines. Those are document-wide —
    ; `*[HTML]: …` at the end turns every earlier "HTML" into an abbr, and
    ; `lang: fi` changes every quote — so a block's source alone does not
    ; say what its inlines are (`MdNode.readingSig`).
    def cacheReading:string ""

    ; ----------------------------------------------------------------------
    ; The company template
    ; ----------------------------------------------------------------------
    ;
    ; Two questions, and they are different. `MdCss.applyTo(style)` answered
    ; the first one — how is the DOCUMENT set — before this layout began, and
    ; the answer is in `style` above. This is the second: what does the sheet
    ; say about THIS BLOCK, given its `{.classes}` and its `{#id}`.
    ;
    ; Only the layout can ask it, because only the layout is walking the
    ; blocks. It is asked once per block and the answer is thrown away, which
    ; is why the sheet is held here rather than resolved into the tree: the
    ; AST says what the document IS and must not learn what it looks like.
    def sheet:MdCss (new MdCss())
    def sheetText:string ""

    ; ----------------------------------------------------------------------
    ; Slides
    ; ----------------------------------------------------------------------
    ;
    ; A slide is a page with rules about where it breaks. `PLAN_SLIDES.md` §4,
    ; in this order, and the order is the whole design:
    ;
    ;   1  MANDATORY   `{.slide}`, or a heading at or above `splitLevel`
    ;   2  FORBIDDEN   `{.no-break}`
    ;   3  PREFERRED   any other heading, when the section it opens does not
    ;                  fit in the room left and does fit on a slide of its own
    ;   4  FALLBACK    overflow — which is what pagination already does
    ;
    ; …and one constraint that is not a break rule and is the thing that makes
    ; an automatic deck look hand-made: KEEP-WITH-NEXT, a heading is never the
    ; last thing on a slide.
    ;
    ; A slide that breaks goes on on a CONTINUATION, which says the slide's
    ; title again at its top — always, whatever it begins with — and, when it
    ; begins inside a section, that section's sub-heading under the title
    ; (`emitSlideTitle`).
    def slides:boolean false
    ; `#` only, at 1. `2` means `#` and `##` each start a slide.
    def splitLevel:int 1
    ; "split" | "shrink" | "clip" — what a slide too full of one block does.
    ; Only `split` is honoured; the other two are carried and reported, which
    ; is the rule the rest of the template binding is written to.
    def slideOverflow:string "split"
    ; How many times a BLOCK had to be cut across two slides. Printed rather
    ; than hidden: `book_slides.rgr` set that precedent, and a deck that
    ; silently drops the third bullet is worse than one that says it did.
    def slideOverflows:int 0
    ; Sheets whose heading said `{header=off}`, `{footer=off}` or
    ; `{furniture=off}`: the edge is left off that sheet.
    def headerOff:[int]
    def footerOff:[int]
    ; GROW: a slide with room to spare is laid out again with everything on
    ; it larger — text, headings, spacing, together, so the title stays the
    ; larger thing — by at most this factor (1.0 = off). A deck has no font
    ; size of its own to ask for; a slide of three bullets at the document's
    ; body size is a slide nobody at the back can read. It never shrinks and
    ; never makes a slide spill: when the larger version does not fit, the
    ; slide stays as it was. Slides with a picture or an embed are left
    ; alone, since those were sized for the room they had.
    def slideGrow:double 1.0
    ; `mode: book` and the page margins of the front matter (MdBook): a
    ; book's right-hand pages are laid out with the inside margin on the left
    def book:MdBook (new MdBook())
    ; How full a grown slide may get, of the room under the margins.
    def slideGrowFill:double 0.82
    ; a grown slide being tried: a chart asks for no other room meanwhile
    def growTrial:boolean false
    ; Per top-level block: the slide it starts on and the one it ends on.
    def blockFirstPage:[int]
    def blockLastPage:[int]
    ; How many slides were grown, and by how much the last one was.
    def slidesGrown:int 0
    ; slides set a little smaller so that a short spill fits (see shrinkSlide)
    def slidesShrunk:int 0
    ; The title of the slide being laid out, repeated at the top of a
    ; continuation slide so a reader knows what they are still looking at.
    def slideTitle:string ""
    def slideTitleLevel:int 0
    ; `{heading=hidden}` on the slide's title: it names the slide and is
    ; not drawn, here or on a continuation slide
    def slideTitleHidden:boolean false
    ; The SECTION the layout is in: the last sub-heading (deeper than
    ; `splitLevel`) under the slide's title, until the next heading. A slide
    ; a block spills onto from inside a section says that heading again
    ; under the title — the reader of the second half of "Footnotes" is
    ; told it is "Footnotes", not only "Plugins". Empty between a title and
    ; its first sub-heading, and while a heading is itself being laid out,
    ; so a continuation that begins WITH a sub-heading has the title alone
    ; over it rather than the previous section's heading.
    def sectionTitle:string ""
    def sectionLevel:int 0
    def sectionHidden:boolean false
    ; What each continuation slide said again at its top, by slide: a slide
    ; laid out again to shrink or grow it (`shrinkSlide`, `growSlide`) says
    ; it again at the new size instead of losing it. Hidden ones are "".
    def contPage:[int]
    def contTitle:[string]
    def contTitleLevel:[int]
    def contSection:[string]
    def contSectionLevel:[int]
    ; HIDDEN HEADINGS (`## Kesä {heading=hidden}`): the page each one names
    ; and where it is in the source. They draw no box, so a host that finds
    ; a block's slide by its boxes asks these (`pageOfHidden`).
    def hiddenSrc:[int]
    def hiddenPage:[int]
    ; pages named without a heading (fullPageName)
    def namedPage:[int]
    def namedText:[string]
    ; the page a hidden heading opened, so a second heading straight after
    ; it still starts a slide of its own
    def hiddenOnPage:int -1
    ; OVERLAY PICTURES: files the host draws over the page itself (a drawing
    ; made on a slide), referenced as a picture is (`![](drawings/a.ink)`)
    ; so that deleting the line deletes the drawing. A picture whose file's
    ; content type is in `overlayTypes` (the host says which) takes no room
    ; and draws nothing here; the page it is on and where it is written are
    ; noted (`overlaySrc`, `overlayPage`, `overlayPath`, one per reference)
    ; for the host to draw it.
    def overlayTypes:[string]
    def overlaySrc:[int]
    def overlayPage:[int]
    def overlayPath:[string]
    ; a `layout=full` gallery's last picture took its whole slide
    def fullPageDone:boolean false
    ; the medium the sheet is read for ("screen" | "print", see
    ; `MdCss.media`); set before `setStyleSheet`
    def media:string "screen"
    def engine:EVGTextEngine (new EVGTextEngine())
    def boxes:[MdBox]

    ; the cursor
    def cursorY:double 0.0
    def page:int 0
    def pageCount:int 1

    ; How many block quotes deep the walk is, which is what `baseRun` reads to
    ; decide the colour of ordinary text.
    def quoteDepth:int 0

    ; Inside an item of a TIGHT list, where a paragraph is not a paragraph.
    def inTightItem:boolean false
    ; How many lists deep. Only the outermost one is separated from what
    ; follows it — a nested list is followed by its parent's next item, not by
    ; a new block.
    def listDepth:int 0

    ; the column being filled
    def contentX:double 0.0
    def contentW:double 0.0
    def contentTop:double 0.0
    def contentBottom:double 0.0

    ; 0 means one page as tall as the document — the screen's mode.
    def paginate:boolean false

    ; What a handler prepared for the fenced diagrams in this document. Empty
    ; unless somebody filled it: the layout can lay a document out without
    ; one, and leaves a labelled slot where a diagram would have gone.
    def embeds:MdEmbedCache (new MdEmbedCache())
    ; left, center or right: the alignment an HTML wrapper asked of the
    ; paragraphs and headings inside it ("" is the default, left)
    def align:string ""
    def alignStack:[string]
    ; formulas, laid out once per source (see `mathBox`)
    def mathBoxes:[string:MathBox]
    ; Where a picture's bytes come from, and which folder the document is in.
    ;
    ; Empty by default and that is the honest default: `![alt](src)` draws as
    ; its ALT TEXT when nobody has the bytes, which is the most truthful thing
    ; to draw, and is what this did for every document before there was a byte
    ; store at all.
    def images:Vfs (new Vfs())
    def haveImages:boolean false
    def docDir:string "/"
    ; Pictures the document names and this layout could not find. Counted
    ; rather than hidden, like every other cost in this file.
    def missingImages:int 0
    ; HTML the document has that is not drawn as written: a tag nobody
    ; draws, a style property nothing reads, a script handler, a link that
    ; would run script. Each said once, with where in the source it was
    ; first met, for a report to name (the MCP server's warnings).
    def htmlNotes:[string]
    def htmlNoteSrc:[int]

    ; The height the document turned out to be, in continuous mode.
    def documentHeight:double 0.0

    ; The block being laid out, so every box it emits can say where in the
    ; source it came from.
    def currentSrc:int -1

    ; The headings this document has, and the page each landed on. Collected
    ; while laying out; used by the table of contents on the pass after.
    def headText:[string]
    def headLevel:[int]
    def headPage:[int]
    def headY:[double]
    ; What a previous pass learned, so the table of contents can print page
    ; numbers that are right. All three, not just the pages: on the second
    ; pass the live tables above are still being filled in AS the contents
    ; print, so reading them there lists whatever has been seen so far —
    ; which is one heading.
    def knownPages:[int]
    def knownText:[string]
    def knownLevel:[int]
    def tocLines:int 0

    Constructor () {
    }

    fn setMeasurer:void (m:EVGTextMeasurer) {
        engine.setMeasurer(m)
        ; Everything cached was measured through the old one.
        this.dropCache()
    }

    ; ----------------------------------------------------------------------
    ; Entry points
    ; ----------------------------------------------------------------------

    ; Front matter into the look of the page. Called before either layout;
    ; a document with no front matter is unchanged by it.
    fn applyMeta:void (doc:MdNode) {
        def meta:MdMeta (MdFrontMatter.of(doc))
        if ((meta.count()) == 0) { return }
        def page:string (meta.get("page" ""))
        def plen:int (strlen page)
        if (plen > 0) {
            def pw:double style.pageWidth
            def ph:double style.pageHeight
            style.pageWidth = (MdFrontMatter.pageW(page pw ph))
            style.pageHeight = (MdFrontMatter.pageH(page ph pw))
        }
        def margin:string (meta.get("margin" ""))
        def mlen:int (strlen margin)
        if (mlen > 0) {
            style.margin = (MdFrontMatter.points(margin style.margin))
        }
        style.title = (meta.get("title" ""))
        style.runningHead = (MdChar.lower((meta.get("runninghead" ""))))
        style.pageNumbers = (MdChar.lower((meta.get("pagenumbers" ""))))
        ; the master's header and footer: `header: ACME Oy`, `footer: {page} /
        ; {pages}`, `header-image: media/logo.png`, `header-align: right`
        if (meta.has("header")) { style.headerText = (meta.get("header" "")) }
        if (meta.has("footer")) { style.footerText = (meta.get("footer" "")) }
        if (meta.has("header-image")) { style.headerImage = (meta.get("header-image" "")) }
        if (meta.has("footer-image")) { style.footerImage = (meta.get("footer-image" "")) }
        if (meta.has("header-align")) { style.headerAlign = (MdCss.alignWord((meta.get("header-align" "")))) }
        if (meta.has("footer-align")) { style.footerAlign = (MdCss.alignWord((meta.get("footer-align" "")))) }
        ; three places on each edge, and how the edge is set
        if (meta.has("header-left")) { style.headerLeft = (meta.get("header-left" "")) }
        if (meta.has("header-center")) { style.headerCenter = (meta.get("header-center" "")) }
        if (meta.has("header-right")) { style.headerRight = (meta.get("header-right" "")) }
        if (meta.has("footer-left")) { style.footerLeft = (meta.get("footer-left" "")) }
        if (meta.has("footer-center")) { style.footerCenter = (meta.get("footer-center" "")) }
        if (meta.has("footer-right")) { style.footerRight = (meta.get("footer-right" "")) }
        if (meta.has("header-color")) { style.headerColor = (meta.get("header-color" "")) }
        if (meta.has("footer-color")) { style.footerColor = (meta.get("footer-color" "")) }
        if (meta.has("header-background")) { style.headerBackground = (meta.get("header-background" "")) }
        if (meta.has("footer-background")) { style.footerBackground = (meta.get("footer-background" "")) }
        if (meta.has("header-size")) { style.headerSize = (MdFrontMatter.points((meta.get("header-size" "")) style.headerSize)) }
        if (meta.has("footer-size")) { style.footerSize = (MdFrontMatter.points((meta.get("footer-size" "")) style.footerSize)) }
        if (meta.has("header-image-height")) { style.headerImageH = (MdFrontMatter.points((meta.get("header-image-height" "")) style.headerImageH)) }
        if (meta.has("footer-image-height")) { style.footerImageH = (MdFrontMatter.points((meta.get("footer-image-height" "")) style.footerImageH)) }
        if (meta.has("header-skip")) { style.headerSkip = (MdChar.lower((meta.get("header-skip" "")))) }
        if (meta.has("footer-skip")) { style.footerSkip = (MdChar.lower((meta.get("footer-skip" "")))) }
        style.wantToc = (meta.flag("toc" false))
        style.breakOnH1 = (meta.flag("breakonh1" false))
        if (meta.has("highlight")) {
            style.highlightCode = (meta.flag("highlight" true))
        }
    }

    ; One page, as tall as it needs to be. What the canvas scrolls.
    ; The template, as text. Parsed once here rather than on every layout.
    ; The DOCUMENT-level properties are applied by the caller, before this —
    ; see `MarkdownEdit.ensureLayout` for the order and why it is that order.
    ; Where pictures come from. Handed the store and the folder the document
    ; lives in, because `![](logo.png)` means "beside this document".
    fn setImages:void (v:Vfs dir:string) {
        images = v
        docDir = dir
        haveImages = true
        this.disarmCache()
    }

    fn setStyleSheet:void (css:string) {
        sheetText = css
        sheet = (new MdCss())
        sheet.media = media
        sheet.addStyleSheet(css)
        ; the same sheet says which lists are figures (`list-style: swot`)
        embeds.listSheet = sheet
        this.dropCache()
    }

    ; What the sheet says about one block. Empty when there is no sheet,
    ; which is the common case and costs one selector match. Under a slide
    ; or section, as being under it (`#intro .lead`).
    fn styleOf:CssComputed (node:MdNode) {
        return (sheet.resolveIn(node scopeCtx))
    }

    ; …what its own classes and id say (`MdCss.resolveOwn`): the box it is on
    fn ownStyleOf:CssComputed (node:MdNode) {
        return (sheet.resolveOwn(node scopeCtx))
    }

    ; ----------------------------------------------------------------------
    ; A slide's own rules
    ; ----------------------------------------------------------------------

    ; At the start of a layout: no heading yet, and the style's look as the
    ; sheet and the front matter left it, to come back to.
    fn startScopes:void () {
        def none:[MdNode]
        scopeHeads = none
        def noCtx@(optional):CssNode
        scopeCtx = noCtx
        clear paperFrom
        clear paperColour
        clear paperPicture
        paperPending = false
        scoped = sheet.hasScoped
        if scoped {
            baseLook = (style.look())
        }
    }

    ; …and at its end, the look put back: a host reads the style after a
    ; layout and must not find the last slide's colours in it.
    fn endScopes:void () {
        if scoped {
            style.setLook(baseLook)
        }
    }

    ; A heading of the document begins: the blocks after it are under it
    ; (and under the ones above it of a lower level).
    fn enterHeading:void (h:MdNode) {
        if ((h.level < 1) || (h.level > 6)) {
            return
        }
        while ((array_length scopeHeads) < 7) {
            push scopeHeads (new MdNode())
        }
        set_at scopeHeads h.level h
        def d:int (h.level + 1)
        while (d <= 6) {
            set_at scopeHeads d (new MdNode())
            d = (d + 1)
        }
        this.enterScope()
    }

    ; The headings block `i` of `doc` is under, found by walking back: for a
    ; block laid out again on its own (a slide shrunk to fit).
    fn scopeAtBlock:void (doc:MdNode i:int) {
        def heads:[MdNode]
        while ((array_length heads) < 7) {
            push heads (new MdNode())
        }
        def limit:int 7
        def j:int i
        while ((j >= 0) && (limit > 1)) {
            def c:MdNode (doc.childAt(j))
            if ((c.kind == "heading") && (c.level < limit)) {
                set_at heads c.level c
                limit = c.level
            }
            j = (j - 1)
        }
        scopeHeads = heads
        this.enterScope()
    }

    fn enterScope:void () {
        scopeCtx = (MdCss.scopeOf(scopeHeads))
        if (scoped == false) {
            return
        }
        style.setLook(baseLook)
        sheet.applyLook(style scopeCtx)
        ; the page's own colour from here on, when it is not the sheet's
        def n:int (array_length paperFrom)
        def last:string (style.pageBackground + "|" + style.pageBackgroundImage)
        def was:string ""
        if (n > 0) {
            was = ((itemAt paperColour (n - 1)) + "|" + (itemAt paperPicture (n - 1)))
        } {
            was = ((itemAt baseLook 22) + "|" + (itemAt baseLook 23))
        }
        if (last != was) {
            if (paperPending && (n > 0)) {
                set_at paperColour (n - 1) style.pageBackground
                set_at paperPicture (n - 1) style.pageBackgroundImage
            } {
                push paperFrom page
                push paperColour style.pageBackground
                push paperPicture style.pageBackgroundImage
            }
            paperPending = true
        }
    }

    ; The heading that began a scope is on page `p`: so is the scope's
    ; colour, from there on.
    fn settlePaper:void (p:int) {
        if (paperPending == false) {
            return
        }
        paperPending = false
        def n:int (array_length paperFrom)
        if (n == 0) {
            return
        }
        set_at paperFrom (n - 1) p
        ; one before it on the same page is overruled by it
        if ((n > 1) && ((itemAt paperFrom (n - 2)) == p)) {
            def keepC:string (itemAt paperColour (n - 1))
            def keepP:string (itemAt paperPicture (n - 1))
            remove_index paperFrom (n - 1)
            remove_index paperColour (n - 1)
            remove_index paperPicture (n - 1)
            set_at paperColour (n - 2) keepC
            set_at paperPicture (n - 2) keepP
        }
    }

    ; The colour of page `p`: the sheet's, or the one a slide's own rules
    ; gave it (`.dark page { background-color }`).
    fn paperOf:string (p:int) {
        def out:string style.pageBackground
        def i:int 0
        while (i < (array_length paperFrom)) {
            if ((itemAt paperFrom i) <= p) {
                out = (itemAt paperColour i)
            }
            i = (i + 1)
        }
        return out
    }

    ; …and its picture
    fn pictureOf:string (p:int) {
        def out:string style.pageBackgroundImage
        def i:int 0
        while (i < (array_length paperFrom)) {
            if ((itemAt paperFrom i) <= p) {
                out = (itemAt paperPicture i)
            }
            i = (i + 1)
        }
        return out
    }

    ; Boxes measured with another style are boxes of another document — and
    ; the sheet is part of the style, because a `{.c3}` a sheet gives three
    ; columns to is different boxes from the same list under a sheet that
    ; does not.
    fn checkStyle:void () {
        ; Every number the sheet, the front matter and the reader gave, into
        ; its safety range: this is the one place they have all arrived by,
        ; and the last before anything is measured (`MdCssLimits`).
        MdCssLimits.clampStyle(style)
        def key:string ((style.fingerprint()) + sheetText)
        if (key != cacheStyleKey) {
            this.dropCache()
            cacheStyleKey = key
        }
    }

    fn layoutContinuous:void (doc:MdNode width:double) {
        if ((fabs (width - cacheWidth)) > 0.01) {
            this.dropCache()
            cacheWidth = width
        }
        this.checkStyle()
        clear boxes
        clear htmlNotes
        clear htmlNoteSrc
        boxIndexReady = false
        pageIndexReady = false
        this.resetHeadings()
        this.startScopes()
        paginate = false
        page = 0
        pageCount = 1
        contentX = style.margin
        contentW = (width - (style.margin * 2.0))
        contentTop = style.margin
        contentBottom = 0.0
        cursorY = contentTop
        this.startNotes(doc)
        this.layoutBody(doc)
        this.placeNotesAtEnd()
        this.endScopes()
        documentHeight = (cursorY + style.margin)
    }

    ; The same sheets, with the breaks a DECK wants rather than the ones a
    ; document wants. Everything below `bodyPass` is `layoutPaged`'s; what is
    ; different is `slideBreakBefore`, which is asked between blocks.
    fn layoutSlides:void (doc:MdNode) {
        slides = true
        slideOverflows = 0
        slideTitle = ""
        slideTitleLevel = 0
        this.clearSection()
        clear contPage
        clear contTitle
        clear contTitleLevel
        clear contSection
        clear contSectionLevel
        this.layoutPaged(doc)
        slides = false
    }

    ; What the document and the template said about where a slide starts. The
    ; document wins, because it is closer to the deck than the company is.
    fn applySlideMeta:void (doc:MdNode) {
        if ((sheet.splitLevel) > 0) { splitLevel = sheet.splitLevel }
        if ((strlen sheet.overflow) > 0) { slideOverflow = sheet.overflow }
        def meta:MdMeta (MdFrontMatter.of(doc))
        book = (MdBook.of(meta))
        if (meta.has("slide-split-level")) {
            def n@(optional):int (str2int (trim (meta.get("slide-split-level" "1"))))
            def lvl:int (?? n 1)
            if (lvl > 0) { splitLevel = lvl }
        }
        ; `valign: center` / `bottom`: every slide's content under its title
        ; (MdSlideLayout), unless the slide says otherwise
        if (meta.has("valign")) {
            deckPlace = (MdSlideLayout.valignOf((meta.get("valign" ""))))
        }
        if (meta.has("slide-overflow")) {
            slideOverflow = (MdChar.lower((trim (meta.get("slide-overflow" "split")))))
        }
        ; `slide-grow: 1.5` lets a slide with room grow by up to half again;
        ; `slide-grow: off` keeps every slide at the document's sizes
        if (meta.has("slide-grow")) {
            def g:string (MdChar.lower((trim (meta.get("slide-grow" "")))))
            if ((g == "off") || (g == "none")) {
                slideGrow = 1.0
            } {
                def gv@(optional):double (str2double g)
                def gd:double (?? gv 1.0)
                if (gd >= 1.0) { slideGrow = gd }
            }
        }
    }

    ; Sheets of a stated size, with the breaks decided here. What is printed.
    fn layoutPaged:void (doc:MdNode) {
        this.checkStyle()
        this.disarmCache()
        clear boxes
        clear htmlNotes
        clear htmlNoteSrc
        boxIndexReady = false
        pageIndexReady = false
        this.resetHeadings()
        this.startScopes()
        paginate = true
        page = 0
        pageCount = 1
        contentX = style.margin
        contentW = (style.pageWidth - (style.margin * 2.0))
        contentTop = style.margin
        contentBottom = (style.pageHeight - style.margin)
        if slides {
            this.applyBookMargins()
        }
        clear headerOff
        clear footerOff
        this.makeEdgeRoom()
        cursorY = contentTop
        clear blockFirstPage
        clear blockLastPage
        clear placeSrc
        clear placeWord
        slideCenter = false
        slideStatement = false
        slidesGrown = 0
        slidesShrunk = 0
        slideTitleOnly = false
        clear spillExcess
        this.startNotes(doc)
        this.layoutBody(doc)
        slideTitleOnly = false
        if (slides && (tocLines == 0)) {
            this.shrinkSlides(doc)
        }
        if ((slides && (slideGrow > 1.01)) && (tocLines == 0)) {
            this.growSlides(doc)
        }
        if slides {
            this.alignSlides()
        }
        slideCenter = false
        slideStatement = false
        this.placeNotesPaged()
        this.endScopes()
        this.emitFurniture()
        if slides {
            this.mirrorBook()
        }
        documentHeight = style.pageHeight
    }

    ; The front matter's margins (MdBook), each edge over the page's own.
    ; Every page of a book is laid out as a LEFT-hand page — the outside
    ; margin on the left — and `mirrorBook` moves the right-hand pages over
    ; afterwards. The text column is as wide on both sides of a spread, so a
    ; page laid out once is right on either side once it is moved; laying a
    ; page out against its own side would need the side known before the
    ; block that breaks onto it, which a block cut in two does not know.
    fn applyBookMargins:void () {
        def pw:double style.pageWidth
        def ph:double style.pageHeight
        def left:double (book.inside(style.margin pw))
        def right:double (book.outside(style.margin pw))
        if (book.isBook()) {
            left = (book.outside(style.margin pw))
            right = (book.inside(style.margin pw))
        }
        contentX = left
        contentW = ((pw - left) - right)
        contentTop = (book.top(style.margin ph))
        contentBottom = (ph - (book.bottom(style.margin ph)))
    }

    ; A book's right-hand pages, moved from the left-hand layout to their
    ; own: everything on them by (inside - outside), but not what is drawn
    ; to the page's edges on purpose (a full-page picture, a band into the
    ; bleed), which belongs to the sheet and not to its text column.
    fn mirrorBook:void () {
        if ((book.isBook()) == false) {
            return
        }
        def pw:double style.pageWidth
        def dx:double ((book.inside(style.margin pw)) - (book.outside(style.margin pw)))
        if ((fabs dx) < 0.01) {
            return
        }
        def i:int 0
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            if (((book.isRecto(b.page)) && (b.bleeds == false)) && ((MdLayout.coversPageWidth(b pw)) == false)) {
                b.x = (b.x + dx)
                if (b.alignW > 0.0) {
                    b.alignX = (b.alignX + dx)
                }
            }
            i = (i + 1)
        }
    }

    sfn coversPageWidth:boolean (b:MdBox pw:double) {
        return ((b.x <= 0.5) && ((b.x + b.w) >= (pw - 0.5)))
    }

    ; ----------------------------------------------------------------------
    ; A table of contents, and what sits in the margins
    ; ----------------------------------------------------------------------
    ;
    ; The contents are laid out TWICE, and the reason is the oldest one in
    ; typesetting: the page numbers depend on where the blocks fall, and where
    ; the blocks fall depends on how tall the contents are. So the first pass
    ; reserves exactly the height the list will need — a number that does not
    ; depend on the page numbers at all, only on how many headings there are —
    ; and the second pass fills the reserved space in. Nothing moves between
    ; the two, so the numbers are right rather than nearly right.
    fn tocHeight:double () {
        if (tocLines == 0) { return 0.0 }
        def lh:double (style.bodySize * style.lineHeight)
        def head:double ((style.h2Size * style.lineHeight) + style.headingSpaceAfter)
        return (((head + (lh * (to_double tocLines))) + style.headingSpaceBefore) + style.paraSpacing)
    }

    fn emitToc:void (x:double w:double) {
        if (tocLines == 0) { return }
        def lh:double (style.bodySize * style.lineHeight)
        cursorY = (cursorY + style.headingSpaceBefore)
        def hy:double (this.reserve((style.h2Size * style.lineHeight)))
        def h:MdBox (MdBox.text("Contents" x hy w (style.h2Size * style.lineHeight)))
        h.family = style.headingFamily
        h.size = style.h2Size
        h.bold = true
        h.color = style.textColor
        this.emit(h)
        cursorY = ((hy + (style.h2Size * style.lineHeight)) + style.headingSpaceAfter)

        def i:int 0
        def n:int (array_length knownPages)
        while (i < n) {
            def level:int (itemAt knownLevel i)
            if (level <= 3) {
                def y:double (this.reserve(lh))
                def indent:double ((to_double (level - 1)) * 14.0)
                def label:MdBox (MdBox.text((itemAt knownText i) (x + indent) y (w - indent) lh))
                label.family = style.bodyFamily
                label.size = style.bodySize
                label.color = style.textColor
                this.emit(label)
                ; The page number, right-aligned against the column's edge.
                def num:string (to_string ((itemAt knownPages i) + 1))
                def probe:MdRun (new MdRun())
                probe.family = style.bodyFamily
                probe.size = style.bodySize
                def nw:double (this.measureRun(num probe))
                def nb:MdBox (MdBox.text(num ((x + w) - nw) y nw lh))
                nb.family = style.bodyFamily
                nb.size = style.bodySize
                nb.color = style.mutedColor
                this.emit(nb)
                cursorY = (y + lh)
            }
            i = (i + 1)
        }
        cursorY = (cursorY + style.paraSpacing)
    }

    ; The running head and the folio, on every sheet. Emitted after the
    ; content, because until then nobody knows how many sheets there are.
    fn emitFurniture:void () {
        if (! paginate) { return }
        this.emitHeadFoot()
        def wantHead:boolean ((strlen style.runningHead) > 0)
        def wantNum:boolean ((strlen style.pageNumbers) > 0)
        if ((! wantHead) && (! wantNum)) { return }
        if (style.runningHead == "none") { wantHead = false }
        if (style.pageNumbers == "none") { wantNum = false }
        def savedPage:int page
        def x:double contentX
        def w:double contentW
        def lh:double (style.furnitureSize * 1.3)
        def p:int 0
        while (p < pageCount) {
            page = p
            if wantHead {
                def text:string (this.headFor(p))
                def tlen:int (strlen text)
                if (tlen > 0) {
                    def hy:double ((contentTop - lh) - 6.0)
                    def b:MdBox (MdBox.text(text x hy w lh))
                    b.family = style.bodyFamily
                    b.size = style.furnitureSize
                    b.color = style.mutedColor
                    this.emit(b)
                    this.emit((MdBox.rect(x (contentTop - 5.0) w 0.5 style.ruleColor)))
                }
            }
            if wantNum {
                def num:string (to_string (p + 1))
                def probe:MdRun (new MdRun())
                probe.family = style.bodyFamily
                probe.size = style.furnitureSize
                def nw:double (this.measureRun(num probe))
                def ny:double (contentBottom + 10.0)
                def nx:double ((x + (w / 2.0)) - (nw / 2.0))
                if (style.pageNumbers == "bottom-right") {
                    nx = ((x + w) - nw)
                }
                if (style.pageNumbers == "bottom-outer") {
                    ; Outer is right on a recto and left on a verso, counting
                    ; the first sheet as page one.
                    def recto:boolean ((p % 2) == 0)
                    if (slides && (book.isBook())) {
                        recto = (book.isRecto(p))
                    }
                    if recto { nx = ((x + w) - nw) } { nx = x }
                }
                def nb:MdBox (MdBox.text(num nx ny nw lh))
                nb.family = style.bodyFamily
                nb.size = style.furnitureSize
                nb.color = style.mutedColor
                this.emit(nb)
            }
            p = (p + 1)
        }
        page = savedPage
    }

    ; The header and the footer on every sheet: up to three places on each
    ; edge (left, centre, right), each a picture and a line of text, in the
    ; top and the bottom margin. `header: …` with `header-align` is the place
    ; that alignment names.
    fn emitHeadFoot:void () {
        def top:[string] (this.edgeSlots(true))
        def bottom:[string] (this.edgeSlots(false))
        def wantTop:boolean (MdLayout.anySlot(top))
        def wantBottom:boolean (MdLayout.anySlot(bottom))
        if ((! wantTop) && (! wantBottom)) { return }
        def savedPage:int page
        def p:int 0
        while (p < pageCount) {
            page = p
            if (wantTop && ((this.edgeShown(p true)))) {
                this.edgeRow(top p true)
            }
            if (wantBottom && ((this.edgeShown(p false)))) {
                this.edgeRow(bottom p false)
            }
            p = (p + 1)
        }
        page = savedPage
    }

    ; [left, centre, right] of one edge, the single `header:` folded into
    ; the place its alignment names.
    fn edgeSlots:[string] (top:boolean) {
        def out:[string]
        def text:string (? top style.headerText style.footerText)
        def image:string (? top style.headerImage style.footerImage)
        def align:string (? top style.headerAlign style.footerAlign)
        push out (? top style.headerLeft style.footerLeft)
        push out (? top style.headerCenter style.footerCenter)
        push out (? top style.headerRight style.footerRight)
        def one:string text
        if ((strlen image) > 0) {
            one = (trim ("![](" + image + ") " + text))
        }
        if ((strlen one) > 0) {
            def at:int 0
            if (align == "center") { at = 1 }
            if (align == "end") { at = 2 }
            def was:string (itemAt out at)
            if ((strlen was) == 0) {
                set out at one
            } {
                set out at (was + " " + one)
            }
        }
        return out
    }

    sfn anySlot:boolean (slots:[string]) {
        def i:int 0
        while (i < (array_length slots)) {
            if ((strlen (trim (itemAt slots i))) > 0) { return true }
            i = (i + 1)
        }
        return false
    }

    ; Whether an edge is drawn on sheet p: not where `header-skip` names the
    ; sheet (first, last, its number) nor where its heading turned it off.
    fn edgeShown:boolean (p:int top:boolean) {
        def off:[int] (? top headerOff footerOff)
        def i:int 0
        while (i < (array_length off)) {
            if ((itemAt off i) == p) { return false }
            i = (i + 1)
        }
        def skip:string (? top style.headerSkip style.footerSkip)
        return ((MdLayout.skips(skip p pageCount)) == false)
    }

    sfn skips:boolean (spec:string p:int pages:int) {
        def words:[string] (strsplit (MdLayout.replaceAll(spec "," " ")) " ")
        def i:int 0
        while (i < (array_length words)) {
            def w:string (trim (itemAt words i))
            if ((w == "first") && (p == 0)) { return true }
            if ((w == "last") && (p == (pages - 1))) { return true }
            if ((strlen w) > 0) {
                def n@(optional):int (str2int w)
                if (!null? n) {
                    if ((unwrap n) == (p + 1)) { return true }
                }
            }
            i = (i + 1)
        }
        return false
    }

    ; `{header=off}`, `{footer=off}` or `{furniture=off}` on a heading.
    fn readEdgesOff:void (node:MdNode) {
        def both:boolean (MdLayout.isOff((node.attrValue("furniture"))))
        if (both || (MdLayout.isOff((node.attrValue("header"))))) {
            push headerOff page
        }
        if (both || (MdLayout.isOff((node.attrValue("footer"))))) {
            push footerOff page
        }
    }

    sfn isOff:boolean (v:string) {
        def t:string (MdChar.lower((trim v)))
        return ((((t == "off") || (t == "none")) || (t == "false")) || (t == "no"))
    }

    ; The text size of an edge.
    fn edgeSize:double (top:boolean) {
        def size:double (? top style.headerSize style.footerSize)
        if (size <= 0.0) {
            size = style.furnitureSize
            if slides {
                size = (style.bodySize * 0.6)
            }
        }
        return size
    }

    ; How tall an edge's row is: its line, or its tallest picture.
    fn edgeRowH:double (slots:[string] top:boolean) {
        def lh:double ((this.edgeSize(top)) * 1.3)
        def imgH:double (? top style.headerImageH style.footerImageH)
        def h:double lh
        def i:int 0
        while (i < (array_length slots)) {
            if (((strlen (MdLayout.slotImage((itemAt slots i)))) > 0) && (imgH > h)) {
                h = imgH
            }
            i = (i + 1)
        }
        return h
    }

    ; A margin too small for its edge is widened, so a tall logo pushes the
    ; content down rather than sitting on it.
    fn makeEdgeRoom:void () {
        def top:[string] (this.edgeSlots(true))
        if (MdLayout.anySlot(top)) {
            def need:double ((this.edgeRowH(top true)) + 14.0)
            if (contentTop < need) { contentTop = need }
        }
        def bottom:[string] (this.edgeSlots(false))
        if (MdLayout.anySlot(bottom)) {
            def needB:double ((this.edgeRowH(bottom false)) + 14.0)
            if ((style.pageHeight - contentBottom) < needB) {
                contentBottom = (style.pageHeight - needB)
            }
        }
    }

    ; `![alt](path)` in a place: the picture's path, or "".
    sfn slotImage:string (slot:string) {
        def a:int (indexOf slot "![")
        if (a < 0) { return "" }
        def m:int (indexOf slot "](")
        if (m < a) { return "" }
        def rest:string (substring slot (m + 2) (strlen slot))
        def e:int (indexOf rest ")")
        if (e < 0) { return "" }
        return (trim (substring rest 0 e))
    }

    ; The place without its picture, and whether the picture came first.
    sfn slotText:string (slot:string) {
        def a:int (indexOf slot "![")
        def m:int (indexOf slot "](")
        if ((a < 0) || (m < a)) { return (trim slot) }
        def rest:string (substring slot (m + 2) (strlen slot))
        def e:int (indexOf rest ")")
        if (e < 0) { return (trim slot) }
        def before:string (substring slot 0 a)
        def after:string (substring rest (e + 1) (strlen rest))
        return (trim ((trim before) + " " + (trim after)))
    }

    sfn imageFirst:boolean (slot:string) {
        def a:int (indexOf slot "![")
        if (a < 0) { return true }
        return ((strlen (trim (substring slot 0 a))) == 0)
    }

    ; One edge on sheet p: the band and the hairline, then each place.
    fn edgeRow:void (slots:[string] p:int top:boolean) {
        def size:double (this.edgeSize(top))
        def lh:double (size * 1.3)
        def rowH:double (this.edgeRowH(slots top))
        def y:double ((contentTop - rowH) - 8.0)
        if (top == false) {
            y = (contentBottom + 8.0)
        }
        if (y < 2.0) {
            y = 2.0
        }
        def mark:int (? top 1 2)
        def band:string (? top style.headerBackground style.footerBackground)
        def haveBand:boolean (((strlen band) > 0) && (band != "transparent"))
        if haveBand {
            def by:double 0.0
            def bh:double ((y + rowH) + 8.0)
            if (top == false) {
                by = (y - 8.0)
                bh = (style.pageHeight - by)
            }
            def bb:MdBox (MdBox.rect(0.0 by style.pageWidth bh band))
            bb.furniture = mark
            this.emit(bb)
        }
        def rule:string (? top style.headerRule style.footerRule)
        if (((strlen rule) > 0) && (rule != "transparent")) {
            def rx:double contentX
            def rw:double contentW
            if haveBand {
                rx = 0.0
                rw = style.pageWidth
            }
            def ry:double ((y + rowH) + 7.0)
            if (top == false) {
                ry = (y - 8.0)
            }
            def rb:MdBox (MdBox.rect(rx ry rw 0.75 rule))
            rb.furniture = mark
            this.emit(rb)
        }
        ; each place's natural width, then the room it gets
        def widths:[double]
        def i:int 0
        while (i < 3) {
            push widths (this.slotWidth((itemAt slots i) p top))
            i = (i + 1)
        }
        def gap:double (size * 1.5)
        def wl:double (itemAt widths 0)
        def wc:double (itemAt widths 1)
        def wr:double (itemAt widths 2)
        def side:double contentW
        if (wc > 0.0) {
            side = (((contentW - wc) * 0.5) - gap)
        }
        if (wc > contentW) { wc = contentW }
        def roomL:double side
        def roomR:double side
        if (wc <= 0.0) {
            if (wr > 0.0) { roomL = ((contentW - wr) - gap) }
            if (wl > 0.0) { roomR = ((contentW - wl) - gap) }
        }
        if (wl > 0.0) {
            this.slotAt((itemAt slots 0) contentX y rowH (MdLayout.minD(wl roomL)) p top)
        }
        if (wc > 0.0) {
            this.slotAt((itemAt slots 1) (contentX + ((contentW - wc) * 0.5)) y rowH wc p top)
        }
        if (wr > 0.0) {
            def w2:double (MdLayout.minD(wr roomR))
            this.slotAt((itemAt slots 2) ((contentX + contentW) - w2) y rowH w2 p top)
        }
    }

    ; An edge's text colour when nobody named one: the muted colour, unless
    ; it is too faint on the sheet to read at that size (WCAG 4.5:1); then
    ; the text colour.
    fn edgeInk:string () {
        def paper:string style.pageBackground
        if ((strlen paper) == 0) { paper = "#ffffff" }
        if ((MdLayout.contrast(style.mutedColor paper)) >= 4.5) { return style.mutedColor }
        return style.textColor
    }

    sfn contrast:double (a:string b:string) {
        def la:double (MdLayout.luminance(a))
        def lb:double (MdLayout.luminance(b))
        if (la < lb) {
            return ((lb + 0.05) / (la + 0.05))
        }
        return ((la + 0.05) / (lb + 0.05))
    }

    sfn luminance:double (hex:string) {
        def c:EVGColor (EVGColor.parse(hex))
        def r:double (MdLayout.channel((to_double (c.red()))))
        def g:double (MdLayout.channel((to_double (c.green()))))
        def b:double (MdLayout.channel((to_double (c.blue()))))
        return (((0.2126 * r) + (0.7152 * g)) + (0.0722 * b))
    }

    sfn channel:double (v:double) {
        def x:double (v / 255.0)
        if (x <= 0.04045) { return (x / 12.92) }
        ; y^2.4, as y^2.375 = y² · y^¼ · y^⅛ (close enough for a threshold)
        def y:double ((x + 0.055) / 1.055)
        def q:double (sqrt (sqrt y))
        return (((y * y) * q) * (sqrt q))
    }

    sfn minD:double (a:double b:double) {
        if (a < b) { return a }
        return b
    }

    ; A place's picture as the byte store has it; `path` empty when it has not.
    fn slotPicture:MdSlotPic (slot:string top:boolean) {
        def out:MdSlotPic (new MdSlotPic())
        def image:string (MdLayout.slotImage(slot))
        if (((strlen image) == 0) || (haveImages == false)) { return out }
        def resolved:string (images.resolve(image docDir))
        if ((strlen resolved) == 0) { return out }
        def st:VfsStat (images.stat(resolved))
        if (st.found == false) { return out }
        out.h = (? top style.headerImageH style.footerImageH)
        out.w = out.h
        if (st.pixelH > 0) {
            out.w = (out.h * ((to_double st.pixelW) / (to_double st.pixelH)))
        }
        out.path = resolved
        out.natW = st.pixelW
        out.natH = st.pixelH
        return out
    }

    fn slotRun:MdRun (top:boolean) {
        def probe:MdRun (new MdRun())
        probe.family = style.bodyFamily
        probe.size = (this.edgeSize(top))
        probe.bold = (? top style.headerBold style.footerBold)
        return probe
    }

    fn slotWidth:double (slot:string p:int top:boolean) {
        if ((strlen (trim slot)) == 0) { return 0.0 }
        def text:string (MdLayout.fillTokens((MdLayout.slotText(slot)) (p + 1) pageCount style.title))
        def tw:double 0.0
        if ((strlen text) > 0) {
            tw = (this.measureRun(text (this.slotRun(top))))
        }
        def iw:double (this.slotPicture(slot top)).w
        if ((iw > 0.0) && (tw > 0.0)) {
            return ((iw + tw) + ((this.edgeSize(top)) * 0.8))
        }
        return (iw + tw)
    }

    ; One place, from x, in w at most.
    fn slotAt:void (slot:string x:double y:double rowH:double w:double p:int top:boolean) {
        def size:double (this.edgeSize(top))
        def lh:double (size * 1.3)
        def colour:string (? top style.headerColor style.footerColor)
        if ((strlen colour) == 0) {
            colour = (this.edgeInk())
        }
        def text:string (MdLayout.fillTokens((MdLayout.slotText(slot)) (p + 1) pageCount style.title))
        def pic:MdSlotPic (this.slotPicture(slot top))
        def iw:double pic.w
        def ih:double pic.h
        def gap:double 0.0
        if ((iw > 0.0) && ((strlen text) > 0)) {
            gap = (size * 0.8)
        }
        if (iw > w) { iw = w }
        def tw:double ((w - iw) - gap)
        def first:boolean (MdLayout.imageFirst(slot))
        def ix:double x
        def tx:double ((x + iw) + gap)
        if (first == false) {
            tx = x
            ix = ((x + w) - iw)
        }
        def mark:int (? top 1 2)
        if (iw > 0.0) {
            def b:MdBox (new MdBox())
            b.kind = 4
            b.x = ix
            b.y = (y + ((rowH - ih) * 0.5))
            b.w = iw
            b.h = ih
            b.imagePath = pic.path
            b.imageNaturalW = pic.natW
            b.imageNaturalH = pic.natH
            b.furniture = mark
            this.emit(b)
        }
        if ((tw > 0.0) && ((strlen text) > 0)) {
            def t:MdBox (MdBox.text(text tx (y + ((rowH - lh) * 0.5)) tw lh))
            t.family = style.bodyFamily
            t.size = size
            t.bold = (? top style.headerBold style.footerBold)
            t.color = colour
            t.furniture = mark
            this.emit(t)
        }
    }

    ; {page}, {pages} and {title} in a header or footer.
    sfn fillTokens:string (text:string page:int pages:int title:string) {
        def out:string text
        out = (MdLayout.replaceAll(out "{page}" (to_string page)))
        out = (MdLayout.replaceAll(out "{pages}" (to_string pages)))
        out = (MdLayout.replaceAll(out "{title}" title))
        return out
    }

    sfn replaceAll:string (text:string what:string with:string) {
        def out:string ""
        def rest:string text
        def at:int (indexOf rest what)
        while (at >= 0) {
            out = (out + (substring rest 0 at) + with)
            rest = (substring rest (at + (strlen what)) (strlen rest))
            at = (indexOf rest what)
        }
        return (out + rest)
    }

    ; What the running head says on that sheet.
    fn headFor:string (p:int) {
        if (style.runningHead == "title") { return style.title }
        if (style.runningHead != "h1") { return "" }
        def best:string ""
        def i:int 0
        def n:int (array_length headText)
        while (i < n) {
            if ((itemAt headLevel i) == 1) {
                if ((itemAt headPage i) <= p) {
                    best = (itemAt headText i)
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; The body, in one pass or in two.
    ;
    ; Two when the document asked for a table of contents, because the page
    ; numbers in it depend on where the blocks fall and where the blocks fall
    ; depends on how tall it is. The first pass leaves a gap of exactly the
    ; right height and learns the pages; the second fills the gap in. Nothing
    ; moves between them.
    fn layoutBody:void (doc:MdNode) {
        tocLines = 0
        if style.wantToc {
            tocLines = (MdLayout.countHeadings(doc))
        }
        if (tocLines == 0) {
            this.bodyPass(doc 0)
            return
        }
        this.bodyPass(doc 1)
        clear knownPages
        clear knownText
        clear knownLevel
        def i:int 0
        def n:int (array_length headPage)
        while (i < n) {
            push knownPages (itemAt headPage i)
            push knownText (itemAt headText i)
            push knownLevel (itemAt headLevel i)
            i = (i + 1)
        }
        clear boxes
        boxIndexReady = false
        pageIndexReady = false
        this.resetHeadings()
        this.endScopes()
        this.startScopes()
        page = 0
        pageCount = 1
        cursorY = contentTop
        this.bodyPass(doc 2)
    }

    ; `mode`: 0 no contents, 1 reserve the space, 2 fill it in.
    ; ----------------------------------------------------------------------
    ; The per-block layout cache
    ; ----------------------------------------------------------------------

    ; Turn it on for this document, if this document is one it can serve.
    ; Answers whether it did, so a caller can say so rather than assume.
    fn setDocSource:void (text:string) {
        docSource = text
    }

    fn armCache:boolean (doc:MdNode) {
        cacheOn = false
        if paginate { return false }
        ; a block's boxes depend on the slide it is under, which its own
        ; source does not say
        if sheet.hasScoped { return false }
        if style.wantToc { return false }
        if ((strlen docSource) == 0) { return false }
        if (doc.readingSig != cacheReading) {
            this.dropCache()
            cacheReading = doc.readingSig
        }
        cacheOn = true
        return true
    }

    fn disarmCache:void () {
        cacheOn = false
    }

    ; Everything measured is measured at a width and through a measurer, so a
    ; change to either makes every entry wrong. The cheap and total answer is
    ; to throw the lot away: it costs one document's layout, once.
    fn dropCache:void () {
        map_clear cacheAt
        clear cacheKey
        clear cacheSrc
        clear cacheTop
        clear cacheHeight
        clear cacheFrom
        clear cacheCount
        clear cacheBoxes
        cacheHits = 0
        cacheMisses = 0
    }

    ; The text that produced this block, which is the only thing its boxes
    ; depend on — plus the width it was measured at, because the same
    ; paragraph breaks in different places in a different column.
    fn cacheKeyOf:string (node:MdNode src:string w:double) {
        def a:int node.srcStart
        def b:int node.srcEnd
        def n:int (strlen src)
        if (a < 0) { a = 0 }
        if (b > n) { b = n }
        if (b < a) { b = a }
        def key:string (((to_string (to_int (w * 16.0))) + "\u0001") + (substring src a b))
        ; a footnote's number is decided by the blocks BEFORE this one, so
        ; the same text draws another number when one is added above it
        if ((notesDoc.noteCount()) > 0) {
            key = (key + "\u0001" + (MdLayout.noteSig(node)))
        }
        return key
    }

    fn cacheFind:int (key:string) {
        if (has cacheAt key) {
            return (unwrap (get cacheAt key))
        }
        return -1
    }

    ; ONE cached box, put where it goes. Both the replay and the audit go
    ; through this, and that is the point of it being a function.
    ;
    ; It was not, and the two disagreed: the replay shifted a box's source
    ; offset by the DIFFERENCE between where the block was and where it is,
    ; having already stored it relative to where it was — subtracting the base
    ; twice — while the audit re-derived the right answer and passed. So a
    ; block that moved got boxes claiming to come from the wrong part of the
    ; file, the caret's line table came out as [[0,10],[0,16],[0,10],[43,63]],
    ; and Up from the end of the document went to the end of the first line.
    ;
    ; A check that recomputes the answer is not checking the code. It is
    ; checking that two people can do the same arithmetic, and here they could
    ; not.
    fn cacheBoxAt:MdBox (slot:int i:int node:MdNode baseY:double) {
        def src:MdBox (itemAt cacheBoxes ((itemAt cacheFrom slot) + i))
        def b:MdBox (src.copy())
        b.y = (b.y + baseY)
        if (b.srcStart >= 0) { b.srcStart = (b.srcStart + node.srcStart) }
        if (b.segSrc >= 0) { b.segSrc = (b.segSrc + node.srcStart) }
        return b
    }

    ; A hit: the boxes again, moved to where this block now sits and stamped
    ; with where its source now is.
    fn cacheReplay:void (slot:int node:MdNode) {
        def cnt:int (itemAt cacheCount slot)
        def i:int 0
        while (i < cnt) {
            push boxes (this.cacheBoxAt(slot i node cursorY))
            i = (i + 1)
        }
        cursorY = (cursorY + (itemAt cacheHeight slot))
        cacheHits = (cacheHits + 1)
    }

    fn cacheStore:void (key:string node:MdNode from:int top:double) {
        def n:int (array_length boxes)
        def at:int (array_length cacheBoxes)
        def i:int from
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            def keep:MdBox (b.copy())
            keep.y = (keep.y - top)
            if (keep.srcStart >= 0) { keep.srcStart = (keep.srcStart - node.srcStart) }
            if (keep.segSrc >= 0) { keep.segSrc = (keep.segSrc - node.srcStart) }
            push cacheBoxes keep
            i = (i + 1)
        }
        def slot:int (array_length cacheKey)
        push cacheKey key
        if (! (has cacheAt key)) {
            set cacheAt key slot
        }
        ; Zero, like `cacheTop`: the boxes were stored RELATIVE to the block,
        ; so what they are relative TO is nothing. Storing the block's own
        ; start here and subtracting it again on replay is the bug above.
        push cacheSrc 0
        push cacheTop 0.0
        push cacheHeight (cursorY - top)
        push cacheFrom at
        push cacheCount (n - from)
        cacheMisses = (cacheMisses + 1)
    }

    ; One top-level block, from the cache when it can be and from the layout
    ; when it cannot.
    fn blockCached:void (node:MdNode src:string x:double w:double) {
        ; …and never while PAGINATING. A cached block is replayed by copying
        ; its boxes and advancing the cursor by its height — `block` is not
        ; called, so `reserve` is not called, so the page never breaks. A
        ; four-hundred-paragraph document came out as two pages with every
        ; paragraph drawn on top of the last.
        ;
        ; `armCache` refuses a paginating layout, but it is asked BEFORE
        ; `layoutPaged` sets `paginate` — so the flag could be left on from
        ; the continuous layout before it. Asked here it cannot be.
        if ((! cacheOn) || paginate) {
            this.block(node x w)
            return
        }
        if (node.srcStart < 0) {
            this.block(node x w)
            return
        }
        ; A span that is empty does not identify a block, and two blocks that
        ; share a key share each other's boxes. That is not hypothetical: a
        ; one-line HTML block used to come out as [32,32], so a document with
        ; two comments in it drew one of them twice and the other not at all.
        ; The parser is fixed and this is the guard that makes the fix
        ; unnecessary rather than load-bearing.
        if (node.srcEnd <= node.srcStart) {
            this.block(node x w)
            return
        }
        def key:string (this.cacheKeyOf(node src w))
        def slot:int (this.cacheFind(key))
        if (slot >= 0) {
            if cacheAudit {
                this.auditBlock(slot node x w)
                return
            }
            this.cacheReplay(slot node)
            return
        }
        def from:int (array_length boxes)
        def top:double cursorY
        this.block(node x w)
        this.cacheStore(key node from top)
    }

    ; Lay the block out for real, then check the cache would have said the
    ; same thing. Slower than either on its own, which is the point: it is a
    ; gate, not a mode anyone ships with.
    fn auditBlock:void (slot:int node:MdNode x:double w:double) {
        cacheAudited = (cacheAudited + 1)
        def from:int (array_length boxes)
        def top:double cursorY
        this.block(node x w)
        def realCount:int ((array_length boxes) - from)
        def realHeight:double (cursorY - top)
        def cnt:int (itemAt cacheCount slot)
        if (realCount != cnt) {
            this.cacheFault((((("box count " + (to_string realCount)) + " vs cached ")
                + (to_string cnt)) + (" for " + node.kind)))
            return
        }
        if ((fabs (realHeight - (itemAt cacheHeight slot))) > 0.01) {
            this.cacheFault(("height " + (to_string realHeight)))
            return
        }
        def i:int 0
        while (i < cnt) {
            def got:MdBox (itemAt boxes (from + i))
            ; What the CACHE would have handed back — built by the same
            ; function the replay uses, not by doing its arithmetic again.
            def want:MdBox (this.cacheBoxAt(slot i node top))
            if (got.text != want.text) {
                this.cacheFault((("text [" + got.text) + ("] vs [" + (want.text + "]"))))
                i = cnt
            } {
                if ((fabs (got.y - want.y)) > 0.01) {
                    this.cacheFault(("y " + (to_string got.y)))
                    i = cnt
                } {
                    if ((fabs (got.x - want.x)) > 0.01) {
                        this.cacheFault(("x " + (to_string got.x)))
                        i = cnt
                    } {
                        if (got.segSrc != want.segSrc) {
                            this.cacheFault((("segSrc " + (to_string got.segSrc))
                                + (" vs " + (to_string want.segSrc))))
                            i = cnt
                        } {
                            if (got.srcStart != want.srcStart) {
                                this.cacheFault((("srcStart " + (to_string got.srcStart))
                                    + (" vs " + (to_string want.srcStart))))
                                i = cnt
                            } {
                                i = (i + 1)
                            }
                        }
                    }
                }
            }
        }
    }

    fn cacheFault:void (what:string) {
        cacheFaults = (cacheFaults + 1)
        if ((strlen cacheFirstFault) == 0) {
            cacheFirstFault = what
        }
    }

    fn bodyPass:void (doc:MdNode mode:int) {
        floatOn = false
        ; a full-page gallery ending the last layout must not break this one
        fullPageDone = false
        def placed:boolean (mode == 0)
        def i:int 0
        def n:int (doc.childCount())
        while (i < n) {
            def child:MdNode (doc.childAt(i))
            if slides {
                ; a `layout=full` gallery filled its last slide edge to edge
                if fullPageDone {
                    fullPageDone = false
                    this.nextSlide()
                }
                if (child.kind == "heading") {
                    ; a heading closes the section it was in; a sub-heading
                    ; opens its own once it has been laid out (below)
                    this.clearSection()
                }
                if (this.slideBreakBefore(doc child i)) {
                    this.nextSlide()
                    ; a sub-heading moved to the next slide is the slide
                    ; going on: the title again over it, as any continuation
                    if (this.continuesSlide(child)) {
                        this.emitSlideTitle()
                    }
                }
                this.keepWithNext(child i n doc)
                if (child.kind == "heading") {
                    if (child.level <= splitLevel) {
                        ; `plainText`, not `literal`: a heading's literal is
                        ; gone by the time the inline parser has finished with
                        ; it — it became the text nodes underneath — so the
                        ; continuation slide carried an empty title.
                        slideTitle = (child.plainText())
                        slideTitleLevel = child.level
                        slideTitleHidden = (MdLayout.hiddenHeading(child))
                        this.notePlace(child (MdLayout.bodyFollows(doc i splitLevel)))
                    }
                }
            }
            if (child.kind == "heading") {
                this.enterHeading(child)
            }
            ; Whether this block opens its slide: a heading that does is the
            ; slide's title, and what comes right under it is fitted to it
            ; (see `fitSlideTitle`) rather than spilled onto a slide of its own.
            def opensSlide:boolean (slides && ((cursorY - contentTop) < 0.5))
            def startPage:int page
            def fromBox:int (array_length boxes)
            def fromHead:int (array_length headText)
            push blockFirstPage page
            this.placeBlock(doc i true)
            if (slides && (child.kind == "heading") && (child.level > splitLevel)) {
                sectionTitle = (child.plainText())
                sectionLevel = child.level
                sectionHidden = (MdLayout.hiddenHeading(child))
            }
            if slides {
                def isTitle:boolean (opensSlide && (child.kind == "heading"))
                if (isTitle && (MdLayout.bodyFollows(doc i splitLevel))) {
                    this.fitSlideTitle(child fromBox fromHead startPage)
                }
                slideTitleOnly = (isTitle && (page == startPage))
            }
            push blockLastPage page
            if (! placed) {
                ; After the title, which is where a reader looks for it; at
                ; the very top when the document has no heading at all.
                def afterTitle:boolean (child.kind == "heading")
                def atTop:boolean (child.kind == "front_matter")
                if (afterTitle || (i == 0)) {
                    if (! atTop) {
                        if (mode == 1) {
                            cursorY = (cursorY + (this.tocHeight()))
                        } {
                            this.emitToc(contentX contentW)
                        }
                        placed = true
                    }
                }
            }
            i = (i + 1)
        }
        this.endFloat()
    }

    ; ----------------------------------------------------------------------
    ; A title too big for its slide
    ; ----------------------------------------------------------------------
    ;
    ; A heading set large enough wraps onto two or three lines, and whatever
    ; is under it no longer fits. A diagram or a chart cannot be cut, so it
    ; went to a slide of its own with the title said again, and the slide it
    ; left held the title and nothing else: one heading, two slides. A title
    ; with something under it on its slide now takes at most `slideTitleMax`
    ; of the room, laid out a step smaller until it does, and the block under
    ; it is given what is left (`slideTitleOnly`, read by `embed` and
    ; `pictureBlock`). A title with nothing under it — a section slide — keeps
    ; the size it was given.
    def slideTitleMax:double 0.6
    ; On a slide, how tall the blocks after a lone picture are, down to the
    ; slide's end: `pictureBlock` leaves them that room (see `heightAfter`).
    def followH:double 0.0
    ; …and whether it can go beside the picture (startFloat), not under it
    def followBeside:boolean false
    ; FLOAT: a picture or a drawing narrower than the column, with `{width=…}`
    ; under it, has the blocks after it set beside it, in the rest of the
    ; column, down to its bottom (`startFloat`). While on: the page it is on,
    ; where it ends, and the column the text beside it gets.
    def floatOn:boolean false
    def floatPage:int 0
    def floatBottom:double 0.0
    def floatX:double 0.0
    def floatW:double 0.0
    ; The slide so far holds its title and nothing else.
    def slideTitleOnly:boolean false
    ; inside a `{container=…}` plate: a block in it does not get one of its own
    def containerDepth:int 0
    ; the plate the block being laid out stands on ("" for none) and the
    ; page under it: a heading's own colour is judged on it, not only the
    ; text's (`## Title {container=box}` kept its light theme colour on a
    ; light plate)
    def plateFill:string ""
    def platePaper:string ""
    ; The typography the block being laid out inherits and adds to
    ; (`MdTypo`: weight, style, transform, spacing), and a face its class
    ; names (`.serif { font-family }`), "" for the element's own
    def typo:MdTypo (new MdTypo())
    def typoDepth:int 0
    def blockFamily:string ""

    ; The headings the block being laid out is under, by level (1…6), as
    ; the sheet sees them (`MdCss.scopeOf`): `#intro h2`, `.dark page`. The
    ; style's look as the sheet left it is kept in `baseLook`, and a slide's
    ; own rules are laid over it while that slide is laid out (`enterScope`).
    def scopeHeads:[MdNode]
    def scopeCtx@(optional):CssNode
    def baseLook:[string]
    def scoped:boolean false
    ; the page's colour and picture from the page a scope began on, when a
    ; slide's rules changed them (`paperOf`, `pictureOf`)
    def paperFrom:[int]
    def paperColour:[string]
    def paperPicture:[string]
    ; a mark whose page is the one its heading lands on, not yet known
    ; (a slide break starts the new page at the heading's first line)
    def paperPending:boolean false

    ; --- footnotes (see "Footnotes" below) --------------------------------
    ; the document whose `notes` are drawn; empty: none
    def notesDoc:MdNode (new MdNode())
    ; per footnote, the page its first drawn reference is on (-1: not yet)
    def noteFirstPage:[int]
    ; per page, the room its footnotes have claimed at its foot
    def noteRoom:[double]
    ; drawing (or measuring) footnotes: their own references claim nothing
    def inNotes:boolean false
    ; a footnote's height, by number, size and column
    def noteHeights:[string:double]
    ; how much smaller footnotes are set than the text
    def noteScale:double 0.78

    ; ----------------------------------------------------------------------
    ; Text beside a narrow picture or drawing (FLOAT)
    ; ----------------------------------------------------------------------
    ;
    ; `{width=60%}` under a figure leaves 40% of the column empty, and the
    ; paragraph after it went under it, so the slide was a narrow figure, a
    ; gap and a line of text below. A figure that was given a width (or
    ; that is narrower than the column anyway) and sits at a side of it
    ; now has the paragraphs, lists and quotes after it set in the rest of
    ; the column, beside it, while they start above its bottom — the way a
    ; CSS float wraps. Under the figure the column is full width again.
    ; Block `i` laid out where the body pass puts it: beside the picture,
    ; chart or table before it while that left a float open, else across
    ; the column, with the text after a picture or chart given room under
    ; it. The first pass reuses a block laid out before (`cached`); a slide
    ; laid out again to shrink or grow it (`relayoutBlock`) goes through
    ; here too, so the text that went beside a table there still does.
    fn placeBlock:void (doc:MdNode i:int cached:boolean) {
        def child:MdNode (doc.childAt(i))
        def fromBox:int (array_length boxes)
        def bx:double contentX
        def bw:double contentW
        if floatOn {
            if ((page == floatPage) && (MdLayout.besideable(child splitLevel))) {
                bx = floatX
                bw = floatW
            } {
                this.endFloat()
            }
        }
        ; a slide's title leaves the top corner its picture is pinned in
        if ((slides && (child.kind == "heading")) && (child.level <= splitLevel)) {
            def inset:double (this.cornerInset(doc i))
            if (inset > 0.0) {
                bw = (contentW - (inset * contentW))
                def cn:MdNode (this.cornerNode(doc i))
                if ((MdSlideLayout.cornerOf((cn.attrValue("float")))) == "top-left") {
                    bx = (contentX + (inset * contentW))
                }
                def gap:double (style.bodySize * 1.2)
                bw = (bw - gap)
                if (bx > contentX) { bx = (bx + gap) }
                this.block(child bx bw)
                followH = 0.0
                return
            }
        }
        followH = 0.0
        followBeside = false
        if (slides && (child.kind == "paragraph")) {
            if ((MdLayout.loneImage(child)).kind == "image") {
                followH = (this.heightAfter(doc i))
                if ((i + 1) < (doc.childCount())) {
                    followBeside = (MdLayout.besideable((doc.childAt((i + 1))) splitLevel))
                }
            }
        }
        ; a chart or diagram given the room under its heading leaves the
        ; text written under it on the slide too (see `embed`)
        if (slides && (child.kind == "embed")) {
            followH = (this.heightAfter(doc i))
            if ((i + 1) < (doc.childCount())) {
                followBeside = (MdLayout.besideable((doc.childAt((i + 1))) splitLevel))
            }
        }
        if floatOn {
            this.block(child bx bw)
            if ((page != floatPage) || (cursorY >= floatBottom)) {
                this.endFloat()
            }
        } {
            if cached {
                this.blockCached(child docSource contentX contentW)
            } {
                this.block(child contentX contentW)
            }
            this.startFloat(doc i fromBox)
        }
        followH = 0.0
    }

    sfn besideable:boolean (node:MdNode splitLevel:int) {
        if ((node.kind == "paragraph") && ((MdLayout.loneImage(node)).kind != "image")) { return true }
        if (node.kind == "list") { return true }
        if (node.kind == "blockquote") { return true }
        ; a heading starts something new: under the figure, full width
        return false
    }

    fn startFloat:void (doc:MdNode i:int fromBox:int) {
        ; a corner picture opened its own (pinPicture)
        if floatOn { return }
        if ((i + 1) >= (doc.childCount())) { return }
        if (! (MdLayout.bodyFollows(doc i splitLevel))) { return }
        def child:MdNode (doc.childAt(i))
        def next:MdNode (doc.childAt((i + 1)))
        if (! (MdLayout.besideable(next splitLevel))) { return }
        ; the block's own picture or drawing, the last one it emitted
        def k:int ((array_length boxes) - 1)
        def at:int -1
        while ((k >= fromBox) && (at < 0)) {
            def c:MdBox (itemAt boxes k)
            ; a corner picture is out of the flow: nothing goes beside it
            ; here, under the title is where the text goes on (pinPicture)
            if (((c.kind == 3) || (c.kind == 4)) && (c.pinned == false)) { at = k }
            k = (k - 1)
        }
        if ((at < 0) && ((child.kind == "table") || (child.kind == "code_block"))) {
            this.startFloatAt(child (this.extentOn(fromBox page)))
            return
        }
        if (at < 0) { return }
        def b:MdBox (itemAt boxes at)
        this.startFloatAt(child b)
    }

    ; The boxes from `from` on that are on page `p`, as one box (kind -1
    ; when there are none): a table's cells, the thing beside which text
    ; goes when it was given a width.
    fn extentOn:MdBox (from:int p:int) {
        def e:MdBox (new MdBox())
        e.kind = -1
        def right:double 0.0
        def bottom:double 0.0
        def k:int from
        while (k < (array_length boxes)) {
            def c:MdBox (itemAt boxes k)
            if ((c.page == p) && (c.retold == false)) {
                if (e.kind < 0) {
                    e.kind = 1
                    e.page = p
                    e.x = c.x
                    e.y = c.y
                    right = (c.x + c.w)
                    bottom = (c.y + c.h)
                }
                if (c.x < e.x) { e.x = c.x }
                if (c.y < e.y) { e.y = c.y }
                if ((c.x + c.w) > right) { right = (c.x + c.w) }
                if ((c.y + c.h) > bottom) { bottom = (c.y + c.h) }
            }
            k = (k + 1)
        }
        e.w = (right - e.x)
        e.h = (bottom - e.y)
        return e
    }

    fn startFloatAt:void (child:MdNode b:MdBox) {
        if (b.kind < 0) { return }
        if (b.page != page) { return }
        def side:string (this.floatSide(child b))
        if ((strlen side) == 0) { return }
        def gap:double (style.bodySize * 1.2)
        def fx:double ((b.x + b.w) + gap)
        def fw:double ((contentX + contentW) - fx)
        if (side == "end") {
            fx = contentX
            fw = ((b.x - contentX) - gap)
        }
        if (fw < (contentW * 0.25)) { return }
        floatOn = true
        floatPage = page
        floatBottom = cursorY
        floatX = fx
        floatW = fw
        cursorY = b.y
    }

    ; Which side of the column box `b` (the drawing block `child` emitted)
    ; sits at, for the text to go to the other: "start", "end", or "" when
    ; it fills the column, is centred, or was not given a width.
    fn floatSide:string (child:MdNode b:MdBox) {
        def want:string (child.attrValue("width"))
        if (child.kind == "paragraph") {
            want = ((MdLayout.loneImage(child)).attrValue("width"))
            if ((strlen want) == 0) {
                want = (child.attrValue("width"))
            }
        }
        if ((strlen want) == 0) { return "" }
        if (b.w > (contentW * 0.75)) { return "" }
        if (b.kind == 3) {
            def kind:string (MdLayout.firstWord(child.info))
            def ei:int (embeds.find(kind child.literal b.w))
            ; A drawing's box starts the column whatever its alignment:
            ; `center` sets the drawing in the middle of its own box
            ; (MdEmbedEntry.shiftIn). So a chart given a width has the text
            ; after it beside it even when centred (a host centres every
            ; chart by default); it went under it, and a chart with its
            ; takeaway in a box beside it ended up on two slides.
            if (ei >= 0) {
                def e:MdEmbedEntry (embeds.entryAt(ei))
                if (e.align == "end") { return "end" }
            }
            return "start"
        }
        ; a picture: at the side it was put, a centred one to the start
        if ((b.x + b.w) >= ((contentX + contentW) - 0.5)) {
            if (b.x > (contentX + 0.5)) { return "end" }
        }
        b.x = contentX
        return "start"
    }

    fn endFloat:void () {
        if (floatOn && (page == floatPage) && (cursorY < floatBottom)) {
            cursorY = floatBottom
        }
        floatOn = false
    }

    ; How tall the blocks after `i` that stay on its slide are, laid out
    ; and taken back: the room a picture leaves under itself so that the
    ; text written under it is on the same slide.
    fn heightAfter:double (doc:MdNode i:int) {
        if (! (MdLayout.bodyFollows(doc i splitLevel))) { return 0.0 }
        return this.measureBlocks(doc (i + 1) 0)
    }

    ; How tall the run of blocks from `from` on is, laid out from the top and
    ; taken back: every block that stays on the slide `from` is on, and, when
    ; `level` is above 0, only up to the next heading at `level` or above —
    ; the SECTION a sub-heading at `level` opens (see `sectionMovesOn`).
    ; Nothing it laid out is left behind: boxes, headings, the slide count and
    ; what a full-page gallery noted for the slides it would have opened.
    fn measureBlocks:double (doc:MdNode from:int level:int) {
        def n:int (doc.childCount())
        if (from >= n) { return 0.0 }
        def savedBoxes:int (array_length boxes)
        def savedY:double cursorY
        def savedPage:int page
        def savedPageCount:int pageCount
        def savedOverflows:int slideOverflows
        def savedHeads:int (array_length headText)
        def savedHeaderOff:int (array_length headerOff)
        def savedFooterOff:int (array_length footerOff)
        def savedNamed:int (array_length namedPage)
        def savedHiddenOn:int hiddenOnPage
        def savedFullDone:boolean fullPageDone
        def wasPaginate:boolean paginate
        paginate = false
        cursorY = 0.0
        def j:int from
        def going:boolean true
        while (going && (j < n)) {
            this.block((doc.childAt(j)) contentX contentW)
            going = (MdLayout.bodyFollows(doc j splitLevel))
            if (going && (level > 0) && ((j + 1) < n)) {
                def next:MdNode (doc.childAt((j + 1)))
                if ((next.kind == "heading") && (next.level <= level)) {
                    going = false
                }
            }
            j = (j + 1)
        }
        def h:double cursorY
        paginate = wasPaginate
        this.truncate(savedBoxes)
        while ((array_length headText) > savedHeads) {
            removeLast headText
            removeLast headLevel
            removeLast headPage
            removeLast headY
        }
        while ((array_length headerOff) > savedHeaderOff) {
            removeLast headerOff
        }
        while ((array_length footerOff) > savedFooterOff) {
            removeLast footerOff
        }
        while ((array_length namedPage) > savedNamed) {
            removeLast namedPage
            removeLast namedText
        }
        hiddenOnPage = savedHiddenOn
        fullPageDone = savedFullDone
        cursorY = savedY
        page = savedPage
        pageCount = savedPageCount
        slideOverflows = savedOverflows
        return h
    }

    ; Whether the block after `i` stays on the slide `i` starts, rather than
    ; starting one of its own.
    sfn bodyFollows:boolean (doc:MdNode i:int splitLevel:int) {
        if ((i + 1) >= (doc.childCount())) { return false }
        def next:MdNode (doc.childAt((i + 1)))
        if (next.kind == "front_matter") { return false }
        if (next.hasClass("no-break")) { return true }
        if (next.hasClass("slide")) { return false }
        if ((next.kind == "heading") && (next.level <= splitLevel)) { return false }
        return true
    }

    fn fitSlideTitle:void (child:MdNode fromBox:int fromHead:int startPage:int) {
        def cap:double ((contentBottom - contentTop) * slideTitleMax)
        if ((page == startPage) && ((cursorY - contentTop) <= cap)) { return }
        def saved:[double] (this.styleNumbers())
        def savedOverflows:int slideOverflows
        def sc:double 0.9
        while (sc > 0.15) {
            this.truncate(fromBox)
            while ((array_length headText) > fromHead) {
                removeLast headText
                removeLast headLevel
                removeLast headPage
                removeLast headY
            }
            this.scaleStyle(saved sc)
            page = startPage
            pageCount = (page + 1)
            slideOverflows = savedOverflows
            cursorY = contentTop
            this.block(child contentX contentW)
            this.restoreStyle(saved)
            if ((page == startPage) && ((cursorY - contentTop) <= cap)) { return }
            sc = (sc - 0.1)
        }
    }

    ; ----------------------------------------------------------------------
    ; …and the four rules, in order
    ; ----------------------------------------------------------------------
    fn slideBreakBefore:boolean (doc:MdNode child:MdNode i:int) {
        ; Never before the first block, and never on a slide with nothing on
        ; it yet — a rule that fires twice in a row leaves a blank slide.
        if (i == 0) { return false }
        if (((cursorY - contentTop) < 0.5) && (hiddenOnPage != page)) { return false }
        ; 2. FORBIDDEN beats 1. MANDATORY. An author who wrote `{.no-break}`
        ; on a heading meant it, and the alternative is a flag that does
        ; nothing whenever it would matter.
        if (child.hasClass("no-break")) { return false }
        ; 1. MANDATORY
        if (child.hasClass("slide")) { return true }
        if (child.kind == "heading") {
            if (child.level <= splitLevel) { return true }
            ; 3. PREFERRED — any other heading, when the slide has to break
            ; anyway: see `sectionMovesOn`.
            return this.sectionMovesOn(doc i)
        }
        return false
    }

    ; 3. PREFERRED, in full. A sub-heading opens a SECTION: it and what
    ; follows, up to the next heading at its level or above (or the next
    ; slide's title). When the section fits in the room left, nothing
    ; breaks — a slide is cut where it has to be, not wherever a heading
    ; happens to fall below the middle (that rule sent the last line of
    ; `### h3` … `###### h6` to a slide of its own with half the slide
    ; empty). When it does not fit, the slide is going to break somewhere,
    ; and the place to break is before the heading: the section starts at
    ; the top of the continuation, under the title, whole. That holds only
    ; when the section fits on a continuation of its own; one taller than
    ; that is cut wherever it runs over, as before, and the continuation
    ; says its heading again (`emitSlideTitle`). A slide that holds only
    ; its title keeps the section: moving it would leave the title alone.
    fn sectionMovesOn:boolean (doc:MdNode i:int) {
        if slideTitleOnly { return false }
        def child:MdNode (doc.childAt(i))
        def h:double (this.measureBlocks(doc i child.level))
        if ((cursorY + h) <= (contentBottom + fitSlack)) { return false }
        def alone:double ((contentBottom - contentTop) - (this.continuationTitleHeight(false)))
        return (h <= alone)
    }

    ; Whether a slide `child` was moved onto by a break is the same slide
    ; going on — a sub-heading, which says the title again over it — rather
    ; than a slide of its own: a title, or a block the author marked
    ; `{.slide}`, which asked for a new slide and gets one as written.
    fn continuesSlide:boolean (child:MdNode) {
        if (child.kind != "heading") { return false }
        if (child.level <= splitLevel) { return false }
        if (child.hasClass("slide")) { return false }
        return true
    }

    ; KEEP-WITH-NEXT. A heading with nothing under it is the one thing that
    ; makes an automatic deck look automatic, so the heading moves rather than
    ; the paragraph. It is asked for the PAIR: the heading's own height plus
    ; one line of whatever follows.
    fn keepWithNext:void (child:MdNode i:int n:int doc:MdNode) {
        if (child.kind != "heading") { return }
        if (MdLayout.hiddenHeading(child)) { return }
        if ((i + 1) >= n) { return }
        def next:MdNode (doc.childAt(i + 1))
        def size:double (style.headingSize(child.level))
        def head:double ((style.headingSpaceBefore + (size * style.lineHeight)) + style.headingSpaceAfter)
        def need:double (head + (this.keepRoom(next)))
        if ((cursorY + need) > contentBottom) {
            if ((cursorY - contentTop) > 0.5) {
                this.nextSlide()
                if (this.continuesSlide(child)) {
                    this.emitSlideTitle()
                }
            }
        }
    }

    ; How much of the next block has to fit beside the heading for the pair to
    ; count as together.
    ;
    ; One body line is right for PROSE: a paragraph that starts under its
    ; heading and runs onto the next slide still reads as one thing. It is
    ; wrong for a block that cannot be cut. A diagram is laid out whole or not
    ; at all, so a heading with one line of room under it takes the heading
    ; and leaves the diagram on the next slide — which is the reader's
    ; complaint, in as many words: the heading on one slide and the diagram on
    ; the next.
    ;
    ; The diagram's height is already known: `MdDiagram.prepare` measured it
    ; before layout began, which is the whole reason that pass exists. Capped
    ; at the room a slide has, because a diagram taller than any slide would
    ; otherwise push every heading forward for ever and still not fit.
    ;
    ; A TABLE is the other unsplittable-ish block and still gets one line. Its
    ; height is not known without laying its rows out, and doing that here
    ; would be a second table algorithm beside `tableWidths`. Named rather
    ; than left as an oversight.
    fn keepRoom:double (next:MdNode) {
        def line:double (style.bodySize * style.lineHeight)
        if (next.kind != "embed") { return line }
        def kind:string (MdLayout.firstWord(next.info))
        def want:string (next.attrValue("width"))
        def useW:double (MdEmbedKinds.widthOf(want contentW))
        def known:double (embeds.heightFor(kind next.literal useW))
        if (known <= 0.0) { return line }
        def room:double (contentBottom - contentTop)
        if (known > room) { return room }
        return known
    }

    fn nextSlide:void () {
        page = (page + 1)
        pageCount = (page + 1)
        cursorY = contentTop
    }

    ; The title again, at the top of a slide a block spilled onto. Emitted
    ; here rather than through `blockInner`, because there is no node for it:
    ; it is the same heading, said twice.
    ;
    ; THE RULE, one for every continuation: the slide's title is said again
    ; at the top, whether the continuation begins with a block cut in two,
    ; a whole block or a sub-heading the break was moved before. When it
    ; begins INSIDE a section, that section's sub-heading is said again
    ; under the title, set and marked as the title is — its own level's
    ; size and ink, no box of the source behind it (`segSrc` -1), and no
    ; "(continued)" suffix, which the deck would have to translate.
    fn emitSlideTitle:void () {
        this.noteContinuation(page)
        def said:boolean false
        if (((strlen slideTitle) > 0) && (slideTitleHidden == false)) {
            this.emitRepeatedHeading(slideTitle slideTitleLevel)
            said = true
        }
        if (((strlen sectionTitle) > 0) && (sectionHidden == false)) {
            if said {
                cursorY = (cursorY + style.headingSpaceBefore)
            }
            this.emitRepeatedHeading(sectionTitle sectionLevel)
        }
    }

    fn emitRepeatedHeading:void (text:string level:int) {
        def size:double (style.headingSize(level))
        def h:double (size * style.lineHeight)
        def b:MdBox (MdBox.text(text contentX cursorY contentW h))
        b.family = style.headingFamily
        b.size = size
        b.bold = true
        ; the heading's own ink: it is the same title, and a dimmed one is
        ; text a reader at the back cannot make out
        b.color = (style.headingInk(level))
        b.retold = true
        this.emit(b)
        cursorY = ((cursorY + h) + style.headingSpaceAfter)
    }

    ; How tall what `emitSlideTitle` says is, with the section's heading or
    ; without it: the room a continuation has is the slide less this.
    fn continuationTitleHeight:double (withSection:boolean) {
        def h:double 0.0
        def said:boolean false
        if (((strlen slideTitle) > 0) && (slideTitleHidden == false)) {
            h = (((style.headingSize(slideTitleLevel)) * style.lineHeight) + style.headingSpaceAfter)
            said = true
        }
        if (withSection && ((strlen sectionTitle) > 0) && (sectionHidden == false)) {
            if said {
                h = (h + style.headingSpaceBefore)
            }
            h = ((h + ((style.headingSize(sectionLevel)) * style.lineHeight)) + style.headingSpaceAfter)
        }
        return h
    }

    fn noteContinuation:void (p:int) {
        def t:string ""
        if (slideTitleHidden == false) { t = slideTitle }
        def st:string ""
        if (sectionHidden == false) { st = sectionTitle }
        def i:int (indexOf contPage p)
        if (i < 0) {
            push contPage p
            push contTitle t
            push contTitleLevel slideTitleLevel
            push contSection st
            push contSectionLevel sectionLevel
            return
        }
        set_at contTitle i t
        set_at contTitleLevel i slideTitleLevel
        set_at contSection i st
        set_at contSectionLevel i sectionLevel
    }

    ; Slide `p` laid out again from its top: what it said again as a
    ; continuation, said again, and the title and section it was in made the
    ; current ones for what follows on it.
    fn resumeContinuation:void (p:int) {
        def i:int (indexOf contPage p)
        if (i < 0) { return }
        slideTitle = (itemAt contTitle i)
        slideTitleLevel = (itemAt contTitleLevel i)
        slideTitleHidden = false
        sectionTitle = (itemAt contSection i)
        sectionLevel = (itemAt contSectionLevel i)
        sectionHidden = false
        this.emitSlideTitle()
    }

    ; Slide `p` went (shrunk into the one before it): its record goes and
    ; every later slide's moves up one.
    fn dropContinuation:void (p:int) {
        def keepP:[int]
        def keepT:[string]
        def keepTL:[int]
        def keepS:[string]
        def keepSL:[int]
        def i:int 0
        while (i < (array_length contPage)) {
            def cp:int (itemAt contPage i)
            if (cp != p) {
                if (cp > p) { cp = (cp - 1) }
                push keepP cp
                push keepT (itemAt contTitle i)
                push keepTL (itemAt contTitleLevel i)
                push keepS (itemAt contSection i)
                push keepSL (itemAt contSectionLevel i)
            }
            i = (i + 1)
        }
        contPage = keepP
        contTitle = keepT
        contTitleLevel = keepTL
        contSection = keepS
        contSectionLevel = keepSL
    }

    fn clearSection:void () {
        sectionTitle = ""
        sectionLevel = 0
        sectionHidden = false
    }

    sfn countHeadings:int (doc:MdNode) {
        def c:int 0
        def i:int 0
        def n:int (doc.childCount())
        while (i < n) {
            def child:MdNode (doc.childAt(i))
            if (child.kind == "heading") {
                if (child.level <= 3) { c = (c + 1) }
            }
            i = (i + 1)
        }
        return c
    }

    fn resetHeadings:void () {
        clear hiddenSrc
        clear hiddenPage
        clear namedPage
        clear namedText
        clear overlaySrc
        clear overlayPage
        clear overlayPath
        hiddenOnPage = -1
        clear headText
        clear headLevel
        clear headPage
        clear headY
    }

    ; `{heading=hidden}` (also `hidden` and `none`) on a heading.
    sfn hiddenHeading:boolean (node:MdNode) {
        return (MdAttrs.headingHidden(node))
    }

    fn noteHidden:void (src:int p:int) {
        def i:int 0
        while (i < (array_length hiddenSrc)) {
            if ((itemAt hiddenSrc i) == src) {
                set_at hiddenPage i p
                return
            }
            i = (i + 1)
        }
        push hiddenSrc src
        push hiddenPage p
    }

    ; An overlay picture written at `src` is on page `p`. A slide laid out
    ; again (shrunk to fit) notes it again: the last word holds.
    fn noteOverlay:void (src:int path:string p:int) {
        def i:int 0
        while (i < (array_length overlaySrc)) {
            if ((itemAt overlaySrc i) == src) {
                set_at overlayPage i p
                set_at overlayPath i path
                return
            }
            i = (i + 1)
        }
        push overlaySrc src
        push overlayPage p
        push overlayPath path
    }

    fn isOverlayType:boolean (contentType:string) {
        return ((indexOf overlayTypes contentType) >= 0)
    }

    ; The page a hidden heading starting at `src` names, -1: none does.
    ; A full-page gallery's picture is a slide of its own with no heading:
    ; it is named by its caption, else the last title and its number
    ; ("Hietaniemi (2)"), so overviews and reports can call it something.
    fn fullPageName:string (it:MdGalleryItem k:int) {
        def cap:string (trim it.caption)
        if it.isText {
            cap = (trim it.text)
            def nl:int (indexOf cap "\n")
            if (nl >= 0) {
                cap = (trim (substring cap 0 nl))
            }
        }
        if ((strlen cap) > 0) {
            return cap
        }
        def last:string ""
        def n:int (array_length headText)
        if (n > 0) {
            last = (itemAt headText (n - 1))
        }
        if ((strlen last) == 0) {
            return ""
        }
        return (last + " (" + (to_string (k + 1)) + ")")
    }

    fn namePage:void (p:int name:string) {
        if ((strlen name) == 0) {
            return
        }
        def i:int 0
        while (i < (array_length namedPage)) {
            if ((itemAt namedPage i) == p) {
                return
            }
            i = (i + 1)
        }
        push namedPage p
        push namedText name
    }

    ; The name a page was given without a heading (a full-page gallery's
    ; picture), or "".
    fn pageName:string (p:int) {
        def i:int 0
        while (i < (array_length namedPage)) {
            if ((itemAt namedPage i) == p) {
                return (itemAt namedText i)
            }
            i = (i + 1)
        }
        return ""
    }

    fn pageOfHidden:int (src:int) {
        def i:int 0
        while (i < (array_length hiddenSrc)) {
            if ((itemAt hiddenSrc i) == src) {
                return (itemAt hiddenPage i)
            }
            i = (i + 1)
        }
        return -1
    }

    ; Room for `h` more, or a new sheet. Returns the y to draw at.
    ; How far past `contentBottom` a block may end and still count as fitting.
    ; A diagram or picture squeezed into the room left is given exactly
    ; `contentBottom - cursorY`, and `cursorY` plus that comes back one
    ; rounding step over `contentBottom` for some paddings: the block went to
    ; a slide of its own and left its title's slide empty. A hundredth of a
    ; point is far below anything a reader sees.
    def fitSlack:double 0.01

    fn reserve:double (h:double) {
        if paginate {
            ; the room the page's footnotes have claimed is not the text's
            def bottom:double (contentBottom - (this.noteRoomOn(page)))
            ; past the budget the rest stays on the last page: a block taller
            ; than any page is drawn cut, not spread over thousands
            if (((cursorY + h) > (bottom + fitSlack)) && (page < (MdCssLimits.pageBudget()))) {
                page = (page + 1)
                pageCount = (page + 1)
                cursorY = contentTop
                ; A block that did not fit is a block cut in half, and on a
                ; deck that is worth saying out loud — and worth repeating the
                ; title for, so a reader of the second half knows what it is
                ; the second half of.
                if slides {
                    slideOverflows = (slideOverflows + 1)
                    ; a later column running onto the slide an earlier one
                    ; already ran onto: under the title said there, once
                    if ((columnsOn > 0) && (page == colSpillPage)) {
                        cursorY = colSpillTop
                    } {
                        this.emitSlideTitle()
                        if (columnsOn > 0) {
                            colSpillPage = page
                            colSpillTop = cursorY
                        }
                    }
                }
            }
        }
        return cursorY
    }

    fn emit:void (b:MdBox) {
        b.page = page
        b.srcStart = currentSrc
        push boxes b
        if ((b.noteRef > 0) && (! inNotes)) {
            this.noteSeen(b.noteRef page)
        }
    }

    ; The first box a block produced, or -1. The two panes of the viewer are
    ; kept in step through this and nothing else.
    ;
    ; It was a scan of every box in the document, once per call, and the
    ; viewer calls it once per BLOCK — so putting the source caret back after
    ; a click was quadratic in the document. Nobody noticed at a click a
    ; second; a caret that moves on every keystroke would have. The index is
    ; built once per layout, at the end, keyed by the block's own srcStart.
    fn buildBoxIndex:void () {
        map_clear boxIndexAt
        def i:int 0
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            if (b.srcStart >= 0) {
                def k:string (to_string b.srcStart)
                if (! (has boxIndexAt k)) {
                    set boxIndexAt k i
                }
            }
            i = (i + 1)
        }
        boxIndexReady = true
    }

    fn forgetPages:void () {
        pageIndexReady = false
    }

    fn buildPageIndex:void () {
        clear pageOrder
        clear pageFrom
        def n:int (array_length boxes)
        def last:int -1
        def i:int 0
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            if (b.page > last) {
                last = b.page
            }
            i = (i + 1)
        }
        ; pageFrom[p] .. pageFrom[p + 1]: page p's run in pageOrder
        def p:int 0
        while (p <= (last + 1)) {
            push pageFrom 0
            p = (p + 1)
        }
        i = 0
        while (i < n) {
            def b2:MdBox (itemAt boxes i)
            if (b2.page >= 0) {
                set pageFrom (b2.page + 1) ((itemAt pageFrom (b2.page + 1)) + 1)
                push pageOrder 0
            }
            i = (i + 1)
        }
        p = 1
        while (p <= (last + 1)) {
            set pageFrom p ((itemAt pageFrom p) + (itemAt pageFrom (p - 1)))
            p = (p + 1)
        }
        def at:[int]
        p = 0
        while (p <= last) {
            push at (itemAt pageFrom p)
            p = (p + 1)
        }
        i = 0
        while (i < n) {
            def b3:MdBox (itemAt boxes i)
            if (b3.page >= 0) {
                def k:int (itemAt at b3.page)
                set pageOrder k i
                set at b3.page (k + 1)
            }
            i = (i + 1)
        }
        pageIndexBoxes = n
        pageIndexReady = true
    }

    ; the indexes in `boxes` of the boxes on page `pg`, in box order
    fn boxesOnPage:[int] (pg:int) {
        if ((! pageIndexReady) || (pageIndexBoxes != (array_length boxes))) {
            this.buildPageIndex()
        }
        def out:[int]
        if ((pg < 0) || ((pg + 1) >= (array_length pageFrom))) {
            return out
        }
        def k:int (itemAt pageFrom pg)
        def end:int (itemAt pageFrom (pg + 1))
        while (k < end) {
            push out (itemAt pageOrder k)
            k = (k + 1)
        }
        return out
    }

    fn firstBoxOf:int (srcStart:int) {
        if (! boxIndexReady) {
            this.buildBoxIndex()
        }
        def k:string (to_string srcStart)
        if (has boxIndexAt k) {
            return (unwrap (get boxIndexAt k))
        }
        return -1
    }

    ; ----------------------------------------------------------------------
    ; Footnotes
    ; ----------------------------------------------------------------------
    ;
    ; A reference is a raised number in the line (`collectRuns`). The notes
    ; themselves go where a printed page puts them: at the foot of the page
    ; — the slide — that first refers to them, small, numbered, under a short
    ; rule. A definition draws nothing where it was written.
    ;
    ; Two halves, because a note's place is only known once the page is:
    ;
    ;   while laying out, a line that first refers to a note reserves the
    ;   note's height at the foot of its page with it (`noteRoomFor`), and
    ;   once placed claims it (`emit` → `noteSeen`), so the text after it
    ;   breaks earlier and never runs into the notes;
    ;
    ;   after the pages are final — shrunk, grown — the notes are drawn
    ;   (`placeNotesPaged`) from the boxes alone: whatever page the first
    ;   reference's box ended up on is the page its note is on. The claims
    ;   are bookkeeping for the breaks; the boxes are the truth.
    ;
    ; Without pages (`layoutContinuous`, one long column) there is no foot to
    ; put them at, so they close the document, in number order, as the HTML
    ; export ends with them.
    ;
    ; The notes' boxes are `furniture` 3: placed by the page, not by the flow
    ; of blocks, which is what every reader of a block's boxes already
    ; leaves aside. A labelled note's boxes carry its definition's source, so
    ; a click on one finds the text that is drawn; an inline note's carry
    ; none, because its text is inside the paragraph that refers to it and a
    ; box there would claim to be part of that paragraph.

    fn startNotes:void (doc:MdNode) {
        notesDoc = doc
        clear noteFirstPage
        clear noteRoom
        def i:int 0
        while (i < (doc.noteCount())) {
            push noteFirstPage -1
            i = (i + 1)
        }
        inNotes = false
    }

    fn noteRoomOn:double (p:int) {
        if ((p < 0) || (p >= (array_length noteRoom))) {
            return 0.0
        }
        return (itemAt noteRoom p)
    }

    fn addNoteRoom:void (p:int h:double) {
        while ((array_length noteRoom) <= p) {
            push noteRoom 0.0
        }
        set_at noteRoom p ((itemAt noteRoom p) + h)
    }

    ; the gap from the text to the notes' rule, and from the rule to them
    fn noteSepH:double () {
        return (style.bodySize * 0.9)
    }

    ; Footnote `n` is referred to on page `p`: the first time, it claims its
    ; room there.
    fn noteSeen:void (n:int p:int) {
        if ((n < 1) || (n > (array_length noteFirstPage))) { return }
        if ((itemAt noteFirstPage (n - 1)) >= 0) { return }
        set_at noteFirstPage (n - 1) p
        def add:double (this.noteHeight(n))
        if ((this.noteRoomOn(p)) <= 0.0) {
            add = (add + (this.noteSepH()))
        }
        this.addNoteRoom(p add)
    }

    ; The room the notes a line refers to for the first time will claim.
    fn noteRoomFor:double (ln:MdLine) {
        if ((! paginate) || inNotes) { return 0.0 }
        if ((array_length noteFirstPage) == 0) { return 0.0 }
        def sum:double 0.0
        def counted:[int]
        def i:int 0
        while (i < (array_length ln.segs)) {
            def seg:MdSeg (itemAt ln.segs i)
            def n:int seg.noteRef
            if ((n >= 1) && (n <= (array_length noteFirstPage))) {
                if ((itemAt noteFirstPage (n - 1)) < 0) {
                    def seen:boolean false
                    for counted cn:int ci {
                        if (cn == n) {
                            seen = true
                        }
                    }
                    if (! seen) {
                        push counted n
                        sum = (sum + (this.noteHeight(n)))
                    }
                }
            }
            i = (i + 1)
        }
        if ((sum > 0.0) && ((this.noteRoomOn(page)) <= 0.0)) {
            sum = (sum + (this.noteSepH()))
        }
        return sum
    }

    ; The claims again, from the boxes that are left — after a slide was cut
    ; back to be laid out again.
    fn retrackNotes:void () {
        def i:int 0
        while (i < (array_length noteFirstPage)) {
            set_at noteFirstPage i -1
            i = (i + 1)
        }
        clear noteRoom
        def k:int 0
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt boxes k)
            if ((b.noteRef > 0) && (b.furniture == 0)) {
                this.noteSeen(b.noteRef b.page)
            }
            k = (k + 1)
        }
    }

    ; How tall footnote `n` is, set as the notes are, in the text column.
    fn noteHeight:double (n:int) {
        def key:string ((to_string n) + "/" + (to_string style.bodySize) + "/" + (to_string contentW))
        if (has noteHeights key) {
            return (unwrap (get noteHeights key))
        }
        def one:[int]
        push one n
        def h:double (this.measureNotes(one contentX contentW))
        set noteHeights key h
        return h
    }

    ; The notes laid out for real and taken away again: their height.
    fn measureNotes:double (list:[int] x:double w:double) {
        def savedPaginate:boolean paginate
        def savedPage:int page
        def savedCount:int pageCount
        def savedCursor:double cursorY
        def savedIn:boolean inNotes
        def savedSrc:int currentSrc
        def from:int (array_length boxes)
        paginate = false
        inNotes = true
        cursorY = 0.0
        this.drawNoteList(list x w)
        def bottom:double 0.0
        def i:int from
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            if ((b.y + b.h) > bottom) {
                bottom = (b.y + b.h)
            }
            i = (i + 1)
        }
        while ((array_length boxes) > from) {
            removeLast boxes
        }
        paginate = savedPaginate
        page = savedPage
        pageCount = savedCount
        cursorY = savedCursor
        inNotes = savedIn
        currentSrc = savedSrc
        return bottom
    }

    ; The notes in `list`, one under the other from the cursor, each its
    ; number and then its blocks, set `noteScale` smaller than the text.
    fn drawNoteList:void (list:[int] x:double w:double) {
        def saved:[double] (this.styleNumbers())
        this.scaleStyle(saved noteScale)
        def wasTight:boolean inTightItem
        inTightItem = true
        def probe:MdRun (this.baseRun())
        def widest:double 0.0
        def k:int 0
        while (k < (array_length list)) {
            def mw:double (this.measureRun(((to_string (itemAt list k)) + ".") probe))
            if (mw > widest) {
                widest = mw
            }
            k = (k + 1)
        }
        def indent:double (widest + style.markerGap)
        def i:int 0
        while (i < (array_length list)) {
            def n:int (itemAt list i)
            def fd:MdNode (notesDoc.noteAt(n))
            if (fd.kind == "footnote_def") {
                def first:int (array_length boxes)
                def top:double cursorY
                this.blocks(fd (x + indent) (w - indent))
                def markerY:double top
                if (first < (array_length boxes)) {
                    def fb:MdBox (this.firstTextBox(first))
                    markerY = fb.y
                }
                def marker:string ((to_string n) + ".")
                def mb:MdBox (MdBox.text(marker x markerY (this.measureRun(marker probe)) (style.bodySize * style.lineHeight)))
                mb.family = style.bodyFamily
                mb.size = style.bodySize
                mb.color = style.mutedColor
                this.emit(mb)
                ; whose source the boxes name: a labelled note its
                ; definition's, an inline one none (see above)
                def j:int first
                while (j < (array_length boxes)) {
                    def nb:MdBox (itemAt boxes j)
                    if ((strlen fd.info) > 0) {
                        if ((nb.srcStart < 0) || (j == ((array_length boxes) - 1))) {
                            nb.srcStart = fd.srcStart
                        }
                    } {
                        nb.srcStart = -1
                    }
                    j = (j + 1)
                }
            }
            i = (i + 1)
        }
        inTightItem = wasTight
        this.restoreStyle(saved)
    }

    ; The notes, with their rule, on page `p` from `top`. Returns where they
    ; end.
    fn drawNotesAt:double (list:[int] p:int top:double) {
        def savedPaginate:boolean paginate
        def savedPage:int page
        def savedIn:boolean inNotes
        def savedSrc:int currentSrc
        paginate = false
        inNotes = true
        page = p
        def from:int (array_length boxes)
        def ruleW:double (contentW * 0.25)
        def rule:MdBox (MdBox.rect(contentX top ruleW 0.75 style.ruleColor))
        this.emit(rule)
        rule.srcStart = -1
        cursorY = (top + (this.noteSepH() * 0.5))
        this.drawNoteList(list contentX contentW)
        def end:double cursorY
        def i:int from
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            b.furniture = 3
            if ((b.y + b.h) > end) {
                end = (b.y + b.h)
            }
            i = (i + 1)
        }
        paginate = savedPaginate
        page = savedPage
        inNotes = savedIn
        currentSrc = savedSrc
        return end
    }

    ; The footnotes `n` refers to (a note may have notes), not yet placed.
    sfn notesWithin:void (node:MdNode first:[int] p:int list:[int]) {
        if (node.kind == "footnote_ref") {
            def m:int node.noteNumber
            if ((m >= 1) && (m <= (array_length first))) {
                if ((itemAt first (m - 1)) < 0) {
                    set_at first (m - 1) p
                    push list m
                }
            }
        }
        def i:int 0
        while (i < (node.childCount())) {
            MdLayout.notesWithin((node.childAt(i)) first p list)
            i = (i + 1)
        }
    }

    ; Each page's notes, at its foot: the notes whose first reference was
    ; drawn on it, in number order, then the notes those refer to.
    fn placeNotesPaged:void () {
        def count:int (notesDoc.noteCount())
        if (count == 0) { return }
        def first:[int]
        def i:int 0
        while (i < count) {
            push first -1
            i = (i + 1)
        }
        def k:int 0
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt boxes k)
            def n:int b.noteRef
            if (((n >= 1) && (n <= count)) && (b.furniture == 0)) {
                if ((itemAt first (n - 1)) < 0) {
                    set_at first (n - 1) b.page
                }
            }
            k = (k + 1)
        }
        def savedCursor:double cursorY
        def p:int 0
        while (p < pageCount) {
            def list:[int]
            def m:int 1
            while (m <= count) {
                if ((itemAt first (m - 1)) == p) {
                    push list m
                }
                m = (m + 1)
            }
            if ((array_length list) > 0) {
                def j:int 0
                while (j < (array_length list)) {
                    MdLayout.notesWithin((notesDoc.noteAt((itemAt list j))) first p list)
                    j = (j + 1)
                }
                def h:double (this.measureNotes(list contentX contentW))
                def sep:double (this.noteSepH())
                ; where this page's own text ends
                def textEnd:double contentTop
                def q:int 0
                while (q < (array_length boxes)) {
                    def tb:MdBox (itemAt boxes q)
                    if ((tb.page == p) && (tb.furniture == 0)) {
                        if ((tb.y + tb.h) > textEnd) {
                            textEnd = (tb.y + tb.h)
                        }
                    }
                    q = (q + 1)
                }
                def top:double ((contentBottom - h) - (sep * 0.5))
                ; Text that reached into their room — a picture fitted to
                ; the page, a reference in a table — has them under it
                ; rather than over it.
                if (top < (textEnd + (sep * 0.5))) {
                    top = (textEnd + (sep * 0.5))
                }
                this.drawNotesAt(list p top)
            }
            p = (p + 1)
        }
        cursorY = savedCursor
    }

    ; One long column: the notes close the document.
    fn placeNotesAtEnd:void () {
        def count:int (notesDoc.noteCount())
        if (count == 0) { return }
        def list:[int]
        def m:int 1
        while (m <= count) {
            push list m
            m = (m + 1)
        }
        def top:double (cursorY + (this.noteSepH() * 0.5))
        cursorY = (this.drawNotesAt(list page top))
    }

    ; The numbers of the footnotes `node` refers to, for the layout cache.
    sfn noteSig:string (node:MdNode) {
        if (node.kind == "footnote_ref") {
            return ((to_string node.noteNumber) + ",")
        }
        def out:string ""
        def i:int 0
        while (i < (node.childCount())) {
            out = (out + (MdLayout.noteSig((node.childAt(i)))))
            i = (i + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; Definition lists and `::: containers`
    ; ----------------------------------------------------------------------

    ; Each term bold, at the list's edge; each of its definitions under it,
    ; indented as a list item's text is. A tight list keeps its definitions
    ; as close as a tight list's items.
    fn defList:void (node:MdNode x:double w:double) {
        def wasTight:boolean inTightItem
        def indent:double style.listIndent
        def savedSrc:int currentSrc
        def i:int 0
        while (i < (node.childCount())) {
            def c:MdNode (node.childAt(i))
            if (c.kind == "dt") {
                def base:MdRun (this.baseRun())
                base.bold = true
                def runs:[MdRun] (this.inlineRuns(c base))
                if (c.srcStart >= 0) {
                    currentSrc = c.srcStart
                }
                this.paragraph(runs x w)
                currentSrc = savedSrc
                cursorY = (cursorY + style.listTightSpacing)
            }
            if (c.kind == "dd") {
                inTightItem = node.listTight
                this.blocks(c (x + indent) (w - indent))
                inTightItem = wasTight
            }
            i = (i + 1)
        }
        if node.listTight {
            def extra:double (style.paraSpacing - style.listTightSpacing)
            if (extra > 0.0) {
                cursorY = (cursorY + extra)
            }
        }
    }

    ; Its title, when the opening line had one, bold over its blocks. The
    ; plate around them is `containerBlock`'s, the one `{container=box}`
    ; draws.
    fn customContainer:void (node:MdNode x:double w:double) {
        if (MdColumns.isRow(node)) {
            this.columnsBlock(node x w)
            return
        }
        if ((strlen node.title) > 0) {
            def tr:MdRun (this.baseRun())
            tr.bold = true
            tr.text = node.title
            def runs:[MdRun]
            push runs tr
            this.paragraph(runs x w)
            cursorY = (cursorY + style.listTightSpacing)
        }
        this.blocks(node x w)
    }

    ; A colour a sheet gives a property, as `#RRGGBB(AA)`; "" for none.
    sfn sheetColour:string (got:CssComputed name:string) {
        if (! (got.has(name))) { return "" }
        def c:EVGColor (CssValue.color((got.get(name))))
        if (! c.isSet) { return "" }
        return (MdContainer.hexOf(c))
    }

    ; ----------------------------------------------------------------------
    ; Blocks
    ; ----------------------------------------------------------------------
    fn blocks:void (parent:MdNode x:double w:double) {
        def i:int 0
        def n:int (parent.childCount())
        while (i < n) {
            def child:MdNode (parent.childAt(i))
            this.block(child x w)
            i = (i + 1)
        }
    }

    fn block:void (node:MdNode x:double w:double) {
        def outerSrc:int currentSrc
        if (node.srcStart >= 0) { currentSrc = node.srcStart }
        ; `{.lead}` and `{#id}`: what the sheet says about this block's size
        ; and colour holds while it is laid out
        def scaled:boolean false
        def saved:[double]
        def savedColor:string style.textColor
        def savedAlign:string align
        def savedTypo:MdTypo typo
        def savedFamily:string blockFamily
        def own:string (this.blockAlign(node))
        ; a section or statement slide centres its lines
        if ((((strlen own) == 0) && slideCenter) && ((node.kind == "paragraph") || (node.kind == "heading"))) {
            own = "center"
        }
        if ((strlen own) > 0) {
            align = own
        }
        ; a statement's text at its title's size; a statement that is only
        ; its title, larger than a title
        def placeR:double (this.statementRatio(node))
        if (placeR > 1.001) {
            saved = (this.styleNumbers())
            this.scaleStyle(saved placeR)
            scaled = true
        }
        ; the typography it inherits (the document's at the top), then its
        ; element's (`heading`, then `h2`), then its class's, below
        def nt:MdTypo (typo.copy())
        if (typoDepth == 0) {
            nt = (style.typoOf("document")).copy()
        }
        def tag:string (MdCss.tagOf(node))
        if (node.kind == "heading") {
            nt.over((style.typoOf("heading")))
        }
        nt.over((style.typoOf(tag)))
        ; a class's background, padding or border: the block on a plate of
        ; its own, as `{container=box}` would put it (`.note { background-
        ; color: #fff3cd; padding: 12pt }` needs no attribute)
        def boxed:boolean false
        if (((strlen sheetText) > 0) && (((node.classCount()) > 0) || ((strlen node.nodeId) > 0))) {
            def got:CssComputed (this.styleOf(node))
            nt.over((MdCss.typoOf(got)))
            if (got.has("font-family")) {
                def fam:string (CssValue.firstFamily((got.get("font-family"))))
                if ((strlen fam) > 0) {
                    blockFamily = fam
                }
            }
            ; …its OWN rules only: `h2 { border-color }` is every h2's look
            boxed = (MdLayout.boxLook((this.ownStyleOf(node))))
            if ((got.has("font-size")) && (scaled == false)) {
                def r:double (this.safeRatio(node (this.sizeRatio(node (got.get("font-size"))))))
                if ((r > 0.0) && ((fabs (r - 1.0)) > 0.001)) {
                    saved = (this.styleNumbers())
                    this.scaleStyle(saved r)
                    scaled = true
                }
            }
            if (got.has("color")) {
                def c:EVGColor (CssValue.color((got.get("color"))))
                if c.isSet {
                    style.textColor = (MdCss.hexOf(c))
                }
            }
        }
        typo = nt
        typoDepth = (typoDepth + 1)
        ; `p { color }` (a class's own colour, set above, wins)
        if (((node.kind == "paragraph") && ((strlen style.paraColor) > 0)) && (style.textColor == savedColor)) {
            if (quoteDepth == 0) {
                style.textColor = style.paraColor
            }
        }
        def plate:string (MdContainer.kindOf(node))
        ; `::: columns` / `::: col` arrange their blocks: a sheet's
        ; `container { background }` plates boxes, not them
        if ((MdColumns.isRow(node)) || (MdColumns.isCell(node))) {
            boxed = false
        }
        if (((strlen plate) == 0) && boxed) {
            if ((node.hasAttr("container")) == false) {
                plate = "box"
            }
        }
        ; a `::: container` is a plate wherever it is — they nest, with more
        ; colons outside; a block INSIDE a `{container=…}` plate gets none
        if (((strlen plate) > 0) && ((containerDepth == 0) || (node.kind == "container"))) {
            this.containerBlock(node x w plate)
        } {
            this.blockInner(node x w)
        }
        typoDepth = (typoDepth - 1)
        typo = savedTypo
        blockFamily = savedFamily
        if scaled {
            this.restoreStyle(saved)
        }
        style.textColor = savedColor
        ; only the block's own: an HTML wrapper's alignment runs on past
        ; the block that opened it, to its closing tag's
        if ((strlen own) > 0) {
            align = savedAlign
        }
        currentSrc = outerSrc
    }

    ; Whether a rule gives its block a box: a solid background, a border or
    ; padding (a gradient is no colour and gives none).
    sfn boxLook:boolean (got:CssComputed) {
        if ((strlen (MdLayout.sheetColour(got "background-color"))) > 0) { return true }
        if ((strlen (MdLayout.sheetColour(got "background"))) > 0) { return true }
        if ((strlen (MdCss.borderColour(got))) > 0) { return true }
        def pads:[double] (MdCss.padding(got))
        for pads pd:double pdi {
            if (pd > 0.0) { return true }
        }
        return false
    }

    ; `{container=box}` / `{container=bubble}` under a block: the block laid
    ; out inside a padded column, then a rounded plate under it on each page
    ; it reached — put BEFORE its boxes, so it is painted first. What colour
    ; the plate and the text are is `MdContainer.plan`'s question.
    fn containerBlock:void (node:MdNode x:double w:double kind:string) {
        def paper:string style.pageBackground
        if (paper == "transparent") { paper = "" }
        ; the block's own colour: its attribute, else what the sheet says
        ; about its classes (`.warning { background-color }`)
        def own:string (MdContainer.fillOf(node))
        def radius:double style.containerRadius
        def shadow:string style.containerShadow
        def pads:[double] ([] _:double (style.containerPadY style.containerPadX style.containerPadY style.containerPadX))
        def border:string style.containerBorder
        def borderW:double style.containerBorderWidth
        if (((strlen sheetText) > 0) && (((node.classCount()) > 0) || ((strlen node.nodeId) > 0))) {
            def got:CssComputed (this.ownStyleOf(node))
            if ((strlen own) == 0) {
                own = (MdLayout.sheetColour(got "background-color"))
            }
            if ((strlen own) == 0) {
                own = (MdLayout.sheetColour(got "background"))
            }
            if (got.has("border-radius")) {
                radius = (CssValue.fontPoints((got.get("border-radius")) radius))
            }
            if (got.has("box-shadow")) {
                shadow = (MdContainer.shadowColour((got.get("box-shadow"))))
            }
            def gp:[double] (MdCss.padding(got))
            def pi:int 0
            while (pi < 4) {
                if ((itemAt gp pi) >= 0.0) {
                    set_at pads pi (itemAt gp pi)
                }
                pi = (pi + 1)
            }
            def bc:string (MdCss.borderColour(got))
            if ((strlen bc) > 0) {
                border = bc
                borderW = (MdCss.borderWidth(got 1.0))
            }
        }
        ; A `::: warning` is a callout on the page, not text lifted off a
        ; picture: on a page of its own colour the plate `{container=box}`
        ; defaults to (that colour, nearly opaque) would not show. So with
        ; nothing said, it takes the theme's own neutral surface — the one
        ; code and table heads stand on.
        def themeFill:string style.containerBackground
        if (((strlen themeFill) == 0) && (node.kind == "container")) {
            themeFill = style.codeBackground
        }
        def p:MdContainer (MdContainer.plan(kind own themeFill radius paper style.textColor style.bodySize))
        p.shadow = shadow
        if ((itemAt pads 0) >= 0.0) { p.padY = (itemAt pads 0) }
        if ((itemAt pads 3) >= 0.0) { p.padX = (itemAt pads 3) }
        if (((strlen border) > 0) && (borderW > 0.0)) {
            p.border = border
            p.borderWidth = borderW
        }
        ; `radius=12px` and `padding=20px` (or `padding="10px 24px"`, top and
        ; bottom, then the sides) on the block, as the theme's lengths read
        if (node.hasAttr("radius")) {
            p.radius = (CssValue.fontPoints((node.attrValue("radius")) p.radius))
        }
        if (node.hasAttr("padding")) {
            def apads:[string] (strsplit (trim (node.attrValue("padding"))) " ")
            def pv:[string]
            for apads pp:string pi {
                if ((strlen pp) > 0) {
                    push pv pp
                }
            }
            if ((array_length pv) > 0) {
                p.padY = (CssValue.fontPoints((itemAt pv 0) p.padY))
                p.padX = p.padY
                if ((array_length pv) > 1) {
                    p.padX = (CssValue.fontPoints((itemAt pv 1) p.padX))
                }
            }
        }
        ; A chart or diagram (`{container=box}` under its fence) keeps the
        ; column it was drawn for — the drawing is cached by that width, so a
        ; narrower column would find none — and the plate hugs the drawing,
        ; which has room of its own round its axes and labels.
        if (node.kind == "embed") {
            p.padX = 0.0
            p.hug = true
            p.tail = 0.0
        }
        def savedInk:string style.textColor
        if ((strlen p.ink) > 0) {
            style.textColor = p.ink
        }
        def savedPlate:string plateFill
        def savedPlatePaper:string platePaper
        plateFill = p.fill
        platePaper = paper
        def before:int (array_length boxes)
        def startPage:int page
        def top:double cursorY
        cursorY = (cursorY + p.padY)
        containerDepth = (containerDepth + 1)
        this.blockInner(node (x + p.padX) (w - (p.padX * 2.0)))
        containerDepth = (containerDepth - 1)
        style.textColor = savedInk
        plateFill = savedPlate
        platePaper = savedPlatePaper
        def plates:[MdBox] (this.plates(p before startPage top x w))
        if ((array_length plates) == 0) { return }
        def last:MdBox (itemAt plates ((array_length plates) - 1))
        ; the block's own space after it, kept below the plate (and its tail)
        def inkBottom:double ((last.y + last.h) - p.padY)
        def gap:double (cursorY - inkBottom)
        if (gap < 0.0) { gap = 0.0 }
        this.insertBoxes(before plates)
        cursorY = (((last.y + last.h) + p.tail) + gap)
    }

    ; One plate per page the block's boxes are on, from `before`.
    fn plates:[MdBox] (p:MdContainer before:int startPage:int top:double x:double w:double) {
        def out:[MdBox]
        def n:int (array_length boxes)
        def pg:int startPage
        while (pg <= page) {
            def minY:double 0.0
            def maxY:double 0.0
            def minX:double 0.0
            def maxX:double 0.0
            def any:boolean false
            def i:int before
            while (i < n) {
                def b:MdBox (itemAt boxes i)
                if ((b.page == pg) && (b.retold == false)) {
                    def bx0:double b.x
                    def bx1:double (b.x + b.w)
                    ; a drawing narrower than its column: where it is drawn
                    if (b.kind == 3) {
                        def ei:int (embeds.find(b.embedKind b.embedSource b.w))
                        if (ei >= 0) {
                            def e:MdEmbedEntry (embeds.entryAt(ei))
                            if (e.ok && (e.width > 0.0)) {
                                bx0 = (b.x + (e.shiftIn(b.w)))
                                if (e.width < b.w) {
                                    bx1 = (bx0 + e.width)
                                }
                            }
                        }
                    }
                    if ((! any) || (b.y < minY)) { minY = b.y }
                    if ((! any) || ((b.y + b.h) > maxY)) { maxY = (b.y + b.h) }
                    if ((! any) || (bx0 < minX)) { minX = bx0 }
                    if ((! any) || (bx1 > maxX)) { maxX = bx1 }
                    any = true
                }
                i = (i + 1)
            }
            if any {
                def pt:double (minY - p.padY)
                if ((pg == startPage) && (top < pt)) { pt = top }
                def px:double x
                def pw:double w
                if p.hug {
                    px = (minX - p.padX)
                    if (px < x) { px = x }
                    pw = ((maxX + p.padX) - px)
                    if ((px + pw) > (x + w)) { pw = ((x + w) - px) }
                }
                def ph:double ((maxY + p.padY) - pt)
                ; a soft shadow (`box-shadow`): three layers under the plate,
                ; each a little larger, lower and fainter
                if ((strlen p.shadow) > 0) {
                    def sc:EVGColor (EVGColor.parse(p.shadow))
                    def li:int 3
                    while (li >= 1) {
                        def g:double (to_double li)
                        def a:double (0.05 + (0.03 * (3.0 - g)))
                        def layer:MdBox (MdBox.rect((px - g) (pt + (g * 1.5)) (pw + (g * 2.0)) (ph + g) (MdContainer.hexOf((EVGColor.rgba((sc.red()) (sc.green()) (sc.blue()) a))))))
                        layer.radius = (p.radius + g)
                        layer.page = pg
                        layer.srcStart = currentSrc
                        push out layer
                        li = (li - 1)
                    }
                }
                def plate:MdBox (MdBox.rect(px pt pw ph p.fill))
                plate.radius = p.radius
                plate.page = pg
                plate.srcStart = currentSrc
                if (pg == page) {
                    plate.tail = p.tail
                }
                push out plate
                ; `border: 2pt solid …`: a line round the plate, inside it
                if ((strlen p.border) > 0) {
                    def half:double (p.borderWidth * 0.5)
                    def edge:MdBox (MdBox.outline((px + half) (pt + half) (pw - p.borderWidth) (ph - p.borderWidth) p.border p.borderWidth))
                    edge.radius = p.radius
                    edge.page = pg
                    edge.srcStart = currentSrc
                    push out edge
                }
            }
            pg = (pg + 1)
        }
        return out
    }

    ; `add` put into the box list at `at`, ahead of what is there
    fn insertBoxes:void (at:int add:[MdBox]) {
        def out:[MdBox]
        def n:int (array_length boxes)
        def i:int 0
        while (i < n) {
            if (i == at) {
                for add a:MdBox k {
                    push out a
                }
            }
            push out (itemAt boxes i)
            i = (i + 1)
        }
        if (at >= n) {
            for add a2:MdBox k2 {
                push out a2
            }
        }
        boxes = out
        pageIndexReady = false
    }

    ; How a heading or paragraph sets its lines: `{.center}`, `{.right}`,
    ; `{.left}` or `{align=center}` under it, else the sheet's `text-align`
    ; for it (`h1 { text-align: center }`, `.lead { text-align: center }`);
    ; "" leaves the alignment it is in (an HTML wrapper's, or the left).
    ; Lists, tables and code keep theirs: a centred list item would leave
    ; its bullet behind.
    fn blockAlign:string (node:MdNode) {
        if ((node.kind != "paragraph") && (node.kind != "heading")) {
            return ""
        }
        if (node.hasClass("center")) {
            return "center"
        }
        if (node.hasClass("right")) {
            return "right"
        }
        if (node.hasClass("left")) {
            return "left"
        }
        def said:string (MdLayout.alignOfWord((MdCss.alignWord((node.attrValue("align"))))))
        if ((strlen said) > 0) {
            return said
        }
        if ((indexOf sheetText "text-align") < 0) {
            return ""
        }
        def got:CssComputed (this.styleOf(node))
        if (got.has("text-align")) {
            return (MdLayout.alignOfWord((MdCss.alignWord((got.get("text-align"))))))
        }
        return ""
    }

    ; MdCss.alignWord's answer as the layout's: "center", "right", "left"
    sfn alignOfWord:string (w:string) {
        if (w == "center") {
            return "center"
        }
        if (w == "end") {
            return "right"
        }
        if (w == "start") {
            return "left"
        }
        return ""
    }

    ; A block's `font-size` as a multiple of what it would have had: `1.3em`
    ; and `130%` say so directly, `26pt` against the sheet's size for the
    ; block's kind (the document's, or the heading level's) — a ratio, so a
    ; slide that was shrunk to fit shrinks the block with it.
    ; The multiple, cut where it would take a size out of the font range.
    ; `scaleStyle` scales every size, not only the block's own — a title said
    ; again on the slide the block spills onto is set in the scaled heading
    ; size — so the largest of them is the one that is held to the range.
    fn safeRatio:double (node:MdNode r:double) {
        def base:double style.bodySize
        def sizes:[double] ([] _:double (style.h1Size style.h2Size style.h3Size style.h4Size style.h5Size style.h6Size style.codeSize))
        def i:int 0
        while (i < (array_length sizes)) {
            if ((itemAt sizes i) > base) {
                base = (itemAt sizes i)
            }
            i = (i + 1)
        }
        if (r <= 1.0) {
            return (MdCssLimits.ratio(r style.bodySize style.pageWidth style.pageHeight))
        }
        return (MdCssLimits.ratio(r base style.pageWidth style.pageHeight))
    }

    fn sizeRatio:double (node:MdNode value:string) {
        def t:string (CssSheet.lower((CssSheet.tidy(value))))
        def n:int (strlen t)
        if ((n > 2) && ((substring t (n - 2) n) == "em")) {
            return (?? (str2double (substring t 0 (n - 2))) 1.0)
        }
        if ((n > 1) && ((substring t (n - 1) n) == "%")) {
            return ((?? (str2double (substring t 0 (n - 1))) 100.0) / 100.0)
        }
        def tag:string "document"
        def fallback:double style.bodySize
        if (node.kind == "heading") {
            tag = ("h" + (to_string node.level))
            fallback = (style.headingSize(node.level))
        }
        def base:double fallback
        def b:CssComputed (sheet.forTag(tag))
        if (b.has("font-size")) {
            base = (CssValue.fontPoints((b.get("font-size")) fallback))
        }
        if (base <= 0.0) {
            return 1.0
        }
        return ((CssValue.fontPoints(value base)) / base)
    }

    ; ----------------------------------------------------------------------
    ; Columns
    ; ----------------------------------------------------------------------
    ;
    ; ```md
    ; - Verkkokauppa kasvoi 18 %
    ; - Jälleenmyynti pysyi ennallaan
    ; - Lisenssit laskivat 4 %
    ; {.c3}
    ; ```
    ;
    ; A block the sheet gives `column-count` to is laid out ONCE at the width
    ; of one column, and the boxes that came out are then cut into columns and
    ; moved. Laying each column out separately would be the obvious thing and
    ; it is wrong twice over: a list's marker width is measured across the
    ; whole list, and an item that wrapped differently in a narrower pass
    ; would change the balance it was being balanced by.
    ;
    ; **The unit is the ITEM, not the line.** `PLAN_SLIDES.md` Stage C: in
    ; document order DOWN each column, and the columns differ by at most one
    ; item. A line-level flow reads better in a newspaper and is unreadable in
    ; a deck, where a bullet split across two columns is a bullet nobody can
    ; follow.
    ;
    ; Which boxes belong to which item is read off the boxes themselves: each
    ; carries the source offset of the block it came from. A box whose offset
    ; is inside no item — a list's own bullet marker is emitted by the list,
    ; not by the item — joins the group before it, which is where it was
    ; drawn.
    fn columnCount:int (node:MdNode) {
        if ((strlen sheetText) == 0) { return 1 }
        if (! (MdLayout.canColumn(node.kind))) { return 1 }
        def got:CssComputed (this.styleOf(node))
        if (! (got.has("column-count"))) { return 1 }
        def n@(optional):int (str2int (CssSheet.tidy((got.get("column-count")))))
        def cols:int (?? n 1)
        if (cols < 2) { return 1 }
        if (cols > 8) { return 8 }
        return cols
    }

    ; Only a block whose children are themselves blocks. A paragraph in three
    ; columns would be a line flow and is a different feature; saying so is
    ; better than cutting a sentence into thirds by accident.
    sfn canColumn:boolean (kind:string) {
        if (kind == "list") { return true }
        if (kind == "block_quote") { return true }
        return false
    }

    fn columnGap:double (node:MdNode) {
        def got:CssComputed (this.styleOf(node))
        if (! (got.has("column-gap"))) { return 18.0 }
        def g:double (CssValue.fontPoints((got.get("column-gap")) 18.0))
        return (MdCssLimits.clampKind("space" g style.pageWidth style.pageHeight))
    }

    fn columnFlow:void (node:MdNode x:double w:double cols:int gap:double) {
        def colW:double ((w - (gap * (int2double (cols - 1)))) / (int2double cols))
        if (colW < 24.0) {
            this.blockPlain(node x w)
            return
        }
        def from:int (array_length boxes)
        def top:double cursorY
        def h:double (this.columnPass(node x colW cols gap top from))
        ; In a paginated layout a block cut into columns is cut as a whole, so
        ; it either fits where it is or starts a sheet of its own. It cannot
        ; be asked to fit before it has been laid out, so it is laid out, and
        ; laid out again from the top of the next sheet when it does not.
        if paginate {
            if ((top + h) > contentBottom) {
                if ((contentTop + h) <= contentBottom) {
                    this.truncate(from)
                    page = (page + 1)
                    pageCount = (page + 1)
                    top = contentTop
                    h = (this.columnPass(node x colW cols gap top from))
                }
            }
        }
        cursorY = (top + h)
    }

    ; ----------------------------------------------------------------------
    ; Blocks side by side (`::: columns`, `{layout=columns}`; MdColumns)
    ; ----------------------------------------------------------------------
    ;
    ; Which block goes in which column and how wide each is is MdColumns'
    ; plan; here the columns are laid out one after the other from the same
    ; top, and the block ends under the longest. A picture or chart in a
    ; column is given the column's room less what is under it in the same
    ; column, as on a slide of its own. On a slide where the columns do not
    ; fit under what is above them, they start the next slide when they fit
    ; there whole.
    ;
    ; while > 0: inside columns (a column that runs onto the next slide puts
    ; the next column's spill under the title said there, not a second one)
    def columnsOn:int 0
    def colSpillPage:int -1
    def colSpillTop:double 0.0
    ; the srcStart of a block whose `width=` made its column's width: it
    ; fills the column (its own `width=` is read as done)
    def takenSrc:int -2

    ; a block's `width=`, or "" when its column took it
    fn widthAttr:string (node:MdNode) {
        if (node.srcStart == takenSrc) { return "" }
        return (node.attrValue("width"))
    }

    fn columnsBlock:void (node:MdNode x:double w:double) {
        def plan:MdColumnsPlan (MdColumns.plan(node))
        def li:int 0
        while (li < (array_length plan.lead)) {
            this.block((node.childAt((itemAt plan.lead li))) x w)
            li = (li + 1)
        }
        if ((plan.count()) == 0) { return }
        def from:int (array_length boxes)
        def startPage:int page
        def top:double cursorY
        def overflows:int slideOverflows
        this.columnsPass(node plan x w top)
        if ((paginate && (page > startPage)) && ((top - contentTop) > 0.5)) {
            ; does it fit at the top of a slide of its own?
            def endPage:int page
            def endY:double cursorY
            this.truncate(from)
            page = startPage
            pageCount = (page + 1)
            slideOverflows = overflows
            cursorY = contentTop
            this.nextSlide()
            if slides {
                this.emitSlideTitle()
            }
            def freshPage:int page
            this.columnsPass(node plan x w cursorY)
            if (page != freshPage) {
                ; no: as it was
                this.truncate(from)
                page = startPage
                pageCount = (page + 1)
                slideOverflows = overflows
                cursorY = top
                this.columnsPass(node plan x w top)
            }
        }
    }

    fn columnsPass:void (node:MdNode plan:MdColumnsPlan x:double w:double top:double) {
        def xs:[double] (plan.lefts(x w))
        def ws:[double] (plan.widths(w))
        def startPage:int page
        def endPage:int page
        def endY:double top
        def savedTaken:int takenSrc
        def savedSpill:int colSpillPage
        def savedSpillTop:double colSpillTop
        columnsOn = (columnsOn + 1)
        colSpillPage = -1
        def g:int 0
        while (g < (plan.count())) {
            def grp:[int] (itemAt plan.groups g)
            def cx:double (itemAt xs g)
            def cw:double (itemAt ws g)
            page = startPage
            cursorY = top
            def k:int 0
            while (k < (array_length grp)) {
                def ci:int (itemAt grp k)
                def child:MdNode (node.childAt(ci))
                takenSrc = -2
                if (plan.isTaken(ci)) {
                    takenSrc = child.srcStart
                }
                ; a picture or chart leaves room for what is under it in
                ; its column
                followH = 0.0
                followBeside = false
                if (slides && ((k + 1) < (array_length grp))) {
                    if (MdColumns.isMedia(child)) {
                        followH = (this.measureNodes(node grp (k + 1) cw))
                    }
                }
                this.block(child cx cw)
                followH = 0.0
                k = (k + 1)
            }
            if ((page > endPage) || ((page == endPage) && (cursorY > endY))) {
                endPage = page
                endY = cursorY
            }
            g = (g + 1)
        }
        takenSrc = savedTaken
        columnsOn = (columnsOn - 1)
        colSpillPage = savedSpill
        colSpillTop = savedSpillTop
        page = endPage
        if ((page + 1) > pageCount) {
            pageCount = (page + 1)
        }
        cursorY = endY
    }

    ; How tall children `idx[from…]` of `parent` are at width `w`, laid out
    ; from the top and taken back (as `measureBlocks`).
    fn measureNodes:double (parent:MdNode idx:[int] from:int w:double) {
        def savedBoxes:int (array_length boxes)
        def savedY:double cursorY
        def savedPage:int page
        def savedPageCount:int pageCount
        def savedOverflows:int slideOverflows
        def savedHeads:int (array_length headText)
        def savedHiddenOn:int hiddenOnPage
        def savedTaken:int takenSrc
        def wasPaginate:boolean paginate
        paginate = false
        cursorY = 0.0
        def j:int from
        while (j < (array_length idx)) {
            takenSrc = -2
            this.block((parent.childAt((itemAt idx j))) contentX w)
            j = (j + 1)
        }
        def h:double cursorY
        paginate = wasPaginate
        this.truncate(savedBoxes)
        while ((array_length headText) > savedHeads) {
            removeLast headText
            removeLast headLevel
            removeLast headPage
            removeLast headY
        }
        hiddenOnPage = savedHiddenOn
        takenSrc = savedTaken
        cursorY = savedY
        page = savedPage
        pageCount = savedPageCount
        slideOverflows = savedOverflows
        return h
    }

    ; ----------------------------------------------------------------------
    ; Where a slide's content sits (`valign=`, `layout=section|statement`;
    ; MdSlideLayout)
    ; ----------------------------------------------------------------------
    ;
    ; Each slide is laid out from the top as before; once it has been
    ; shrunk or grown, `alignSlides` moves its content down to where its
    ; title said. The slides are found by their titles' source (the pages
    ; renumber when a slide is shrunk into the one before it).
    def deckPlace:string ""
    def placeSrc:[int]
    def placeWord:[string]
    ; laying out a section or statement slide: lines centred
    def slideCenter:boolean false
    ; …a statement: its text at the title's size
    def slideStatement:boolean false
    ; …a statement that is only its title
    def slideStatementAlone:boolean false

    fn notePlace:void (title:MdNode hasBody:boolean) {
        def word:string (MdSlideLayout.wordOf(title deckPlace))
        slideCenter = (MdSlideLayout.whole(word))
        slideStatement = (word == "statement")
        slideStatementAlone = (slideStatement && (hasBody == false))
        if ((strlen word) == 0) { return }
        def i:int (indexOf placeSrc title.srcStart)
        if (i >= 0) {
            set_at placeWord i word
            return
        }
        push placeSrc title.srcStart
        push placeWord word
    }

    ; how much larger block `node` is set on a statement slide
    fn statementRatio:double (node:MdNode) {
        if (! slideStatement) { return 1.0 }
        if (containerDepth > 0) { return 1.0 }
        if (node.kind == "heading") {
            if (slideStatementAlone && (node.level <= splitLevel)) { return 1.5 }
            return 1.0
        }
        if (node.kind != "paragraph") { return 1.0 }
        if (style.bodySize <= 0.0) { return 1.0 }
        ; a short statement (a line or two, as the slide is for) at one and
        ; a half times the title's size, as a statement that is only its
        ; title is; a longer one at the title's size
        def r:double ((style.headingSize(slideTitleLevel)) / style.bodySize)
        if ((MdLayout.wordCount((node.plainText()))) <= 12) {
            r = (r * 1.5)
        }
        if (r < 1.0) { return 1.0 }
        return (this.safeRatio(node r))
    }

    sfn wordCount:int (t:string) {
        def n:int 0
        def parts:[string] (strsplit (trim t) " ")
        for parts w:string wi {
            if ((strlen (trim w)) > 0) {
                n = (n + 1)
            }
        }
        return n
    }

    fn alignSlides:void () {
        if ((array_length placeSrc) == 0) { return }
        ; the word for each page, from the title on it
        def word:[string]
        def tsrc:[int]
        def p0:int 0
        while (p0 < pageCount) {
            push word ""
            push tsrc -1
            p0 = (p0 + 1)
        }
        def i:int 0
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            if (((b.retold == false) && (b.furniture == 0)) && ((b.page >= 0) && (b.page < pageCount))) {
                def k:int (indexOf placeSrc b.srcStart)
                if ((k >= 0) && ((strlen (itemAt word b.page)) == 0)) {
                    set_at word b.page (itemAt placeWord k)
                    set_at tsrc b.page b.srcStart
                }
            }
            i = (i + 1)
        }
        ; a hidden title draws nothing: its page is where it was noted
        def h:int 0
        while (h < (array_length placeSrc)) {
            def hp:int (this.pageOfHidden((itemAt placeSrc h)))
            if (((hp >= 0) && (hp < pageCount)) && ((strlen (itemAt word hp)) == 0)) {
                set_at word hp (itemAt placeWord h)
                set_at tsrc hp (itemAt placeSrc h)
            }
            h = (h + 1)
        }
        def p:int 0
        while (p < pageCount) {
            def w:string (itemAt word p)
            if ((strlen w) > 0) {
                this.alignPage(p w (itemAt tsrc p))
            }
            p = (p + 1)
        }
        pageIndexReady = false
    }

    fn movable:boolean (b:MdBox p:int) {
        if (b.page != p) { return false }
        if (b.pinned || (b.furniture != 0)) { return false }
        return true
    }

    fn alignPage:void (p:int w:string title:int) {
        def whole:boolean (MdSlideLayout.whole(w))
        def top:double 0.0
        def bottom:double 0.0
        def any:boolean false
        def i:int 0
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            if (this.movable(b p)) {
                if (whole || (b.srcStart != title)) {
                    if ((! any) || (b.y < top)) { top = b.y }
                    if ((! any) || ((b.y + b.h) > bottom)) { bottom = (b.y + b.h) }
                    any = true
                }
            }
            i = (i + 1)
        }
        if (! any) { return }
        def foot:double (contentBottom - (this.noteRoomOn(p)))
        def d:double (MdSlideLayout.shift(w top bottom contentTop foot))
        if (d < 0.5) { return }
        def k:int 0
        while (k < (array_length boxes)) {
            def c:MdBox (itemAt boxes k)
            if (this.movable(c p)) {
                if (whole || (c.srcStart != title)) {
                    c.y = (c.y + d)
                }
            }
            k = (k + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; A picture in a corner of the slide (`{float=top-right width=8%}`)
    ; ----------------------------------------------------------------------
    ;
    ; Out of the flow: drawn in the corner of the content area, `pinned`
    ; (a centred slide does not move it), and nothing goes under it — the
    ; slide's title is set narrower (`cornerInset`) and the text after it
    ; beside it, down to its foot, as beside any narrow picture (FLOAT).
    fn pinPicture:void (node:MdNode corner:string path:string img:MdNode st:VfsStat) {
        def fw:double ((MdSlideLayout.topCornerShare(node)) * contentW)
        if ((indexOf corner "bottom") == 0) {
            def v:string (trim (node.attrValue("width")))
            fw = (MdEmbedKinds.widthOf(v contentW))
            if ((strlen v) == 0) { fw = (contentW * 0.12) }
        }
        def fh:double (fw * 0.5)
        if ((st.pixelW > 0) && (st.pixelH > 0)) {
            fh = (fw * ((to_double st.pixelH) / (to_double st.pixelW)))
        }
        def most:double ((contentBottom - contentTop) * 0.3)
        if (fh > most) {
            fw = (fw * (most / fh))
            fh = most
        }
        def px:double contentX
        if ((indexOf corner "right") > 0) {
            px = ((contentX + contentW) - fw)
        }
        def py:double contentTop
        if ((indexOf corner "bottom") == 0) {
            py = (contentBottom - fh)
        }
        def b:MdBox (new MdBox())
        b.kind = 4
        b.x = px
        b.y = py
        b.w = fw
        b.h = fh
        b.imagePath = path
        b.imageAlt = (img.plainText())
        b.imageNaturalW = st.pixelW
        b.imageNaturalH = st.pixelH
        b.pinned = true
        this.emit(b)
        ; the text after it, beside it while it is above its foot
        if (((indexOf corner "top") == 0) && (cursorY < (py + fh))) {
            def gap:double (style.bodySize * 1.2)
            floatOn = true
            floatPage = page
            floatBottom = (py + fh)
            floatW = ((contentW - fw) - gap)
            floatX = contentX
            if ((indexOf corner "left") > 0) {
                floatX = ((contentX + fw) + gap)
            }
        }
    }

    ; The block of slide-title `i`'s slide that is pinned in a top corner,
    ; or an empty node.
    fn cornerNode:MdNode (doc:MdNode i:int) {
        def j:int i
        while (MdLayout.bodyFollows(doc j splitLevel)) {
            def c:MdNode (doc.childAt((j + 1)))
            if ((c.kind == "paragraph") && ((MdSlideLayout.topCornerShare(c)) > 0.0)) {
                if ((MdLayout.loneImage(c)).kind == "image") { return c }
            }
            j = (j + 1)
        }
        return (new MdNode())
    }

    ; how much of the width (0..1) that corner block takes, 0 for none
    fn cornerInset:double (doc:MdNode i:int) {
        def c:MdNode (this.cornerNode(doc i))
        if (c.kind != "paragraph") { return 0.0 }
        return (MdSlideLayout.topCornerShare(c))
    }

    ; ----------------------------------------------------------------------
    ; Growing a slide that has room
    ; ----------------------------------------------------------------------
    ; ----------------------------------------------------------------------
    ; Shrinking a slide that spills a little
    ; ----------------------------------------------------------------------
    ;
    ; A slide whose last block runs over by a line or an item gets a slide of
    ; its own for that remainder: the title again and one bullet. Or the
    ; last row of a table and the sentence after it: blocks that START on
    ; the continuation and end there are part of the spill too, as long as
    ; none of them would have started a slide of its own anyway.
    ; When the spill is short — at most `slideShrinkSpill` of a slide — and
    ; that continuation holds nothing else, the slide is laid out again a step
    ; smaller, down to `slideShrinkMin`, and kept at the first size where it
    ; fits. The continuation goes, and every later slide moves up one.
    def slideShrinkMin:double 0.8
    def slideShrinkSpill:double 0.3
    ; A TABLE that runs over is set smaller by itself — its text and cell
    ; padding, the title and the lead above it as they were — and further:
    ; ten rows on a dark theme's 20pt body spilled half a table, where 14pt
    ; holds them on one slide. Down to `tableShrinkMin` of its size, for a
    ; spill of at most `tableShrinkSpill` of a slide.
    def tableShrinkMin:double 0.6
    def tableShrinkSpill:double 0.8

    fn shrinkSlides:void (doc:MdNode) {
        def n:int (doc.childCount())
        if ((array_length blockFirstPage) != n) {
            return
        }
        def p:int 0
        while ((p + 1) < pageCount) {
            this.shrinkSlide(doc p)
            p = (p + 1)
        }
    }

    fn shrinkSlide:boolean (doc:MdNode p:int) {
        def n:int (doc.childCount())
        ; the blocks that start on p (the last of them may run on to p + 1),
        ; then those that start on p + 1 and end there
        def members:[int]
        def spanning:int -1
        def extras:int 0
        def i:int 0
        while (i < n) {
            def fp:int (itemAt blockFirstPage i)
            def lp:int (itemAt blockLastPage i)
            if ((fp < p) && (lp >= p)) {
                return false
            }
            if (fp == (p + 1)) {
                def ex:MdNode (doc.childAt(i))
                if (lp != (p + 1)) {
                    return false
                }
                if (ex.hasClass("slide")) {
                    return false
                }
                ; a heading there may have been a break the rules chose
                if (ex.kind == "heading") {
                    return false
                }
                push members i
                extras = (extras + 1)
            }
            if (fp == p) {
                if (extras > 0) {
                    return false
                }
                push members i
                if (lp == (p + 1)) {
                    spanning = i
                } {
                    if (lp != p) {
                        return false
                    }
                }
            }
            i = (i + 1)
        }
        if ((array_length members) == extras) {
            return false
        }
        if ((spanning < 0) && (extras == 0)) {
            return false
        }
        if (spanning >= 0) {
            if ((itemAt members (((array_length members) - extras) - 1)) != spanning) {
                return false
            }
        }
        ; how much went over, and where the two slides' boxes are
        ; what spilled, not counting the title said again above it
        def b0:int -1
        def b1:int -1
        def spillTop:double contentBottom
        def spillBottom:double contentTop
        def k:int 0
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt boxes k)
            if ((b.page == p) || (b.page == (p + 1))) {
                if (b0 < 0) { b0 = k }
                b1 = (k + 1)
                if (b.kind == 3) {
                    return false
                }
                def isTitle:boolean ((b.kind == 0) && (b.segSrc < 0))
                if ((b.page == (p + 1)) && (isTitle == false)) {
                    if (b.y < spillTop) { spillTop = b.y }
                    if ((b.y + b.h) > spillBottom) { spillBottom = (b.y + b.h) }
                }
            }
            k = (k + 1)
        }
        ; a table spread evenly over the two slides put more on the second
        ; than filling the first would have: what would have spilled
        def spill:double ((spillBottom - spillTop) - (this.spillExcessAt((p + 1))))
        def room:double (contentBottom - contentTop)
        def tableOnly:boolean false
        if ((spanning >= 0) && (extras == 0)) {
            def sb:MdNode (doc.childAt(spanning))
            tableOnly = (sb.kind == "table")
        }
        def most:double slideShrinkSpill
        def least:double slideShrinkMin
        if tableOnly {
            most = tableShrinkSpill
            least = tableShrinkMin
        }
        if ((b0 < 0) || (spill > (room * most))) {
            return false
        }
        def kept:[MdBox]
        def m:int b0
        while (m < b1) {
            push kept (itemAt boxes m)
            m = (m + 1)
        }
        def tail:[MdBox]
        m = b1
        while (m < (array_length boxes)) {
            push tail (itemAt boxes m)
            m = (m + 1)
        }
        def saved:[double] (this.styleNumbers())
        def savedPage:int page
        def savedPageCount:int pageCount
        def savedCursor:double cursorY
        def savedOverflows:int slideOverflows
        def sc:double 0.95
        while (sc >= (least - 0.001)) {
            this.truncate(b0)
            if tableOnly {
                this.scaleTable(saved sc)
            } {
                this.scaleStyle(saved sc)
            }
            page = p
            pageCount = (p + 1)
            cursorY = contentTop
            this.resumeContinuation(p)
            floatOn = false
            def j:int 0
            while (j < (array_length members)) {
                this.relayoutBlock(doc (itemAt members j))
                j = (j + 1)
            }
            this.endFloat()
            def fits:boolean (page == p)
            this.restoreStyle(saved)
            if fits {
                ; the continuation is gone: every later slide moves up one
                def t:int 0
                while (t < (array_length tail)) {
                    def tb:MdBox (itemAt tail t)
                    tb.page = (tb.page - 1)
                    push boxes tb
                    t = (t + 1)
                }
                def q:int 0
                while (q < n) {
                    if ((itemAt blockFirstPage q) > p) {
                        set_at blockFirstPage q ((itemAt blockFirstPage q) - 1)
                    }
                    if ((itemAt blockLastPage q) > p) {
                        set_at blockLastPage q ((itemAt blockLastPage q) - 1)
                    }
                    q = (q + 1)
                }
                this.dropSpillExcess((p + 1))
                this.dropContinuation((p + 1))
                this.pagesMovedUp(p)
                page = (savedPage - 1)
                pageCount = (savedPageCount - 1)
                cursorY = savedCursor
                slideOverflows = (savedOverflows - 1)
                if (slideOverflows < 0) {
                    slideOverflows = 0
                }
                slidesShrunk = (slidesShrunk + 1)
                return true
            }
            sc = (sc - 0.05)
        }
        ; nothing smaller fitted: the two slides as they were
        this.truncate(b0)
        def r:int 0
        while (r < (array_length kept)) {
            push boxes (itemAt kept r)
            r = (r + 1)
        }
        r = 0
        while (r < (array_length tail)) {
            push boxes (itemAt tail r)
            r = (r + 1)
        }
        page = savedPage
        pageCount = savedPageCount
        cursorY = savedCursor
        slideOverflows = savedOverflows
        return false
    }

    ; One block of a slide laid out again (shrunk or grown), keeping the
    ; title and the section current as `bodyPass` does, so a continuation
    ; it runs onto says the right ones.
    fn relayoutBlock:void (doc:MdNode i:int) {
        def child:MdNode (doc.childAt(i))
        if scoped {
            this.scopeAtBlock(doc i)
        }
        if (child.kind == "heading") {
            this.clearSection()
            if (child.level <= splitLevel) {
                slideTitle = (child.plainText())
                slideTitleLevel = child.level
                slideTitleHidden = (MdLayout.hiddenHeading(child))
                this.notePlace(child (MdLayout.bodyFollows(doc i splitLevel)))
            }
        }
        this.placeBlock(doc i false)
        if ((child.kind == "heading") && (child.level > splitLevel)) {
            sectionTitle = (child.plainText())
            sectionLevel = child.level
            sectionHidden = (MdLayout.hiddenHeading(child))
        }
    }

    fn growSlides:void (doc:MdNode) {
        def n:int (doc.childCount())
        if ((array_length blockFirstPage) != n) {
            return
        }
        def p:int 0
        while (p < pageCount) {
            this.growSlide(doc p)
            p = (p + 1)
        }
    }

    fn growSlide:void (doc:MdNode p:int) {
        def n:int (doc.childCount())
        def mediaW:[double]
        def mediaH:[double]
        ; the blocks of this slide, none spilling into or out of it
        def members:[int]
        def i:int 0
        while (i < n) {
            def fp:int (itemAt blockFirstPage i)
            def lp:int (itemAt blockLastPage i)
            if (fp == p) {
                if (lp != p) {
                    return
                }
                push members i
            } {
                if ((fp < p) && (lp >= p)) {
                    return
                }
            }
            i = (i + 1)
        }
        if ((array_length members) == 0) {
            return
        }
        ; its boxes, which are one run: pages only ever go forward
        def b0:int -1
        def b1:int -1
        def bottom:double contentTop
        def k:int 0
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt boxes k)
            if (b.page == p) {
                if (b0 < 0) { b0 = k }
                b1 = (k + 1)
                ; a picture or chart may stay as it is while the text grows
                ; (beside it, or in a column of its own): the slide grows
                ; only when every one of them keeps its size
                if (((b.kind == 3) || ((strlen b.imagePath) > 0)) && (b.pinned == false)) {
                    push mediaW b.w
                    push mediaH b.h
                }
                if ((b.y + b.h) > bottom) { bottom = (b.y + b.h) }
            }
            k = (k + 1)
        }
        if (b0 < 0) {
            return
        }
        def room:double (contentBottom - contentTop)
        def used:double (bottom - contentTop)
        def hasMedia:boolean ((array_length mediaW) > 0)
        if (used <= 0.0) {
            return
        }
        ; a picture or chart that keeps its size may be what makes the slide
        ; full: the text beside it can still grow, down to that same foot
        if ((used >= (room * slideGrowFill)) && (hasMedia == false)) {
            return
        }
        ; …and with one, what is checked is the boxes' foot, not the cursor
        ; (the space after a chart grows with the text and is no box)
        def limit:double (contentTop + (room * (slideGrowFill + 0.1)))
        if (hasMedia && (bottom > limit)) { limit = contentBottom }
        ; the first guess from the height; text wraps more as it grows, so
        ; each try is laid out and checked, a step smaller when it does not fit
        def s:double ((room * slideGrowFill) / used)
        ; with a picture or chart the room the text has is not the slide's
        ; height: each size from the largest down is tried
        if hasMedia { s = slideGrow }
        if (s > slideGrow) { s = slideGrow }
        def kept:[MdBox]
        def m:int b0
        while (m < b1) {
            push kept (itemAt boxes m)
            m = (m + 1)
        }
        def tail:[MdBox]
        m = b1
        while (m < (array_length boxes)) {
            push tail (itemAt boxes m)
            m = (m + 1)
        }
        def saved:[double] (this.styleNumbers())
        def headsBefore:int (MdLayout.headingLines(kept 0 (array_length kept) ((itemAt saved 0) * 1.15)))
        def savedPage:int page
        def savedPageCount:int pageCount
        def savedCursor:double cursorY
        def savedOverflows:int slideOverflows
        while (s > 1.04) {
            this.truncate(b0)
            this.growStyle(saved s)
            page = p
            cursorY = contentTop
            this.resumeContinuation(p)
            floatOn = false
            growTrial = true
            def j:int 0
            while (j < (array_length members)) {
                this.relayoutBlock(doc (itemAt members j))
                j = (j + 1)
            }
            this.endFloat()
            growTrial = false
            ; …and a heading that was one line stays one line: a title
            ; broken in two to be larger is not larger, it is worse
            def headsNow:int (MdLayout.headingLines(boxes b0 (array_length boxes) ((itemAt saved 0) * s * 1.15)))
            def reach:double cursorY
            if hasMedia { reach = (this.footOn(b0 p)) }
            def fits:boolean (((page == p) && (reach <= (limit + 0.5))) && (headsNow <= headsBefore))
            if (fits && ((array_length mediaW) > 0)) {
                fits = (this.mediaKept(b0 p mediaW mediaH))
            }
            this.restoreStyle(saved)
            page = savedPage
            pageCount = savedPageCount
            cursorY = savedCursor
            slideOverflows = savedOverflows
            if fits {
                def t:int 0
                while (t < (array_length tail)) {
                    push boxes (itemAt tail t)
                    t = (t + 1)
                }
                slidesGrown = (slidesGrown + 1)
                return
            }
            s = (s - 0.08)
        }
        ; nothing larger fitted: the slide as it was
        this.truncate(b0)
        def r:int 0
        while (r < (array_length kept)) {
            push boxes (itemAt kept r)
            r = (r + 1)
        }
        r = 0
        while (r < (array_length tail)) {
            push boxes (itemAt tail r)
            r = (r + 1)
        }
    }

    ; The lowest edge of the boxes from `from` on page `p`.
    fn footOn:double (from:int p:int) {
        def foot:double contentTop
        def k:int from
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt boxes k)
            if ((b.page == p) && ((b.y + b.h) > foot)) { foot = (b.y + b.h) }
            k = (k + 1)
        }
        return foot
    }

    ; Whether the pictures and charts from box `from` on page `p` are the
    ; sizes `ws`×`hs` they were, in the same order.
    fn mediaKept:boolean (from:int p:int ws:[double] hs:[double]) {
        def m:int 0
        def k:int from
        while (k < (array_length boxes)) {
            def b:MdBox (itemAt boxes k)
            if ((b.page == p) && (((b.kind == 3) || ((strlen b.imagePath) > 0)) && (b.pinned == false))) {
                if (m >= (array_length ws)) { return false }
                if ((fabs (b.w - (itemAt ws m))) > 1.0) { return false }
                if ((fabs (b.h - (itemAt hs m))) > 1.0) { return false }
                m = (m + 1)
            }
            k = (k + 1)
        }
        return (m == (array_length ws))
    }

    ; How many lines of heading-sized text boxes from..to hold: distinct
    ; baselines among text larger than `minSize`.
    sfn headingLines:int (list:[MdBox] from:int to:int minSize:double) {
        def ys:[double]
        def i:int from
        while (i < to) {
            def b:MdBox (itemAt list i)
            if (((b.kind == 0) && (b.size > minSize)) && ((strlen b.text) > 0)) {
                def seen:boolean false
                def k:int 0
                while (k < (array_length ys)) {
                    if ((fabs ((itemAt ys k) - b.y)) < 1.0) {
                        seen = true
                    }
                    k = (k + 1)
                }
                if (! seen) {
                    push ys b.y
                }
            }
            i = (i + 1)
        }
        return (array_length ys)
    }

    ; Every size and space a slide's content is measured with, in one list,
    ; so a grown slide can put them all back exactly.
    fn styleNumbers:[double] () {
        def v:[double] ([] _:double (style.bodySize style.paraSpacing style.h1Size style.h2Size style.h3Size style.h4Size style.h5Size style.h6Size))
        push v style.headingSpaceBefore
        push v style.headingSpaceAfter
        push v style.codeSize
        push v style.codePadding
        push v style.quoteBarWidth
        push v style.quoteIndent
        push v style.quotePadY
        push v style.listIndent
        push v style.markerGap
        push v style.listTightSpacing
        push v style.cellPadX
        push v style.cellPadY
        push v style.embedSpacing
        push v style.tableSize
        return v
    }

    fn scaleStyle:void (v:[double] s:double) {
        style.bodySize = ((itemAt v 0) * s)
        style.paraSpacing = ((itemAt v 1) * s)
        style.h1Size = ((itemAt v 2) * s)
        style.h2Size = ((itemAt v 3) * s)
        style.h3Size = ((itemAt v 4) * s)
        style.h4Size = ((itemAt v 5) * s)
        style.h5Size = ((itemAt v 6) * s)
        style.h6Size = ((itemAt v 7) * s)
        style.headingSpaceBefore = ((itemAt v 8) * s)
        style.headingSpaceAfter = ((itemAt v 9) * s)
        style.codeSize = ((itemAt v 10) * s)
        style.codePadding = ((itemAt v 11) * s)
        style.quoteBarWidth = ((itemAt v 12) * s)
        style.quoteIndent = ((itemAt v 13) * s)
        style.quotePadY = ((itemAt v 14) * s)
        style.listIndent = ((itemAt v 15) * s)
        style.markerGap = ((itemAt v 16) * s)
        style.listTightSpacing = ((itemAt v 17) * s)
        style.cellPadX = ((itemAt v 18) * s)
        style.cellPadY = ((itemAt v 19) * s)
        style.embedSpacing = ((itemAt v 20) * s)
        style.tableSize = ((itemAt v 21) * s)
    }

    ; GROW's scale: everything on the slide larger except the slide titles
    ; (the headings a slide breaks at, `splitLevel` and up) and the space
    ; around headings. A title is the same size on every slide of the deck,
    ; however much is under it; a heading inside the slide grows with its
    ; text, never past the title's size.
    fn growStyle:void (v:[double] s:double) {
        this.scaleStyle(v s)
        def titleSize:double (itemAt v 2)
        def lv:int 1
        while (lv <= 6) {
            def was:double (itemAt v (lv + 1))
            if (lv <= splitLevel) {
                titleSize = was
            }
            lv = (lv + 1)
        }
        style.h1Size = (MdLayout.grownHeading((itemAt v 2) s 1 splitLevel titleSize))
        style.h2Size = (MdLayout.grownHeading((itemAt v 3) s 2 splitLevel titleSize))
        style.h3Size = (MdLayout.grownHeading((itemAt v 4) s 3 splitLevel titleSize))
        style.h4Size = (MdLayout.grownHeading((itemAt v 5) s 4 splitLevel titleSize))
        style.h5Size = (MdLayout.grownHeading((itemAt v 6) s 5 splitLevel titleSize))
        style.h6Size = (MdLayout.grownHeading((itemAt v 7) s 6 splitLevel titleSize))
        style.headingSpaceBefore = (itemAt v 8)
        style.headingSpaceAfter = (itemAt v 9)
    }

    ; A level-`level` heading of size `was` on a slide grown by `s`: a title
    ; (level up to `splitLevel`) as it was, any other at most `titleSize`.
    sfn grownHeading:double (was:double s:double level:int splitLevel:int titleSize:double) {
        if (level <= splitLevel) {
            return was
        }
        def g:double (was * s)
        if ((g > titleSize) && (was <= titleSize)) {
            return titleSize
        }
        if (g < was) {
            return was
        }
        return g
    }

    ; A table's own size (`tableSize`, else the body's) and its cells'
    ; padding scaled by `s` (the padding over and under by `s`²);
    ; everything else as saved in `v`.
    fn scaleTable:void (v:[double] s:double) {
        this.scaleStyle(v 1.0)
        def size:double (itemAt v 21)
        if (size <= 0.0) {
            size = (itemAt v 0)
        }
        style.tableSize = (size * s)
        style.cellPadX = ((itemAt v 18) * s)
        ; the air between rows gives way faster than the text
        style.cellPadY = (((itemAt v 19) * s) * s)
    }

    fn restoreStyle:void (v:[double]) {
        this.scaleStyle(v 1.0)
    }

    fn truncate:void (n:int) {
        while ((array_length boxes) > n) {
            removeLast boxes
        }
        ; what the boxes left say about the pages' footnotes
        if ((notesDoc.noteCount()) > 0) {
            if (! inNotes) {
                this.retrackNotes()
            }
        }
    }

    ; Lay the block out at one column's width from `top`, then move the groups
    ; into columns. Returns the height the columns take.
    fn columnPass:double (node:MdNode x:double colW:double cols:int gap:double top:double from:int) {
        def wasPaginate:boolean paginate
        paginate = false
        cursorY = top
        this.blockPlain(node x colW)
        paginate = wasPaginate
        def to:int (array_length boxes)
        if (to <= from) { return 0.0 }

        ; Which item each box belongs to.
        def owner:[int]
        def kids:int (node.childCount())
        def i:int from
        def last:int 0
        while (i < to) {
            def b:MdBox (itemAt boxes i)
            ; A list's own bullet carries the LIST's source offset, and a
            ; list starts where its first item does — so asking the spans
            ; alone puts every marker in the first item's group and leaves
            ; the bullets behind in column one while their text moves. The
            ; groups are emitted in order, so a box may never belong to an
            ; earlier one than the box before it.
            def g:int (MdLayout.itemOf(node kids b.srcStart))
            if (g < last) { g = last }
            push owner g
            last = g
            i = (i + 1)
        }
        ; …and where each group sits.
        def gTop:[double]
        def gBot:[double]
        def gSeen:[boolean]
        def k:int 0
        while (k < kids) {
            push gTop 0.0
            push gBot 0.0
            push gSeen false
            k = (k + 1)
        }
        i = from
        while (i < to) {
            def b2:MdBox (itemAt boxes i)
            def g2:int (itemAt owner (i - from))
            if (g2 < kids) {
                if (itemAt gSeen g2) {
                    if (b2.y < (itemAt gTop g2)) { set_at gTop g2 b2.y }
                    if ((b2.y + b2.h) > (itemAt gBot g2)) { set_at gBot g2 (b2.y + b2.h) }
                } {
                    set_at gSeen g2 true
                    set_at gTop g2 b2.y
                    set_at gBot g2 (b2.y + b2.h)
                }
            }
            i = (i + 1)
        }

        ; The split: document order down each column, and at most one item
        ; between the longest column and the shortest.
        def base:int (idiv kids cols)
        def extra:int (kids - (base * cols))
        def colOf:[int]
        def firstOf:[int]
        def c:int 0
        def at:int 0
        while (c < cols) {
            def take:int base
            if (c < extra) { take = (take + 1) }
            push firstOf at
            def t:int 0
            while (t < take) {
                push colOf c
                at = (at + 1)
                t = (t + 1)
            }
            c = (c + 1)
        }
        while ((array_length colOf) < kids) {
            push colOf (cols - 1)
        }

        ; Move them.
        def dy:[double]
        c = 0
        while (c < cols) {
            def firstIdx:int (itemAt firstOf c)
            def shift:double 0.0
            if (firstIdx < kids) {
                if (itemAt gSeen firstIdx) {
                    shift = (top - (itemAt gTop firstIdx))
                }
            }
            push dy shift
            c = (c + 1)
        }
        i = from
        while (i < to) {
            def b3:MdBox (itemAt boxes i)
            def g3:int (itemAt owner (i - from))
            if (g3 >= kids) { g3 = (kids - 1) }
            if (g3 < 0) { g3 = 0 }
            def col:int (itemAt colOf g3)
            b3.x = (b3.x + ((int2double col) * (colW + gap)))
            b3.y = (b3.y + (itemAt dy col))
            i = (i + 1)
        }

        ; The tallest column is the block's height.
        def h:double 0.0
        def g4:int 0
        while (g4 < kids) {
            if (itemAt gSeen g4) {
                def col2:int (itemAt colOf g4)
                def bot:double (((itemAt gBot g4) + (itemAt dy col2)) - top)
                if (bot > h) { h = bot }
            }
            g4 = (g4 + 1)
        }
        return h
    }

    ; The direct child whose source span holds `off`, or -1.
    sfn itemOf:int (node:MdNode kids:int off:int) {
        if (off < 0) { return -1 }
        def i:int 0
        while (i < kids) {
            def k:MdNode (node.childAt(i))
            if (k.srcStart >= 0) {
                if ((k.srcStart <= off) && (off < k.srcEnd)) { return i }
            }
            i = (i + 1)
        }
        return -1
    }

    fn blockInner:void (node:MdNode x:double w:double) {
        def cols:int (this.columnCount(node))
        if (cols > 1) {
            this.columnFlow(node x w cols (this.columnGap(node)))
            return
        }
        this.blockPlain(node x w)
    }

    fn blockPlain:void (node:MdNode x:double w:double) {
        def kind:string node.kind
        if (kind == "paragraph") {
            if (this.pictureBlock(node x w)) { return }
            if ((MdSvg.isWhole((MdSvg.paraText(node)))) && (this.svgPicture(node x w))) { return }
            def runs:[MdRun] (this.inlineRuns(node (this.baseRun())))
            this.paragraph(runs x w)
            def gap:double style.paraSpacing
            if inTightItem {
                gap = style.listTightSpacing
            }
            cursorY = (cursorY + gap)
            return
        }
        if (kind == "heading") {
            this.heading(node x w)
            return
        }
        if (kind == "thematic_break") {
            def y:double (this.reserve(14.0))
            this.emit((MdBox.rect(x (y + 6.0) w 1.0 style.ruleColor)))
            cursorY = (y + 14.0)
            return
        }
        if (kind == "code_block") {
            if (MdGallery.isGallery(node)) {
                this.gallery(node x w)
                return
            }
            this.codeBlock(node x w)
            return
        }
        if (kind == "html_block") {
            if (this.htmlBlock(node x w)) {
                return
            }
            ; Markup this layout does not read is shown as what it is —
            ; which is also more honest than dropping it.
            def shown:MdNode (MdNode.create("code_block"))
            shown.literal = node.literal
            shown.info = "html"
            this.codeBlock(shown x w)
            return
        }
        if (kind == "block_quote") {
            this.blockQuote(node x w)
            return
        }
        if (kind == "list") {
            this.list(node x w)
            return
        }
        if (kind == "table") {
            this.table(node x w)
            return
        }
        if (kind == "front_matter") {
            return
        }
        if (kind == "embed") {
            this.embed(node x w)
            return
        }
        if (kind == "math_block") {
            this.mathBlock(node x w)
            return
        }
        ; drawn at the foot of the page that first refers to it (`placeNotes`)
        if (kind == "footnote_def") {
            return
        }
        if (kind == "dl") {
            this.defList(node x w)
            return
        }
        if (kind == "container") {
            this.customContainer(node x w)
            return
        }
        ; anything unexpected still shows its contents rather than vanishing
        this.blocks(node x w)
    }

    fn baseRun:MdRun () {
        def r:MdRun (new MdRun())
        r.family = style.bodyFamily
        if ((strlen blockFamily) > 0) {
            r.family = blockFamily
        }
        r.size = style.bodySize
        r.color = style.textColor
        if (quoteDepth > 0) {
            r.color = style.quoteColor
        }
        return r
    }

    ; A heading's colour where it is: the theme's for its level, or, on a
    ; plate that colour does not read on, the plate's own ink
    ; (MdContainer.inkOnPaper, as the text in it gets).
    fn headingInkHere:string (level:int) {
        def ink:string (style.headingInk(level))
        if ((strlen plateFill) == 0) {
            return ink
        }
        def on:string (MdContainer.inkOnPaper(plateFill ink platePaper))
        if ((strlen on) > 0) {
            return on
        }
        return ink
    }

    fn heading:void (node:MdNode x:double w:double) {
        if (style.breakOnH1 && (node.level == 1)) {
            ; A chapter opener starts its own sheet — but not the first one,
            ; which would be a blank page before the title.
            if (paginate && ((array_length boxes) > 0)) {
                page = (page + 1)
                pageCount = (page + 1)
                cursorY = contentTop
            }
        }
        if (MdLayout.hiddenHeading(node)) {
            ; `{heading=hidden}`: the slide's name, its anchor and its line
            ; in the contents, and nothing on the slide — the room is the
            ; pictures'. Recorded at the top of what comes next.
            push headText (node.plainText())
            push headLevel node.level
            push headPage page
            this.settlePaper(page)
            push headY cursorY
            this.readEdgesOff(node)
            this.noteHidden(node.srcStart page)
            hiddenOnPage = page
            return
        }
        def size:double (style.headingSize(node.level))
        def base:MdRun (new MdRun())
        base.family = style.headingFamily
        if ((strlen blockFamily) > 0) {
            base.family = blockFamily
        }
        base.size = size
        base.bold = true
        base.color = (this.headingInkHere(node.level))
        def runs:[MdRun] (this.inlineRuns(node base))
        cursorY = (cursorY + style.headingSpaceBefore)
        ; Recorded BEFORE the lines are placed, so the page is the page the
        ; heading starts on rather than the one it may have spilled onto.
        def at:double (this.reserve((size * style.lineHeight)))
        push headText (node.plainText())
        push headLevel node.level
        push headPage page
        this.settlePaper(page)
        push headY at
        this.readEdgesOff(node)
        this.paragraph(runs x w)
        if (node.level <= 2) {
            def y:double cursorY
            this.emit((MdBox.rect(x (y + 4.0) w 1.0 style.ruleColor)))
            cursorY = (y + 5.0)
        }
        cursorY = (cursorY + style.headingSpaceAfter)
    }

    ; A code block: a `diff` block's added and removed lines on green and red
    ; bands, line numbers in a gutter (`.numbers`), highlighted lines
    ; (`lines=`) on a band with a bar at the left — what each line is comes
    ; from MdCodeLines.
    fn codeBlock:void (node:MdNode x:double w0:double) {
        ; `{width=55%}` under it: that share of the column, and the text
        ; after it beside it (startFloat)
        def w:double (MdEmbedKinds.widthOf((this.widthAttr(node)) w0))
        def numbers:string ""
        if (node.hasClass("numbers")) {
            numbers = "1"
        }
        if (node.hasAttr("numbers")) {
            numbers = (node.attrValue("numbers"))
        }
        def cl:MdCodeLines (MdCodeLines.read(node.literal node.info numbers (node.attrValue("lines"))))
        def count:int (array_length cl.lines)
        def shown:int count
        if (shown < 1) { shown = 1 }
        def lh:double (style.codeSize * style.codeLineHeight)
        def boxH:double ((lh * (to_double shown)) + (style.codePadding * 2.0))
        def y:double (this.reserve(boxH))
        this.emit((MdBox.rect(x y w boxH style.codeBackground)))
        this.emit((MdBox.outline(x y w boxH style.codeBorder 1.0)))
        def ty:double (y + style.codePadding)
        def lang:MdLanguage (MdCodeHighlight.languageFor(cl.lang))
        def probe:MdRun (new MdRun())
        probe.family = style.monoFamily
        probe.size = style.codeSize
        ; the gutter: as wide as the widest number, and a gap
        def gutter:double 0.0
        if cl.numbers {
            def widest:string ""
            for cl.lines gl:MdCodeLine gi {
                def nt:string (to_string gl.number)
                if ((gl.number >= 0) && ((strlen nt) > (strlen widest))) {
                    widest = nt
                }
            }
            if ((strlen widest) > 0) {
                gutter = ((this.measureRun(widest probe)) + style.codePadding)
            }
        }
        def dark:boolean ((MdLayout.luminance(style.codeBackground)) < 0.25)
        def added:string (MdLayout.tint(style.codeBackground "#2da44e" 0.2))
        def removed:string (MdLayout.tint(style.codeBackground "#cf222e" 0.18))
        def addInk:string "#1a7f37"
        def delInk:string "#cf222e"
        if dark {
            added = (MdLayout.tint(style.codeBackground "#2ea043" 0.3))
            removed = (MdLayout.tint(style.codeBackground "#f85149" 0.26))
            addInk = "#3fb950"
            delInk = "#f85149"
        }
        ; a highlight is a lighter (darker) band, its bar an accent blue
        def markBand:string (MdLayout.tint(style.codeBackground "#1f2328" 0.08))
        def markBar:string "#0969da"
        def numInk:string "#57606a"
        if dark {
            markBand = (MdLayout.tint(style.codeBackground "#e6edf3" 0.13))
            markBar = "#79c0ff"
            numInk = "#8b949e"
        }
        def build:boolean ((node.hasClass("build")) && (cl.steps > 0))
        def tx0:double ((x + style.codePadding) + gutter)
        ; a diff's markers in a column of their own, so the code lines up
        ; whatever the face's widths of +, - and space are
        def markCol:double 0.0
        if cl.diff {
            markCol = ((this.measureRun("+" probe)) + (this.measureRun(" " probe)))
            def dw:double ((this.measureRun("-" probe)) + (this.measureRun(" " probe)))
            if (dw > markCol) {
                markCol = dw
            }
        }
        def state:int 0
        def i:int 0
        while (i < count) {
            def ln:MdCodeLine (itemAt cl.lines i)
            if (ln.kind == 1) {
                this.emit((MdBox.rect((x + 1.0) ty (w - 2.0) lh added)))
            }
            if (ln.kind == 2) {
                this.emit((MdBox.rect((x + 1.0) ty (w - 2.0) lh removed)))
            }
            if (ln.mark > 0) {
                def band:MdBox (MdBox.rect((x + 1.0) ty (w - 2.0) lh markBand))
                def bar:MdBox (MdBox.rect((x + 1.0) ty 3.0 lh markBar))
                if build {
                    band.buildStep = ln.mark
                    bar.buildStep = ln.mark
                }
                this.emit(band)
                this.emit(bar)
            }
            if ((cl.numbers && (ln.number >= 0)) && (gutter > 0.0)) {
                def nt2:string (to_string ln.number)
                def nw:double (this.measureRun(nt2 probe))
                def nb:MdBox (MdBox.text(nt2 ((x + style.codePadding) + ((gutter - style.codePadding) - nw)) ty nw lh))
                nb.family = style.monoFamily
                nb.size = style.codeSize
                nb.color = numInk
                ; a gutter number is drawn dim on purpose and read with its
                ; line: not the text a contrast check is for
                nb.quiet = true
                this.emit(nb)
            }
            def lx:double tx0
            if ((strlen ln.marker) > 0) {
                def mw:double (this.measureRun(ln.marker probe))
                if (ln.marker != " ") {
                    def mb:MdBox (MdBox.text(ln.marker lx ty mw lh))
                    mb.family = style.monoFamily
                    mb.size = style.codeSize
                    mb.color = addInk
                    if (ln.kind == 2) {
                        mb.color = delInk
                    }
                    this.emit(mb)
                }
                lx = (lx + markCol)
            }
            if ((ln.kind == 3) || (ln.kind == 4)) {
                def hb:MdBox (MdBox.text(ln.text lx ty ((w - (lx - x)) - style.codePadding) lh))
                hb.family = style.monoFamily
                hb.size = style.codeSize
                hb.color = style.codeComment
                hb.bold = (ln.kind == 4)
                this.emit(hb)
            } {
                if style.highlightCode {
                    def hl:MdHighlightedLine (MdCodeHighlight.line(ln.code lang state))
                    state = hl.state
                    this.codeLine(hl lx ty lh)
                } {
                    def b:MdBox (MdBox.text(ln.code lx ty ((w - (lx - x)) - style.codePadding) lh))
                    b.family = style.monoFamily
                    b.size = style.codeSize
                    b.color = style.textColor
                    this.emit(b)
                }
            }
            ty = (ty + lh)
            i = (i + 1)
        }
        cursorY = ((y + boxH) + style.paraSpacing)
    }

    ; a colour t of the way from a to b (a when either does not parse)
    sfn tint:string (a:string b:string t:double) {
        def ca:EVGColor (EVGColor.parse(a))
        def cb:EVGColor (EVGColor.parse(b))
        if ((ca.isSet == false) || (cb.isSet == false)) {
            return a
        }
        def r:double ((to_double (ca.red())) + (((to_double (cb.red())) - (to_double (ca.red()))) * t))
        def g:double ((to_double (ca.green())) + (((to_double (cb.green())) - (to_double (ca.green()))) * t))
        def bl:double ((to_double (ca.blue())) + (((to_double (cb.blue())) - (to_double (ca.blue()))) * t))
        def c:EVGColor (EVGColor.create(r g bl 1.0))
        return (c.toHexString())
    }

    ; One line of code, token by token. Each is measured and placed after the
    ; one before it, exactly as a paragraph's segments are — the face is the
    ; same for all of them, so what varies is only the colour, and the run
    ; still has to be measured because the face is not monospaced.
    fn codeLine:void (hl:MdHighlightedLine x0:double y:double lh:double) {
        def probe:MdRun (new MdRun())
        probe.family = style.monoFamily
        probe.size = style.codeSize
        def cx:double x0
        def i:int 0
        def n:int (array_length hl.tokens)
        while (i < n) {
            def t:MdToken (itemAt hl.tokens i)
            def tlen:int (strlen t.text)
            if (tlen > 0) {
                ; The whitespace at either end of a token is laid as advance
                ; rather than as text — the same rule a paragraph's segments
                ; follow, and for the same reason: a space has no glyph, and a
                ; consumer that trims the edges of a text run then draws the
                ; geometry the PDF draws. Without it `const frame` prints
                ; correctly and previews as `constframe`.
                def lead:int (MdLayout.leadingSpaces(t.text))
                def trail:int (MdLayout.trailingSpaces(t.text tlen lead))
                if (lead > 0) {
                    def gap:string (substring t.text 0 lead)
                    cx = (cx + (this.measureRun(gap probe)))
                }
                def core:string (substring t.text lead (tlen - trail))
                def clen:int (strlen core)
                if (clen > 0) {
                    def wid:double (this.measureRun(core probe))
                    def b:MdBox (MdBox.text(core cx y wid lh))
                    b.family = style.monoFamily
                    b.size = style.codeSize
                    b.color = (style.codeColor(t.kind))
                    this.emit(b)
                    cx = (cx + wid)
                }
                if (trail > 0) {
                    def tail:string (substring t.text (tlen - trail) tlen)
                    cx = (cx + (this.measureRun(tail probe)))
                }
            }
            i = (i + 1)
        }
    }

    fn blockQuote:void (node:MdNode x:double w:double) {
        def pad:double style.quotePadY
        def top:double cursorY
        def innerX:double ((x + style.quoteBarWidth) + style.quoteIndent)
        def innerW:double (w - ((style.quoteBarWidth + style.quoteIndent)))
        def startPage:int page
        def before:int (array_length boxes)
        cursorY = (cursorY + pad)
        quoteDepth = (quoteDepth + 1)
        ; A quote is a block with paragraphs in it wherever it stands, even
        ; inside a tight list item.
        def wasTight:boolean inTightItem
        inTightItem = false
        this.blocks(node innerX innerW)
        inTightItem = wasTight
        quoteDepth = (quoteDepth - 1)
        ; Where the CONTENT ended, which is not where the cursor is: `blocks`
        ; leaves the cursor past the last child's own trailing space, and that
        ; space belongs OUTSIDE the bar. Reading the bottom off the boxes it
        ; just emitted works whatever the last child turned out to be — a
        ; paragraph, a list, a table, a nested quote, a drawing — where
        ; subtracting a paragraph's spacing would only work for a paragraph.
        def inkBottom:double (top + pad)
        def i:int before
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            ; On this sheet only. A quote that crossed a break has boxes whose
            ; y is measured from the top of another page.
            if (b.page == page) {
                def edge:double (b.y + b.h)
                if (edge > inkBottom) {
                    inkBottom = edge
                }
            }
            i = (i + 1)
        }
        def bottom:double (inkBottom + pad)
        ; `blockquote { background-color }`: a band under the quote on its
        ; last page, put before its boxes so it is painted first
        if ((strlen style.quoteBackground) > 0) {
            def bandTop:double top
            if (page != startPage) {
                bandTop = contentTop
            }
            def band:MdBox (MdBox.rect(x bandTop w (bottom - bandTop) style.quoteBackground))
            band.page = page
            band.srcStart = currentSrc
            def firstHere:int (array_length boxes)
            def fi:int ((array_length boxes) - 1)
            while (fi >= before) {
                def fb:MdBox (itemAt boxes fi)
                if (fb.page == page) {
                    firstHere = fi
                }
                fi = (fi - 1)
            }
            def one:[MdBox]
            push one band
            this.insertBoxes(firstHere one)
        }
        ; The bar is drawn per page, so a quote that spans a break gets one on
        ; each sheet rather than a single stripe that goes off the bottom.
        if (page == startPage) {
            this.emit((MdBox.rect(x top style.quoteBarWidth (bottom - top) style.quoteBarColor)))
        } {
            this.emit((MdBox.rect(x contentTop style.quoteBarWidth (bottom - contentTop) style.quoteBarColor)))
        }
        cursorY = (bottom + style.paraSpacing)
    }

    fn list:void (node:MdNode x:double w:double) {
        def items:int (node.childCount())
        def i:int 0
        def number:int node.listStart
        listDepth = (listDepth + 1)
        def wasTight:boolean inTightItem
        ; `li { text-transform … }`: what the items' text inherits
        def listTypo:MdTypo typo
        def lt:MdTypo (typo.copy())
        lt.over((style.typoOf("li")))
        typo = lt
        ; How far the text is indented, which is as far as the WIDEST marker
        ; needs and never less than the style's own step.
        ;
        ; It was the step alone. `1.` fits inside it and `100.` does not, so a
        ; list long enough to reach three digits wrote its numbers across the
        ; first letters of its own items — and the box the marker claimed
        ; stayed the same width as the number grew, which is a lie anything
        ; that clips or hit-tests a box would have believed.
        def probe:MdRun (this.baseRun())
        def widest:double 0.0
        def probeNum:int node.listStart
        def k:int 0
        while (k < items) {
            def probeItem:MdNode (node.childAt(k))
            def pm:string (MdLayout.markerFor(node probeItem probeNum))
            if node.listOrdered {
                probeNum = (probeNum + 1)
            }
            def pw:double (this.measureRun(pm probe))
            if (pw > widest) {
                widest = pw
            }
            k = (k + 1)
        }
        def indent:double style.listIndent
        def need:double (widest + style.markerGap)
        if (need > indent) {
            indent = need
        }
        while (i < items) {
            def item:MdNode (node.childAt(i))
            def marker:string (MdLayout.markerFor(node item number))
            if node.listOrdered {
                number = (number + 1)
            }
            def innerX:double (x + indent)
            def innerW:double (w - indent)
            def markerY:double cursorY
            def markerPage:int page
            def firstBox:int (array_length boxes)
            def startPage:int page
            def startY:double cursorY
            def startOverflows:int slideOverflows
            inTightItem = node.listTight
            this.blocks(item innerX innerW)
            ; On a slide an item is not cut in two when it fits on one: its
            ; bullet on one slide and its words on the next reads as a slide
            ; that lost a line. Undone and laid out again on the next slide.
            if ((slides && paginate) && (page > startPage)) {
                def itemH:double (this.itemHeight(firstBox startY startPage))
                def full:double (contentBottom - contentTop)
                if ((itemH <= full) && (startY > (contentTop + 0.5))) {
                    this.truncate(firstBox)
                    page = startPage
                    pageCount = (page + 1)
                    slideOverflows = startOverflows
                    ; the next reserve starts the next slide, with its title
                    cursorY = contentBottom
                    firstBox = (array_length boxes)
                    this.blocks(item innerX innerW)
                }
            }
            inTightItem = wasTight
            ; The marker goes where the item's first line went: the page and
            ; the top of its first box.
            if (firstBox < (array_length boxes)) {
                def fb:MdBox (this.firstTextBox(firstBox))
                markerY = fb.y
                markerPage = fb.page
            }
            def savedPage:int page
            page = markerPage
            def markerW:double (this.measureRun(marker probe))
            def mb:MdBox (MdBox.text(marker x markerY markerW (style.bodySize * style.lineHeight)))
            mb.family = style.bodyFamily
            mb.size = style.bodySize
            mb.color = (? ((strlen style.markerColor) > 0) style.markerColor style.mutedColor)
            this.emit(mb)
            page = savedPage
            if (! node.listTight) {
                cursorY = (cursorY + 2.0)
            }
            i = (i + 1)
        }
        typo = listTypo
        listDepth = (listDepth - 1)
        ; The list's own separation from whatever follows it, which the items
        ; stopped providing when the list went tight. Only the OUTERMOST list
        ; gets it: a nested list is followed by its parent's next item, and an
        ; item's worth of air is what that wants.
        if (listDepth == 0) {
            if node.listTight {
                def extra:double (style.paraSpacing - style.listTightSpacing)
                if (extra > 0.0) {
                    cursorY = (cursorY + extra)
                }
            }
        }
    }

    ; How tall an item laid out from box `from` on is, counting from where it
    ; started — across a slide break, the part on each slide.
    fn itemHeight:double (from:int startY:double startPage:int) {
        def total:double 0.0
        def top:double startY
        def bottom:double startY
        def pg:int startPage
        def i:int from
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            if (b.page != pg) {
                total = (total + (bottom - top))
                pg = b.page
                top = b.y
                bottom = b.y
            }
            if ((b.y + b.h) > bottom) {
                bottom = (b.y + b.h)
            }
            i = (i + 1)
        }
        return (total + (bottom - top))
    }

    ; The first text box from `from` on — not a continuation title — or the
    ; first box at all.
    fn firstTextBox:MdBox (from:int) {
        def i:int from
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            if ((b.kind == 0) && (b.segSrc >= 0)) {
                return b
            }
            if (b.kind == 5) {
                return b
            }
            i = (i + 1)
        }
        return (itemAt boxes from)
    }

    ; A fenced diagram. The layout cannot draw one and must still leave a
    ; hole of the right height — so it asks the cache, which a handler filled
    ; before layout began. A diagram nobody prepared is a labelled slot: an
    ; empty rectangle tells a reader nothing, and a silent omission tells
    ; them less.
    ; The pictures a chart draws (its `image` marks, which name them as the
    ; document does: `media/logo.svg`), resolved against this layout's
    ; pictures the way `![](media/logo.svg)` is, and each fitted inside the
    ; box the chart gave it with its own proportions (Vega's `aspect`, on by
    ; default). A display list stretches a picture to its box, so the fit is
    ; made here. A name the store does not have draws nothing and is counted
    ; in `missingImages`. Works from the name the scene kept in `alt`, so a
    ; second pass over the same drawing gives the same boxes.
    fn chartPictures:void (root:EVGElement) {
        def i:int 0
        while (i < (array_length root.children)) {
            def c:EVGElement (itemAt root.children i)
            i = (i + 1)
            if ((c.tagName == "img") && ((strlen c.alt) > 0)) {
                c.src = ""
                if haveImages {
                    def path:string (images.resolve(c.alt docDir))
                    def st:VfsStat (new VfsStat())
                    if ((strlen path) > 0) {
                        st = (images.stat(path))
                    }
                    if st.found {
                        c.src = path
                        if ((st.pixelW > 0) && (st.pixelH > 0)) {
                            MdLayout.containIn(c (to_double st.pixelW) (to_double st.pixelH))
                        }
                    } {
                        missingImages = (missingImages + 1)
                    }
                } {
                    missingImages = (missingImages + 1)
                }
            }
        }
    }

    ; `el`'s box made the largest one of the proportions natW : natH that fits
    ; inside it, centred where it was.
    sfn containIn:void (el:EVGElement natW:double natH:double) {
        def x:double el.left.pixels
        def y:double el.top.pixels
        def w:double el.width.pixels
        def h:double el.height.pixels
        if ((w <= 0.0) || (h <= 0.0)) { return }
        def k:double (natW / natH)
        def fw:double w
        def fh:double (w / k)
        if (fh > h) {
            fh = h
            fw = (h * k)
        }
        el.left = (EVGUnit.px((x + ((w - fw) * 0.5))))
        el.top = (EVGUnit.px((y + ((h - fh) * 0.5))))
        el.width = (EVGUnit.px(fw))
        el.height = (EVGUnit.px(fh))
    }

    fn embed:void (node:MdNode x:double w:double) {
        def kind:string (MdLayout.firstWord(node.info))
        ; `{width=360}` under the fence, clamped to the column. `MdDiagram`
        ; works the same number out of the same attribute before layout
        ; begins, and it has to be the same number: the cache is keyed by the
        ; width the diagram was prepared at, so one point of disagreement is a
        ; slot with an apology in it instead of a drawing.
        def want:string (this.widthAttr(node))
        def useW:double (MdEmbedKinds.widthOf(want w))
        def known:double (embeds.heightFor(kind node.literal useW))
        def drawn:boolean (known > 0.0)
        if drawn {
            def pe:int (embeds.find(kind node.literal useW))
            if (pe >= 0) {
                def pentry:MdEmbedEntry (embeds.entryAt(pe))
                if (pentry.ok && (!null? pentry.root)) {
                    this.chartPictures((unwrap pentry.root))
                }
            }
        }
        def h:double 64.0
        if drawn { h = known }
        ; On a slide a diagram taller than the room left under its heading is
        ; given that room rather than a slide of its own: the deck scales a
        ; scene into its box, and a heading alone on one slide with its
        ; diagram on the next reads as two broken slides. Only when most of
        ; the slide is still free; a diagram under a full slide moves on.
        ;
        ; The room is less what is written under it on the same slide
        ; (`followH`, as a picture's): a chart filling the slide down to the
        ; margin pushed a one-line source or takeaway under it onto a slide
        ; of its own. Text that goes beside a narrow one (startFloat) takes
        ; no room under it.
        if (slides && paginate) {
            def full:double (contentBottom - contentTop)
            def avail:double (contentBottom - cursorY)
            def room:double avail
            ; …and the space between them
            def below:double 0.0
            if (followH > 0.0) {
                below = (followH + style.embedSpacing)
            }
            if ((followBeside && ((strlen want) > 0)) && (useW <= (contentW * 0.75))) {
                if (((contentW - useW) - (style.bodySize * 1.2)) >= (contentW * 0.25)) {
                    below = 0.0
                }
            }
            if ((below > 0.0) && ((avail - below) >= (full * 0.3))) {
                avail = (avail - below)
            }
            def under:boolean (slideTitleOnly && (room >= (full * 0.2)))
            def held:boolean ((h > avail) && ((room >= (full * 0.45)) || under))
            if held {
                h = avail
            }
            if (h > full) {
                h = full
            }
            ; A chart or figure is drawn for a room: one cut to a smaller
            ; box would run over what is under it, so it is drawn again for
            ; the box (MdDiagram.refit); one held smaller before and with
            ; more room now is drawn for that.
            def notation:string (MdEmbedKinds.notationOf(kind))
            if ((drawn && (growTrial == false)) && ((notation == "vega") || (notation == "figure"))) {
                def had:double (embeds.fitFor(kind node.literal useW))
                if held {
                    embeds.askRoom(kind node.literal useW h)
                } {
                    if ((had > 0.0) && (avail > (had + 1.0))) {
                        embeds.askRoom(kind node.literal useW avail)
                    } {
                        ; a chart that grows to its room and says no height,
                        ; drawn for the room a slide keeps on any slide
                        ; (`chartRoomKept`) and shorter than the room this
                        ; slide has under its title: drawn for this room
                        if ((((notation == "vega") && (had <= 0.0)) && (embeds.chartGrow > 1.0)) && ((avail > (h + 8.0)) && ((indexOf node.literal "\"height\"") < 0))) {
                            embeds.askRoom(kind node.literal useW avail)
                        }
                    }
                }
            }
        }
        def y:double (this.reserve(h))
        def b:MdBox (new MdBox())
        b.kind = 3
        b.x = x
        b.y = y
        b.w = useW
        b.h = h
        b.embedKind = kind
        b.embedSource = node.literal
        this.emit(b)
        if (! drawn) {
            b.stroke = style.codeBorder
            b.strokeWidth = 1.0
            def note:string (embeds.noteFor(kind node.literal useW))
            def nlen:int (strlen note)
            if (nlen == 0) { note = (kind + " — no handler prepared this one") }
            b.embedNote = note
            ; said as plainly as the text round it: a muted italic line was
            ; read as decoration, not as the reason the chart is missing
            if (nlen > 0) { note = ("⚠ " + kind + ": " + note) }
            def label:MdBox (MdBox.text(note (x + style.codePadding) (y + style.codePadding) (useW - (style.codePadding * 2.0)) (style.bodySize * style.lineHeight)))
            label.family = style.bodyFamily
            label.size = style.bodySize
            label.color = style.textColor
            this.emit(label)
        }
        cursorY = ((y + h) + style.embedSpacing)
    }

    ; What stands in front of an item: a bullet, a number, or a task box. One
    ; place, because the measuring pass and the drawing pass have to agree —
    ; they did not have to before, when the column was a constant.
    sfn markerFor:string (list:MdNode item:MdNode number:int) {
        if (item.taskState >= 0) {
            return (? (item.taskState == 1) "☑" "☐")
        }
        if list.listOrdered {
            return ((to_string number) + list.listDelim)
        }
        return "•"
    }

    sfn firstWord:string (info:string) {
        def n:int (strlen info)
        def i:int 0
        while (i < n) {
            def c:int (charAt info i)
            if (c == 32) { return (substring info 0 i) }
            if (c == 9) { return (substring info 0 i) }
            i = (i + 1)
        }
        return info
    }

    ; ----------------------------------------------------------------------
    ; Inlines → runs
    ; ----------------------------------------------------------------------
    ; Returning the array rather than filling one that was passed in.
    ;
    ; `push` into an array PARAMETER works on JavaScript and does nothing on
    ; Go, where the parameter is a slice and the append lands on a copy. The
    ; JavaScript suite passed and the Go suite laid out an empty page; there
    ; is no warning in between, so the rule here is that an array is a return
    ; value and never an out-parameter.
    ; The runs of a block's inline content, in the typography it holds
    ; (`typo`): bold or not, italic or not and the spacing on the base run
    ; every other copies, then the letters changed as `text-transform` says
    ; — not in code, which is what it is.
    fn inlineRuns:[MdRun] (node:MdNode base:MdRun) {
        if (typo.isEmpty()) {
            return (this.collectRuns(node base))
        }
        if (typo.weight == 1) { base.bold = true }
        if (typo.weight == 0) { base.bold = false }
        if (typo.italic == 1) { base.italic = true }
        if (typo.italic == 0) { base.italic = false }
        if typo.spacingSet {
            base.spacing = (MdLayout.spacingFor(typo.spacing base.size))
        }
        def runs:[MdRun] (this.collectRuns(node base))
        def t:string typo.transform
        if (((strlen t) > 0) && (t != "none")) {
            for runs r:MdRun ri {
                if ((r.code == false) && ((strlen r.math) == 0)) {
                    r.text = (MdTypo.apply(t r.text))
                }
            }
        }
        return runs
    }

    ; `letter-spacing` in points: as written, or (negative, from `em`) a
    ; share of the size
    sfn spacingFor:double (spacing:double size:double) {
        if (spacing < 0.0) {
            return ((0.0 - spacing) * size)
        }
        return spacing
    }

    fn collectRuns:[MdRun] (node:MdNode base:MdRun) {
        def out:[MdRun]
        ; the style inline HTML has switched on, innermost last
        def cur:MdRun base
        def outer:[MdRun]
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def c:MdNode (node.childAt(i))
            def kind:string c.kind
            if (kind == "text") {
                def r:MdRun (cur.copyStyle())
                r.text = c.literal
                r.srcStart = c.srcStart
                r.srcEnd = c.srcEnd
                r.atom = c.subst
                push out r
            }
            ; markdown-it's spans: drawn as their HTML tags are
            if ((((kind == "sub") || (kind == "sup")) || (kind == "ins")) || ((kind == "mark") || (kind == "abbr"))) {
                ; An abbreviation has nowhere to show its title on a slide, so
                ; it is its text; the title goes to HTML as <abbr title>.
                def xr:MdRun (cur.copyStyle())
                if (kind != "abbr") {
                    xr = (this.tagStyle(cur kind))
                }
                def nested:[MdRun] (this.collectRuns(c xr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "softbreak") {
                def sb:MdRun (cur.copyStyle())
                sb.text = " "
                sb.srcStart = c.srcStart
                sb.srcEnd = c.srcEnd
                push out sb
            }
            if (kind == "linebreak") {
                def lb:MdRun (cur.copyStyle())
                lb.hardBreak = true
                lb.srcStart = c.srcStart
                lb.srcEnd = c.srcEnd
                push out lb
            }
            if (kind == "code") {
                def cr:MdRun (cur.copyStyle())
                cr.family = style.monoFamily
                cr.size = (cur.size * 0.92)
                cr.code = true
                cr.bold = false
                cr.italic = false
                cr.text = c.literal
                cr.srcStart = c.srcStart
                cr.srcEnd = c.srcEnd
                push out cr
            }
            if (kind == "math") {
                def mr:MdRun (cur.copyStyle())
                mr.text = (strfromcode 65532)
                mr.math = c.literal
                mr.mathDisplay = (c.info == "display")
                mr.srcStart = c.srcStart
                mr.srcEnd = c.srcEnd
                push out mr
            }
            if (kind == "html_inline") {
                ; a tag switches a style on or off for what follows it; a
                ; comment or a tag nobody draws is not shown
                def tg:MdHtmlTag (MdHtml.tag(c.literal))
                def nm:string tg.name
                if ((nm == "br") || (nm == "wbr")) {
                    if (nm == "br") {
                        def brk:MdRun (cur.copyStyle())
                        brk.hardBreak = true
                        brk.srcStart = c.srcStart
                        brk.srcEnd = c.srcEnd
                        push out brk
                    }
                } {
                    if tg.close {
                        if ((array_length outer) > 0) {
                            cur = (itemAt outer ((array_length outer) - 1))
                            remove_index outer ((array_length outer) - 1)
                        }
                        if (nm == "q") {
                            def qc:MdRun (cur.copyStyle())
                            qc.text = (strfromcode 8221)
                            push out qc
                        }
                    } {
                        if (MdLayout.isVoidTag(nm)) {
                            ; nothing to close: it styles nothing after it
                            if (nm == "img") {
                                this.htmlNote("an <img> inside a sentence is not drawn: put it on a line of its own")
                            } {
                                this.htmlNote((("<" + nm) + "> is not drawn"))
                            }
                        }
                        if ((((strlen nm) > 0) && (tg.selfClose == false)) && ((MdLayout.isVoidTag(nm)) == false)) {
                            push outer cur
                            cur = (this.htmlStyle(cur tg))
                            ; a list in the middle of text (a table cell's
                            ; `Points: <ul><li>…`): an item a line
                            if (nm == "li") {
                                if ((array_length out) > 0) {
                                    def lb:MdRun (cur.copyStyle())
                                    lb.hardBreak = true
                                    push out lb
                                }
                                def bu:MdRun (cur.copyStyle())
                                bu.text = ((strfromcode 8226) + " ")
                                push out bu
                            }
                            if (nm == "q") {
                                def qo:MdRun (cur.copyStyle())
                                qo.text = (strfromcode 8220)
                                push out qo
                            }
                        }
                    }
                }
            }
            if (kind == "emph") {
                def er:MdRun (cur.copyStyle())
                er.italic = true
                def nested:[MdRun] (this.collectRuns(c er))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "strong") {
                def sr:MdRun (cur.copyStyle())
                sr.bold = true
                def nested:[MdRun] (this.collectRuns(c sr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "strike") {
                def kr:MdRun (cur.copyStyle())
                kr.color = style.mutedColor
                kr.strike = true
                def nested:[MdRun] (this.collectRuns(c kr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "link") {
                def lr:MdRun (cur.copyStyle())
                lr.color = style.linkColor
                lr.link = (MdUrl.safeLink(c.destination))
                if ((strlen lr.link) == 0) {
                    this.htmlNote("a link to a script address (javascript:, vbscript:, data:) keeps its text but not its address")
                }
                def nested:[MdRun] (this.collectRuns(c lr))
                def ni:int 0
                def nn:int (array_length nested)
                while (ni < nn) {
                    push out (itemAt nested ni)
                    ni = (ni + 1)
                }
            }
            if (kind == "footnote_ref") {
                ; its number, raised, as a printed page sets it
                def fr:MdRun (cur.copyStyle())
                fr.text = (to_string c.noteNumber)
                fr.shiftOf = cur.size
                if (cur.shift != 0) {
                    fr.shiftOf = cur.shiftOf
                }
                fr.size = (cur.size * 0.75)
                fr.shift = 1
                fr.color = style.linkColor
                fr.noteRef = c.noteNumber
                fr.srcStart = c.srcStart
                fr.srcEnd = c.srcEnd
                push out fr
            }
            if (kind == "image") {
                ; An image the layout has no bytes for still says what it was.
                def ir:MdRun (cur.copyStyle())
                ir.italic = true
                ir.color = style.mutedColor
                ir.quiet = true
                def alt:string (c.plainText())
                ir.text = (("[" + alt) + "]")
                ir.srcStart = c.srcStart
                ir.srcEnd = c.srcEnd
                push out ir
            }
            i = (i + 1)
        }
        return out
    }

    ; ----------------------------------------------------------------------
    ; HTML blocks
    ; ----------------------------------------------------------------------
    ;
    ;     <div style="text-align: center">       <p align="right">…</p>
    ;     Centered text                          <center>…</center>
    ;     </div>                                 <h2 align="center">…</h2>
    ;
    ; A wrapper's content is read again as markdown and laid out in its
    ; place, aligned as the wrapper says. A wrapper whose content runs past a
    ; blank line arrives as two blocks — the opening tag, then markdown, then
    ; the closing tag — so its alignment is kept on a stack until the close.
    ; A <table> is drawn as a table, spans and all. Anything else is shown as
    ; markup.
    fn htmlBlock:boolean (node:MdNode x:double w:double) {
        def lit:string node.literal
        def n:int (strlen lit)
        def lead:int (MdInline.leadTrim(lit))
        if (lead >= n) {
            return true
        }
        if ((charAt lit lead) != 60) {
            return false
        }
        if (((lead + 3) < n) && ((substring lit lead (lead + 4)) == "<!--")) {
            ; a comment is not shown; what follows it on its lines is
            def ce:int (indexOf lit "-->")
            if ((ce > 0) && ((trim (substring lit (ce + 3) n)) != "")) {
                this.innerMarkdown(node (substring lit (ce + 3) n) (ce + 3) x w)
            }
            return true
        }
        def tg:MdHtmlTag (MdHtml.tagAt(lit lead))
        def nm:string tg.name
        if ((strlen nm) == 0) {
            return false
        }
        if tg.close {
            if (MdLayout.isWrapper(nm)) {
                if ((array_length alignStack) > 0) {
                    align = (itemAt alignStack ((array_length alignStack) - 1))
                    remove_index alignStack ((array_length alignStack) - 1)
                }
                def rest0:string (substring lit tg.end n)
                if ((trim rest0) != "") {
                    this.innerMarkdown(node rest0 tg.end x w)
                }
                return true
            }
            return false
        }
        if (nm == "table") {
            this.htmlTable(node lit x w)
            return true
        }
        if (nm == "hr") {
            def y:double (this.reserve(14.0))
            this.emit((MdBox.rect(x (y + 6.0) w 1.0 style.ruleColor)))
            cursorY = (y + 14.0)
            return true
        }
        if (nm == "br") {
            cursorY = (cursorY + (style.bodySize * style.lineHeight))
            return true
        }
        this.noteHandlers(tg)
        if (nm == "svg") {
            return (this.svgPicture(node x w))
        }
        if ((nm == "ul") || (nm == "ol")) {
            ; said again as a Markdown list, and laid out as one
            def hl:MdHtmlList (MdHtmlMd.listItems(lit lead))
            def ldoc:MdNode (MdBlock.parseText((MdHtmlMd.listMarkdown(hl))))
            ; its text is not the source's, so all of it stands for the
            ; list's markup: a click on an item finds the <ul>
            MdLayout.pinSrc(ldoc (node.srcOfLiteral(lead)) (node.srcOfLiteral(hl.end)))
            this.blocks(ldoc x w)
            def tail:string (substring lit hl.end n)
            if ((trim tail) != "") {
                this.innerMarkdown(node tail hl.end x w)
            }
            return true
        }
        if (nm == "img") {
            def src:string (tg.attr("src"))
            if ((strlen src) == 0) {
                return true
            }
            ; the address in <…>, so a space or a bracket in it holds
            def md:string ("![" + (tg.attr("alt")) + "](<" + src + ">)")
            def size:string ""
            def wd:string (trim (tg.attr("width")))
            if ((strlen wd) > 0) {
                size = ("width=" + wd)
            }
            def ht:string (trim (tg.attr("height")))
            if ((strlen ht) > 0) {
                if ((strlen size) > 0) {
                    size = (size + " ")
                }
                size = (size + "height=" + ht)
            }
            if ((strlen size) > 0) {
                md = (md + "\n{" + size + "}")
            }
            this.innerMarkdown(node md lead x w)
            return true
        }
        if (MdLayout.isMediaTag(nm)) {
            this.htmlNote((("<" + nm) + "> is not supported: a slide shows text and pictures, not video, sound or other pages; it is shown as its markup"))
            return false
        }
        if ((MdLayout.isWrapper(nm)) == false) {
            if ((nm == "script") || (nm == "style")) {
                this.htmlNote((("<" + nm) + "> is shown as text and never run; a deck's styles go in its theme CSS"))
            } {
                this.htmlNote((("<" + nm) + "> is not drawn as HTML: it is shown as its markup"))
            }
            return false
        }
        def al:string (tg.align())
        if (nm == "center") {
            al = "center"
        }
        def closeAt:int (MdHtml.closingOf(lit nm tg.end))
        if (closeAt < 0) {
            ; the content runs on past this block: the alignment holds until
            ; the closing tag's own block
            push alignStack align
            if ((strlen al) > 0) {
                align = al
            }
            def after0:string (substring lit tg.end n)
            if ((trim after0) != "") {
                this.innerMarkdown(node after0 tg.end x w)
            }
            return true
        }
        def inner:string (substring lit tg.end closeAt)
        def closeTag:MdHtmlTag (MdHtml.tagAt(lit closeAt))
        def level:int (MdLayout.headingLevelOf(nm))
        if (level > 0) {
            def hashes:string ""
            def k:int 0
            while (k < level) {
                hashes = (hashes + "#")
                k = (k + 1)
            }
            inner = (hashes + " " + (MdLayout.oneLine(inner)))
        }
        if (nm == "summary") {
            inner = ("**" + (trim (MdLayout.oneLine(inner))) + "**")
        }
        def save:string align
        if ((strlen al) > 0) {
            align = al
        }
        def wst:MdHtmlStyle (MdHtmlStyle.read((tg.attr("style")) "color background background-color padding border-radius text-align"))
        for wst.ignored wi:string wk {
            this.htmlNote((((("style " + wi) + " on <") + nm) + "> is not drawn: a block's style draws color, background-color, padding, border-radius and text-align"))
        }
        if ((strlen wst.fill) > 0) {
            ; a background is a plate: `{container=box}` with its colour,
            ; padding and rounding
            this.htmlPlate(node inner tg.end wst x w)
        } {
            def savedInk:string style.textColor
            if ((strlen wst.color) > 0) {
                def ic:EVGColor (CssValue.color(wst.color))
                if ic.isSet {
                    style.textColor = (MdCss.hexOf(ic))
                }
            }
            this.innerMarkdown(node inner tg.end x w)
            style.textColor = savedInk
        }
        align = save
        def after:string (substring lit closeTag.end n)
        if ((trim after) != "") {
            this.innerMarkdown(node after closeTag.end x w)
        }
        return true
    }

    ; `<div style="background:#123;padding:20px;border-radius:12px">`: its
    ; content on a plate, as `{container=box background=#123 padding=20px
    ; radius=12px}` under a block draws it
    fn htmlPlate:void (outer:MdNode text:string base:int st:MdHtmlStyle x:double w:double) {
        def doc:MdNode (MdBlock.parseText((MdLayout.dedent(text))))
        MdLayout.remapSrc(doc outer base)
        def box:MdNode (MdNode.create("container"))
        box.srcStart = outer.srcStart
        box.srcEnd = outer.srcEnd
        ; the plate is part of the block its text is (the report's elements)
        if ((doc.childCount()) > 0) {
            def first:MdNode (doc.childAt(0))
            box.srcStart = first.srcStart
        }
        box.setAttr("container" "box")
        box.setAttr("background" st.fill)
        if ((strlen st.padding) > 0) {
            box.setAttr("padding" st.padding)
        }
        if ((strlen st.radius) > 0) {
            box.setAttr("radius" st.radius)
        }
        def i:int 0
        while (i < (doc.childCount())) {
            box.add((doc.childAt(i)))
            i = (i + 1)
        }
        def savedInk:string style.textColor
        if ((strlen st.color) > 0) {
            def ic:EVGColor (CssValue.color(st.color))
            if ic.isSet {
                style.textColor = (MdCss.hexOf(ic))
            }
        }
        this.block(box x w)
        style.textColor = savedInk
    }

    ; A block that is one <svg> element: drawn as the picture the host made
    ; of it (`MdSvg`). Before the host has it, or with no host, nothing is
    ; drawn and it is noted.
    fn svgPicture:boolean (node:MdNode x:double w:double) {
        def svg:string (MdSvg.ofBlock(node))
        if ((strlen svg) == 0) {
            this.htmlNote("an <svg> is drawn as a picture when the block is the <svg> element alone; this one is shown as its markup")
            return false
        }
        def para:MdNode (MdNode.create("paragraph"))
        para.srcStart = node.srcStart
        para.srcEnd = node.srcEnd
        para.takeAttrsFrom(node)
        ; `<svg width="200">` is shown that wide, as `<img width>` is
        if ((para.hasAttr("width")) == false) {
            def root:MdHtmlTag (MdHtml.tagAt(svg 0))
            def sw:string (trim (root.attr("width")))
            if ((strlen sw) > 2) {
                if ((substring sw ((strlen sw) - 2) (strlen sw)) == "px") {
                    sw = (substring sw 0 ((strlen sw) - 2))
                }
            }
            if (((strlen sw) > 0) && (!null? (str2double sw))) {
                para.setAttr("width" sw)
            }
        }
        def img:MdNode (MdNode.create("image"))
        img.destination = (MdSvg.pathOf(svg))
        img.srcStart = node.srcStart
        img.srcEnd = node.srcEnd
        para.add(img)
        if ((this.pictureBlock(para x w)) == false) {
            this.htmlNote("an inline <svg> was not drawn: the picture made of it is not there yet")
        }
        return true
    }

    sfn isWrapper:boolean (nm:string) {
        return ((indexOf " div p center section article header footer main aside nav figure figcaption blockquote details summary span h1 h2 h3 h4 h5 h6 a font b strong i em small " ((" " + nm) + " ")) >= 0)
    }

    sfn headingLevelOf:int (nm:string) {
        if ((strlen nm) != 2) {
            return 0
        }
        if ((charAt nm 0) != 104) {
            return 0
        }
        def d:int ((charAt nm 1) - 48)
        if ((d >= 1) && (d <= 6)) {
            return d
        }
        return 0
    }

    sfn oneLine:string (s:string) {
        def out:string ""
        def i:int 0
        def n:int (strlen s)
        while (i < n) {
            def c:int (charAt s i)
            if ((c == 10) || (c == 13)) {
                out = (out + " ")
            } {
                out = (out + (strfromcode c))
            }
            i = (i + 1)
        }
        return (trim out)
    }

    ; Markdown found inside an HTML block, laid out where the block is. Its
    ; nodes' source spans are moved back into the file through the block's
    ; own map, so a click on it still finds the text. Every line is taken
    ; off its indent first: HTML is indented for reading, and four spaces of
    ; it would make an indented code block of the content.
    fn innerMarkdown:void (outer:MdNode text:string base:int x:double w:double) {
        def src:string (MdLayout.dedent(text))
        def doc:MdNode (MdBlock.parseText(src))
        MdLayout.remapSrc(doc outer base)
        this.blocks(doc x w)
    }

    sfn dedent:string (s:string) {
        def lines:[string] (strsplit s "\n")
        def out:string ""
        def i:int 0
        while (i < (array_length lines)) {
            if (i > 0) {
                out = (out + "\n")
            }
            def ln:string (itemAt lines i)
            def k:int 0
            while ((k < (strlen ln)) && (((charAt ln k) == 32) || ((charAt ln k) == 9))) {
                k = (k + 1)
            }
            out = (out + (substring ln k (strlen ln)))
            i = (i + 1)
        }
        return out
    }

    ; every node of `n` placed at start..end of the source
    sfn pinSrc:void (n:MdNode start:int end:int) {
        n.srcStart = start
        n.srcEnd = end
        def i:int 0
        while (i < (n.childCount())) {
            MdLayout.pinSrc((n.childAt(i)) start end)
            i = (i + 1)
        }
    }

    sfn remapSrc:void (n:MdNode outer:MdNode base:int) {
        if (n.srcStart >= 0) {
            n.srcStart = (outer.srcOfLiteral((base + n.srcStart)))
        }
        if (n.srcEnd >= 0) {
            n.srcEnd = (outer.srcOfLiteral((base + n.srcEnd)))
        }
        def i:int 0
        while (i < (n.childCount())) {
            MdLayout.remapSrc((n.childAt(i)) outer base)
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; An HTML table
    ; ----------------------------------------------------------------------
    ;
    ; The markdown table's look — padding, border, header tint — with what
    ; only HTML says: cells that span rows and columns, header rows from
    ; <thead> or <th>, alignment per cell. Column widths are the markdown
    ; table's algorithm (min- and max-content, the room shared out), with a
    ; spanning cell's widths shared over the columns it covers. A cell is
    ; centred vertically in the rows it spans, as a browser does.
    fn cellRuns:[MdRun] (outer:MdNode cell:MdHtmlCell) {
        def base:MdRun (this.baseRun())
        if cell.header {
            base.bold = true
        }
        this.cellStyle(outer cell base)
        def out:[MdRun]
        def src:string (trim (MdLayout.dedent(cell.inner)))
        if ((strlen src) == 0) {
            return out
        }
        def lead:int (MdInline.leadTrim(cell.inner))
        def doc:MdNode (MdBlock.parseText(src))
        MdLayout.remapSrc(doc outer (cell.start + lead))
        def i:int 0
        while (i < (doc.childCount())) {
            def b:MdNode (doc.childAt(i))
            if (i > 0) {
                def brk:MdRun (base.copyStyle())
                brk.hardBreak = true
                push out brk
            }
            def runs:[MdRun] (this.inlineRuns(b base))
            if (b.kind == "html_block") {
                def lit:string b.literal
                def bl:int (MdInline.leadTrim(lit))
                def btg:MdHtmlTag (MdHtml.tagAt(lit bl))
                if ((btg.name == "ul") || (btg.name == "ol")) {
                    ; a list in a cell: an item a line, with its marker
                    runs = (this.cellListRuns((MdHtmlMd.listItems(lit bl)) base))
                } {
                    if (btg.name == "table") {
                        runs = (this.cellTableRuns(lit base))
                    } {
                        ; a lone tag in a cell (<br>, <b>…): its text, plainly
                        def tr:MdRun (base.copyStyle())
                        tr.text = (MdLayout.stripTags(b.literal))
                        push runs tr
                    }
                }
            }
            def k:int 0
            while (k < (array_length runs)) {
                push out (itemAt runs k)
                k = (k + 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; What a cell's `style=""` / `bgcolor=` and the table's cell tones
    ; (`{cells=…}`, `table { cell-tones }`) make of its text, and the colour
    ; it is filled with (`cell.fill`, drawn by `htmlGroup`).
    fn cellStyle:void (outer:MdNode cell:MdHtmlCell base:MdRun) {
        def tones:MdCellTones (MdCellTones.forTable(outer style.tableCellTones))
        def tone:string (tones.toneOf((MdLayout.stripTags(cell.inner))))
        if ((strlen tone) > 0) {
            base.bold = true
            base.color = (MdCellTones.inkOf(tone (this.tablePaper())))
            cell.fill = (MdCellTones.fillOf(tone (this.tablePaper())))
        }
        def st:MdHtmlStyle (MdHtmlStyle.read(cell.style "color background background-color font-weight font-style text-align vertical-align"))
        def fill:string st.fill
        if ((strlen fill) == 0) {
            fill = cell.bgcolor
        }
        if ((strlen fill) > 0) {
            def fc:EVGColor (CssValue.color(fill))
            if fc.isSet {
                cell.fill = (MdCss.hexOf(fc))
            }
        }
        if ((strlen st.color) > 0) {
            def ic:EVGColor (CssValue.color(st.color))
            if ic.isSet {
                base.color = (MdCss.hexOf(ic))
            }
        }
        if (st.weight == "bold") {
            base.bold = true
        }
        if (st.weight == "normal") {
            base.bold = false
        }
        if (st.slant == "italic") {
            base.italic = true
        }
        for st.ignored ig:string ii {
            this.htmlNote((("style " + ig) + " on a table cell is not drawn: a cell's style draws color, background-color, font-weight, font-style and text-align"))
        }
    }

    fn cellListRuns:[MdRun] (list:MdHtmlList base:MdRun) {
        def out:[MdRun]
        for list.items it:MdHtmlItem k {
            if (k > 0) {
                def brk:MdRun (base.copyStyle())
                brk.hardBreak = true
                push out brk
            }
            def mark:MdRun (base.copyStyle())
            def ind:string ""
            def d:int 0
            while (d < it.depth) {
                ind = (ind + "    ")
                d = (d + 1)
            }
            if (it.marker == "-") {
                mark.text = (ind + (strfromcode 8226) + " ")
            } {
                mark.text = ((ind + it.marker) + " ")
            }
            push out mark
            def idoc:MdNode (MdBlock.parseText(it.text))
            if ((idoc.childCount()) > 0) {
                for (this.inlineRuns((idoc.childAt(0)) base)) ir:MdRun ik {
                    push out ir
                }
            }
        }
        return out
    }

    ; A table inside a cell: a line a row, its cells' text between dots.
    fn cellTableRuns:[MdRun] (lit:string base:MdRun) {
        this.htmlNote("a table inside a table cell is drawn as lines of text, one a row")
        def out:[MdRun]
        def t:MdHtmlTable (MdHtml.table(lit))
        for t.rows row:MdHtmlRow r {
            if (r > 0) {
                def brk:MdRun (base.copyStyle())
                brk.hardBreak = true
                push out brk
            }
            def parts:[string]
            for row.cells c:MdHtmlCell ci {
                push parts (MdLayout.stripTags(c.inner))
            }
            def tr:MdRun (base.copyStyle())
            tr.text = (join parts "  ·  ")
            push out tr
        }
        return out
    }

    sfn stripTags:string (s:string) {
        def out:string ""
        def inTag:boolean false
        def i:int 0
        while (i < (strlen s)) {
            def c:int (charAt s i)
            if (c == 60) {
                inTag = true
            } {
                if (c == 62) {
                    inTag = false
                } {
                    if (inTag == false) {
                        if (c == 10) {
                            out = (out + " ")
                        } {
                            out = (out + (strfromcode c))
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return (trim out)
    }

    fn linesHeight:double (lines:[MdLine]) {
        def sum:double 0.0
        def i:int 0
        while (i < (array_length lines)) {
            def ln:MdLine (itemAt lines i)
            sum = (sum + ln.height)
            i = (i + 1)
        }
        return sum
    }

    fn htmlTable:void (outer:MdNode lit:string x:double w:double) {
        def t:MdHtmlTable (MdHtml.table(lit))
        def rows:int (t.rowCount())
        def cols:int t.cols
        if ((rows == 0) || (cols == 0)) {
            return
        }
        if ((strlen t.caption) > 0) {
            def save:string align
            align = "center"
            this.innerMarkdown(outer ("*" + (MdLayout.oneLine(t.caption)) + "*") 0 x w)
            align = save
            cursorY = (cursorY - (style.paraSpacing * 0.5))
        }
        def padX:double style.cellPadX
        def padY:double style.cellPadY
        ; every cell, its runs, and its span clamped to the table
        def cells:[MdHtmlCell]
        def cellRuns:[[MdRun]]
        def r:int 0
        while (r < rows) {
            def row:MdHtmlRow (itemAt t.rows r)
            def k:int 0
            while (k < (array_length row.cells)) {
                def c:MdHtmlCell (itemAt row.cells k)
                if (row.head) {
                    c.header = true
                }
                if ((c.row + c.rowspan) > rows) {
                    c.rowspan = (rows - c.row)
                }
                push cells c
                push cellRuns (this.cellRuns(outer c))
                k = (k + 1)
            }
            r = (r + 1)
        }
        ; column widths: single-column cells first, then spans spread over
        ; the columns they cover
        def natural:[double]
        def minimum:[double]
        def c0:int 0
        while (c0 < cols) {
            push natural (padX * 2.0)
            push minimum (padX * 2.0)
            c0 = (c0 + 1)
        }
        def pass:int 0
        while (pass < 2) {
            def i:int 0
            while (i < (array_length cells)) {
                def cell:MdHtmlCell (itemAt cells i)
                def runs:[MdRun] (itemAt cellRuns i)
                def single:boolean (cell.colspan == 1)
                if (single == (pass == 0)) {
                    def nat:double ((this.runsWidth(runs)) + (padX * 2.0))
                    def least:double 0.0
                    def tight:[MdLine] (this.breakRuns(runs 1.0))
                    def ti:int 0
                    while (ti < (array_length tight)) {
                        def tl:MdLine (itemAt tight ti)
                        if (tl.width > least) {
                            least = tl.width
                        }
                        ti = (ti + 1)
                    }
                    least = (least + (padX * 2.0))
                    def haveNat:double 0.0
                    def haveMin:double 0.0
                    def cc:int cell.col
                    while ((cc < (cell.col + cell.colspan)) && (cc < cols)) {
                        haveNat = (haveNat + (itemAt natural cc))
                        haveMin = (haveMin + (itemAt minimum cc))
                        cc = (cc + 1)
                    }
                    def spanN:double (to_double cell.colspan)
                    cc = cell.col
                    while ((cc < (cell.col + cell.colspan)) && (cc < cols)) {
                        if (nat > haveNat) {
                            set_at natural cc ((itemAt natural cc) + ((nat - haveNat) / spanN))
                        }
                        if (least > haveMin) {
                            set_at minimum cc ((itemAt minimum cc) + ((least - haveMin) / spanN))
                        }
                        cc = (cc + 1)
                    }
                }
                i = (i + 1)
            }
            pass = (pass + 1)
        }
        def widths:[double] (MdLayout.shareWidths(natural minimum w))
        def colX:[double]
        def cx:double x
        def c1:int 0
        while (c1 < cols) {
            push colX cx
            cx = (cx + (itemAt widths c1))
            c1 = (c1 + 1)
        }
        ; row heights: single-row cells, then a spanning cell's remainder on
        ; the last row it covers
        def rowH:[double]
        def r1:int 0
        while (r1 < rows) {
            push rowH ((style.bodySize * style.lineHeight) + (padY * 2.0))
            r1 = (r1 + 1)
        }
        def cellLines:[[MdLine]]
        def cellW:[double]
        def j:int 0
        while (j < (array_length cells)) {
            def cell2:MdHtmlCell (itemAt cells j)
            def cw:double 0.0
            def cc2:int cell2.col
            while ((cc2 < (cell2.col + cell2.colspan)) && (cc2 < cols)) {
                cw = (cw + (itemAt widths cc2))
                cc2 = (cc2 + 1)
            }
            push cellW cw
            def lines:[MdLine] (this.breakRuns((itemAt cellRuns j) (cw - (padX * 2.0))))
            push cellLines lines
            j = (j + 1)
        }
        def spanPass:int 0
        while (spanPass < 2) {
            def j2:int 0
            while (j2 < (array_length cells)) {
                def cell3:MdHtmlCell (itemAt cells j2)
                if ((cell3.rowspan == 1) == (spanPass == 0)) {
                    def need:double ((this.linesHeight((itemAt cellLines j2))) + (padY * 2.0))
                    def have:double 0.0
                    def rr:int cell3.row
                    while (rr < (cell3.row + cell3.rowspan)) {
                        have = (have + (itemAt rowH rr))
                        rr = (rr + 1)
                    }
                    if (need > have) {
                        def last:int ((cell3.row + cell3.rowspan) - 1)
                        set_at rowH last ((itemAt rowH last) + (need - have))
                    }
                }
                j2 = (j2 + 1)
            }
            spanPass = (spanPass + 1)
        }
        ; drawn a group of rows at a time: rows a span ties together go onto
        ; the same slide, and the header groups (`<thead>` rows) are drawn
        ; again at the top of every slide the table continues on
        def gFrom:[int]
        def gTo:[int]
        def gH:[double]
        def g0:int 0
        while (g0 < rows) {
            def g1:int (g0 + 1)
            def grow:boolean true
            while grow {
                grow = false
                def q:int 0
                while (q < (array_length cells)) {
                    def cq:MdHtmlCell (itemAt cells q)
                    if (((cq.row >= g0) && (cq.row < g1)) && ((cq.row + cq.rowspan) > g1)) {
                        g1 = (cq.row + cq.rowspan)
                        grow = true
                    }
                    q = (q + 1)
                }
            }
            def gh:double 0.0
            def rq:int g0
            while (rq < g1) {
                gh = (gh + (itemAt rowH rq))
                rq = (rq + 1)
            }
            push gFrom g0
            push gTo g1
            push gH gh
            g0 = g1
        }
        def heads:int 0
        def headH:double 0.0
        def more:boolean true
        while (more && (heads < (array_length gFrom))) {
            def all:boolean true
            def hr:int (itemAt gFrom heads)
            while (hr < (itemAt gTo heads)) {
                ; a `<thead>` row, or one of `<th>` cells only
                def hrow:MdHtmlRow (itemAt t.rows hr)
                if (hrow.head == false) {
                    def hk:int 0
                    while (hk < (array_length hrow.cells)) {
                        def hc:MdHtmlCell (itemAt hrow.cells hk)
                        if (hc.header == false) {
                            all = false
                        }
                        hk = (hk + 1)
                    }
                    if ((array_length hrow.cells) == 0) {
                        all = false
                    }
                }
                hr = (hr + 1)
            }
            if all {
                headH = (headH + (itemAt gH heads))
                heads = (heads + 1)
            } {
                more = false
            }
        }
        def body:[double]
        def bi:int heads
        while (bi < (array_length gH)) {
            push body (itemAt gH bi)
            bi = (bi + 1)
        }
        def plan:MdTablePlan (this.tablePlan(body headH))
        def on:int -1
        def gi:int heads
        while (gi < (array_length gFrom)) {
            def s:int (itemAt plan.slideOf (gi - heads))
            if (s != on) {
                if ((on >= 0) || (s > 0)) {
                    this.tableBreak()
                }
                on = s
                def hg:int 0
                while (hg < heads) {
                    this.htmlGroup(cells cellLines cellW colX rowH (itemAt gFrom hg) (itemAt gTo hg) (itemAt gH hg) padX)
                    hg = (hg + 1)
                }
            }
            this.htmlGroup(cells cellLines cellW colX rowH (itemAt gFrom gi) (itemAt gTo gi) (itemAt gH gi) padX)
            gi = (gi + 1)
        }
        if (heads == (array_length gFrom)) {
            def hg2:int 0
            while (hg2 < heads) {
                this.htmlGroup(cells cellLines cellW colX rowH (itemAt gFrom hg2) (itemAt gTo hg2) (itemAt gH hg2) padX)
                hg2 = (hg2 + 1)
            }
        }
        cursorY = (cursorY + style.paraSpacing)
    }

    ; Rows g0..g1 of an HTML table, `gh` tall, at the cursor.
    fn htmlGroup:void (cells:[MdHtmlCell] cellLines:[[MdLine]] cellW:[double] colX:[double] rowH:[double] g0:int g1:int gh:double padX:double) {
        def rowY:[double]
        def acc:double 0.0
        def rq:int g0
        while (rq < g1) {
            push rowY acc
            acc = (acc + (itemAt rowH rq))
            rq = (rq + 1)
        }
        def y0:double (this.reserve(gh))
        def m:int 0
        while (m < (array_length cells)) {
            def cm:MdHtmlCell (itemAt cells m)
            if ((cm.row >= g0) && (cm.row < g1)) {
                def cy:double (y0 + (itemAt rowY (cm.row - g0)))
                def ch:double 0.0
                def rs:int cm.row
                while (rs < (cm.row + cm.rowspan)) {
                    ch = (ch + (itemAt rowH rs))
                    rs = (rs + 1)
                }
                def cxm:double (itemAt colX cm.col)
                def cwm:double (itemAt cellW m)
                if cm.header {
                    this.emit((MdBox.rect(cxm cy cwm ch style.tableHeadBackground)))
                }
                if ((strlen cm.fill) > 0) {
                    this.emit((MdBox.rect(cxm cy cwm ch cm.fill)))
                }
                this.emit((MdBox.outline(cxm cy cwm ch style.tableBorder 1.0)))
                def lines2:[MdLine] (itemAt cellLines m)
                def inner:double (cwm - (padX * 2.0))
                def ty:double (cy + ((ch - (this.linesHeight(lines2))) / 2.0))
                def li:int 0
                while (li < (array_length lines2)) {
                    def ln:MdLine (itemAt lines2 li)
                    def lx:double (cxm + padX)
                    if (cm.align == "right") {
                        lx = (((cxm + cwm) - padX) - ln.width)
                    }
                    if (cm.align == "center") {
                        lx = ((cxm + padX) + ((inner - ln.width) / 2.0))
                    }
                    this.emitLine(ln lx ty)
                    ty = (ty + ln.height)
                    li = (li + 1)
                }
            }
            m = (m + 1)
        }
        cursorY = (y0 + gh)
    }

    ; The markdown table's width algorithm over given min- and max-content
    ; widths: as written when it fits, else each column at least its minimum
    ; and the room left shared in proportion to what each still wants.
    sfn shareWidths:[double] (natural:[double] minimum:[double] w:double) {
        def widths:[double]
        def cols:int (array_length natural)
        def total:double 0.0
        def leastTotal:double 0.0
        def k:int 0
        while (k < cols) {
            total = (total + (itemAt natural k))
            leastTotal = (leastTotal + (itemAt minimum k))
            k = (k + 1)
        }
        def j:int 0
        while (j < cols) {
            def lo:double (itemAt minimum j)
            def hi:double (itemAt natural j)
            if (total <= w) {
                push widths hi
            } {
                if (leastTotal >= w) {
                    push widths lo
                } {
                    def want:double (total - leastTotal)
                    def share:double 0.0
                    if (want > 0.0) {
                        share = (((hi - lo) / want) * (w - leastTotal))
                    }
                    push widths (lo + share)
                }
            }
            j = (j + 1)
        }
        return widths
    }

    ; What an inline HTML tag makes of the style around it. Tags nobody draws
    ; (span, abbr's title, a link's target) leave the style as it was.
    ; `style=""` gives the text its colour, a colour behind it, its size,
    ; weight and slant and a line under or through it; what else it says,
    ; and a script handler (`onclick`), is noted, not drawn.
    fn htmlStyle:MdRun (cur:MdRun tg:MdHtmlTag) {
        def nm:string tg.name
        def r:MdRun (this.tagStyle(cur nm))
        if (MdLayout.isMediaTag(nm)) {
            this.htmlNote((("<" + nm) + "> is not supported: a slide shows text and pictures, not video, sound or other pages"))
        }
        if (((MdLayout.isInlineTag(nm)) == false) && ((MdLayout.isMediaTag(nm)) == false)) {
            this.htmlNote((("<" + nm) + "> is not drawn: Sliqtly draws the inline tags b, strong, i, em, u, s, del, ins, mark, code, kbd, sub, sup, small, q, abbr, a and span"))
        }
        this.noteHandlers(tg)
        if ((nm == "abbr") || (nm == "acronym")) {
            if (tg.has("title")) {
                r.underline = true
            }
        }
        if (nm == "a") {
            def href:string (tg.attr("href"))
            if ((strlen href) > 0) {
                r.link = (MdUrl.safeLink(href))
                if ((strlen r.link) > 0) {
                    r.color = style.linkColor
                } {
                    this.htmlNote("a link to a script address (javascript:, vbscript:, data:) keeps its text but not its address")
                }
            }
        }
        def st:MdHtmlStyle (MdHtmlStyle.read((tg.attr("style")) "color background background-color font-size font-weight font-style text-decoration text-decoration-line"))
        def col:string st.color
        if ((strlen col) == 0) {
            if (nm == "font") {
                col = (tg.attr("color"))
            }
        }
        if ((strlen col) > 0) {
            r.color = col
        }
        if ((strlen st.fill) > 0) {
            def fc:EVGColor (CssValue.color(st.fill))
            if fc.isSet {
                r.fill = (MdCss.hexOf(fc))
            } {
                push st.ignored "background-color"
            }
        }
        if ((strlen st.size) > 0) {
            def sz:double (this.spanSize(cur st.size))
            if (sz > 0.0) {
                r.size = sz
            } {
                push st.ignored "font-size"
            }
        }
        if (st.weight == "bold") {
            r.bold = true
        }
        if (st.weight == "normal") {
            r.bold = false
        }
        if (st.slant == "italic") {
            r.italic = true
        }
        if (st.slant == "normal") {
            r.italic = false
        }
        if (st.underline != 0) {
            r.underline = (st.underline > 0)
        }
        if (st.strike != 0) {
            r.strike = (st.strike > 0)
        }
        for st.ignored ig:string ii {
            this.htmlNote((((("style " + ig) + " on <") + nm) + "> is not drawn: inline styles draw color, background-color, font-size, font-weight, font-style and text-decoration"))
        }
        return r
    }

    ; the elements that have no closing tag
    sfn isVoidTag:boolean (nm:string) {
        return ((indexOf " img input hr source embed meta link area col param track base " ((" " + nm) + " ")) >= 0)
    }

    ; what a slide cannot show at all: moving pictures and other pages
    sfn isMediaTag:boolean (nm:string) {
        return ((indexOf " video audio iframe object embed canvas frame frameset applet " ((" " + nm) + " ")) >= 0)
    }

    sfn isInlineTag:boolean (nm:string) {
        return ((indexOf " b strong i em cite var dfn u ins s strike del mark code tt samp kbd sub sup small big abbr acronym a span font q br wbr ul ol li " ((" " + nm) + " ")) >= 0)
    }

    ; `onclick` and its kin: nothing on a slide runs script, so a handler is
    ; said to be left out rather than kept silently
    fn noteHandlers:void (tg:MdHtmlTag) {
        for tg.keys k:string i {
            if (((strlen k) > 2) && ((indexOf k "on") == 0)) {
                this.htmlNote((((k + " on <") + tg.name) + "> is left out: nothing in a slide runs script"))
            }
        }
    }

    ; A span's `font-size` in the layout's points: absolute sizes against the
    ; document's own (`font-size: 32pt` where the body is 20pt is 1.6 times
    ; the body), `em`, `%` and `larger`/`smaller` against the text around it,
    ; the CSS words (`large`, `x-large`…) against the body, all kept within
    ; the sizes a slide can show (`MdCssLimits`). -1 when it is not a size.
    fn spanSize:double (cur:MdRun value:string) {
        def t:string (MdChar.lower((trim value)))
        def n:int (strlen t)
        def words:[string] ([] _:string ("xx-small" "x-small" "small" "medium" "large" "x-large" "xx-large" "xxx-large"))
        def scales:[double] ([] _:double (0.6 0.75 0.89 1.0 1.2 1.5 2.0 3.0))
        def wi:int (indexOf words t)
        def r:double -1.0
        def against:double style.bodySize
        if (wi >= 0) {
            r = (itemAt scales wi)
        }
        if (t == "larger") {
            r = 1.2
            against = cur.size
        }
        if (t == "smaller") {
            r = 0.83
            against = cur.size
        }
        if ((r < 0.0) && ((n > 3) && ((substring t (n - 3) n) == "rem"))) {
            r = (?? (str2double (trim (substring t 0 (n - 3)))) -1.0)
        }
        if ((r < 0.0) && ((n > 2) && ((substring t (n - 2) n) == "em"))) {
            r = (?? (str2double (trim (substring t 0 (n - 2)))) -1.0)
            against = cur.size
        }
        if ((r < 0.0) && ((n > 1) && ((substring t (n - 1) n) == "%"))) {
            r = ((?? (str2double (trim (substring t 0 (n - 1)))) -100.0) / 100.0)
            against = cur.size
        }
        if (r < 0.0) {
            ; a length: against the size the document's sheet gives its body
            def base:double style.bodySize
            def b:CssComputed (sheet.forTag("document"))
            if (b.has("font-size")) {
                base = (CssValue.fontPoints((b.get("font-size")) style.bodySize))
            }
            def pts:double (CssValue.fontPoints(t -1.0))
            if ((pts <= 0.0) || (base <= 0.0)) {
                return -1.0
            }
            r = (pts / base)
        }
        if (r <= 0.0) {
            return -1.0
        }
        def want:double (against * r)
        def ratio:double (MdCssLimits.ratio((want / style.bodySize) style.bodySize style.pageWidth style.pageHeight))
        return (style.bodySize * ratio)
    }

    ; Said once per layout, with where it was first met.
    fn htmlNote:void (text:string) {
        if ((indexOf htmlNotes text) >= 0) {
            return
        }
        push htmlNotes text
        push htmlNoteSrc currentSrc
    }

    ; What an element of this name does to the style around it, whether it
    ; came as HTML (`<sup>`) or as markdown (`^…^`, which is the same `sup`).
    fn tagStyle:MdRun (cur:MdRun nm:string) {
        def r:MdRun (cur.copyStyle())
        if ((nm == "b") || (nm == "strong")) { r.bold = true }
        if ((((nm == "i") || (nm == "em")) || ((nm == "cite") || (nm == "var"))) || (nm == "dfn")) { r.italic = true }
        if ((nm == "u") || (nm == "ins")) { r.underline = true }
        if ((nm == "s") || ((nm == "strike") || (nm == "del"))) {
            r.strike = true
            r.color = style.mutedColor
        }
        if (nm == "mark") {
            r.mark = true
            r.color = style.markColor
        }
        if ((nm == "code") || ((nm == "tt") || (nm == "samp"))) {
            r.family = style.monoFamily
            r.size = (cur.size * 0.92)
            r.code = true
        }
        if (nm == "kbd") {
            r.family = style.monoFamily
            r.size = (cur.size * 0.85)
            r.kbd = true
        }
        if ((nm == "sub") || (nm == "sup")) {
            r.shiftOf = cur.size
            if (cur.shift != 0) {
                r.shiftOf = cur.shiftOf
            }
            r.size = (cur.size * 0.75)
            r.shift = 1
            if (nm == "sub") {
                r.shift = -1
            }
        }
        if (nm == "small") { r.size = (cur.size * 0.85) }
        if (nm == "big") { r.size = (cur.size * 1.15) }
        return r
    }

    ; One broken line, placed with its left edge at `x0` and its top at `y`:
    ; a text box per segment, and what goes behind and over them — a code
    ; tint, a highlight, a key cap, a line under or through.
    fn emitLine:void (ln:MdLine x0:double y:double) {
        def top:double (y + ln.extraTop)
        def lh:double (ln.height - ln.extraTop)
        ; The line's baseline: the lowest one its segments would have on
        ; their own, which is the largest face's. Every segment stands on
        ; it — <small> print, a key cap and a code span no longer float up
        ; to the top of the line box they are smaller than.
        def base:double 0.0
        def s0:int 0
        while (s0 < (array_length ln.segs)) {
            def g0:MdSeg (itemAt ln.segs s0)
            if (((strlen g0.math) == 0) && (g0.shift == 0)) {
                def b0:double (this.baselineIn(g0))
                if (b0 > base) {
                    base = b0
                }
            }
            s0 = (s0 + 1)
        }
        def s:int 0
        def sn:int (array_length ln.segs)
        while (s < sn) {
            def seg:MdSeg (itemAt ln.segs s)
            def sx:double (x0 + seg.x)
            def own:double (this.baselineIn(seg))
            if ((strlen seg.math) > 0) {
                def mt:double top
                if (base > 0.0) {
                    mt = (top + (base - own))
                }
                this.emit((this.mathSegBox(seg sx mt)))
                s = (s + 1)
                continue
            }
            ; on the line's baseline, or — a sub- or superscript — moved off
            ; it by a share of the size of the text it sits in
            def ty:double top
            if (base > 0.0) {
                ty = (top + (base - own))
            }
            if (seg.shift != 0) {
                def big:double base
                if (big <= 0.0) {
                    big = (this.baselineAt(seg.family seg.bold seg.italic seg.shiftOf))
                }
                def want:double (big + (seg.shiftOf * 0.2))
                if (seg.shift > 0) {
                    want = (big - (seg.shiftOf * 0.38))
                }
                ty = (top + (want - own))
            }
            if ((seg.code || seg.mark) || ((strlen seg.fill) > 0)) {
                def pad:double 2.0
                def fill:string style.codeBackground
                if seg.mark {
                    fill = style.markBackground
                }
                if ((strlen seg.fill) > 0) {
                    fill = seg.fill
                }
                this.emit((MdBox.rect((sx - pad) (top + 1.0) (seg.w + (pad * 2.0)) (lh - 2.0) fill)))
            }
            if seg.kbd {
                def kp:double 3.0
                def kFace:string style.kbdBackground
                if ((strlen kFace) == 0) {
                    kFace = style.codeBackground
                }
                def kEdge:string style.kbdBorder
                if ((strlen kEdge) == 0) {
                    kEdge = style.codeBorder
                }
                this.emit((MdBox.rect((sx - kp) (top + 2.0) (seg.w + (kp * 2.0)) (lh - 4.0) kFace)))
                this.emit((MdBox.outline((sx - kp) (top + 2.0) (seg.w + (kp * 2.0)) (lh - 4.0) kEdge 1.0)))
            }
            def b:MdBox (MdBox.text(seg.text sx ty seg.w lh))
            b.segSrc = seg.srcStart
            b.segLen = seg.srcLen
            b.segAtom = seg.atom
            b.family = seg.family
            b.size = seg.size
            b.bold = seg.bold
            b.italic = seg.italic
            b.color = seg.color
            b.link = seg.link
            b.strike = seg.strike
            b.quiet = seg.quiet
            b.noteRef = seg.noteRef
            b.spacing = seg.spacing
            this.emit(b)
            if (seg.underline || seg.strike) {
                def base:double (ty + (this.baselineAt(seg.family seg.bold seg.italic seg.size)))
                def th:double (seg.size * 0.06)
                if (th < 1.0) {
                    th = 1.0
                }
                if seg.underline {
                    this.emit((MdBox.rect(sx (base + (seg.size * 0.1)) seg.w th seg.color)))
                }
                if seg.strike {
                    this.emit((MdBox.rect(sx (base - (seg.size * 0.3)) seg.w th seg.color)))
                }
            }
            s = (s + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; TeX math
    ; ----------------------------------------------------------------------
    ;
    ; A formula is set by `MathLayout` in ems and drawn at `mathPx` pixels per
    ; em: a little larger than the text around it, because the Computer
    ; Modern faces the formulas are cut from are small on the body — the same
    ; 1.21 KaTeX uses. Boxes are kept per source, since a line is measured
    ; several times while it is being broken.
    sfn mathPx:double (size:double) {
        return (size * 1.21)
    }

    fn mathBox:MathBox (tex:string display:boolean) {
        def key:string tex
        if display {
            key = ("display:" + tex)
        }
        if (has mathBoxes key) {
            return (unwrap (get mathBoxes key))
        }
        def b:MathBox (MathLayout.layout(tex display))
        set mathBoxes key b
        return b
    }

    ; Where the painter puts the baseline of a run of `seg`'s face, down from
    ; the top of its line box — the rule the painters draw text by, so a
    ; formula stands on the same line as the words beside it.
    fn baselineIn:double (seg:MdSeg) {
        return (this.baselineAt(seg.family seg.bold seg.italic seg.size))
    }

    fn baselineAt:double (family:string bold:boolean italic:boolean size:double) {
        def face:string (style.faceFor(family bold italic))
        def m:EVGTextMetrics (engine.measureRun("Hg" face size))
        ; a TrueType measurer reports hhea's descender, which is negative
        def asc:double (fabs m.ascent)
        def desc:double (fabs m.descent)
        if ((asc + desc) <= 0.0) {
            return (size * 0.9)
        }
        return (((size - (asc + desc)) / 2.0) + asc)
    }

    fn mathSegBox:MdBox (seg:MdSeg x:double lineTop:double) {
        def mb:MathBox (this.mathBox(seg.math seg.mathDisplay))
        def px:double (MdLayout.mathPx(seg.size))
        def base:double (lineTop + (this.baselineIn(seg)))
        def b:MdBox (new MdBox())
        b.kind = 5
        b.x = x
        b.y = (base - (mb.h * px))
        b.w = seg.w
        b.h = ((mb.h + mb.d) * px)
        b.size = px
        b.color = seg.color
        b.embedSource = seg.math
        b.embedKind = "math"
        if seg.mathDisplay {
            b.embedKind = "math-display"
        }
        b.segSrc = seg.srcStart
        b.segLen = seg.srcLen
        return b
    }

    ; A $$ display: centred in the column, scaled down when it would not fit.
    fn mathBlock:void (node:MdNode x:double w:double) {
        def mb:MathBox (this.mathBox(node.literal true))
        def px:double (MdLayout.mathPx(style.bodySize))
        if (((mb.w * px) > w) && (mb.w > 0.0)) {
            px = (w / mb.w)
        }
        def bw:double (mb.w * px)
        def bh:double ((mb.h + mb.d) * px)
        def pad:double (style.bodySize * 0.35)
        def y:double (this.reserve((bh + (2.0 * pad))))
        def b:MdBox (new MdBox())
        b.kind = 5
        b.x = (x + ((w - bw) / 2.0))
        b.y = (y + pad)
        b.w = bw
        b.h = bh
        b.size = px
        b.color = style.textColor
        if (quoteDepth > 0) {
            b.color = style.quoteColor
        }
        b.embedSource = node.literal
        b.embedKind = "math-display"
        this.emit(b)
        cursorY = (((y + bh) + (2.0 * pad)) + style.paraSpacing)
    }

    ; ----------------------------------------------------------------------
    ; A paragraph: runs in, positioned lines out
    ; ----------------------------------------------------------------------
    fn paragraph:void (runs:[MdRun] x:double w:double) {
        def lines:[MdLine] (this.breakRuns(runs w))
        def firstBox:int (array_length boxes)
        def i:int 0
        def n:int (array_length lines)
        while (i < n) {
            def ln:MdLine (itemAt lines i)
            ; a line that first refers to a footnote needs the footnote's
            ; room on its page too: without it the line goes on and its note
            ; goes nowhere, so the two go to the next page together
            def y:double (this.reserve((ln.height + (this.noteRoomFor(ln)))))
            def dx:double 0.0
            if (align == "center") {
                dx = ((w - ln.width) / 2.0)
            }
            if (align == "right") {
                dx = (w - ln.width)
            }
            if (dx < 0.0) {
                dx = 0.0
            }
            this.emitLine(ln (x + dx) y)
            cursorY = (y + ln.height)
            i = (i + 1)
        }
        if ((align == "center") || (align == "right")) {
            def k:int firstBox
            while (k < (array_length boxes)) {
                def b:MdBox (itemAt boxes k)
                if (b.kind == 0) {
                    b.align = align
                    b.alignX = x
                    b.alignW = w
                }
                k = (k + 1)
            }
        }
        ; where the column its lines were set in ends (an export widens a
        ; text box to there, not to the slide's edge: in columns, or beside
        ; a picture, that would be over the next column)
        def m:int firstBox
        while (m < (array_length boxes)) {
            def cb:MdBox (itemAt boxes m)
            if (cb.kind == 0) {
                cb.colRight = (x + w)
            }
            m = (m + 1)
        }
    }

    ; ----------------------------------------------------------------------
    ; From a point on the page back to a character in the file
    ; ----------------------------------------------------------------------
    ;
    ; This is the question a caret is, and until the segments carried their
    ; own offsets it could not be asked: every box of a paragraph held that
    ; PARAGRAPH's start, so the finest answer available was "the block you
    ; clicked". The viewer's `sourceOffsetAt` returned exactly that.
    ;
    ; It lives here rather than in the web facade because it is layout, not
    ; chrome: it has to measure with the measurer the layout measured with, or
    ; the caret lands beside the glyphs rather than between them. `PptxEdit`
    ; and `DocxEditController` each learned that separately.

    ; A box's y in DOCUMENT coordinates. `sheetGap` >= 0 means the sheets are
    ; stacked with that much between them; below zero means one column.
    ; A box's y in DOCUMENT coordinates. `sheetGap` >= 0 means the sheets are
    ; stacked with that much between them; below zero means one column.
    ;
    ; The gap runs BEFORE the first sheet too. A document whose first page
    ; starts at y=0 sits against the top of the window with nothing above it,
    ; which reads as a page that has been cut rather than one that starts.
    fn boxTop:double (b:MdBox sheetGap:double) {
        if (sheetGap >= 0.0) {
            return ((b.y + sheetGap) + ((to_double b.page) * (style.pageHeight + sheetGap)))
        }
        return b.y
    }

    fn measureStyled:double (text:string family:string size:double bold:boolean italic:boolean) {
        def len:int (strlen text)
        if (len == 0) { return 0.0 }
        def face:string (style.faceFor(family bold italic))
        def m:EVGTextMetrics (engine.measureRun(text face size))
        return m.width
    }

    ; Which character of a placed run the pointer at `x` is over, as a source
    ; offset. Splits on glyph midpoints, so a click lands on the nearer side
    ; of a character rather than always its left — the same rule
    ; `OfficeTextMetrics.offsetAtX` follows for the .docx caret.
    ;
    ; The walk is over the box's TEXT and the answer is in the FILE, and those
    ; are the same length only where the run holds no escape and no entity. So
    ; the result is clamped into the box's own span: an approximate offset
    ; inside a run is a caret one character out, while an unclamped one is a
    ; caret in the next paragraph.
    fn offsetInBox:int (b:MdBox x:double) {
        if (b.segSrc < 0) { return -1 }
        def len:int (strlen b.text)
        if (len == 0) { return b.segSrc }
        def want:double (x - b.x)
        if (want <= 0.0) { return b.segSrc }
        def k:int 0
        def hit:int len
        while (k < len) {
            def w0:double (this.measureStyled((substring b.text 0 k) b.family b.size b.bold b.italic))
            def w1:double (this.measureStyled((substring b.text 0 (k + 1)) b.family b.size b.bold b.italic))
            if (want < ((w0 + w1) * 0.5)) {
                hit = k
                k = len
            } {
                k = (k + 1)
            }
        }
        if b.segAtom {
            ; the nearer END of what the glyph stands for
            if ((hit * 2) < len) { return b.segSrc }
            if ((hit * 2) == len) {
                if ((want * 2.0) < b.w) { return b.segSrc }
            }
            return (b.segSrc + b.segLen)
        }
        def at:int (b.segSrc + hit)
        def stop:int (b.segSrc + b.segLen)
        if (at > stop) { at = stop }
        return at
    }

    ; The text box at a point in document coordinates, or -1. A click to the
    ; right of the last word on a line belongs to that line rather than to
    ; nothing, so the nearest box on the line the pointer is ON wins — which
    ; is what puts a caret at the end of a line when a reader clicks past it.
    fn boxAtPoint:int (x:double y:double sheetGap:double) {
        def best:int -1
        def bestDx:double 0.0
        def i:int 0
        def n:int (array_length boxes)
        while (i < n) {
            def b:MdBox (itemAt boxes i)
            if ((b.kind == 0) && (b.segSrc >= 0)) {
                def top:double (this.boxTop(b sheetGap))
                if ((y >= top) && (y < (top + b.h))) {
                    def dx:double 0.0
                    if (x < b.x) { dx = (b.x - x) }
                    if (x > (b.x + b.w)) { dx = (x - (b.x + b.w)) }
                    if (best < 0) {
                        best = i
                        bestDx = dx
                    } {
                        if (dx < bestDx) {
                            best = i
                            bestDx = dx
                        }
                    }
                }
            }
            i = (i + 1)
        }
        return best
    }

    ; The whole question in one call: a point on the page, a character in the
    ; file, or -1 when nothing that carries a source was drawn there.
    fn srcAtPoint:int (x:double y:double sheetGap:double) {
        def i:int (this.boxAtPoint(x y sheetGap))
        if (i < 0) { return -1 }
        def b:MdBox (itemAt boxes i)
        return (this.offsetInBox(b x))
    }

    fn measureRun:double (text:string r:MdRun) {
        def len:int (strlen text)
        if (len == 0) { return 0.0 }
        if ((strlen r.math) > 0) {
            def mb:MathBox (this.mathBox(r.math r.mathDisplay))
            return (mb.w * (MdLayout.mathPx(r.size)))
        }
        def face:string (style.faceFor(r.family r.bold r.italic))
        def m:EVGTextMetrics (engine.measureRun(text face r.size))
        if (r.spacing != 0.0) {
            return (m.width + (EVGTextEngine.trackingWidth(text r.spacing)))
        }
        return m.width
    }

    ; ----------------------------------------------------------------------
    ; Breaking a line across several faces
    ; ----------------------------------------------------------------------
    ;
    ; The algorithm `EVGTextEngine` uses, with one change: the accumulator is
    ; a list of segments rather than a string, so a change of face is a new
    ; segment instead of the end of the line. Each segment is measured WHOLE
    ; — not as a sum of word widths plus a guessed space — which is what
    ; makes the break land where the painter will draw it.
    fn breakRuns:[MdLine] (runs:[MdRun] maxWidth:double) {
        def lines:[MdLine]

        ; --- atoms: words, runs of spaces, and forced breaks ---------------
        def aText:[string]
        def aRun:[int]
        def aSpace:[boolean]
        def aBreak:[boolean]
        ; Where each atom starts inside its run's text. The atoms are what a
        ; segment is assembled from, so this is the only place the offset is
        ; still known — by the time `flushOpen` sees `openText` it is a string
        ; with no memory of where it was cut from.
        def aOff:[int]
        def ri:int 0
        def rn:int (array_length runs)
        while (ri < rn) {
            def r:MdRun (itemAt runs ri)
            if r.hardBreak {
                push aText ""
                push aRun ri
                push aSpace false
                push aBreak true
                push aOff 0
            } {
                def t:string r.text
                def tn:int (strlen t)
                def i:int 0
                while (i < tn) {
                    def start:int i
                    def c:int (charAt t i)
                    def isSpace:boolean (MdChar.isSpaceOrTab(c))
                    def scanning:boolean true
                    while scanning {
                        if (i >= tn) { scanning = false }
                        if scanning {
                            def c2:int (charAt t i)
                            def s2:boolean (MdChar.isSpaceOrTab(c2))
                            if (s2 == isSpace) { i = (i + 1) } { scanning = false }
                        }
                    }
                    push aText (substring t start i)
                    push aRun ri
                    push aSpace isSpace
                    push aBreak false
                    push aOff start
                }
            }
            ri = (ri + 1)
        }

        ; --- the greedy fill ----------------------------------------------
        def cur:MdLine (new MdLine())
        def usedWidth:double 0.0
        def openRun:int -1
        def openText:string ""
        def openOff:int 0
        ; What `openText` measures, carried forward instead of measured again.
        ; `prevAtom` is the last atom that went in, and `prevAtomW` what it
        ; measures alone — the pair that lets the next atom be charged its
        ; advance AND its kern without re-reading the whole segment.
        def openW:double 0.0
        def prevAtom:string ""
        def prevAtomW:double 0.0
        def ai:int 0
        def an:int (array_length aText)
        def guard:int 0
        while (ai < an) {
            guard = (guard + 1)
            if (guard > 2000000) { ai = an }
            if (ai < an) {
                def hard:boolean (itemAt aBreak ai)
                def isSpace:boolean (itemAt aSpace ai)
                def segCount:int (array_length cur.segs)
                def lineEmpty:boolean ((segCount == 0) && ((strlen openText) == 0))
                if hard {
                    usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                    openRun = -1
                    openText = ""
                    openOff = 0
                    openW = 0.0
                    prevAtom = ""
                    prevAtomW = 0.0
                    def done:MdLine (this.finishLine(cur))
                    push lines done
                    cur = (new MdLine())
                    usedWidth = 0.0
                    ai = (ai + 1)
                } {
                    if (isSpace && lineEmpty) {
                        ; a wrapped line does not begin with the space it
                        ; wrapped at
                        ai = (ai + 1)
                    } {
                        def r:int (itemAt aRun ai)
                        def t:string (itemAt aText ai)
                        def run:MdRun (itemAt runs r)
                        def candidate:double 0.0
                        ; What the line measures with this atom on it, and —
                        ; when it is taken — what the open segment then
                        ; measures.
                        ;
                        ; Measuring `openText + t` outright is what this did
                        ; first, and it re-read the whole open segment once per
                        ; word: quadratic in the segment, with a cache entry
                        ; per prefix. A kern pair depends only on the two
                        ; codepoints either side of the join, so `prevAtom + t`
                        ; is charged the same advance and the same pair as the
                        ; whole string would be — the growth is
                        ; `measure(prevAtom + t) - measure(prevAtom)`, and the
                        ; running total stays the number a whole-string
                        ; measurement gives.
                        def grown:double 0.0
                        if (r == openRun) {
                            def joined:double (this.measureRun((prevAtom + t) run))
                            grown = ((openW + joined) - prevAtomW)
                            candidate = (usedWidth + grown)
                            ; Near the break, throw the running total away and
                            ; ask for the whole segment. A sum of parts and a
                            ; single measurement agree to the last bit only by
                            ; luck, and this is the one place where the last
                            ; bit decides where the line ends.
                            def slack:double (candidate - maxWidth)
                            if (slack < 0.0) {
                                slack = (0.0 - slack)
                            }
                            if (slack < 1.0) {
                                grown = (this.measureRun((openText + t) run))
                                candidate = (usedWidth + grown)
                            }
                        } {
                            def openRunObj:MdRun run
                            if (openRun >= 0) { openRunObj = (itemAt runs openRun) }
                            def openExact:double 0.0
                            if (openRun >= 0) { openExact = (this.measureRun(openText openRunObj)) }
                            grown = (this.measureRun(t run))
                            candidate = ((usedWidth + openExact) + grown)
                        }
                        def startsSegment:boolean (r != openRun)
                        if (isSpace && startsSegment) {
                            ; A space that would OPEN a segment becomes pure
                            ; advance instead of text.
                            ;
                            ; It has no glyph, so nothing is lost — and every
                            ; consumer that trims the edges of a text run (an
                            ; HTML preview does; so does anything that treats
                            ; a run as a line box) then draws the same
                            ; geometry as the PDF. Before this, `[LICENSE]`
                            ; followed by ` for details` lost the space
                            ; between them in the preview while the PDF kept
                            ; it: one layout, two pictures.
                            usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                            openRun = -1
                            openText = ""
                            openOff = 0
                            openW = 0.0
                            prevAtom = ""
                            prevAtomW = 0.0
                            usedWidth = (usedWidth + (this.measureRun(t run)))
                            ai = (ai + 1)
                        } {
                        def overflows:boolean ((candidate > maxWidth) && (! lineEmpty) && (! isSpace))
                        if overflows {
                            usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                            openRun = -1
                            openText = ""
                            openOff = 0
                            openW = 0.0
                            prevAtom = ""
                            prevAtomW = 0.0
                            def wrapped:MdLine (this.finishLine(cur))
                            push lines wrapped
                            cur = (new MdLine())
                            usedWidth = 0.0
                        } {
                            if (r == openRun) {
                                openText = (openText + t)
                            } {
                                usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
                                openRun = r
                                openText = t
                                openOff = (itemAt aOff ai)
                            }
                            openW = grown
                            prevAtom = t
                            prevAtomW = (this.measureRun(t run))
                            ai = (ai + 1)
                        }
                        }
                    }
                }
            }
        }
        usedWidth = (this.flushOpen(cur runs openRun openText openOff usedWidth))
        def leftover:int (array_length cur.segs)
        def any:int (array_length lines)
        if ((leftover > 0) || (any == 0)) {
            def last:MdLine (this.finishLine(cur))
            push lines last
        }
        return lines
    }

    ; The open segment, measured and placed. Returns the new used width.
    fn flushOpen:double (cur:MdLine runs:[MdRun] openRun:int openText:string openOff:int usedWidth:double) {
        if (openRun < 0) { return usedWidth }
        def len:int (strlen openText)
        if (len == 0) { return usedWidth }
        def run:MdRun (itemAt runs openRun)
        def seg:MdSeg (new MdSeg())
        seg.text = openText
        ; Where this piece sits in the document. `openOff` is how far into the
        ; run's TEXT it started, and text and source are the same length only
        ; where the run holds no escape and no entity — so the answer is
        ; clamped to the run's own span rather than allowed to run past the
        ; node it belongs to. `MdSrcMapScan` is what says how often the two
        ; are the same string: on CommonMark's own corpus, every time it can
        ; be checked at all.
        if (run.srcStart >= 0) {
            def at:int (run.srcStart + openOff)
            if (run.srcEnd >= run.srcStart) {
                if (at > run.srcEnd) { at = run.srcEnd }
            }
            seg.srcStart = at
            def upto:int (at + len)
            if (run.srcEnd >= run.srcStart) {
                if (upto > run.srcEnd) { upto = run.srcEnd }
            }
            seg.srcLen = (upto - at)
            if (seg.srcLen < 0) { seg.srcLen = 0 }
            if run.atom {
                ; all of it or none of it: the run's text is not its source
                seg.atom = true
                seg.srcStart = run.srcStart
                seg.srcLen = (run.srcEnd - run.srcStart)
            }
        }
        seg.family = run.family
        seg.size = run.size
        seg.bold = run.bold
        seg.italic = run.italic
        seg.color = run.color
        seg.code = run.code
        seg.link = run.link
        seg.math = run.math
        seg.mathDisplay = run.mathDisplay
        seg.underline = run.underline
        seg.strike = run.strike
        seg.quiet = run.quiet
        seg.mark = run.mark
        seg.fill = run.fill
        seg.kbd = run.kbd
        seg.shift = run.shift
        seg.shiftOf = run.shiftOf
        seg.noteRef = run.noteRef
        seg.spacing = run.spacing
        seg.x = usedWidth
        seg.w = (this.measureRun(openText run))
        push cur.segs seg
        return (usedWidth + seg.w)
    }

    ; A line's height and baseline are the maximum over its segments, so a
    ; small code span inside larger prose does not pull the line up.
    fn finishLine:MdLine (cur:MdLine) {
        def n:int (array_length cur.segs)
        def height:double (style.bodySize * style.lineHeight)
        def ascent:double (style.bodySize * 0.9)
        def width:double 0.0
        if (n > 0) {
            ; the trailing space a wrap left behind is not part of the line
            def last:MdSeg (itemAt cur.segs (n - 1))
            def trimmed:string (MdLayout.trimTrailing(last.text))
            def tlen:int (strlen trimmed)
            def olen:int (strlen last.text)
            if (tlen != olen) {
                last.text = trimmed
                ; …and the source it covers shrinks with it, or a caret
                ; dragged to the end of a wrapped line lands on a space the
                ; line no longer draws.
                if (last.srcLen > (olen - tlen)) {
                    last.srcLen = (last.srcLen - (olen - tlen))
                } {
                    last.srcLen = 0
                }
                def r:MdRun (new MdRun())
                r.family = last.family
                r.size = last.size
                r.bold = last.bold
                r.italic = last.italic
                last.w = (this.measureRun(trimmed r))
            }
            height = 0.0
            def above:double 0.0
            def below:double 0.0
            def i:int 0
            while (i < n) {
                def seg:MdSeg (itemAt cur.segs i)
                def face:string (style.faceFor(seg.family seg.bold seg.italic))
                def m:EVGTextMetrics (engine.measureRun("Hg" face seg.size))
                def h:double (seg.size * style.lineHeight)
                if (h > height) { height = h }
                if (m.ascent > ascent) { ascent = m.ascent }
                width = (seg.x + seg.w)
                if ((strlen seg.math) > 0) {
                    ; how far the formula reaches past the text's own
                    ; baseline, up and down
                    def mb:MathBox (this.mathBox(seg.math seg.mathDisplay))
                    def px:double (MdLayout.mathPx(seg.size))
                    def base:double (this.baselineIn(seg))
                    def up:double ((mb.h * px) - base)
                    def down:double ((base + (mb.d * px)) - h)
                    if (up > above) { above = up }
                    if (down > below) { below = down }
                }
                i = (i + 1)
            }
            cur.extraTop = above
            height = ((height + above) + below)
        }
        cur.height = height
        cur.ascent = ascent
        cur.width = width
        return cur
    }

    sfn leadingSpaces:int (v:string) {
        def n:int (strlen v)
        def i:int 0
        while (i < n) {
            def c:int (charAt v i)
            if (! (MdChar.isSpaceOrTab(c))) { return i }
            i = (i + 1)
        }
        return n
    }

    sfn trailingSpaces:int (v:string n:int lead:int) {
        def i:int n
        def going:boolean true
        while going {
            if (i <= lead) { going = false }
            if going {
                def c:int (charAt v (i - 1))
                if (MdChar.isSpaceOrTab(c)) { i = (i - 1) } { going = false }
            }
        }
        return (n - i)
    }

    sfn trimTrailing:string (v:string) {
        def n:int (strlen v)
        def i:int n
        def going:boolean true
        while going {
            if (i <= 0) { going = false }
            if going {
                def c:int (charAt v (i - 1))
                if (MdChar.isSpaceOrTab(c)) { i = (i - 1) } { going = false }
            }
        }
        return (substring v 0 i)
    }

    ; ----------------------------------------------------------------------
    ; Tables
    ; ----------------------------------------------------------------------
    fn table:void (node:MdNode x:double w:double) {
        def rows:int (node.childCount())
        if (rows == 0) { return }
        def head:MdNode (node.childAt(0))
        def cols:int (head.childCount())
        if (cols == 0) { return }
        ; `{width=60%}` under it: that share of the column, and the text
        ; after it beside it (startFloat)
        def tw:double (MdEmbedKinds.widthOf((this.widthAttr(node)) w))
        def was:double (this.tableTextOn())
        def widths:[double] (this.gridWidths(node tw))
        ; cells coloured by their text (`{cells=…}`, `table { cell-tones }`)
        def tones:MdCellTones (MdCellTones.forTable(node style.tableCellTones))
        ; the header rows, said again on every slide the table continues on
        def heads:int 0
        while ((heads < rows) && (MdLayout.isHeadRow((node.childAt(heads))))) {
            heads = (heads + 1)
        }
        def heights:[double]
        def headH:double 0.0
        def r0:int 0
        while (r0 < rows) {
            def rh:double (this.tableRowHeight((node.childAt(r0)) widths cols tones))
            if (r0 < heads) {
                headH = (headH + rh)
            } {
                push heights rh
            }
            r0 = (r0 + 1)
        }
        def plan:MdTablePlan (this.tablePlan(heights headH))
        def on:int -1
        def r2:int heads
        while (r2 < rows) {
            def s:int (itemAt plan.slideOf (r2 - heads))
            if (s != on) {
                if (on >= 0) {
                    this.tableBreak()
                } {
                    if (s > 0) {
                        this.tableBreak()
                    }
                }
                on = s
                def hr:int 0
                while (hr < heads) {
                    this.tableRow((node.childAt(hr)) x widths cols tones)
                    hr = (hr + 1)
                }
            }
            this.tableRow((node.childAt(r2)) x widths cols tones)
            r2 = (r2 + 1)
        }
        if (heads == rows) {
            def hr2:int 0
            while (hr2 < heads) {
                this.tableRow((node.childAt(hr2)) x widths cols tones)
                hr2 = (hr2 + 1)
            }
        }
        style.bodySize = was
        cursorY = (cursorY + style.paraSpacing)
    }

    sfn isHeadRow:boolean (row:MdNode) {
        if ((row.childCount()) == 0) { return false }
        def c:MdNode (row.childAt(0))
        return c.isHeader
    }

    ; ----------------------------------------------------------------------
    ; A table cut across slides
    ; ----------------------------------------------------------------------
    ;
    ; Which slide each row group goes to is `MdTableSplit`'s answer, from
    ; heights alone; the room it is given is what is left here and what a
    ; continuation slide has under the title said again. Rows are spread
    ; evenly on a deck, filled to the bottom on a printed page.
    ;
    ; Per slide: how much more of a balanced table sits on it (its repeated
    ; header, and the rows balancing moved over) than filling the slide
    ; before it would have left there. The slide shrinker
    ; judges a spill by what it would have been (`shrinkSlide`).
    def spillExcess:[double]

    fn tablePlan:MdTablePlan (groups:[double] headH:double) {
        if ((paginate == false) || (page >= (MdCssLimits.pageBudget()))) {
            def flat:MdTablePlan (new MdTablePlan())
            def i:int 0
            while (i < (array_length groups)) {
                push flat.slideOf 0
                i = (i + 1)
            }
            return flat
        }
        def titleH:double 0.0
        if slides {
            titleH = (this.continuationTitleHeight(true))
        }
        def firstRoom:double (contentBottom - cursorY)
        def nextRoom:double ((contentBottom - contentTop) - titleH)
        def plan:MdTablePlan (MdTableSplit.plan(groups headH firstRoom nextRoom slides))
        if (slides && (plan.slides == 2)) {
            ; the header said again is there because of the cut, like the
            ; title over it
            this.setSpillExcess((page + 1) ((plan.tail - plan.greedyTail) + headH))
        }
        return plan
    }

    ; A table's own break: the next slide, the title again, and the count a
    ; cut block adds to, exactly as `reserve` does when a block runs over.
    fn tableBreak:void () {
        if (page >= (MdCssLimits.pageBudget())) { return }
        page = (page + 1)
        pageCount = (page + 1)
        cursorY = contentTop
        if slides {
            slideOverflows = (slideOverflows + 1)
            this.emitSlideTitle()
        }
    }

    fn setSpillExcess:void (p:int v:double) {
        while ((array_length spillExcess) <= p) {
            push spillExcess 0.0
        }
        set_at spillExcess p v
    }

    fn spillExcessAt:double (p:int) {
        if ((p < 0) || (p >= (array_length spillExcess))) { return 0.0 }
        return (itemAt spillExcess p)
    }

    ; Slide p + 1 was folded into p (`shrinkSlide`): the pages noted for
    ; the slides after p move up one, as their boxes did. A hidden title
    ; written after the shrunk slide was still noted on the page below its
    ; own, so it named the slide before it and its slide began at the
    ; first thing drawn instead of at its heading (deleting that slide by
    ; number left the heading behind).
    fn pagesMovedUp:void (p:int) {
        MdLayout.shiftAfter(hiddenPage p)
        MdLayout.shiftAfter(headPage p)
        MdLayout.shiftAfter(namedPage p)
        MdLayout.shiftAfter(overlayPage p)
        MdLayout.shiftAfter(noteFirstPage p)
        if (hiddenOnPage > p) {
            hiddenOnPage = (hiddenOnPage - 1)
        }
    }

    sfn shiftAfter:void (pages:[int] p:int) {
        def i:int 0
        while (i < (array_length pages)) {
            def v:int (itemAt pages i)
            if (v > p) {
                set_at pages i (v - 1)
            }
            i = (i + 1)
        }
    }

    ; the slide `p` went: what was recorded for the slides after it moves up
    fn dropSpillExcess:void (p:int) {
        def kept:[double]
        def i:int 0
        while (i < (array_length spillExcess)) {
            if (i != p) {
                push kept (itemAt spillExcess i)
            }
            i = (i + 1)
        }
        spillExcess = kept
    }

    ; ----------------------------------------------------------------------
    ; A picture
    ; ----------------------------------------------------------------------
    ;
    ; `![alt](logo.png)` on a paragraph of its own becomes a picture; anywhere
    ; else it stays ALT TEXT.
    ;
    ; That split is deliberate rather than a first step. A picture in the
    ; middle of a sentence has to sit on a text baseline, which is a different
    ; question from putting a block on a page and one markdown almost never
    ; asks — every `![]()` in this repository's own documents is on a line of
    ; its own. A block picture is the case that exists, and it is the one that
    ; reaches a deck, a PDF and a slide.
    ;
    ; A picture nobody can find stays alt text too. That is not a fallback
    ; that hides a problem: it is exactly what the reader sees in the preview,
    ; so the preview and the export are missing the same picture rather than
    ; disagreeing about it. `missingImages` counts them.
    fn pictureBlock:boolean (node:MdNode x:double w:double) {
        if (! haveImages) { return false }
        def img:MdNode (MdLayout.loneImage(node))
        if (img.kind != "image") { return false }
        def path:string (images.resolve(img.destination docDir))
        if ((strlen path) == 0) {
            missingImages = (missingImages + 1)
            return false
        }
        def st:VfsStat (images.stat(path))
        if (! st.found) {
            missingImages = (missingImages + 1)
            return false
        }
        ; drawn by the host over the page: no room here (a pass that only
        ; measures what follows a picture does not place it)
        if (this.isOverlayType(st.contentType)) {
            if paginate {
                this.noteOverlay(node.srcStart path page)
            }
            return true
        }

        ; Its own size, never scaled UP — a 64pt icon in a 468pt column is a
        ; 64pt icon — and fitted down when it is wider than the column.
        def natW:double (to_double st.pixelW)
        def natH:double (to_double st.pixelH)
        def useW:double natW
        def useH:double natH
        if (natW <= 0.0) {
            useW = w
            useH = (w * 0.5)
        }
        def wantAttr:string (this.widthAttr(node))
        def asked:double (MdEmbedKinds.widthOf(wantAttr w))
        ; On a slide a `width` is the width it is shown at, larger than its
        ; pixels too (the handles on the slide set it); a document page
        ; only ever fits it down.
        def grows:boolean ((slides && paginate) && ((strlen wantAttr) > 0))
        if ((asked < useW) || grows) {
            if (useW > 0.0) {
                useH = (useH * (asked / useW))
                useW = asked
            }
        }
        if (useW > w) {
            useH = (useH * (w / useW))
            useW = w
        }
        ; `{height=200}` / `{height=50%}` (of the page's content height), and
        ; the theme's `img { max-height }`: the picture keeps its shape
        def fullH:double (contentBottom - contentTop)
        def maxH:double 0.0
        def hAttr:string (node.attrValue("height"))
        if ((strlen hAttr) > 0) {
            def hBase:double fullH
            if (hBase <= 0.0) {
                hBase = useH
            }
            maxH = (MdEmbedKinds.widthOf(hAttr hBase))
        }
        if ((style.imgMaxHeight > 0.0) && ((maxH <= 0.0) || (style.imgMaxHeight < maxH))) {
            if ((strlen hAttr) == 0) {
                maxH = style.imgMaxHeight
            }
        }
        if ((maxH > 0.0) && (useH > maxH)) {
            useW = (useW * (maxH / useH))
            useH = maxH
        }
        ; …and on a slide a `height` (without a `width`) the height it is
        ; shown at, as wide as that makes it up to the column
        if ((((slides && paginate) && ((strlen hAttr) > 0)) && ((strlen wantAttr) == 0)) && ((useH > 0.0) && ((maxH > useH) && (useW > 0.0)))) {
            def hk:double (maxH / useH)
            if ((useW * hk) > w) {
                hk = (w / useW)
            }
            useW = (useW * hk)
            useH = (useH * hk)
        }
        ; On a slide a picture is shown at the size of its room: the column's
        ; width and the height under its heading, less what is written under
        ; it on the same slide (`followH`), so a large picture (an SVG is
        ; drawn 2560 wide) leaves its caption on the slide and a small one
        ; (a 160×90 PNG) is not a stamp in a corner. Set larger at most 4
        ; times; a picture given a `width` or `height` is as asked. A
        ; document page keeps a picture's own size.
        ; A picture narrow enough for the text after it to go beside it
        ; (startFloat) leaves no room under itself for that text.
        def under:double followH
        if ((followBeside && ((strlen wantAttr) > 0)) && (useW <= (contentW * 0.75))) {
            if (((contentW - useW) - (style.bodySize * 1.2)) >= (contentW * 0.25)) {
                under = 0.0
            }
        }
        if ((slides && paginate) && (((strlen wantAttr) == 0) && ((strlen hAttr) == 0))) {
            def roomH:double ((contentBottom - cursorY) - followH)
            def up:double (MdLayout.pictureScale(useW useH w roomH 4.0))
            useW = (useW * up)
            useH = (useH * up)
        }
        ; On a slide a picture taller than the room under its heading is
        ; given that room (shrunk, its shape kept) rather than running off
        ; the bottom (and above the text under it, when there is room for
        ; both); on a full slide it moves on as it did.
        if (slides && paginate) {
            def avail:double (contentBottom - cursorY)
            if ((avail - under) >= (fullH * 0.25)) {
                avail = (avail - under)
            }
            def titleOnly:boolean (slideTitleOnly && (avail >= (fullH * 0.2)))
            if ((useH > avail) && ((avail >= (fullH * 0.35)) || titleOnly)) {
                useW = (useW * (avail / useH))
                useH = avail
            }
            if (useH > fullH) {
                useW = (useW * (fullH / useH))
                useH = fullH
            }
        }
        ; `{float=top-right}`: in that corner of the slide, out of the flow
        def corner:string (MdSlideLayout.cornerOf((node.attrValue("float"))))
        if (((strlen corner) > 0) && slides) {
            if paginate {
                this.pinPicture(node corner path img st)
            }
            return true
        }
        ; where it sits in the column: `{align=center}`, else the theme's
        ; `img { justify-content }`, else centred on a slide
        def align:string (MdCss.alignWord((node.attrValue("align"))))
        if ((strlen align) == 0) {
            align = style.imgAlign
        }
        if (((strlen align) == 0) && slides) {
            align = "center"
        }
        def px:double x
        if (align == "center") {
            px = (x + ((w - useW) * 0.5))
        }
        if (align == "end") {
            px = ((x + w) - useW)
        }

        def y:double (this.reserve(useH))
        def b:MdBox (new MdBox())
        b.kind = 4
        b.x = px
        b.y = y
        b.w = useW
        b.h = useH
        b.imagePath = path
        b.imageAlt = (img.plainText())
        b.imageNaturalW = st.pixelW
        b.imageNaturalH = st.pixelH
        this.emit(b)
        cursorY = ((y + useH) + style.paraSpacing)
        return true
    }

    ; How much a `w`×`h` picture is set larger to fill a room `roomW` wide
    ; and `roomH` high, at most `most` times; 1 when it is as large already
    ; or the room is too low to show it larger (then the slide's own rules
    ; shrink it or move it on).
    sfn pictureScale:double (w:double h:double roomW:double roomH:double most:double) {
        if ((w <= 0.0) || (h <= 0.0)) { return 1.0 }
        def s:double (roomW / w)
        if ((roomH / h) < s) { s = (roomH / h) }
        if (s > most) { s = most }
        if (s < 1.0) { return 1.0 }
        return s
    }


    ; ----------------------------------------------------------------------
    ; A gallery (```gallery, MdGallery)
    ; ----------------------------------------------------------------------
    ;
    ; `layout=grid`: the cells in rows across the column, each row as tall
    ; as the slide allows for as many rows as keep a row at least
    ; `galleryMinRow` high; the rows that do not fit go on to the next slide
    ; (with its title again, as any block that spills). On a document page
    ; a row is two thirds of a column's width high. `layout=full`: one
    ; picture a slide, edge to edge.
    def galleryMinRow:double 140.0

    fn gallery:void (node:MdNode x:double w:double) {
        def g:MdGallery (MdGallery.of(node))
        if ((array_length g.items) == 0) {
            return
        }
        def look:MdGalleryLook (g.look(sheet))
        if ((g.layout == "full") && paginate) {
            this.galleryFull(g look)
            return
        }
        this.galleryGrid(g look x w)
    }

    fn galleryGrid:void (g:MdGallery look:MdGalleryLook x:double w:double) {
        def cols:int (g.columnsFor(look))
        def gap:double look.gap
        if (gap > (w * 0.2)) {
            gap = (w * 0.2)
        }
        ; on a slide, as many across as show the most of the pictures in
        ; the room there is (portraits side by side, not cropped wide)
        if (slides && paginate) {
            def aspects:[double]
            def anyCap:boolean false
            def ai:int 0
            while (ai < (array_length g.items)) {
                def it:MdGalleryItem (itemAt g.items ai)
                def a:double 0.0
                if (it.isText == false) {
                    def pic:MdBox (this.galleryPicture(it))
                    if ((pic.imageNaturalW > 0) && (pic.imageNaturalH > 0)) {
                        a = ((to_double pic.imageNaturalW) / (to_double pic.imageNaturalH))
                    }
                    if ((strlen it.caption) > 0) { anyCap = true }
                }
                push aspects a
                ai = (ai + 1)
            }
            def capH:double 0.0
            if (anyCap && (g.caption == "below")) {
                capH = (style.bodySize * style.lineHeight)
            }
            def fullR:double (contentBottom - contentTop)
            def roomR:double (contentBottom - cursorY)
            if (roomR < (fullR * 0.35)) { roomR = fullR }
            cols = (g.columnsForRoom(look aspects w roomR gap capH galleryMinRow))
        }
        def rows:[[int]] (g.rows(cols))
        def nRows:int (array_length rows)
        def rowH:double (((w - (gap * (to_double (cols - 1)))) / (to_double cols)) * 0.66)
        if (slides && paginate) {
            def fullH:double (contentBottom - contentTop)
            def room:double (contentBottom - cursorY)
            if (room < (fullH * 0.35)) {
                ; too little under what is there: the gallery starts a slide
                room = fullH
            }
            def least:double galleryMinRow
            if (least > (fullH * 0.45)) {
                least = (fullH * 0.45)
            }
            def per:int (MdGallery.rowsPerPage(room gap least nRows))
            rowH = ((room - (gap * (to_double (per - 1)))) / (to_double per))
            if (rowH > fullH) {
                rowH = fullH
            }
        }
        def r:int 0
        while (r < nRows) {
            def row:[int] (itemAt rows r)
            def widths:[double] (g.rowWidths(row cols w gap))
            def y:double (this.reserve(rowH))
            def last:boolean (r == (nRows - 1))
            if ((strlen look.background) > 0) {
                def bgH:double rowH
                if (last == false) {
                    bgH = (rowH + gap)
                }
                this.emit((MdBox.rect(x y w bgH look.background)))
            }
            def cx:double x
            def k:int 0
            while (k < (array_length row)) {
                def idx:int (itemAt row k)
                def cw:double (itemAt widths k)
                this.galleryCell(g idx cx y cw rowH)
                cx = ((cx + cw) + gap)
                k = (k + 1)
            }
            cursorY = (y + rowH)
            if (last == false) {
                cursorY = (cursorY + gap)
            }
            r = (r + 1)
        }
        cursorY = (cursorY + style.paraSpacing)
    }

    ; One cell of a grid: its background, the picture (or a text cell's
    ; words), the caption and the border, in that order.
    fn galleryCell:void (g:MdGallery idx:int x:double y:double w:double h:double) {
        def it:MdGalleryItem (itemAt g.items idx)
        def cl:MdCellLook (g.cellLook(sheet it style))
        def cap:MdCellLook (g.captionLook(sheet it style))
        def ground:string cl.background
        if ((strlen ground) == 0) {
            def look:MdGalleryLook (g.look(sheet))
            ground = look.background
        }
        this.readableCaption(cap (g.caption == "overlay") ground)
        def capText:string it.caption
        def capW:double ((((w - cl.padL) - cl.padR) - cap.padL) - cap.padR)
        def capH:double 0.0
        if ((it.isText == false) && (((strlen capText) > 0) && (g.caption != "none"))) {
            capH = (this.linesHeight((this.galleryLines(capText cap capW))))
        }
        def pic:MdBox (this.galleryPicture(it))
        def c:MdGalleryCell (g.placeCell(it idx x y w h cl cap capH (to_double pic.imageNaturalW) (to_double pic.imageNaturalH)))
        if ((strlen cl.background) > 0) {
            def bg:MdBox (MdBox.rect(x y w h cl.background))
            bg.radius = cl.radius
            this.emit(bg)
        }
        if it.isText {
            this.galleryText(it.text cl c.capX c.capY c.capW c.capH true)
        } {
            def rounded:double 0.0
            if ((((cl.padT + cl.padR) + cl.padB) + cl.padL) < 0.01) {
                rounded = cl.radius
            }
            this.galleryPlace(pic c rounded)
            if c.dim {
                this.emit((MdBox.rect(c.dimX c.dimY c.dimW c.dimH (this.dimColor(cap)))))
            }
            if (capH > 0.0) {
                this.galleryText(capText cap c.capX c.capY c.capW (c.capH + 0.5) false)
            }
        }
        if ((cl.borderWidth > 0.0) && ((strlen cl.borderColor) > 0)) {
            def o:MdBox (MdBox.outline(x y w h cl.borderColor cl.borderWidth))
            o.radius = cl.radius
            this.emit(o)
        }
    }

    ; `layout=full`: each picture on a slide of its own, over the whole
    ; page — and in print over the bleed past it — with no margins and no
    ; header or footer. The first goes on the slide the gallery is on when
    ; that slide holds nothing yet (a hidden title is nothing).
    ; A hidden title written just before a full-page gallery names the
    ; gallery's first slide, not the slide the break leaves behind: the
    ; titles noted on `from` after the last thing drawn there move to `to`.
    fn carryHidden:void (from:int to:int) {
        if (hiddenOnPage != from) {
            return
        }
        def last:int -1
        def i:int 0
        while (i < (array_length boxes)) {
            def b:MdBox (itemAt boxes i)
            if (b.page == from) {
                def s:int b.srcStart
                if (b.segSrc >= 0) {
                    s = b.segSrc
                }
                if (s > last) {
                    last = s
                }
            }
            i = (i + 1)
        }
        def h:int 0
        while (h < (array_length hiddenSrc)) {
            if (((itemAt hiddenPage h) == from) && ((itemAt hiddenSrc h) > last)) {
                set_at hiddenPage h to
            }
            h = (h + 1)
        }
        hiddenOnPage = to
        def n:int (array_length headPage)
        if ((n > 0) && ((itemAt headPage (n - 1)) == from)) {
            set_at headPage (n - 1) to
        }
    }

    fn galleryFull:void (g:MdGallery look:MdGalleryLook) {
        def pw:double style.pageWidth
        def ph:double style.pageHeight
        def b:double 0.0
        if style.forPrint {
            b = style.bleed
        }
        ; the text keeps this far from the edge: half the page's margin,
        ; and in print the safe area the printing house asked for
        def inset:double (style.margin * 0.5)
        if (style.forPrint && (style.safeArea > inset)) {
            inset = style.safeArea
        }
        def k:int 0
        while (k < (array_length g.items)) {
            if ((k > 0) || ((cursorY - contentTop) > 0.5)) {
                def from:int page
                this.nextSlide()
                if (k == 0) {
                    this.carryHidden(from page)
                }
            }
            push headerOff page
            push footerOff page
            def it:MdGalleryItem (itemAt g.items k)
            this.namePage(page (this.fullPageName(it k)))
            def cl:MdCellLook (g.cellLook(sheet it style))
            def cap:MdCellLook (g.captionLook(sheet it style))
            def ground:string look.background
            if ((strlen cl.background) > 0) {
                ground = cl.background
            }
            this.readableCaption(cap (g.caption == "overlay") ground)
            if ((strlen ground) > 0) {
                def gb:MdBox (MdBox.rect((0.0 - b) (0.0 - b) (pw + (b * 2.0)) (ph + (b * 2.0)) ground))
                gb.bleeds = (b > 0.0)
                this.emit(gb)
            }
            if it.isText {
                this.galleryText(it.text cl (inset + cl.padL) (inset + cl.padT) (((pw - (inset * 2.0)) - cl.padL) - cl.padR) (((ph - (inset * 2.0)) - cl.padT) - cl.padB) true)
            } {
                def capText:string it.caption
                if (g.caption == "none") {
                    capText = ""
                }
                def capW:double (((pw - (inset * 2.0)) - cap.padL) - cap.padR)
                def capH:double 0.0
                if ((strlen capText) > 0) {
                    capH = (this.linesHeight((this.galleryLines(capText cap capW))))
                }
                def band:double 0.0
                if (capH > 0.0) {
                    band = (((capH + cap.padT) + cap.padB) + inset)
                    if (band > (ph * 0.4)) {
                        band = (ph * 0.4)
                    }
                }
                def pic:MdBox (this.galleryPicture(it))
                def c (new MdGalleryCell())
                c.item = k
                ; the picture's place: the page and the bleed round it, less
                ; the band a caption below takes; inside a cell's padding
                def px:double ((0.0 - b) + cl.padL)
                def py:double ((0.0 - b) + cl.padT)
                def pwid:double (((pw + (b * 2.0)) - cl.padL) - cl.padR)
                def phei:double (((ph + (b * 2.0)) - cl.padT) - cl.padB)
                if ((g.caption == "below") && (band > 0.0)) {
                    phei = (((ph + b) - band) - cl.padT)
                }
                MdGallery.fitPicture(c g.fit it.focusX it.focusY (to_double pic.imageNaturalW) (to_double pic.imageNaturalH) px py pwid phei)
                this.galleryPlace(pic c cl.radius)
                ; it is cut at the page's edge only where it reaches it
                def last:int ((array_length boxes) - 1)
                if (((b > 0.0) && (last >= 0)) && ((strlen pic.imagePath) > 0)) {
                    def lb:MdBox (itemAt boxes last)
                    lb.bleeds = true
                }
                if (capH > 0.0) {
                    def cy:double (((ph - inset) - cap.padB) - capH)
                    if (g.caption == "overlay") {
                        def dy:double ((cy - cap.padT) - (inset * 0.5))
                        def dim:MdBox (MdBox.rect((0.0 - b) dy (pw + (b * 2.0)) ((ph - dy) + b) (this.dimColor(cap))))
                        dim.bleeds = (b > 0.0)
                        this.emit(dim)
                    }
                    this.galleryText(capText cap (inset + cap.padL) cy capW (capH + 0.5) false)
                }
            }
            k = (k + 1)
        }
        cursorY = contentBottom
        fullPageDone = true
    }

    ; The picture an item names, as a box that knows its file and size;
    ; `imagePath` is "" when the store has no such picture.
    fn galleryPicture:MdBox (it:MdGalleryItem) {
        def b:MdBox (new MdBox())
        b.kind = 4
        b.imageAlt = it.caption
        if ((strlen b.imageAlt) == 0) {
            b.imageAlt = it.src
        }
        if (! haveImages) {
            missingImages = (missingImages + 1)
            return b
        }
        def path:string (images.resolve(it.src docDir))
        if ((strlen path) == 0) {
            missingImages = (missingImages + 1)
            return b
        }
        def st:VfsStat (images.stat(path))
        if (! st.found) {
            missingImages = (missingImages + 1)
            return b
        }
        b.imagePath = path
        b.imageNaturalW = st.pixelW
        b.imageNaturalH = st.pixelH
        return b
    }

    ; The picture where the cell says, or its name in brackets in that
    ; place when there are no bytes for it.
    fn galleryPlace:void (pic:MdBox c:MdGalleryCell radius:double) {
        if ((strlen pic.imagePath) == 0) {
            def lk (new MdCellLook())
            lk.fontSize = (style.bodySize * 0.8)
            lk.family = style.bodyFamily
            lk.color = style.mutedColor
            lk.align = "center"
            this.emit((MdBox.outline(c.picX c.picY c.picW c.picH style.ruleColor 1.0)))
            def first:int (array_length boxes)
            this.galleryText(("[" + pic.imageAlt + "]") lk c.picX c.picY c.picW c.picH true)
            def q:int first
            while (q < (array_length boxes)) {
                def qb:MdBox (itemAt boxes q)
                qb.quiet = true
                q = (q + 1)
            }
            return
        }
        pic.x = c.picX
        pic.y = c.picY
        pic.w = c.picW
        pic.h = c.picH
        pic.hasCrop = c.cropped
        pic.cropX = c.cropX
        pic.cropY = c.cropY
        pic.cropW = c.cropW
        pic.cropH = c.cropH
        pic.radius = radius
        this.emit(pic)
    }

    ; The band under an overlay caption: the caption's own background when
    ; the sheet gives one, else the page's colour at 55 %, as `bg-dim`
    ; lays the page over a slide's picture.
    ; A caption that reads (4.5:1). On a picture (`overlay`) the band under
    ; it is made just dark (or light) enough for its ink whatever the
    ; picture is, from the paper at 55 % up to 90 %; below a picture the
    ; ink must read on `ground`. A colour from the stylesheet is kept.
    fn readableCaption:void (cap:MdCellLook overlay:boolean ground:string) {
        def paper:string style.pageBackground
        if (((strlen paper) == 0) || (paper == "transparent")) {
            paper = "#ffffff"
        }
        if overlay {
            ; a photo's caption: a dark see-through band with white text,
            ; which reads over light and dark pictures alike. A caption the
            ; sheet coloured dark gets a light band instead.
            if (cap.colorSet == false) {
                cap.color = "#FFFFFF"
            }
            if ((strlen cap.background) == 0) {
                def shade:int 0
                if ((MdContainer.luminance(cap.color)) <= 0.4) {
                    shade = 255
                }
                def a:double 0.45
                def fill:string ""
                while ((a < 0.901) && ((strlen fill) == 0)) {
                    def tryFill:string (MdContainer.hexOf((EVGColor.rgba(shade shade shade a))))
                    if ((MdContainer.worstContrast(cap.color tryFill)) >= 4.5) {
                        fill = tryFill
                    }
                    a = (a + 0.05)
                }
                if ((strlen fill) == 0) {
                    fill = (MdContainer.hexOf((EVGColor.rgba(shade shade shade 0.9))))
                }
                cap.background = fill
            }
            if (cap.colorSet == false) {
                def ink:string (MdContainer.inkOn(cap.background cap.color))
                if ((strlen ink) > 0) {
                    cap.color = ink
                }
            }
            return
        }
        if cap.colorSet {
            return
        }
        def under:string ground
        if ((strlen under) == 0) {
            under = paper
        }
        if ((MdContainer.contrast(cap.color under)) >= 4.5) {
            return
        }
        if ((MdContainer.contrast(style.textColor under)) >= 4.5) {
            cap.color = style.textColor
            return
        }
        def ink2:string (MdContainer.inkOn(under cap.color))
        if ((strlen ink2) > 0) {
            cap.color = ink2
        }
    }

    fn dimColor:string (cap:MdCellLook) {
        if ((strlen cap.background) > 0) {
            return cap.background
        }
        def paper:string style.pageBackground
        if (((strlen paper) == 0) || (paper == "transparent")) {
            paper = "#ffffff"
        }
        def c:EVGColor (EVGColor.parse(paper))
        def hex:string (c.toHexString())
        return (hex + "8C")
    }

    fn galleryLines:[MdLine] (text:string lk:MdCellLook w:double) {
        def r (new MdRun())
        r.text = text
        r.family = lk.family
        if ((strlen r.family) == 0) {
            r.family = style.bodyFamily
        }
        r.size = lk.fontSize
        r.bold = lk.bold
        r.color = lk.color
        def runs:[MdRun]
        push runs r
        def width:double w
        if (width < 8.0) {
            width = 8.0
        }
        return (this.breakRuns(runs width))
    }

    ; Words set in `x, y, w, h` in the look's type and alignment, as many
    ; lines as fit; `middle`: centred down the box (a text cell).
    fn galleryText:void (text:string lk:MdCellLook x:double y:double w:double h:double middle:boolean) {
        def lines:[MdLine] (this.galleryLines(text lk w))
        def total:double (this.linesHeight(lines))
        def ty:double y
        if (middle && (total < h)) {
            ty = (y + ((h - total) * 0.5))
        }
        def first:int (array_length boxes)
        def i:int 0
        while (i < (array_length lines)) {
            def ln:MdLine (itemAt lines i)
            if (((ty + ln.height) - y) > (h + 0.5)) {
                ; what does not fit is left out rather than drawn over the
                ; next cell
                i = (array_length lines)
            } {
                def dx:double 0.0
                if (lk.align == "center") {
                    dx = ((w - ln.width) * 0.5)
                }
                if (lk.align == "end") {
                    dx = (w - ln.width)
                }
                if (dx < 0.0) {
                    dx = 0.0
                }
                this.emitLine(ln (x + dx) ty)
                ty = (ty + ln.height)
                i = (i + 1)
            }
        }
        if (lk.align != "start") {
            def word:string "center"
            if (lk.align == "end") {
                word = "right"
            }
            def k:int first
            while (k < (array_length boxes)) {
                def b:MdBox (itemAt boxes k)
                if (b.kind == 0) {
                    b.align = word
                    b.alignX = x
                    b.alignW = w
                }
                k = (k + 1)
            }
        }
    }

    ; The one image a paragraph holds, when that is ALL it holds. A caption
    ; beside the picture makes it a sentence with a picture in it, and a
    ; sentence is laid out as a sentence.
    sfn loneImage:MdNode (node:MdNode) {
        def found:MdNode (new MdNode())
        def i:int 0
        def n:int (node.childCount())
        while (i < n) {
            def c:MdNode (node.childAt(i))
            if (c.kind == "image") {
                if (found.kind == "image") { return (new MdNode()) }
                found = c
            } {
                if (c.kind == "text") {
                    if ((strlen (trim c.literal)) > 0) { return (new MdNode()) }
                } {
                    if (c.kind != "softbreak") { return (new MdNode()) }
                }
            }
            i = (i + 1)
        }
        return found
    }

    ; How wide each column is, in the space the table has.
    ;
    ; Split out of `table` so that the DECK can ask it: `MdToPptx` builds a
    ; real PowerPoint table and has to give it the same grid, and a second
    ; implementation of this would be a second table algorithm to keep in
    ; step with the first. One algorithm, two callers.
    fn tableWidths:[double] (node:MdNode w:double) {
        def was:double (this.tableTextOn())
        def out:[double] (this.gridWidths(node w))
        style.bodySize = was
        return out
    }

    ; A table's text is set at `table { font-size }` when the sheet gives
    ; one: the body's size is that while the table is measured and drawn,
    ; and what it was is returned to be put back.
    fn tableTextOn:double () {
        def was:double style.bodySize
        if (style.tableSize > 0.0) {
            style.bodySize = style.tableSize
        }
        return was
    }

    fn gridWidths:[double] (node:MdNode w:double) {
        def widths:[double]
        def rows:int (node.childCount())
        if (rows == 0) { return widths }
        def head:MdNode (node.childAt(0))
        def cols:int (head.childCount())
        if (cols == 0) { return widths }

        ; TWO widths per column, not one: what the cell wants if nothing
        ; wrapped (MAX-CONTENT) and what it needs before a word has to be
        ; broken in half (MIN-CONTENT).
        ;
        ; Scaling the max-content widths by one factor — which is what this
        ; did — is only right when every column shrinks equally well, and a
        ; column of one-word labels beside a column of paragraphs is the case
        ; where it is not. `Area | Current expectation` in this repository's
        ; own README came out with a first column narrower than the word
        ; `Host/runtime`, which then ran out of its cell and across the text
        ; in the next one: unreadable, and unreadable in a way a wider table
        ; would not have been.
        ;
        ; So: no column below its min-content width, and the room that is left
        ; shared out in proportion to how much each column would still like.
        ; That is the table algorithm HTML has had since HTML 4 §17.5.2, and
        ; it is what a browser does with this same markdown.
        def natural:[double]
        def minimum:[double]
        def tones:MdCellTones (MdCellTones.forTable(node style.tableCellTones))
        def c:int 0
        while (c < cols) {
            def wid:double 0.0
            def least:double 0.0
            def r:int 0
            while (r < rows) {
                def row:MdNode (node.childAt(r))
                def rc:int (row.childCount())
                if (c < rc) {
                    def cell:MdNode (row.childAt(c))
                    def runs:[MdRun] (this.tableCellRuns(cell tones))
                    def cw:double (this.runsWidth(runs))
                    if (cw > wid) { wid = cw }
                    ; The narrowest column this cell can be set in, asked of
                    ; the line breaker itself rather than guessed from the
                    ; text: break it into a column of one point and the widest
                    ; line that comes back is the widest thing that cannot be
                    ; broken. Guessing it from spaces would disagree with the
                    ; breaker exactly where it matters — `ts_parser` is three
                    ; runs and one word.
                    def tight:[MdLine] (this.breakRuns(runs 1.0))
                    def ti:int 0
                    def tn:int (array_length tight)
                    while (ti < tn) {
                        def tl:MdLine (itemAt tight ti)
                        if (tl.width > least) { least = tl.width }
                        ti = (ti + 1)
                    }
                }
                r = (r + 1)
            }
            push natural (wid + (style.cellPadX * 2.0))
            push minimum (least + (style.cellPadX * 2.0))
            c = (c + 1)
        }
        def total:double 0.0
        def leastTotal:double 0.0
        def k:int 0
        while (k < cols) {
            total = (total + (itemAt natural k))
            leastTotal = (leastTotal + (itemAt minimum k))
            k = (k + 1)
        }
        def j:int 0
        if (total <= w) {
            ; It fits as written. On a slide it spans its column (or the
            ; `width` it was given), the room left shared out as each column
            ; is wide: a five-column table of short cells filled the left
            ; half of the slide and left the right half empty.
            def extra:double 0.0
            if (slides && (total > 0.0)) {
                extra = (w - total)
            }
            while (j < cols) {
                def nat:double (itemAt natural j)
                push widths (nat + (extra * (nat / total)))
                j = (j + 1)
            }
        } {
            if (leastTotal >= w) {
                ; Even unbreakable, it does not fit. The table is then wider
                ; than the column it sits in, which is visible and honest;
                ; squeezing below this point does not make it fit, it only
                ; moves the overflow inside the cells where it lands on top of
                ; the neighbouring text.
                while (j < cols) {
                    push widths (itemAt minimum j)
                    j = (j + 1)
                }
            } {
                def room:double (w - leastTotal)
                def want:double (total - leastTotal)
                while (j < cols) {
                    def lo:double (itemAt minimum j)
                    def hi:double (itemAt natural j)
                    def share:double (((hi - lo) / want) * room)
                    push widths (lo + share)
                    j = (j + 1)
                }
            }
        }
        return widths
    }

    fn runsWidth:double (runs:[MdRun]) {
        def total:double 0.0
        def i:int 0
        def n:int (array_length runs)
        while (i < n) {
            def r:MdRun (itemAt runs i)
            total = (total + (this.measureRun(r.text r)))
            i = (i + 1)
        }
        return total
    }

    ; A table cell's text as runs: bold in the header row, and bold in its
    ; tone's text colour where the table's mapping names what it says.
    ; Measuring and drawing ask this one function, so a cell is never
    ; measured in one face and drawn in another.
    fn tableCellRuns:[MdRun] (cell:MdNode tones:MdCellTones) {
        def base:MdRun (this.baseRun())
        if cell.isHeader {
            base.bold = true
            if ((strlen style.tableHeadColor) > 0) {
                base.color = style.tableHeadColor
            }
        }
        def tone:string (tones.toneOfCell(cell))
        if ((strlen tone) > 0) {
            base.bold = true
            base.color = (MdCellTones.inkOf(tone (this.tablePaper())))
        }
        return (this.inlineRuns(cell base))
    }

    ; the colour a table's tinted cells are worked out against
    fn tablePaper:string () {
        return (MdCellTones.paperOf(style.pageBackground style.textColor))
    }

    fn tableRowHeight:double (row:MdNode widths:[double] cols:int tones:MdCellTones) {
        def rowH:double 0.0
        def c:int 0
        def rc:int (row.childCount())
        while (c < cols) {
            def h:double ((style.bodySize * style.lineHeight) + (style.cellPadY * 2.0))
            if (c < rc) {
                def cell:MdNode (row.childAt(c))
                def runs:[MdRun] (this.tableCellRuns(cell tones))
                def inner:double ((itemAt widths c) - (style.cellPadX * 2.0))
                def lines:[MdLine] (this.breakRuns(runs inner))
                h = ((this.linesHeight(lines)) + (style.cellPadY * 2.0))
            }
            if (h > rowH) { rowH = h }
            c = (c + 1)
        }
        return rowH
    }

    fn tableRow:void (row:MdNode x:double widths:[double] cols:int tones:MdCellTones) {
        ; Every cell is broken to its own column first, so the row is as tall
        ; as the tallest of them.
        def heights:[double]
        def rowH:double 0.0
        def c:int 0
        def rc:int (row.childCount())
        while (c < cols) {
            def h:double ((style.bodySize * style.lineHeight) + (style.cellPadY * 2.0))
            if (c < rc) {
                def cell:MdNode (row.childAt(c))
                def runs:[MdRun] (this.tableCellRuns(cell tones))
                def inner:double ((itemAt widths c) - (style.cellPadX * 2.0))
                def lines:[MdLine] (this.breakRuns(runs inner))
                def sum:double 0.0
                def i:int 0
                def n:int (array_length lines)
                while (i < n) {
                    def ln:MdLine (itemAt lines i)
                    sum = (sum + ln.height)
                    i = (i + 1)
                }
                h = (sum + (style.cellPadY * 2.0))
            }
            push heights h
            if (h > rowH) { rowH = h }
            c = (c + 1)
        }
        def y:double (this.reserve(rowH))
        def cx:double x
        def c2:int 0
        while (c2 < cols) {
            def cw:double (itemAt widths c2)
            def isHead:boolean false
            def tone:string ""
            if (c2 < rc) {
                def cell0:MdNode (row.childAt(c2))
                isHead = cell0.isHeader
                tone = (tones.toneOfCell(cell0))
            }
            if isHead {
                this.emit((MdBox.rect(cx y cw rowH style.tableHeadBackground)))
            }
            def toned:boolean ((strlen tone) > 0)
            if toned {
                this.emit((MdBox.rect(cx y cw rowH (MdCellTones.fillOf(tone (this.tablePaper()))))))
            }
            this.emit((MdBox.outline(cx y cw rowH style.tableBorder 1.0)))
            if (c2 < rc) {
                def cell:MdNode (row.childAt(c2))
                def runs:[MdRun] (this.tableCellRuns(cell tones))
                def inner:double (cw - (style.cellPadX * 2.0))
                def lines:[MdLine] (this.breakRuns(runs inner))
                def ty:double (y + style.cellPadY)
                ; a toned cell is a value, set in the middle of its cell
                if toned {
                    ty = (y + ((rowH - (this.linesHeight(lines))) / 2.0))
                }
                def i:int 0
                def n:int (array_length lines)
                while (i < n) {
                    def ln:MdLine (itemAt lines i)
                    def lx:double (cx + style.cellPadX)
                    if (cell.align == "right") {
                        lx = (((cx + cw) - style.cellPadX) - ln.width)
                    }
                    if ((cell.align == "center") || toned) {
                        lx = ((cx + style.cellPadX) + ((inner - ln.width) / 2.0))
                    }
                    this.emitLine(ln lx ty)
                    ty = (ty + ln.height)
                    i = (i + 1)
                }
            }
            cx = (cx + cw)
            c2 = (c2 + 1)
        }
        cursorY = (y + rowH)
    }
}
