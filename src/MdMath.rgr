; ============================================================================
; MdMath.rgr — the formulas of a document, through RangerMath.
; ============================================================================
;
; RangerMath is a crate of its own (gallery/math/src/lib.rs). The Rust-syntax
; modules of this crate know .rgr classes by name, not another crate's types,
; so they use a formula through this class: its size in ems from
; `MathLayout`, its outlines from `MathRender`.

Import "../../math/src/MathRender.rgr"
Import "pkg:evg/EVGElement.rgr"

class MdMath {
    ; width, height above the baseline and depth below it, in ems
    def w:double 0.0
    def h:double 0.0
    def d:double 0.0

    sfn size:MdMath (tex:string display:boolean) {
        def b:MathBox (MathLayout.layout(tex display))
        def m:MdMath (new MdMath())
        m.w = b.w
        m.h = b.h
        m.d = b.d
        return m
    }

    ; the formula's outlines, `px` pixels per em, in `colour`
    sfn element:EVGElement (tex:string display:boolean px:double colour:string) {
        def b:MathBox (MathLayout.layout(tex display))
        return (MathRender.boxElement(b px colour))
    }
}
