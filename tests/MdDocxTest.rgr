; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdDocxTest.rgr — a markdown document, as a Word document.
; ============================================================================
;
;   npm run markdown:docx:test
;
; `MdToDocx` builds the model `DocxEditController` edits and `DocxView` draws —
; the Word editor this repository already has. So the claim is not "it produced
; something"; it is that what came out is the SHAPE that editor expects:
; paragraphs with spans, list kinds Word understands, and a hyperlink where the
; document had a link.
;
; And the costs, counted. A document that quietly lost its table is worse than
; one that says it could not carry it.
; ============================================================================

Import "../src/MdBlock.rgr"
Import "../src/MdToDocx.rgr"
Import "../src/MdDocSync.rgr"
Import "../../docx_viewer/src/DocxView.rgr"
Import "../src/MdDiagram.rgr"
Import "../../docx_viewer/src/DocxA11y.rgr"
Import "../../vfs/src/Vfs.rgr"

class DocCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print (("  FAIL " + name) + ("  got " + (to_string got)) + ("  want " + (to_string want)))
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }
}

class MdDocxTest {
    def maker:MdToDocx (new MdToDocx())

    sfn main:void () {
        def t (new MdDocxTest())
        t.run()
    }

    fn make:RichDocument (src:string) {
        def node:MdNode (MdBlock.parseText(src))
        maker = (new MdToDocx())
        def st (new MdStyle())
        return (maker.build(node st))
    }

    fn makeWith:RichDocument (src:string v:Vfs) {
        def node:MdNode (MdBlock.parseText(src))
        maker = (new MdToDocx())
        maker.setImages(v "/")
        def st (new MdStyle())
        return (maker.build(node st))
    }

    fn run:void () {
        def c (new DocCheck())
        print "== MdDocxTest =="
        this.shape(c)
        this.formatting(c)
        this.markdownIt(c)
        this.lists(c)
        this.costs(c)
        this.tables(c)
        this.inlineMath(c)
        this.drawn(c)
        this.drawings(c)
        this.pictures(c)
        this.headingWriteback(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }

    ; ----------------------------------------------------------------------
    fn shape:void (c:DocCheck) {
        print "-- a stream of paragraphs, which is what Word is --"
        def src:string "# Otsikko\n\nEnsimmainen kappale.\n\nToinen kappale.\n"
        def d:RichDocument (this.make(src))
        c.eqInt("three paragraphs came out" (array_length d.paragraphs) 3)
        c.eqInt("…one of them a heading" maker.result.headings 1)
        c.eqInt("…and two of them prose" maker.result.paragraphs 2)

        def h:Paragraph (itemAt d.paragraphs 0)
        c.eqStr("the heading carries Word's own style name" h.styleId "Heading1")
        c.eqStr("…and its text" (h.plainText()) "Otsikko")
        def p1:Paragraph (itemAt d.paragraphs 1)
        c.eqStr("the first paragraph is the first paragraph" (p1.plainText()) "Ensimmainen kappale.")

        ; Every paragraph has an ID, because that is how `DocxEditController`
        ; names one. A document of paragraphs with no ids is one the editor
        ; cannot put a caret in.
        def ids:boolean true
        def i:int 0
        while (i < (array_length d.paragraphs)) {
            def p:Paragraph (itemAt d.paragraphs i)
            if (p.id <= 0) { ids = false }
            i = (i + 1)
        }
        c.ok("and every paragraph has an id the editor can name it by" ids)
    }

    ; A title retyped in Word is a patch on the heading, not a second document.
    fn headingWriteback:void (c:DocCheck) {
        print "-- a heading retyped in Word writes back to the .md --"
        def src:string "# Hello there {.lead}\n\nA line.\n"
        def d:RichDocument (this.make(src))
        def h:Paragraph (itemAt d.paragraphs 0)
        c.ok("the heading is stamped" (h.mdSrcStart >= 0))
        c.eqStr("the stamp is the visible heading" h.mdLastText "Hello there")
        def inner:string (substring src h.mdSrcStart h.mdSrcEnd)
        c.eqStr("the inner span is the heading words" inner "Hello there")
        h.text = "New title"
        def starts:[int]
        def ends:[int]
        def texts:[string]
        def paras:[Paragraph]
        MdDocSync.collect(d starts ends texts paras)
        c.eqInt("one heading changed" (array_length starts) 1)
        def from:int (itemAt starts 0)
        def to:int (itemAt ends 0)
        def text:string (itemAt texts 0)
        def next:string ((substring src 0 from) + text)
        next = (next + (substring src to (strlen src)))
        c.ok("the markdown has the new title" (MdDocxTest.hasSub(next "New title")))
        c.ok("the hashes stayed" (MdDocxTest.hasSub(next "# New title")))
        c.ok("the class stayed" (MdDocxTest.hasSub(next "{.lead}")))
        c.ok("the body stayed" (MdDocxTest.hasSub(next "A line.")))
    }

    ; ----------------------------------------------------------------------
    fn formatting:void (c:DocCheck) {
        print "-- bold, italic, code and a link are spans --"
        def src:string "Tama on **lihava** ja *kursiivi* ja `koodi` ja [linkki](https://example.com).\n"
        def d:RichDocument (this.make(src))
        c.eqInt("one paragraph" (array_length d.paragraphs) 1)
        def p:Paragraph (itemAt d.paragraphs 0)

        ; The plain text is the sentence without any markers in it: a marker
        ; that survived into the text would be drawn as a character.
        c.eqStr("the text is the sentence, with no markers in it"
            (p.plainText()) "Tama on lihava ja kursiivi ja koodi ja linkki.")

        c.ok("a span is bold" (MdDocxTest.anySpan(p "bold")))
        c.ok("…another is italic" (MdDocxTest.anySpan(p "italic")))
        c.ok("…another is underlined, because it is a link" (MdDocxTest.anySpan(p "underline")))
        c.ok("and the link carries where it goes"
            (MdDocxTest.hasLink(p "https://example.com")))

        ; The bold span covers the WORD and not the sentence. A span that
        ; covered everything would still be "a bold span" and would be wrong.
        def b:TextSpan (MdDocxTest.spanOf(p "bold"))
        def word:string (substring (p.plainText()) b.start b.end)
        c.eqStr("…and the bold span covers the word that was bold" word "lihava")
    }

    ; markdown-it's spans and the typographer, in Word: `++ins++` is
    ; underlined; sup, sub and mark have no TextSpan property to go to, so
    ; their text stays, in the style around it — never lost.
    fn markdownIt:void (c:DocCheck) {
        print "-- markdown-it's spans and replacements --"
        def src:string "19^th^ H~2~O ++new++ ==hot== (c) HTML\n\n*[HTML]: Hyper Text\n"
        def d:RichDocument (this.make(src))
        c.eqInt("one paragraph: the abbreviation's definition is not one" (array_length d.paragraphs) 1)
        def p:Paragraph (itemAt d.paragraphs 0)
        c.eqStr("every span's text is there, replaced where it should be"
            (p.plainText()) ("19th H2O new hot " + ((strfromcode 169) + " HTML")))
        c.ok("++new++ is underlined" (MdDocxTest.anySpan(p "underline")))
        def i:int 0
        while (i < (array_length p.spans)) {
            def sp:TextSpan (itemAt p.spans i)
            if sp.underline {
                c.eqStr("…and only it" (substring (p.plainText()) sp.start sp.end) "new")
            }
            i = (i + 1)
        }
    }

    ; ----------------------------------------------------------------------
    fn lists:void (c:DocCheck) {
        print "-- a list item is a paragraph Word knows is one --"
        def src:string "- yksi\n- kaksi\n\n1. eka\n2. toka\n"
        def d:RichDocument (this.make(src))
        c.eqInt("four items" maker.result.listItems 4)
        def bullets:int 0
        def numbers:int 0
        def i:int 0
        while (i < (array_length d.paragraphs)) {
            def p:Paragraph (itemAt d.paragraphs i)
            if (p.listKind == 1) { bullets = (bullets + 1) }
            if (p.listKind == 2) { numbers = (numbers + 1) }
            i = (i + 1)
        }
        ; The KIND, not the count: a numbered list that came out as bullets
        ; has the right number of paragraphs and the wrong document.
        c.eqInt("two of them are bullets" bullets 2)
        c.eqInt("…and two are numbered" numbers 2)

        ; Nesting is a level, not a second list.
        def nested:string "- ulko\n  - sisa\n"
        def nd:RichDocument (this.make(nested))
        c.eqInt("a nested item is still an item" maker.result.listItems 2)
        def deep:int 0
        def j:int 0
        while (j < (array_length nd.paragraphs)) {
            def np:Paragraph (itemAt nd.paragraphs j)
            if (np.listLevel > 0) { deep = (deep + 1) }
            j = (j + 1)
        }
        c.eqInt("…one level deeper" deep 1)
    }

    ; ----------------------------------------------------------------------
    fn costs:void (c:DocCheck) {
        print "-- and what it could not carry, said out loud --"
        def src:string "```mermaid\nflowchart LR\n  A --> B\n```\n"
        def d:RichDocument (this.make(src))
        c.eqInt("the diagram went in as its name" maker.result.drawingsAsText 1)
        c.ok("…and that was said out loud" ((maker.result.noteCount()) >= 1))
        c.ok("…and the summary says so too"
            (MdDocxTest.hasSub((maker.result.describe()) "drawing(s) as their name")))

        def codeSrc:string "```js\nconst a = 1;\nconst b = 2;\n```\n"
        def cd:RichDocument (this.make(codeSrc))
        c.eqInt("a fenced block is one code block" maker.result.codeBlocks 1)
        c.eqInt("…of one paragraph per line" (array_length cd.paragraphs) 2)
        def c0:Paragraph (itemAt cd.paragraphs 0)
        c.eqStr("…with the line in it" (c0.plainText()) "const a = 1;")
    }

    ; A formula in a line is an equation span: its TeX for the writer, one
    ; line of Unicode as its text, never merged with its neighbours.
    fn inlineMath:void (c:DocCheck) {
        print "-- a formula in a line is an equation --"
        def d:RichDocument (this.make("Kun $a^2 + b^2 = c^2$ ja $x$ on.\n"))
        def p:Paragraph (itemAt d.paragraphs 0)
        def eqs:int 0
        def first:string ""
        def i:int 0
        while (i < (array_length p.spans)) {
            def sp:TextSpan (itemAt p.spans i)
            if ((strlen sp.math) > 0) {
                if (eqs == 0) {
                    first = sp.math
                }
                eqs = (eqs + 1)
            }
            i = (i + 1)
        }
        c.eqInt("two equation spans" eqs 2)
        c.eqStr("…the first keeps its TeX" first "a^2 + b^2 = c^2")
        c.ok("the text holds no TeX" ((indexOf (p.plainText()) "^") < 0))
        c.ok("…but the formula's letters" (MdDocxTest.hasSub((p.plainText()) "c")))
    }

    ; A markdown table is a Word table: rows, cells, the header row shaded and
    ; bold, the column alignment on each cell's paragraph, inline formatting
    ; kept, and the columns sharing the text column.
    fn tables:void (c:DocCheck) {
        print "-- a table is a Word table --"
        def src:string "| Nimi | Määrä |\n| :--- | ---: |\n| **omena** | 3 |\n| päärynä |\n"
        def d:RichDocument (this.make(src))
        c.eqInt("one table counted" maker.result.tables 1)
        c.eqInt("…in the document" (array_length d.tables) 1)
        c.eqInt("…as one body block" (array_length d.blocks) 1)
        def t:DocumentTable (itemAt d.tables 0)
        c.eqInt("three rows" (t.rowCount()) 3)
        c.eqInt("two columns" (t.columnCount()) 2)
        def sec:DocSection d.section
        def text:int ((sec.pageWTwips - sec.marginLeftTwips) - sec.marginRightTwips)
        def w0:int (itemAt t.colWidthsTwips 0)
        c.eqInt("the columns share the text column" w0 (idiv text 2))
        def head:DocTableRow (itemAt t.rows 0)
        def h0:DocTableCell (itemAt head.cells 0)
        c.ok("the header row is shaded" ((strlen h0.fillHex) == 6))
        def hp:Paragraph (itemAt h0.paragraphs 0)
        c.eqStr("…and holds its words" (hp.plainText()) "Nimi")
        c.ok("…in bold" (d.paraHasBold(hp)))
        def h1:DocTableCell (itemAt head.cells 1)
        def h1p:Paragraph (itemAt h1.paragraphs 0)
        c.eqInt("a right-aligned column is right-aligned" h1p.align 2)
        def body:DocTableRow (itemAt t.rows 1)
        def b0:DocTableCell (itemAt body.cells 0)
        c.ok("a body cell is not shaded" ((strlen b0.fillHex) == 0))
        def bp:Paragraph (itemAt b0.paragraphs 0)
        c.eqStr("…its bold word kept" (bp.plainText()) "omena")
        c.ok("…as bold" (d.paraHasBold(bp)))
        def short:DocTableRow (itemAt t.rows 2)
        c.eqInt("a short row still has every cell" (array_length short.cells) 2)
        def gap:DocTableCell (itemAt short.cells 1)
        def gp:Paragraph (itemAt gap.paragraphs 0)
        c.eqStr("…the missing one empty" (gp.plainText()) "")
        c.ok("the summary names the table" (MdDocxTest.hasSub((maker.result.describe()) "1 table(s)")))

        ; …and the Word viewer draws the cells' words
        def view (new DocxView())
        view.init("gallery/pdf_writer/assets/fonts")
        def nums (new WordNumbering())
        def ed (new DocxEditController())
        ed.bindDocument(d)
        def dl:EVGDisplayList (view.buildDisplayList(d 0 nums ed false))
        def said:string ""
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds i)
            if (cmd.kind == 3) {
                said = ((said + cmd.text) + "|")
            }
            i = (i + 1)
        }
        c.ok("the viewer draws the cells' words"
            ((MdDocxTest.hasSub(said "omena")) && (MdDocxTest.hasSub(said "Määrä"))))
    }

    ; ----------------------------------------------------------------------

    ; ----------------------------------------------------------------------
    ; …and the Word viewer draws it
    ; ----------------------------------------------------------------------
    ;
    ; A model the editor accepts is half the claim. The other half is that
    ; `DocxView` — the docx module's OWN painter, the same marks its canvas
    ; path makes, through `DocxInk` in list mode — produces a page from it.
    ;
    ; This is the function the markdown page calls, so a model that laid out to
    ; nothing would show up here rather than as a blank canvas in a browser.
    fn drawn:void (c:DocCheck) {
        print "-- and the Word viewer draws it --"
        def src:string "# Otsikko\n\nEnsimmainen kappale, pitka tarpeeksi rivittymaan tassa leveydessa.\n\n- yksi\n- kaksi\n"
        def d:RichDocument (this.make(src))

        def view (new DocxView())
        view.init("gallery/pdf_writer/assets/fonts")
        def nums (new WordNumbering())
        def ed (new DocxEditController())
        ed.bindDocument(d)
        def dl:EVGDisplayList (view.buildDisplayList(d 0 nums ed false))
        c.eqInt("one page came out of it" (view.layout.pageCount()) 1)
        c.ok("…with marks on it" ((array_length dl.cmds) > 5) )

        def texts:int 0
        def said:string ""
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds i)
            if (cmd.kind == 3) {
                texts = (texts + 1)
                said = ((said + cmd.text) + "|")
            }
            i = (i + 1)
        }
        ; TEXT RUNS, not just marks: a page of rectangles would also "have
        ; commands", which is the same distinction the markdown page's own
        ; check makes about itself.
        c.ok("…drawn as text runs" (texts > 3))
        c.ok("…saying what the document says"
            ((MdDocxTest.hasSub(said "Otsikko")) && (MdDocxTest.hasSub(said "yksi"))))
    }

    ; ----------------------------------------------------------------------
    ; A diagram is geometry here too
    ; ----------------------------------------------------------------------
    ;
    ; The Word view drew a ```mermaid fence as the words "[mermaid diagram]"
    ; while the preview beside it drew the flowchart and the deck carried it
    ; as shapes — the same document, missing its picture on one tab. The tree
    ; the layout prepared is handed over and becomes a DRAWING, and the claim
    ; is checked where it lands: the block, the laid-out line, and the marks
    ; on the page — PATHS, because a page of rectangles would also "have
    ; commands" and a diagram's edges are what a rasterized copy loses.
    fn drawings:void (c:DocCheck) {
        print "-- a diagram is geometry in the Word document too --"
        def src:string "# Kaavio\n\n```dot\ndigraph { saapuu -> tarkista; tarkista -> laskuta; }\n```\n\nJa teksti sen alla.\n"
        def node:MdNode (MdBlock.parseText(src))
        def cache (new MdEmbedCache())
        MdDiagram.prepare(node cache 600.0 "default")
        c.eqInt("the layout drew the fence" (cache.count()) 1)
        maker = (new MdToDocx())
        maker.setEmbeds(cache)
        def st (new MdStyle())
        def d:RichDocument (maker.build(node st))
        c.eqInt("the diagram went in as a drawing" maker.result.drawings 1)
        c.eqInt("…and not as its name" maker.result.drawingsAsText 0)
        c.eqInt("…one drawing on the document" (d.drawingCount()) 1)
        def dr:DocDrawing (itemAt d.drawings 0)
        c.ok("…with its tree behind it" (dr.hasRoot()))
        c.eqStr("…named for its notation" dr.name "Graphviz diagram")
        c.eqStr("…and carrying its source" dr.source "digraph { saapuu -> tarkista; tarkista -> laskuta; }\n")
        c.ok("…sized from what was drawn" ((dr.widthPx > 10) && (dr.heightPx > 10)))
        c.ok("…in the summary" (MdDocxTest.hasSub((maker.result.describe()) "drawing(s) placed")))
        ; The block sits between the heading and the paragraph, where the
        ; fence was: a drawing appended at the end would be a drawing in the
        ; wrong place.
        c.eqInt("the document has three blocks" (array_length d.blocks) 3)
        def b1:DocBlock (itemAt d.blocks 1)
        c.eqInt("…and the middle one is the drawing" b1.kind (DocBlockKind.drawing()))

        ; …and the Word viewer draws it: a line for the drawing, and paths
        ; inside its box.
        def view (new DocxView())
        view.init("gallery/pdf_writer/assets/fonts")
        def nums (new WordNumbering())
        def ed (new DocxEditController())
        ed.bindDocument(d)
        def dl:EVGDisplayList (view.buildDisplayList(d 0 nums ed false))
        def pg:LaidPage (view.layout.pageAt(0))
        def drawnLine:int -1
        def li:int 0
        while (li < (array_length pg.lines)) {
            def ln:LaidLine (itemAt pg.lines li)
            if (ln.kind == (LaidLineKind.drawing())) { drawnLine = li }
            li = (li + 1)
        }
        c.ok("the layout made a line for it" (drawnLine >= 0))
        if (drawnLine >= 0) {
            def ln:LaidLine (itemAt pg.lines drawnLine)
            c.ok("…no wider than the column" (ln.width <= pg.contentW))
            def paths:int 0
            def labels:int 0
            def inside:int 0
            def i:int 0
            while (i < (array_length dl.cmds)) {
                def cmd:EVGDrawCmd (itemAt dl.cmds i)
                if ((cmd.kind == 6) || (cmd.kind == 7)) { paths = (paths + 1) }
                if (cmd.kind == 3) {
                    if (cmd.text == "laskuta") {
                        labels = (labels + 1)
                        def lx:double (to_double ln.x)
                        def ly:double (to_double ln.y)
                        def lw:double (to_double ln.width)
                        def lh:double (to_double ln.height)
                        if ((((cmd.x >= lx) && (cmd.y >= ly)) && (cmd.x <= (lx + lw))) && (cmd.y <= (ly + lh))) {
                            inside = (inside + 1)
                        }
                    }
                }
                i = (i + 1)
            }
            c.ok("…the page has the diagram's edges as paths" (paths >= 2))
            c.eqInt("…and its labels as text" labels 1)
            c.eqInt("…inside the box the layout gave it" inside 1)
        }

        ; A reader who cannot see it is told what it is.
        def tree:EVGA11yTree (DocxA11y.build(d 0 0 0 0 true))
        def named:boolean false
        def ni:int 0
        while (ni < (array_length tree.nodes)) {
            def an:EVGA11yNode (itemAt tree.nodes ni)
            if (an.name == "Graphviz diagram") { named = true }
            ni = (ni + 1)
        }
        c.ok("…and the accessibility tree names it" named)

        ; Without a cache the fence is still its name, and still counted:
        ; the Go and Python suites build documents with no diagram reader
        ; behind them and must not lose the words.
        def plain:RichDocument (this.make(src))
        c.eqInt("with nothing drawn, the fence is its name" maker.result.drawingsAsText 1)
        c.eqInt("…and no drawing" (plain.drawingCount()) 0)
    }

    ; ----------------------------------------------------------------------
    ; A picture is bytes here too
    ; ----------------------------------------------------------------------
    ;
    ; The deck already carries pictures; this view drew `![alt](src)` as
    ; italic alt text, so the same markdown lost its picture depending on
    ; which TAB the reader was on. The store is the same `Vfs` the layout and
    ; the deck read, so the three views cannot be missing different pictures.
    fn pictures:void (c:DocCheck) {
        print "-- a picture is bytes in the Word document too --"
        def v (new Vfs())
        def mem (new VfsMemory())
        def blob (new VfsBlob())
        def raw:string "PNGBYTESHERE"
        def buf:buffer (buffer_alloc (strlen raw))
        def bi:int 0
        while (bi < (strlen raw)) {
            buffer_set buf bi (charAt raw bi)
            bi = (bi + 1)
        }
        blob.bytes = buf
        blob.contentType = "image/png"
        blob.pixelW = 240
        blob.pixelH = 120
        mem.put("/logo.png" blob)
        v.mount("/" mem)

        def src:string "# Otsikko\n\n![Yhtion logo](logo.png)\n\nTeksti kuvan alla.\n"

        ; Without a store: alt text, exactly as before, and counted.
        def plain:RichDocument (this.make(src))
        c.eqInt("with no store no picture is carried" maker.result.pictures 0)
        c.ok("…and the alt text is what the paragraph says"
            (MdDocxTest.hasSub((MdDocxTest.allText(plain)) "[Yhtion logo]")))

        ; With one: a `DocImage`, which is what a Word document holds.
        def d:RichDocument (this.makeWith(src v))
        c.eqInt("with a store one picture is carried" maker.result.pictures 1)
        def img:DocImage (MdDocxTest.firstImage(d))
        c.eqStr("…named by the path the store knows" img.partPath "/logo.png")
        c.eqStr("…with the alt text the document gave it" img.altText "Yhtion logo")
        c.eqInt("…and its bytes" (buffer_length img.bytes) (strlen raw))
        ; 240pt in the preview is 320 CSS px on a page `DocxLayout` measures in
        ; px — the same FRACTION of the page, which is the thing a reader
        ; compares between the two tabs.
        c.eqInt("…sized for the page the Word view measures" img.widthPx 320)
        c.ok("…and the alt text is NOT also written out"
            (! (MdDocxTest.hasSub((MdDocxTest.allText(d)) "[Yhtion logo]"))))

        ; …and the VIEWER draws it: a picture in the model that never reaches
        ; the page is the bug this whole check is about.
        def view (new DocxView())
        view.init("gallery/pdf_writer/assets/fonts")
        def nums (new WordNumbering())
        def ed (new DocxEditController())
        ed.bindDocument(d)
        def dl:EVGDisplayList (view.buildDisplayList(d 0 nums ed true))
        def drawn:int 0
        def i:int 0
        while (i < (array_length dl.cmds)) {
            def cmd:EVGDrawCmd (itemAt dl.cmds i)
            if (cmd.kind == 2) {
                if (cmd.src == "/logo.png") { drawn = (drawn + 1) }
            }
            i = (i + 1)
        }
        c.eqInt("the Word view draws it, by the name the store answers to" drawn 1)

        ; A picture nobody has is alt text again — the same answer the preview
        ; and the deck give, rather than a third one.
        def gone:string "# Otsikko\n\n![Poissa](nope.png)\n"
        def g:RichDocument (this.makeWith(gone v))
        c.eqInt("a picture nobody has is not carried" maker.result.pictures 0)
        c.eqInt("…and it is counted as missed" maker.result.missedPictures 1)
        c.ok("…and it is alt text on the page"
            (MdDocxTest.hasSub((MdDocxTest.allText(g)) "[Poissa]")))
    }

    sfn firstImage:DocImage (d:RichDocument) {
        def i:int 0
        while (i < (array_length d.paragraphs)) {
            def p:Paragraph (itemAt d.paragraphs i)
            if ((array_length p.images) > 0) {
                return (itemAt p.images 0)
            }
            i = (i + 1)
        }
        return (new DocImage())
    }

    sfn allText:string (d:RichDocument) {
        def out:string ""
        def i:int 0
        while (i < (array_length d.paragraphs)) {
            def p:Paragraph (itemAt d.paragraphs i)
            out = ((out + (p.plainText())) + "|")
            i = (i + 1)
        }
        return out
    }

    sfn anySpan:boolean (p:Paragraph what:string) {
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if (what == "bold") { if s.bold { return true } }
            if (what == "italic") { if s.italic { return true } }
            if (what == "underline") { if s.underline { return true } }
            i = (i + 1)
        }
        return false
    }

    sfn spanOf:TextSpan (p:Paragraph what:string) {
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if (what == "bold") { if s.bold { return s } }
            if (what == "italic") { if s.italic { return s } }
            i = (i + 1)
        }
        return (new TextSpan())
    }

    sfn hasLink:boolean (p:Paragraph url:string) {
        def i:int 0
        while (i < (array_length p.spans)) {
            def s:TextSpan (itemAt p.spans i)
            if (s.hyperlink == url) { return true }
            i = (i + 1)
        }
        return false
    }

    sfn hasSub:boolean (hay:string needle:string) {
        return ((indexOf hay needle) >= 0)
    }
}
