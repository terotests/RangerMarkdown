; ============================================================================
; MdContainerTest.rgr — `{container=box}` / `{container=bubble}` plates.
; ============================================================================
;
;   npm run markdown:container:test
;
; The plan (colour, ink, radius) without a layout, then the plate a layout
; puts under the block: before its text, around it, and the room it takes.
; ============================================================================

Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdCss.rgr"
Import "../src/MdContainer.rgr"
Import "../src/MdToEvg.rgr"

class ContainerCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }
}

class MdContainerTest {
    sfn main:void () {
        def c:ContainerCheck (new ContainerCheck())
        print "== MdContainerTest =="
        MdContainerTest.reading(c)
        MdContainerTest.planning(c)
        MdContainerTest.layout(c)
        MdContainerTest.sheet(c)
        MdContainerTest.painting(c)
        MdContainerTest.headings(c)
        MdContainerTest.shadows(c)
        print ""
        print ((("passed=" + (to_string c.passed)) + " failed=") + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    sfn firstBlock:MdNode (src:string) {
        def doc:MdNode (MdBlock.parseText(src))
        return (doc.childAt(0))
    }

    sfn reading:void (c:ContainerCheck) {
        def p:MdNode (MdContainerTest.firstBlock("Some words here\n{container=bubble}\n"))
        c.eqStr("the attribute line under a paragraph" (MdContainer.kindOf(p)) "bubble")
        c.eqStr("…and the paragraph keeps only its words" p.kind "paragraph")
        c.ok("…and its source runs to the end of the attribute line, so a cached layout sees a change" (p.srcEnd >= 33))
        c.eqStr("box" (MdContainer.kindOf((MdContainerTest.firstBlock("A\n{container=box}\n")))) "box")
        c.eqStr("another word is a box" (MdContainer.kindOf((MdContainerTest.firstBlock("A\n{container=card}\n")))) "box")
        c.eqStr("none is none" (MdContainer.kindOf((MdContainerTest.firstBlock("A\n{container=none}\n")))) "")
        c.eqStr("no attribute, no plate" (MdContainer.kindOf((MdContainerTest.firstBlock("A\n")))) "")
        def f:MdNode (MdContainerTest.firstBlock("A\n{container=box background=#fff8}\n"))
        c.eqStr("a #rgba colour is an attribute value" (MdContainer.kindOf(f)) "box")
        c.eqStr("background= is the plate's colour" (MdContainer.fillOf(f)) "#FFFFFF88")
        c.eqStr("bg= a colour too" (MdContainer.fillOf((MdContainerTest.firstBlock("A\n{container=box bg=#204060}\n")))) "#204060")
        c.eqStr("bg= a picture is not a colour" (MdContainer.fillOf((MdContainerTest.firstBlock("A\n{container=box bg=media/a.jpg}\n")))) "")
    }

    sfn planning:void (c:ContainerCheck) {
        def light:MdContainer (MdContainer.plan("box" "" "" -1.0 "#ffffff" "#1f2328" 20.0))
        c.eqStr("default: the page's colour, see-through" light.fill "#FFFFFFD9")
        c.eqStr("dark text reads on it" light.ink "")
        c.ok("a box is a little rounded" ((light.radius > 5.0) && (light.radius < 12.0)))
        c.ok("a box fills the column" (! light.hug))
        def dark:MdContainer (MdContainer.plan("box" "" "" -1.0 "#101820" "#f0f0f0" 20.0))
        c.eqStr("a dark page gives a dark plate" dark.fill "#101820D9")
        c.eqStr("…and its light text stays" dark.ink "")
        def pic:MdContainer (MdContainer.plan("bubble" "" "" -1.0 "" "#1f2328" 20.0))
        c.eqStr("a page with only a picture: white under dark text" pic.fill "#FFFFFFD9")
        c.ok("a bubble hugs its text and has a tail" (pic.hug && (pic.tail > 0.0)))
        c.ok("a bubble is rounder than a box" (pic.radius > light.radius))
        def picLight:MdContainer (MdContainer.plan("box" "" "" -1.0 "" "#ffffff" 20.0))
        c.eqStr("…black under light text" picLight.fill "#000000B3")
        def own:MdContainer (MdContainer.plan("box" "#203040" "" -1.0 "#ffffff" "#1f2328" 20.0))
        c.eqStr("the block's own colour wins" own.fill "#203040")
        c.eqStr("dark text on a dark plate turns white" own.ink "#FFFFFF")
        def thin:MdContainer (MdContainer.plan("box" "#FFFFFF33" "" -1.0 "#ffffff" "#1f2328" 20.0))
        c.ok("a nearly clear plate cannot promise dark text on black" ((MdContainer.worstContrast("#1f2328" "#FFFFFF33")) < 4.5))
        c.eqStr("…on a white page it is judged on the page: dark text stays" thin.ink "")
        def thinPic:MdContainer (MdContainer.plan("box" "#FFFFFF33" "" -1.0 "" "#1f2328" 20.0))
        c.ok("…over a picture the ink is whichever reads better" ((strlen thinPic.ink) > 0))
        ; the guide's side card on a light theme (Tero 2026-10-06: white
        ; text on it, 1.1:1)
        def tint:MdContainer (MdContainer.plan("box" "#00000010" "" -1.0 "#ffffff" "#16202c" 20.0))
        c.eqStr("a faint grey card on a white slide keeps dark text" tint.ink "")
        def tintLight:MdContainer (MdContainer.plan("box" "#00000010" "" -1.0 "#ffffff" "#f0f0f0" 20.0))
        c.eqStr("…and light text on it turns near-black" tintLight.ink "#111111")
        def tintDark:MdContainer (MdContainer.plan("box" "#ffffff14" "" -1.0 "#101820" "#f0f0f0" 20.0))
        c.eqStr("a faint light card on a dark slide keeps light text" tintDark.ink "")
        def themed:MdContainer (MdContainer.plan("box" "" "#ffeecc" 4.0 "#ffffff" "#1f2328" 20.0))
        c.eqStr("the theme's colour" themed.fill "#ffeecc")
        c.ok("the theme's radius" (themed.radius == 4.0))
        def none:MdContainer (MdContainer.plan("" "" "" -1.0 "#ffffff" "#1f2328" 20.0))
        c.eqStr("no kind, no fill" none.fill "")
    }

    sfn laid:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        if ((strlen css) > 0) {
            def mc:MdCss (new MdCss())
            mc.addStyleSheet(css)
            mc.applyTo(l.style)
            l.setStyleSheet(css)
        }
        l.setDocSource(src)
        l.layoutContinuous(doc 600.0)
        return l
    }

    ; `container { box-shadow }`: three fainter layers under the plate, in
    ; the shadow's colour; none without it, none for `box-shadow: none`
    sfn shadows:void (c:ContainerCheck) {
        c.eqStr("box-shadow: its colour" (MdContainer.shadowColour("0 6pt 18pt rgba(46,58,99,0.12)")) "#2E3A63")
        c.eqStr("…a hex one" (MdContainer.shadowColour("0 4pt 10pt #102030")) "#102030")
        c.eqStr("…none" (MdContainer.shadowColour("none")) "")
        c.eqStr("…no colour is black" (MdContainer.shadowColour("0 4pt 10pt")) "#000000")
        def plain:MdLayout (MdContainerTest.laid("Inside\n{container=box}\n" "container { background-color: #ffffff }"))
        def shad:MdLayout (MdContainerTest.laid("Inside\n{container=box}\n" "container { background-color: #ffffff; box-shadow: 0 6pt 18pt rgba(46,58,99,0.12) }"))
        c.eqStr("a plate with a shadow has three more boxes" (to_string (array_length shad.boxes)) (to_string ((array_length plain.boxes) + 3)))
        def first:MdBox (itemAt shad.boxes 0)
        def plate:MdBox (itemAt shad.boxes 3)
        c.ok("…drawn first, under the plate" (((first.kind == 1) && (first.y > plate.y)) && (first.w > plate.w)))
        c.ok("…in the shadow's colour, faint" (((indexOf first.fill "#2E3A63") == 0) && ((strlen first.fill) == 9)))
        c.eqStr("…and the plate is still white" plate.fill "#FFFFFF")
        def cls:MdLayout (MdContainerTest.laid("Inside\n{.card container=box}\n" ".card { box-shadow: 0 2pt 6pt #000000 }"))
        c.eqStr("a class's box-shadow" (to_string (array_length cls.boxes)) (to_string ((array_length plain.boxes) + 3)))
    }

    ; a slide's title on a plate, over its background picture
    sfn headings:void (c:ContainerCheck) {
        def src:string "## Ranta {bg=media/k1.jpg container=box}\n\nKesä.\n"
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        l.setDocSource(src)
        l.layoutSlides(doc)
        def pi:int (MdContainerTest.plateIndex(l))
        def ti:int (MdContainerTest.indexOfText(l "Ranta"))
        c.ok("a title can sit on a plate" ((pi >= 0) && (pi < ti)))
        if ((pi >= 0) && (ti >= 0)) {
            def plate:MdBox (itemAt l.boxes pi)
            def t:MdBox (itemAt l.boxes ti)
            c.ok("…round the title" ((t.y > plate.y) && ((t.y + t.h) < (plate.y + plate.h))))
            c.ok("…not round the text under it" ((MdContainerTest.textBox(l "Kesä.")).y >= (plate.y + plate.h)))
        }
        ; a dark theme's light-blue h2 on a light plate turns dark, as the
        ; text on a plate does: a heading's own colour is judged on it
        def dark:string "page { background-color: #101a2e } document { color: #f0f4ff } h2 { color: #7ee0ff } container { background-color: #ffffffdd }"
        def hl:MdLayout (MdContainerTest.laid("## Levy {container=box}\n\nUnder\n" dark))
        def ht:MdBox (MdContainerTest.textBox(hl "Levy"))
        c.eqStr("a light heading on a light plate is set dark" ht.color "#111111")
        def hu:MdBox (MdContainerTest.textBox(hl "Under"))
        c.eqStr("…the text under it keeps the theme's" hu.color "#F0F4FF")
        def ok:MdLayout (MdContainerTest.laid("## Levy {container=box}\n" "h2 { color: #102030 } container { background-color: #ffffff }"))
        def hk:MdBox (MdContainerTest.textBox(ok "Levy"))
        c.eqStr("…a heading that reads on its plate keeps its colour" hk.color "#102030")
    }

    sfn textBox:MdBox (l:MdLayout t:string) {
        for l.boxes b:MdBox i {
            if ((b.kind == 0) && (b.text == t)) {
                return b
            }
        }
        return (new MdBox())
    }

    sfn plateIndex:int (l:MdLayout) {
        for l.boxes b:MdBox i {
            if ((b.kind == 1) && (b.radius > 0.0)) {
                return i
            }
        }
        return -1
    }

    sfn indexOfText:int (l:MdLayout t:string) {
        for l.boxes b:MdBox i {
            if ((b.kind == 0) && (b.text == t)) {
                return i
            }
        }
        return -1
    }

    sfn layout:void (c:ContainerCheck) {
        def plain:MdLayout (MdContainerTest.laid("Before\n\nInside\n\nAfter\n" ""))
        def boxed:MdLayout (MdContainerTest.laid("Before\n\nInside\n{container=box}\n\nAfter\n" ""))
        def pi:int (MdContainerTest.plateIndex(boxed))
        c.ok("a plate is laid" (pi >= 0))
        c.ok("…before the text, so it is painted under it" (pi < (MdContainerTest.indexOfText(boxed "Inside"))))
        c.ok("…after the block above" (pi > (MdContainerTest.indexOfText(boxed "Before"))))
        def plate:MdBox (itemAt boxed.boxes pi)
        def t:MdBox (MdContainerTest.textBox(boxed "Inside"))
        c.ok("the text is inside the plate, with room round it" ((((t.x > plate.x) && (t.y > plate.y)) && ((t.x + t.w) < (plate.x + plate.w))) && ((t.y + t.h) < (plate.y + plate.h))))
        c.ok("a box spans the column" ((fabs (plate.w - boxed.contentW)) < 0.5))
        def tp:MdBox (MdContainerTest.textBox(plain "Inside"))
        c.ok("the text moved in by the padding" (t.x > tp.x))
        def after0:MdBox (MdContainerTest.textBox(plain "After"))
        def after1:MdBox (MdContainerTest.textBox(boxed "After"))
        c.ok("the next block moves down for the plate" (after1.y > after0.y))
        c.ok("…and does not sit on it" (after1.y >= (plate.y + plate.h)))
        c.eqStr("the plate belongs to its block" (to_string plate.srcStart) (to_string t.srcStart))

        def bub:MdLayout (MdContainerTest.laid("Hi\n{container=bubble}\n\nAfter\n" ""))
        def bp:MdBox (itemAt bub.boxes (MdContainerTest.plateIndex(bub)))
        c.ok("a bubble hugs a short line" (bp.w < (bub.contentW * 0.5)))
        c.ok("…and has a tail" (bp.tail > 0.0))
        def ba:MdBox (MdContainerTest.textBox(bub "After"))
        c.ok("…which the next block clears" (ba.y >= ((bp.y + bp.h) + bp.tail)))

        def dark:MdLayout (MdContainerTest.laid("Inside\n{container=box background=#102030}\n" ""))
        def darkText:MdBox (MdContainerTest.textBox(dark "Inside"))
        c.eqStr("dark plate, white text" darkText.color "#FFFFFF")
        def again:MdLayout (MdContainerTest.laid("Inside\n{container=box background=#102030}\n\nOutside\n" ""))
        def outside:MdBox (MdContainerTest.textBox(again "Outside"))
        c.ok("the text after it keeps its own colour" (outside.color != "#FFFFFF"))

        def list:MdLayout (MdContainerTest.laid("- One\n- Two\n{container=box}\n" ""))
        def lp:int (MdContainerTest.plateIndex(list))
        c.ok("a list can sit on a plate too" ((lp >= 0) && (lp < (MdContainerTest.indexOfText(list "One")))))
    }

    sfn sheet:void (c:ContainerCheck) {
        def l:MdLayout (MdContainerTest.laid("Inside\n{container=box}\n" "container { background-color: #ffeecc; border-radius: 3pt }"))
        def plate:MdBox (itemAt l.boxes (MdContainerTest.plateIndex(l)))
        c.eqStr("the theme's container colour" plate.fill "#FFEECC")
        c.ok("the theme's radius" ((fabs (plate.radius - 3.0)) < 0.01))
        def own:MdLayout (MdContainerTest.laid("Inside\n{container=box background=#ffffff}\n" "container { background-color: #ffeecc }"))
        def ownPlate:MdBox (itemAt own.boxes (MdContainerTest.plateIndex(own)))
        c.eqStr("the block's own colour over the theme's" ownPlate.fill "#FFFFFF")
    }

    sfn painting:void (c:ContainerCheck) {
        def l:MdLayout (MdContainerTest.laid("Hi\n{container=bubble}\n" ""))
        def painter:MdToEvg (new MdToEvg())
        def dl:EVGDisplayList (new EVGDisplayList())
        def plate:MdBox (itemAt l.boxes (MdContainerTest.plateIndex(l)))
        painter.paintBox(dl l plate 0.0)
        c.ok("a rounded rectangle and its tail" ((array_length dl.cmds) == 2))
        def r:EVGDrawCmd (itemAt dl.cmds 0)
        c.ok("the rectangle is rounded" ((r.kind == 0) && (r.radius > 0.0)))
        def tl:EVGDrawCmd (itemAt dl.cmds 1)
        c.ok("the tail is a filled path below it" ((tl.kind == 6) && ((array_length tl.pts) == 6)))
        c.ok("…in the plate's colour" ((tl.r == r.r) && (tl.a == r.a)))
    }
}
