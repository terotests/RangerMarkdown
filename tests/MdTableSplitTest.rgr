; ============================================================================
; MdTableSplitTest.rgr — which slide each row of a long table goes to.
; ============================================================================
;
;   npm run markdown:tablesplit:test
;
; Heights only: `MdTableSplit` is the model, the layout draws what it says.
; ============================================================================

Import "../src/MdTableSplit.rgr"

class SplitCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }
}

class MdTableSplitTest {
    sfn main:void () {
        def c:SplitCheck (new SplitCheck())
        print "== MdTableSplitTest =="
        MdTableSplitTest.run(c)
        print ""
        print ((("passed=" + (to_string c.passed)) + " failed=") + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    sfn rows:[double] (n:int h:double) {
        def out:[double]
        def i:int 0
        while (i < n) {
            push out h
            i = (i + 1)
        }
        return out
    }

    ; "6+5+5": how many groups each slide got
    sfn counts:string (p:MdTablePlan) {
        def out:string ""
        def s:int 0
        while (s < p.slides) {
            def k:int 0
            def i:int 0
            while (i < (array_length p.slideOf)) {
                if ((itemAt p.slideOf i) == s) {
                    k = (k + 1)
                }
                i = (i + 1)
            }
            if (s > 0) {
                out = (out + "+")
            }
            out = (out + (to_string k))
            s = (s + 1)
        }
        return out
    }

    sfn run:void (c:SplitCheck) {
        ; rows of 10 under a 10 header; a continuation slide holds 8 rows
        ; (90 under its title), the first slide 6 (70 left under the text)
        def sixteen:[double] (MdTableSplitTest.rows(16 10.0))
        def greedy:MdTablePlan (MdTableSplit.plan(sixteen 10.0 70.0 90.0 false))
        c.eqStr("filled to the brim: 6 + 8 + 2" (MdTableSplitTest.counts(greedy)) "6+8+2")
        def even:MdTablePlan (MdTableSplit.plan(sixteen 10.0 70.0 90.0 true))
        c.eqStr("balanced: as many slides, rows spread" (MdTableSplitTest.counts(even)) "5+6+5")
        c.ok("greedy tail is kept for the shrinker" ((even.greedyTail > 19.0) && (even.greedyTail < 21.0)))

        ; it fits: one slide, nothing moved
        def fits:MdTablePlan (MdTableSplit.plan((MdTableSplitTest.rows(5 10.0)) 10.0 70.0 90.0 true))
        c.eqStr("a table that fits stays whole" (MdTableSplitTest.counts(fits)) "5")

        ; two over: 8 + 2 greedy, 5 + 5 balanced, greedy tail 20
        def two:MdTablePlan (MdTableSplit.plan((MdTableSplitTest.rows(10 10.0)) 10.0 90.0 90.0 true))
        c.eqStr("two slides at the top of a slide: 5 + 5" (MdTableSplitTest.counts(two)) "5+5")
        c.ok("…and the greedy tail is two rows" ((two.greedyTail > 19.0) && (two.greedyTail < 21.0)))

        ; the first slide has no room for a row under its header: the table
        ; starts on the next slide, which is counted
        def late:MdTablePlan (MdTableSplit.plan((MdTableSplitTest.rows(4 10.0)) 10.0 15.0 90.0 true))
        c.eqStr("no room on the first slide: it starts on the next" (MdTableSplitTest.counts(late)) "0+4")

        ; uneven heights: no slide is over its room
        def mixed:[double] ([] _:double (10.0 30.0 10.0 10.0 40.0 10.0 10.0 20.0 10.0 30.0 10.0 10.0))
        def mp:MdTablePlan (MdTableSplit.plan(mixed 10.0 90.0 90.0 true))
        def over:int 0
        def s:int 0
        while (s < mp.slides) {
            def sum:double 0.0
            def i:int 0
            while (i < (array_length mixed)) {
                if ((itemAt mp.slideOf i) == s) {
                    sum = (sum + (itemAt mixed i))
                }
                i = (i + 1)
            }
            if (sum > 80.01) {
                over = (over + 1)
            }
            s = (s + 1)
        }
        c.ok("uneven rows: no slide over its room" (over == 0))
        def mg:MdTablePlan (MdTableSplit.plan(mixed 10.0 90.0 90.0 false))
        c.ok("…on as few slides as filling them would take" (mp.slides == mg.slides))

        ; a group taller than any slide is put alone and drawn cut
        def huge:MdTablePlan (MdTableSplit.plan(([] _:double (10.0 200.0 10.0)) 10.0 90.0 90.0 true))
        c.eqStr("a group taller than a slide stands alone" (MdTableSplitTest.counts(huge)) "1+1+1")
    }
}
