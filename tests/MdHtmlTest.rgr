; SPDX-License-Identifier: AGPL-3.0-or-later
;
; MdHtmlTest — the HTML a markdown document carries: inline tags that change
; how text looks (<mark> <u> <sub> <sup> <kbd> <abbr>), wrappers that align
; what is in them, and <table> with row and column spans.

Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdHtml.rgr"
Import "../src/MdCss.rgr"
Import "../src/MdToPptx.rgr"
Import "../src/MdHtmlMd.rgr"
Import "../src/MdSvg.rgr"
Import "../src/MdUrl.rgr"
Import "../src/MdToDocx.rgr"

class MdHtmlTest {
    def passed:int 0
    def failed:int 0

    sfn main:void () {
        def t (new MdHtmlTest())
        t.run()
    }

    fn check:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
            print ("  PASS  " + name)
        } {
            failed = (failed + 1)
            print ("  FAIL  " + name)
        }
    }

    sfn laidOut:MdLayout (src:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.layoutContinuous(doc 600.0)
        return l
    }

    sfn box:MdBox (l:MdLayout text:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.text == text)) {
                return b
            }
            i = (i + 1)
        }
        def none:MdBox (new MdBox())
        none.kind = -1
        return none
    }

    sfn rectsUnder:int (l:MdLayout b:MdBox fill:string) {
        def n:int 0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def r:MdBox (itemAt l.boxes i)
            if ((r.kind == 1) && ((fill == "") || (r.fill == fill))) {
                if (((r.x <= (b.x + 0.5)) && ((r.x + r.w) >= ((b.x + b.w) - 0.5))) && ((r.y >= (b.y - 4.0)) && (r.y <= ((b.y + b.h) + 4.0)))) {
                    n = (n + 1)
                }
            }
            i = (i + 1)
        }
        return n
    }

    fn run:void () {
        this.testTags()
        this.testInline()
        this.testBaseline()
        this.testMarkCss()
        this.testClassCss()
        this.testAlign()
        this.testTable()
        this.testPptx()
        this.testMarkdownIt()
        this.testSpanStyles()
        this.testHtmlLists()
        this.testCells()
        this.testDivPlate()
        this.testSvg()
        this.testScripts()
        this.testNotes()
        print ("passed=" + (to_string passed) + " failed=" + (to_string failed))
        if (failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    fn testTags:void () {
        def t:MdHtmlTag (MdHtml.tag("<abbr title=\"Graphical User Interface\">"))
        this.check("a tag's name" (t.name == "abbr"))
        this.check("and its quoted attribute" ((t.attr("title")) == "Graphical User Interface"))
        def d:MdHtmlTag (MdHtml.tag("<div style=\"color: red; text-align: center\">"))
        this.check("text-align out of a style" ((d.align()) == "center"))
        def p:MdHtmlTag (MdHtml.tag("<P ALIGN=right>"))
        this.check("align= in any case, unquoted" ((p.align()) == "right"))
        def c:MdHtmlTag (MdHtml.tag("</mark>"))
        this.check("a closing tag" (c.close && (c.name == "mark")))
    }

    fn testInline:void () {
        def l:MdLayout (MdHtmlTest.laidOut("A <mark>lit</mark> and <u>under</u>, ~~gone~~, H<sub>2</sub>O and x<sup>2</sup>, <kbd>Ctrl</kbd>."))
        this.check("no tag is shown as text" ((MdHtmlTest.box(l "<mark>")).kind < 0))
        def m:MdBox (MdHtmlTest.box(l "lit"))
        this.check("highlighted text has a yellow box behind it" ((MdHtmlTest.rectsUnder(l m "#ffe766")) == 1))
        def u:MdBox (MdHtmlTest.box(l "under"))
        this.check("underlined text has a line under it" ((MdHtmlTest.rectsUnder(l u "")) >= 1))
        def g:MdBox (MdHtmlTest.box(l "gone"))
        this.check("~~struck~~ text has a line through it" ((MdHtmlTest.rectsUnder(l g "")) >= 1))
        def two:MdBox (MdHtmlTest.box(l "2"))
        this.check("a subscript is smaller" (two.size < m.size))
        this.check("and sits lower than the line" (two.y > m.y))
        def sq:MdBox (itemAt l.boxes 0)
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if (((b.kind == 0) && (b.text == "2")) && (b.x > two.x)) {
                sq = b
            }
            k = (k + 1)
        }
        this.check("a superscript sits higher than the line" (sq.y < m.y))
        def ctrl:MdBox (MdHtmlTest.box(l "Ctrl"))
        this.check("a key has a cap" ((MdHtmlTest.rectsUnder(l ctrl "")) >= 1))
    }

    ; Smaller text stands on the line's baseline, not at the top of its box.
    fn testBaseline:void () {
        def l:MdLayout (MdHtmlTest.laidOut("Use <small>small print</small> and <kbd>F5</kbd> here."))
        def big:MdBox (MdHtmlTest.box(l "Use "))
        def sm:MdBox (MdHtmlTest.box(l "small print"))
        def k:MdBox (MdHtmlTest.box(l "F5"))
        def bBig:double (big.y + (l.baselineAt(big.family big.bold big.italic big.size)))
        def bSm:double (sm.y + (l.baselineAt(sm.family sm.bold sm.italic sm.size)))
        def bK:double (k.y + (l.baselineAt(k.family k.bold k.italic k.size)))
        this.check("small print is smaller" (sm.size < big.size))
        this.check("and on the same baseline" ((fabs (bSm - bBig)) < 0.5))
        this.check("a key's letters too" ((fabs (bK - bBig)) < 0.5))
    }

    ; mark and kbd take their colours from the sheet
    fn testMarkCss:void () {
        def doc:MdNode (MdBlock.parseText("A <mark>lit</mark> <kbd>K</kbd>"))
        def l:MdLayout (new MdLayout())
        def c:MdCss (new MdCss())
        def css:string "mark { background-color: #3355ff; color: #ffffff } kbd { background-color: #112233; border-color: #445566 }"
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.layoutContinuous(doc 600.0)
        def m:MdBox (MdHtmlTest.box(l "lit"))
        def k:MdBox (MdHtmlTest.box(l "K"))
        this.check("mark's background from the sheet" ((MdHtmlTest.rectsUnder(l m "#3355FF")) == 1))
        this.check("and its text colour" (m.color == "#FFFFFF"))
        this.check("a key's face from the sheet" ((MdHtmlTest.rectsUnder(l k "#112233")) == 1))
    }

    sfn styled:MdLayout (md:string css:string) {
        def doc:MdNode (MdBlock.parseText(md))
        def l:MdLayout (new MdLayout())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.layoutContinuous(doc 600.0)
        return l
    }

    sfn fills:string (l:MdLayout) {
        def out:string " "
        def i:int 0
        while (i < (array_length l.boxes)) {
            def r:MdBox (itemAt l.boxes i)
            if (r.kind == 1) {
                out = (out + r.fill + " ")
            }
            i = (i + 1)
        }
        return out
    }

    fn testClassCss:void () {
        def css:string "document { font-size: 20pt } .lead { font-size: 26pt; color: #ff8800 } .kicker { font-size: 0.7em }"
        def l:MdLayout (MdHtmlTest.styled("Iso\n{.lead}\n\nPieni\n{.kicker}\n\nTavallinen" css))
        def big:MdBox (MdHtmlTest.box(l "Iso"))
        def small:MdBox (MdHtmlTest.box(l "Pieni"))
        def plain:MdBox (MdHtmlTest.box(l "Tavallinen"))
        this.check(".lead's font-size is used" ((fabs (big.size - 26.0)) < 0.01))
        this.check("…and its colour" (big.color == "#FF8800"))
        this.check(".kicker's size in em" ((fabs (small.size - 14.0)) < 0.01))
        this.check("a paragraph without a class is as it was" (((fabs (plain.size - 20.0)) < 0.01) && (plain.color != "#FF8800")))
        def code:string "```\nx = 1\n```"
        def t:MdLayout (MdHtmlTest.styled(code "code { background-color: #151c4833 }"))
        this.check("a code background keeps its alpha" ((indexOf (MdHtmlTest.fills(t)) " #151C4833 ") >= 0))
        def n:MdLayout (MdHtmlTest.styled(code "code { background-color: none }"))
        this.check("background-color: none draws nothing" ((indexOf (MdHtmlTest.fills(n)) " transparent ") >= 0))
    }

    fn testAlign:void () {
        def l:MdLayout (MdHtmlTest.laidOut("<div style=\"text-align: center\">\nIn the middle\n</div>\n\n<p align=\"right\">On the right</p>\n\nLeft"))
        def mid:MdBox (MdHtmlTest.box(l "In the middle"))
        def right:MdBox (MdHtmlTest.box(l "On the right"))
        def left:MdBox (MdHtmlTest.box(l "Left"))
        this.check("the div's text is centred" ((fabs (((mid.x + (mid.w / 2.0)) - (left.x + ((l.contentW) / 2.0))))) < 2.0))
        this.check("the p's text is on the right" ((fabs (((right.x + right.w) - (left.x + l.contentW)))) < 2.0))
        this.check("and what follows is left again" (left.x < mid.x))
        ; a wrapper whose content is past a blank line
        def l2:MdLayout (MdHtmlTest.laidOut("<div align=\"center\">\n\n**Bold** words\n\n</div>\n\nAfter"))
        def b2:MdBox (MdHtmlTest.box(l2 "Bold"))
        def a2:MdBox (MdHtmlTest.box(l2 "After"))
        this.check("an open wrapper aligns the blocks until it closes" (b2.x > (a2.x + 20.0)))
    }

    fn testTable:void () {
        def src:string "<table>\n  <thead>\n    <tr>\n      <th rowspan=\"2\">Document Type</th>\n      <th colspan=\"2\">Support</th>\n    </tr>\n    <tr>\n      <th>Ours</th>\n      <th>Others</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr>\n      <td>Docs</td>\n      <td>Full</td>\n      <td>Basic</td>\n    </tr>\n  </tbody>\n</table>"
        def t:MdHtmlTable (MdHtml.table(src))
        this.check("three rows, three columns" (((t.rowCount()) == 3) && (t.cols == 3)))
        def r1:MdHtmlRow (itemAt t.rows 1)
        def ours:MdHtmlCell (itemAt r1.cells 0)
        this.check("the second header row starts after the rowspan" (ours.col == 1))
        def l:MdLayout (MdHtmlTest.laidOut(src))
        def doc:MdBox (MdHtmlTest.box(l "Document Type"))
        def sup:MdBox (MdHtmlTest.box(l "Support"))
        def o:MdBox (MdHtmlTest.box(l "Ours"))
        def x:MdBox (MdHtmlTest.box(l "Others"))
        def d:MdBox (MdHtmlTest.box(l "Docs"))
        this.check("every cell is drawn" (((doc.kind == 0) && (sup.kind == 0)) && (((o.kind == 0) && (x.kind == 0)) && (d.kind == 0))))
        this.check("the spanning header is centred between its two rows" ((doc.y > sup.y) && (doc.y < o.y)))
        this.check("the column span starts over its first column" ((fabs ((sup.x - o.x))) < 1.0))
        this.check("headers are bold" (doc.bold && o.bold))
        this.check("body cells are not" (d.bold == false))
        this.check("the body row is under the headers" (d.y > o.y))
    }

    fn testPptx:void () {
        def src:string "# Deck\n\n## Table\n\n<table><tr><th>A</th><th>B</th></tr><tr><td colspan=\"2\">both</td></tr></table>\n"
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.layoutSlides(doc)
        def conv:MdToPptx (new MdToPptx())
        def deck:PptxDeck (conv.deck(doc l))
        def found:boolean false
        def s:int 0
        while (s < (array_length deck.pres.slides)) {
            def sl:PptxSlide (itemAt deck.pres.slides s)
            def k:int 0
            while (k < (array_length sl.shapes)) {
                def sh:PptxShape (itemAt sl.shapes k)
                if ((indexOf sh.name "HTML") == 0) {
                    found = true
                }
                k = (k + 1)
            }
            s = (s + 1)
        }
        this.check("an HTML table goes into the deck as a drawn group" found)
    }

    ; markdown-it's spans in markdown rather than in tags — `^th^ ~2~
    ; ++ins++ ==mark==` — drawn as the tags above are, and the typographer's
    ; and the emoji's replacements drawn as the characters they stand for.
    fn testMarkdownIt:void () {
        def src:string "Big 19^th^ and H~2~O, ++under++ and ==lit== (c) :wink: HTML.\n\n*[HTML]: Hyper Text Markup Language\n"
        def l:MdLayout (MdHtmlTest.laidOut(src))
        def big:MdBox (MdHtmlTest.box(l "Big 19"))
        def th:MdBox (MdHtmlTest.box(l "th"))
        this.check("^th^ is drawn" (th.kind == 0))
        this.check("…smaller" (th.size < big.size))
        this.check("…and higher than the line" (th.y < big.y))
        def two:MdBox (MdHtmlTest.box(l "2"))
        this.check("~2~ is drawn smaller" ((two.kind == 0) && (two.size < big.size)))
        this.check("…and lower than the line" (two.y > big.y))
        def u:MdBox (MdHtmlTest.box(l "under"))
        this.check("++under++ has a line under it" ((MdHtmlTest.rectsUnder(l u "")) >= 1))
        def m:MdBox (MdHtmlTest.box(l "lit"))
        this.check("==lit== has the highlight behind it" ((MdHtmlTest.rectsUnder(l m l.style.markBackground)) == 1))
        def c:MdBox (MdHtmlTest.box(l (strfromcode 169)))
        this.check("(c) is drawn as the copyright sign" (c.kind == 0))
        this.check("…which stands for all three characters of (c)" ((c.segSrc == (indexOf src "(c)")) && (c.segLen == 3)))
        this.check("…as one" c.segAtom)
        def w:MdBox (MdHtmlTest.box(l (MdChar.fromCode(128521))))
        this.check(":wink: is drawn as the emoji" (w.kind == 0))
        this.check("…standing for the shortcode" (w.segLen == 6))
        this.check("an abbreviation is drawn as its text" ((MdHtmlTest.box(l "HTML")).kind == 0))
        def any:boolean false
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((indexOf b.text "Hyper") >= 0)) { any = true }
            if ((b.kind == 0) && ((indexOf b.text "*[") >= 0)) { any = true }
            i = (i + 1)
        }
        this.check("…and its definition is not drawn at all" (any == false))

        ; …and ==mark== is a highlighted run in the .pptx
        def deckSrc:string "# Deck\n\n## Slide\n\nA ==lit== word.\n"
        def doc:MdNode (MdBlock.parseText(deckSrc))
        def dl:MdLayout (new MdLayout())
        dl.applySlideMeta(doc)
        dl.setDocSource(deckSrc)
        dl.layoutSlides(doc)
        def conv:MdToPptx (new MdToPptx())
        def deck:PptxDeck (conv.deck(doc dl))
        def lit:boolean false
        def plain:boolean false
        def sx:int 0
        while (sx < (array_length deck.pres.slides)) {
            def sl:PptxSlide (itemAt deck.pres.slides sx)
            def k:int 0
            while (k < (array_length sl.shapes)) {
                def sh:PptxShape (itemAt sl.shapes k)
                def pi:int 0
                while (pi < (array_length sh.text.paragraphs)) {
                    def par:PptxParagraph (itemAt sh.text.paragraphs pi)
                    def ri:int 0
                    while (ri < (array_length par.runs)) {
                        def run:PptxTextRun (itemAt par.runs ri)
                        if ((run.text == "lit") && run.highlight.isSet) { lit = true }
                        if (((indexOf run.text "word") >= 0) && (run.highlight.isSet == false)) { plain = true }
                        ri = (ri + 1)
                    }
                    pi = (pi + 1)
                }
                k = (k + 1)
            }
            sx = (sx + 1)
        }
        this.check("==lit== is a highlighted run in the deck" lit)
        this.check("…and the words around it are not" plain)
    }

    sfn hasNote:boolean (l:MdLayout part:string) {
        for l.htmlNotes n:string i {
            if ((indexOf n part) >= 0) {
                return true
            }
        }
        return false
    }

    ; the first text box whose text has `part` in it
    sfn boxWith:MdBox (l:MdLayout part:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((indexOf b.text part) >= 0)) {
                return b
            }
            i = (i + 1)
        }
        def none:MdBox (new MdBox())
        none.kind = -1
        return none
    }

    sfn rectFilled:boolean (l:MdLayout fill:string) {
        for l.boxes b:MdBox i {
            if ((b.kind == 1) && ((MdChar.lower(b.fill)) == fill)) {
                return true
            }
        }
        return false
    }

    fn testSpanStyles:void () {
        def l:MdLayout (MdHtmlTest.laidOut("Plain <span style=\"background-color:#ffd54a;color:#111\">behind</span> <span style=\"font-size:32pt\">big</span> <span style=\"font-size:0.5em\">half</span> <span style=\"font-weight:bold;font-style:italic\">bi</span> <span style=\"text-decoration:underline wavy red\">wave</span> <span style=\"font-size:x-large\">xl</span>"))
        def plain:MdBox (MdHtmlTest.box(l "Plain "))
        def lb:MdLayout (MdHtmlTest.laidOut("Plain <span style=\"background-color:#ffd54a;color:#111\">behind</span> text"))
        def bg:MdBox (MdHtmlTest.box(lb "behind"))
        this.check("span background-color: a box of that colour behind the text" ((MdHtmlTest.rectsUnder(lb bg "#FFD54A")) == 1))
        this.check("…and its own colour" (bg.color == "#111"))
        def big:MdBox (MdHtmlTest.box(l "big"))
        this.check("span font-size 32pt is larger than the body" (big.size > (plain.size * 1.2)))
        def half:MdBox (MdHtmlTest.box(l "half"))
        this.check("span font-size 0.5em is half the text around it" ((fabs (half.size - (plain.size * 0.5))) < 0.6))
        def bi:MdBox (MdHtmlTest.box(l "bi"))
        this.check("span font-weight bold and font-style italic" (bi.bold && bi.italic))
        def wave:MdBox (MdHtmlTest.box(l "wave"))
        this.check("span text-decoration underline draws a line under it" ((MdHtmlTest.rectsUnder(l wave "")) >= 1))
        def xl:MdBox (MdHtmlTest.box(l "xl"))
        this.check("span font-size x-large is 1.5 times the body" ((fabs (xl.size - (plain.size * 1.5))) < 0.6))
        def st:MdHtmlStyle (MdHtmlStyle.read("background: #1d2a6b url(x.png); font-weight: 300; letter-spacing: 2px" "background font-weight"))
        this.check("background shorthand: its colour" (st.fill == "#1d2a6b"))
        this.check("a light weight is normal" (st.weight == "normal"))
        this.check("a property not read is listed" ((join st.ignored ",") == "letter-spacing"))
    }

    fn testHtmlLists:void () {
        def hl:MdHtmlList (MdHtmlMd.listItems("<ol start=\"3\">\n<li>three <b>b</b></li>\n<li>four<ul><li>inner</li></ul></li>\n</ol>after" 0))
        this.check("ol start: the items are numbered from it" ((MdHtmlMd.listMarkdown(hl)) == "3. three <b>b</b>\n4. four\n   - inner"))
        this.check("…and the list ends at its closing tag" (hl.end == 81))
        def l:MdLayout (MdHtmlTest.laidOut("<ul>\n<li>first</li>\n<li>second <b>bold</b></li>\n</ul>\n\n<ol start=\"3\">\n<li>third</li>\n</ol>\n"))
        this.check("an HTML list is not shown as markup" ((MdHtmlTest.boxWith(l "<li>")).kind < 0))
        def a:MdBox (MdHtmlTest.boxWith(l "first"))
        def b:MdBox (MdHtmlTest.boxWith(l "second"))
        this.check("each <li> is an item of its own" (((a.kind == 0) && (b.kind == 0)) && (b.y > a.y)))
        def bb:MdBox (MdHtmlTest.boxWith(l "bold"))
        this.check("inline tags in an item are drawn" bb.bold)
        this.check("ol start=3 numbers its first item 3" ((MdHtmlTest.boxWith(l "3.")).kind == 0))
    }

    fn testCells:void () {
        def src:string "<table>\n<tr><th>Cell</th><th style=\"background:#3fb68b\">Content</th></tr>\n<tr><td>List</td><td><ul><li>yksi</li><li>kaksi</li></ul></td></tr>\n<tr><td>Nested</td><td><table><tr><td>a</td><td>b</td></tr></table></td></tr>\n<tr><td style=\"color:#ff6b6b;text-align:right\">972</td><td bgcolor=\"#123456\">x</td></tr>\n</table>\n"
        def t:MdHtmlTable (MdHtml.table(src))
        this.check("a table inside a cell adds no rows to the outer one" ((t.rowCount()) == 4))
        def l:MdLayout (MdHtmlTest.laidOut(src))
        def one:MdBox (MdHtmlTest.boxWith(l "yksi"))
        def two:MdBox (MdHtmlTest.boxWith(l "kaksi"))
        this.check("a list in a cell: an item a line" (((one.kind == 0) && (two.kind == 0)) && (two.y > one.y)))
        def bul:MdBox (MdHtmlTest.boxWith(l (strfromcode 8226)))
        this.check("…each with its bullet" (bul.kind == 0))
        this.check("a nested table is its rows as lines" ((MdHtmlTest.boxWith(l "a  ·  b")).kind == 0))
        this.check("cell style background is drawn" (MdHtmlTest.rectFilled(l "#3fb68b")))
        this.check("cell bgcolor is drawn" (MdHtmlTest.rectFilled(l "#123456")))
        def red:MdBox (MdHtmlTest.boxWith(l "972"))
        this.check("cell style color is the text's" ((MdChar.lower(red.color)) == "#ff6b6b"))
        def toned:string "<table>\n<tr><td>Done</td><td>Late</td></tr>\n</table>\n{cells=\"Done=green Late=red\"}\n"
        def tl:MdLayout (MdHtmlTest.laidOut(toned))
        def done:MdBox (MdHtmlTest.boxWith(tl "Done"))
        this.check("{cells=} tones an HTML table's cells" done.bold)
    }

    fn testDivPlate:void () {
        def l:MdLayout (MdHtmlTest.laidOut("<div style=\"background:#1d2a6b;padding:20px;border-radius:12px;color:#fff\">\nOn a **plate**\n</div>\n"))
        def plate:MdBox (new MdBox())
        for l.boxes b:MdBox i {
            if ((b.kind == 1) && ((MdChar.lower(b.fill)) == "#1d2a6b")) {
                plate = b
            }
        }
        this.check("div style background: a plate of that colour" ((MdChar.lower(plate.fill)) == "#1d2a6b"))
        this.check("…rounded as border-radius says (12px = 9pt)" ((fabs (plate.radius - 9.0)) < 0.01))
        def tx:MdBox (MdHtmlTest.boxWith(l "On a"))
        this.check("…padded as padding says (20px = 15pt)" ((fabs ((tx.x - plate.x) - 15.0)) < 0.5))
        this.check("…and its text in its colour" ((MdChar.lower(tx.color)) == "#ffffff"))
        def pb:MdBox (MdHtmlTest.boxWith(l "plate"))
        this.check("markdown inside it is read" pb.bold)
    }

    fn testSvg:void () {
        def raw:string "<svg width=\"200\" height=\"100\" onload=\"alert(1)\"><script>alert(1)</script><circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"#5ce1ff\" onclick=\"x()\"/><a href=\"javascript:x\"><rect/></a><image href=\"https://x/y.png\"/><use href=\"#c\"/><foreignObject><div>x</div></foreignObject></svg>"
        def c:string (MdSvg.clean(raw))
        this.check("svg: script, handlers, links out and foreignObject are dropped" ((((indexOf c "script") < 0) && ((indexOf c "onload") < 0)) && (((indexOf c "onclick") < 0) && (((indexOf c "image") < 0) && ((indexOf c "foreignObject") < 0)))))
        this.check("…the drawing is kept" ((indexOf c "<circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"#5ce1ff\"/>") > 0))
        this.check("…an inside link is kept" ((indexOf c "<use href=\"#c\"/>") > 0))
        this.check("…and it names its namespace" ((indexOf c "xmlns=\"http://www.w3.org/2000/svg\"") > 0))
        this.check("viewBox keeps its case" ((indexOf (MdSvg.clean("<svg viewBox=\"0 0 1 1\"></svg>")) "viewBox=") > 0))
        this.check("a style with an outside url() is dropped" ((indexOf (MdSvg.clean("<svg><rect style=\"fill:url(http://x)\"/></svg>")) "style") < 0))
        this.check("svg with text after it is not one picture" ((MdSvg.clean("<svg></svg> and more")) == ""))
        this.check("the same drawing has the same name" ((MdSvg.pathOf(c)) == (MdSvg.pathOf((MdSvg.clean(raw))))))
        def doc:MdNode (MdBlock.parseText("# T\n\n<svg width=\"20\" height=\"10\"><rect width=\"20\" height=\"10\"/></svg>\n\n<svg width=\"30\">\n<circle r=\"3\"/>\n</svg>\n\n- <svg><rect/></svg>\n"))
        def uses:[MdSvgUse] (MdSvg.inDoc(doc))
        this.check("svg on its own line, as a block and in a list item are found" ((array_length uses) == 3))
        ; a picture store that has the drawn picture: the slide shows it
        def l:MdLayout (new MdLayout())
        def u0:MdSvgUse (itemAt uses 0)
        def vfs (new Vfs())
        def mem (new VfsMemory())
        def blob (new VfsBlob())
        blob.bytes = (buffer_alloc 8)
        blob.contentType = "image/png"
        blob.pixelW = 200
        blob.pixelH = 100
        mem.put(("/" + u0.path) blob)
        vfs.mount("/" mem)
        l.images = vfs
        l.haveImages = true
        l.layoutContinuous(doc 600.0)
        def pic:boolean false
        for l.boxes b:MdBox i {
            if ((b.kind == 4) && (b.imagePath == ("/" + u0.path))) {
                pic = true
            }
        }
        this.check("an <svg> paragraph is drawn as its picture" pic)
        this.check("no svg markup is drawn as text" ((MdHtmlTest.boxWith(l "<svg")).kind < 0))
    }

    fn testScripts:void () {
        this.check("javascript: runs script" (MdUrl.runsScript(" JavaScript:alert(1)" false)))
        this.check("a data: picture does not, as a picture" ((MdUrl.runsScript("data:image/png;base64,xx" true)) == false))
        this.check("https does not" ((MdUrl.runsScript("https://sliqtly.com" false)) == false))
        def l:MdLayout (MdHtmlTest.laidOut("<a href=\"javascript:alert(1)\">js link</a> and [md](javascript:alert(2)) and <a href=\"https://sliqtly.com\">ok</a>"))
        this.check("an HTML javascript: link keeps no address" ((MdHtmlTest.boxWith(l "js link")).link == ""))
        this.check("a Markdown javascript: link keeps no address" ((MdHtmlTest.boxWith(l "md")).link == ""))
        this.check("an https link keeps it" ((MdHtmlTest.boxWith(l "ok")).link == "https://sliqtly.com"))
        this.check("the dropped address is noted" (MdHtmlTest.hasNote(l "script address")))
        def dx:MdToDocx (new MdToDocx())
        def dst (new MdStyle())
        def ddoc:RichDocument (dx.build((MdBlock.parseText("[md](javascript:alert(2)) [ok](https://a.b)")) dst))
        def links:[string]
        for ddoc.paragraphs dp:Paragraph bi {
            for dp.spans sp:TextSpan si {
                if ((strlen sp.hyperlink) > 0) {
                    push links sp.hyperlink
                }
            }
        }
        this.check("Word export keeps only the safe link" ((join links ",") == "https://a.b"))
    }

    fn testNotes:void () {
        def l:MdLayout (MdHtmlTest.laidOut("<span onclick=\"alert(1)\" style=\"letter-spacing:2px\">x</span> <video src=\"v.mp4\"></video> <blink>b</blink>\n\n<iframe src=\"https://example.com\"></iframe>\n\n<script>alert(1)</script>\n"))
        this.check("a handler is noted" (MdHtmlTest.hasNote(l "onclick on <span>")))
        this.check("a style property nothing reads is noted" (MdHtmlTest.hasNote(l "style letter-spacing on <span>")))
        this.check("<video> is noted" (MdHtmlTest.hasNote(l "<video> is not supported")))
        this.check("an unknown tag is noted" (MdHtmlTest.hasNote(l "<blink> is not drawn")))
        this.check("<iframe> is noted" (MdHtmlTest.hasNote(l "<iframe> is not supported")))
        this.check("<script> is noted as shown, not run" (MdHtmlTest.hasNote(l "<script> is shown as text")))
        this.check("each note once, with a place" ((array_length l.htmlNotes) == (array_length l.htmlNoteSrc)))
    }
}
}
