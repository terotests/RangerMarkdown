; SPDX-License-Identifier: AGPL-3.0-or-later

; ============================================================================
; MdSlidesTest.rgr — columns, and where a slide breaks.
; ============================================================================
;
;   npm run markdown:slides:test
;
; `PLAN_SLIDES.md` stages C and D, and each stage's own "done when".
;
; **Columns (C).** In document order DOWN each column, the columns differing
; by at most one item, and the same answer on the page as on the canvas. The
; check is the ORDER and the COLUMN INDEX of each item, not the number of
; boxes: a flow that put items across the rows instead of down the columns
; produces exactly as many boxes in exactly as many columns and is unreadable.
;
; **Slides (D).** The four rules of §4, in order, on a fixture written to
; exercise them — a heading that must break, one that must not, one kept with
; its first paragraph, and a slide that overflows. Each is checked by WHICH
; SLIDE a block landed on, because a rule that fires on the wrong block still
; produces the right number of slides.
; ============================================================================

Import "../src/MdBlock.rgr"
Import "../src/MdLayout.rgr"
Import "../src/MdCss.rgr"
Import "../src/MdDiagram.rgr"
Import "../src/MdToEvg.rgr"

class SlideCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    fn eqInt:void (name:string got:int want:int) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print (("    got  " + (to_string got)) + (" want " + (to_string want)))
        }
    }
}

class MdSlidesTest {
    sfn main:void () {
        def t:MdSlidesTest (new MdSlidesTest())
        t.run()
    }

    sfn laidOut:MdLayout (src:string css:string width:double) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.setDocSource(src)
        l.layoutContinuous(doc width)
        return l
    }

    sfn asSlides:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.layoutSlides(doc)
        return l
    }

    ; Which column a given piece of text was drawn in, counting from the left
    ; edge of the content. -1 when it is not on the page at all.
    sfn columnOf:int (l:MdLayout want:string x0:double colW:double gap:double) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) {
                    def d:double (b.x - x0)
                    return (to_int ((d / (colW + gap)) + 0.5))
                }
            }
            i = (i + 1)
        }
        return -1
    }

    sfn yOf:double (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) { return b.y }
            }
            i = (i + 1)
        }
        return (0.0 - 1.0)
    }

    ; The last slide a heading's text is on — a continuation repeats it.
    sfn lastSlideOf:int (l:MdLayout want:string) {
        def last:int -1
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) { last = b.page }
            }
            i = (i + 1)
        }
        return last
    }

    sfn slideOf:int (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == want) { return b.page }
            }
            i = (i + 1)
        }
        return -1
    }

    ; ----------------------------------------------------------------------
    fn columns:void (c:SlideCheck) {
        print "-- three columns, down each one --"
        def src:string "Before.\n\n- one\n- two\n- three\n- four\n- five\n- six\n- seven\n{.c3}\n\nAfter.\n"
        def css:string ".c3 { column-count: 3; column-gap: 24pt }"
        def l:MdLayout (MdSlidesTest.laidOut(src css 600.0))
        def x0:double l.contentX
        def colW:double (((600.0 - (l.style.margin * 2.0)) - 48.0) / 3.0)

        ; Seven items over three columns: 3, 2, 2 — and at most one item
        ; between the longest and the shortest.
        def cols:string ""
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "one" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "two" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "three" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "four" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "five" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "six" x0 colW 24.0))))
        cols = (cols + (to_string (MdSlidesTest.columnOf(l "seven" x0 colW 24.0))))
        c.eqStr("document order, down each column" cols "0001122")

        ; …and DOWN, which is the half a row-major flow would get wrong while
        ; producing the same three columns.
        c.ok("the second item is below the first" ((MdSlidesTest.yOf(l "two")) > (MdSlidesTest.yOf(l "one"))))
        c.ok("and the fourth is level with the first" ((fabs ((MdSlidesTest.yOf(l "four")) - (MdSlidesTest.yOf(l "one")))) < 0.5))
        c.ok("…as is the sixth" ((fabs ((MdSlidesTest.yOf(l "six")) - (MdSlidesTest.yOf(l "one")))) < 0.5))

        ; The bullets travel with their text. They are emitted by the LIST and
        ; carry its source offset, not the item's, so a flow that grouped by
        ; offset alone left every bullet in the first column.
        def bullets:int 0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if (b.text == "•") {
                    if (b.x > (x0 + 1.0)) { bullets = (bullets + 1) }
                }
            }
            i = (i + 1)
        }
        c.eqInt("four bullets moved out of the first column" bullets 4)

        ; What follows starts below the tallest column, not below the whole
        ; list as it was laid out before it was cut.
        def after:double (MdSlidesTest.yOf(l "After."))
        c.ok("the next block clears the columns" (after > (MdSlidesTest.yOf(l "three"))))
        def firstY:double (MdSlidesTest.yOf(l "one"))
        c.ok("…and does not clear the whole list" (after < (firstY + 300.0)))

        ; Without a sheet, nothing is in columns — the attribute alone means
        ; nothing, which is the whole point of the split.
        def plain:MdLayout (MdSlidesTest.laidOut(src "" 600.0))
        c.eqInt("with no sheet there are no columns" (MdSlidesTest.columnOf(plain "seven" x0 colW 24.0)) 0)

        ; A paragraph is not cut into columns: that would be a line flow and
        ; is a different feature. Saying so beats thirding a sentence.
        def para:MdNode (MdBlock.parseText("Some prose.\n{.c3}\n"))
        def pl:MdLayout (new MdLayout())
        pl.style = (new MdStyle())
        pl.setStyleSheet(css)
        pl.setDocSource("Some prose.\n{.c3}\n")
        pl.layoutContinuous(para 600.0)
        c.eqInt("a paragraph stays one column" (MdSlidesTest.columnOf(pl "Some prose." pl.contentX colW 24.0)) 0)
    }

    ; ----------------------------------------------------------------------
    ; The four rules, each on the block it is about
    fn breaks:void (c:SlideCheck) {
        print "-- where a slide breaks --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 405pt; padding: 36pt }"
        def src:string "# Title\n\nOpening line.\n\n## First\n\nOne.\n\n## Second\n\nTwo.\n\n### Under second\n\nThree.\n"
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        c.eqInt("the level comes from the sheet" l.splitLevel 2)
        c.eqInt("a heading at the level starts a slide" (MdSlidesTest.slideOf(l "First")) 1)
        c.eqInt("…and the next one the slide after" (MdSlidesTest.slideOf(l "Second")) 2)
        c.eqInt("the title keeps its own" (MdSlidesTest.slideOf(l "Title")) 0)
        c.eqInt("…with the paragraph under it" (MdSlidesTest.slideOf(l "Opening line.")) 0)
        ; 3. PREFERRED: a deeper heading whose section fits in the room left
        ; is a subheading of what is there and stays with it.
        c.eqInt("a deeper heading near the top stays" (MdSlidesTest.slideOf(l "Under second")) 2)

        ; 1. MANDATORY by attribute, on a block that is not a heading at all.
        def marked:string "# Title\n\nOne.\n\nTwo.\n{.slide}\n\nThree.\n"
        def m:MdLayout (MdSlidesTest.asSlides(marked css))
        c.eqInt("{.slide} starts one" (MdSlidesTest.slideOf(m "Two.")) 1)
        c.eqInt("…and what follows stays with it" (MdSlidesTest.slideOf(m "Three.")) 1)

        ; 2. FORBIDDEN beats 1. MANDATORY: an author who wrote `{.no-break}`
        ; on a heading meant it, and a flag that does nothing when it would
        ; matter is worse than no flag.
        def held:string "# Title\n\nOne.\n\n## Second {.no-break}\n\nTwo.\n"
        def h:MdLayout (MdSlidesTest.asSlides(held css))
        c.eqInt("{.no-break} holds a heading that would have broken" (MdSlidesTest.slideOf(h "Second")) 0)

        ; …and the document beats the template, because it is closer to the
        ; deck than the company is.
        def fm:string "---\nslide-split-level: 1\n---\n\n# Title\n\nOne.\n\n## Second\n\nTwo.\n"
        def f:MdLayout (MdSlidesTest.asSlides(fm css))
        c.eqInt("front matter beats the sheet" f.splitLevel 1)
        c.eqInt("…so a level-two heading no longer breaks" (MdSlidesTest.slideOf(f "Second")) 0)
    }

    ; KEEP-WITH-NEXT, which is the thing that makes an automatic deck look
    ; hand-made: a heading is never the last thing on a slide.
    fn keepWithNext:void (c:SlideCheck) {
        print "-- a heading is never the last thing on a slide --"
        ; A short page, and enough prose to fill it to just under the bottom.
        def css:string "deck { split-level: 1 } page { width: 720pt; height: 200pt; padding: 20pt }"
        def src:string "# Title\n\nFiller one.\n\nFiller two.\n\nFiller three.\n\nFiller four.\n\n### Low heading\n\nUnder it.\n"
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        def hs:int (MdSlidesTest.slideOf(l "Low heading"))
        def ps:int (MdSlidesTest.slideOf(l "Under it."))
        c.ok("the heading was reached" (hs >= 0))
        c.eqInt("and what is under it is on the same slide" ps hs)

        ; The noun the failure is about: a slide whose LAST box is a heading.
        c.eqInt("no slide ends on a heading" (MdSlidesTest.slidesEndingOnAHeading(l)) 0)

        ; …and the case a reader actually reported: the heading on one slide
        ; and its DIAGRAM on the next.
        ;
        ; One body line of room under a heading is enough for prose, because a
        ; paragraph that starts under its heading and runs on still reads as
        ; one thing. It is not enough for a block that cannot be cut: the
        ; heading fits, the diagram does not, and the pair comes apart. The
        ; diagram's height was measured before layout began — that is what the
        ; prepare pass is for — so the rule can ask for the real number.
        ; Sized so the rule has to fire and CAN: the diagram is 200pt in a
        ; slide with 260pt of room, so the pair fits once the heading moves —
        ; and does not fit where the heading would otherwise have stayed.
        ; Without `keepRoom` the heading lands on slide 0 and the diagram on
        ; slide 1, which is the reader's complaint in two numbers.
        def dcss:string "deck { split-level: 1 } page { width: 720pt; height: 300pt; padding: 20pt }"
        def dsrc:string "# Title\n\nFiller one.\n\n### Kaavio\n\n```mermaid\nflowchart TD\n  A[Kirjoita jotain] --> B[Renderoi se]\n```\n"
        def dl:MdLayout (MdSlidesTest.asSlidesWithDiagrams(dsrc dcss))
        def dh:int (MdSlidesTest.slideOf(dl "Kaavio"))
        def dd:int (MdSlidesTest.slideOfEmbed(dl))
        c.ok("the heading with a diagram under it was reached" (dh >= 0))
        c.ok("…and the diagram was drawn" (dd >= 0))
        c.eqInt("a heading and its diagram are on the same slide" dd dh)
    }

    ; The first embed slot's slide, or -1. A diagram is not a text box, so
    ; `slideOf` cannot see it — and the whole failure is about where the
    ; diagram went.
    sfn slideOfEmbed:int (l:MdLayout) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 3) { return b.page }
            i = (i + 1)
        }
        return (0 - 1)
    }

    ; As `asSlides`, with the diagrams measured first — which is the order the
    ; editor uses and the only order in which `keepRoom` has a number to ask
    ; for.
    sfn asSlidesWithDiagrams:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        def cw:double (l.style.pageWidth - (l.style.margin * 2.0))
        MdDiagram.prepare(doc l.embeds cw "default")
        l.layoutSlides(doc)
        if (MdDiagram.refit(doc l.embeds cw "default")) {
            l.layoutSlides(doc)
        }
        return l
    }

    ; A title set so large that it wraps, with a diagram under it. The
    ; diagram went to a slide of its own with the title said again, and the
    ; slide it left held the title and nothing else — one heading, two slides
    ; (Sliqtly: `h2 { font-size: 80pt }` over a chart). The diagram now takes
    ; the room left under the title; a title too big for even that is set
    ; smaller; a title alone on its slide keeps its size.
    fn bigTitle:void (c:SlideCheck) {
        print "-- a big title keeps its diagram --"
        def dia:string "```mermaid\nflowchart TD\n  A[Kirjoita jotain] --> B[Renderoi se]\n```\n"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } h2 { font-size: 44pt }"
        def src:string ("## Keskilämpötila kuukausittain kolmella asemalla\n\n" + dia)
        def l:MdLayout (MdSlidesTest.asSlidesWithDiagrams(src css))
        c.eqInt("a wrapped title and its diagram are one slide" l.pageCount 1)
        c.eqInt("…the diagram is on it" (MdSlidesTest.slideOfEmbed(l)) 0)
        c.eqInt("…and nothing was said twice" l.slideOverflows 0)
        c.ok("…and the diagram stays on the slide" (MdSlidesTest.embedBottom(l) <= (l.contentBottom + 0.5)))
        c.ok("the title kept its size" ((MdSlidesTest.biggestText(l)) > 43.0))

        def hcss:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } h2 { font-size: 120pt }"
        def hl:MdLayout (MdSlidesTest.asSlidesWithDiagrams(src hcss))
        c.eqInt("a title taller than the slide and its diagram are one slide" hl.pageCount 1)
        c.eqInt("…the diagram is on it" (MdSlidesTest.slideOfEmbed(hl)) 0)
        c.ok("…because the title was set smaller" ((MdSlidesTest.biggestText(hl)) < 119.0))
        c.ok("…and the diagram stays on the slide" (MdSlidesTest.embedBottom(hl) <= (hl.contentBottom + 0.5)))

        def scss:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } h2 { font-size: 90pt }"
        def sl:MdLayout (MdSlidesTest.asSlidesWithDiagrams("## Iso otsikko\n\n## Seuraava\n\nTekstiä.\n" scss))
        c.ok("a title alone on its slide keeps its size" ((MdSlidesTest.biggestTextOn(sl 0)) > 89.0))
    }

    ; A diagram taller than the room under its title is given exactly that
    ; room: its height is `contentBottom - cursorY`. `reserve` then asked
    ; whether `cursorY + h` ran past `contentBottom`, and for some paddings
    ; that sum, in floating point, came out one rounding step past it — so
    ; the diagram went to a slide of its own, and the title's slide was
    ; empty. In Sliqtly dragging the page padding made the diagram vanish
    ; and come back every other value (0.54in drawn, 0.56in empty).
    fn exactFit:void (c:SlideCheck) {
        print "-- a diagram squeezed to the room left stays on its slide --"
        def dia:string "```mermaid\nflowchart TD\n  A[Boy meets girl] -->|musters up the courage| B((Boy asks girl on a date))\n  B --> C[They kiss]\n  C -->|both feel a spark| D((Start talking every day))\n  D --> E[Girl says yes]\n  E --> F((Save the date))\n```\n"
        def src:string ("## Romantic\n\n" + dia)
        def moved:int 0
        def firstBad:string ""
        def pad:double 20.0
        while (pad <= 90.0) {
            def css:string ("deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: " + (to_string pad) + "pt }")
            def l:MdLayout (MdSlidesTest.asSlidesWithDiagrams(src css))
            if ((l.pageCount != 1) || ((MdSlidesTest.slideOfEmbed(l)) != 0)) {
                moved = (moved + 1)
                if ((strlen firstBad) == 0) { firstBad = (to_string pad) }
            }
            pad = (pad + 0.36)
        }
        if (moved > 0) { print ("   first padding that moved it: " + firstBad + "pt") }
        c.eqInt("no padding sends the diagram to a slide of its own" moved 0)
    }

    sfn embedBottom:double (l:MdLayout) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 3) { return (b.y + b.h) }
            i = (i + 1)
        }
        return 0.0
    }

    sfn biggestText:double (l:MdLayout) {
        return (MdSlidesTest.biggestTextOn(l (0 - 1)))
    }

    ; The largest text size on slide `p` (any slide when `p` is -1).
    sfn biggestTextOn:double (l:MdLayout p:int) {
        def big:double 0.0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((p < 0) || (b.page == p))) {
                if (b.size > big) { big = b.size }
            }
            i = (i + 1)
        }
        return big
    }

    ; How many slides have a heading as the lowest thing on them.
    sfn slidesEndingOnAHeading:int (l:MdLayout) {
        def bad:int 0
        def p:int 0
        while (p < l.pageCount) {
            def lowest:double (0.0 - 1.0)
            def lowestBold:boolean false
            def i:int 0
            while (i < (array_length l.boxes)) {
                def b:MdBox (itemAt l.boxes i)
                if (b.page == p) {
                    if (b.kind == 0) {
                        if (b.y > lowest) {
                            lowest = b.y
                            lowestBold = (b.size > (l.style.bodySize + 0.5))
                        }
                    }
                }
                i = (i + 1)
            }
            if lowestBold { bad = (bad + 1) }
            p = (p + 1)
        }
        return bad
    }

    ; A block too tall for one slide is cut, the count is printed, and the
    ; continuation carries the title — so a reader of the second half knows
    ; what it is the second half of.
    fn overflow:void (c:SlideCheck) {
        print "-- and a slide too full --"
        def css:string "deck { split-level: 1 } page { width: 720pt; height: 160pt; padding: 20pt }"
        def body:string "# Long\n\n"
        def i:int 0
        while (i < 40) {
            body = ((body + "- item ") + (to_string i)) + "\n"
            i = (i + 1)
        }
        def l:MdLayout (MdSlidesTest.asSlides(body css))
        c.ok("it took more than one slide" (l.pageCount > 1))
        c.ok("and said how many blocks it cut" (l.slideOverflows > 0))
        c.eqStr("with the policy it was told" l.slideOverflow "split")
        c.ok("the continuation carries the title" ((MdSlidesTest.lastSlideOf(l "Long")) > 0))
        c.eqInt("and no untranslated suffix" (MdSlidesTest.slideOf(l "Long (jatkuu)")) -1)

        ; A policy this layout does not honour is carried and named rather
        ; than silently treated as the default.
        def shrink:MdLayout (MdSlidesTest.asSlides(body "deck { split-level: 1; overflow: shrink }"))
        c.eqStr("another policy is carried" shrink.slideOverflow "shrink")
    }

    ; A list item is not cut between two slides: its bullet and its words
    ; land on the same one, and an item that fits on a slide is moved whole.
    fn wholeItems:void (c:SlideCheck) {
        print "-- a list item stays whole --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 200pt; padding: 20pt } document { font-size: 14pt }"
        def body:string "## Key Features\n\n"
        def i:int 0
        while (i < 9) {
            body = (body + "- **Feature " + (to_string i) + "** is described here in a sentence long enough to wrap onto a second line of the slide\n")
            i = (i + 1)
        }
        def l:MdLayout (MdSlidesTest.asSlides(body css))
        c.ok("the list takes more than one slide" (l.pageCount > 1))
        ; every bullet is on the page of the text that follows it, and no
        ; item has lines on two slides
        def bad:int 0
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if ((b.kind == 0) && (b.text == "•")) {
                def near:int -1
                def j:int 0
                while (j < (array_length l.boxes)) {
                    def t:MdBox (itemAt l.boxes j)
                    if (((t.kind == 0) && (t.segSrc >= 0)) && (t.text != "•")) {
                        if ((near < 0) && ((t.page == b.page) && ((t.y + 1.0) >= b.y))) {
                            if ((t.y - b.y) < 2.0) {
                                near = j
                            }
                        }
                    }
                    j = (j + 1)
                }
                if (near < 0) {
                    bad = (bad + 1)
                }
            }
            k = (k + 1)
        }
        c.eqInt("no bullet stands without its first line" bad 0)
        ; every item's words on one slide: its source span, and the pages of
        ; the boxes drawn from it
        def cut:int 0
        def at:int (strlen "## Key Features\n\n")
        def f:int 0
        while (f < 9) {
            def line:string ("- **Feature " + (to_string f) + "** is described here in a sentence long enough to wrap onto a second line of the slide\n")
            def end:int (at + (strlen line))
            def pg:int -1
            def m:int 0
            while (m < (array_length l.boxes)) {
                def b2:MdBox (itemAt l.boxes m)
                if (((b2.kind == 0) && (b2.segSrc >= at)) && (b2.segSrc < end)) {
                    if (pg < 0) {
                        pg = b2.page
                    }
                    if (b2.page != pg) {
                        cut = (cut + 1)
                    }
                }
                m = (m + 1)
            }
            at = end
            f = (f + 1)
        }
        c.eqInt("no item is cut between two slides" cut 0)
    }

    sfn slidesAt:MdLayout (src:string css:string shrinkMin:double tableMin:double) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.slideShrinkMin = shrinkMin
        l.tableShrinkMin = tableMin
        l.layoutSlides(doc)
        return l
    }

    sfn slidesWith:MdLayout (src:string css:string shrinkMin:double) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.slideShrinkMin = shrinkMin
        l.layoutSlides(doc)
        return l
    }

    ; A slide that spills by one item is set a little smaller instead of
    ; getting a continuation slide for that item.
    fn shrinkToFit:void (c:SlideCheck) {
        print "-- a short spill shrinks the slide --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 220pt; padding: 20pt } document { font-size: 14pt }"
        def body:string "## Features\n\n"
        def n:int 0
        def spilled:boolean false
        while ((n < 30) && (spilled == false)) {
            body = (body + "- item number " + (to_string n) + "\n")
            def off:MdLayout (MdSlidesTest.slidesWith(body css 1.0))
            if (off.pageCount > 1) {
                spilled = true
            }
            n = (n + 1)
        }
        c.ok("some length spills without shrinking" spilled)
        def on:MdLayout (MdSlidesTest.slidesWith((body + "\n## Next\n\nText\n") css 0.8))
        c.eqInt("with it, the list stays on one slide" (MdSlidesTest.slideOf(on ("item number " + (to_string (n - 1))))) 0)
        c.eqInt("and the next slide is the second" (MdSlidesTest.slideOf(on "Text")) 1)
        c.eqInt("one slide was shrunk" on.slidesShrunk 1)
        def big:string "## Long\n\n"
        def k:int 0
        while (k < 40) {
            big = (big + "- line " + (to_string k) + "\n")
            k = (k + 1)
        }
        def far:MdLayout (MdSlidesTest.slidesWith(big css 0.8))
        c.ok("a long spill is still split" (far.pageCount > 1))
    }

    ; Ten rows on a dark theme's 20pt body ran half a table onto a second
    ; slide. The table alone is set smaller; the title keeps its size.
    fn tableShrinks:void (c:SlideCheck) {
        print "-- a table that runs over is set smaller by itself --"
        def css:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 54pt } document { font-size: 20pt }"
        def rows:string "| # | Asiakas | Maa | Summa |\n|---|---|---|---:|\n"
        def i:int 1
        while (i <= 10) {
            rows = (rows + "| " + (to_string i) + " | Asiakas" + (to_string i) + " Oy | Suomi | " + (to_string (1500 - (i * 70))) + " |\n")
            i = (i + 1)
        }
        def src:string ("## Top 10 asiakasta\n\nKymmenen suurinta tuo 41 % summasta.\n\n" + rows + "\n## Seuraava\n\nTeksti\n")
        def off:MdLayout (MdSlidesTest.slidesAt(src css 1.0 1.0))
        c.ok("unshrunk, the table runs onto a second slide" ((MdSlidesTest.slideOf(off "Asiakas10 Oy")) == 1))
        def on:MdLayout (MdSlidesTest.slidesWith(src css 0.8))
        c.eqInt("the last row stays on the first slide" (MdSlidesTest.slideOf(on "Asiakas10 Oy")) 0)
        c.eqInt("and the next slide is the second" (MdSlidesTest.slideOf(on "Teksti")) 1)
        def tSize:double (MdSlidesTest.sizeOf(on "Top 10 asiakasta"))
        def oSize:double (MdSlidesTest.sizeOf(off "Top 10 asiakasta"))
        c.ok(("the title keeps its size: " + (to_string tSize)) (((tSize > 0.0) && ((tSize - oSize) < 0.01)) && ((oSize - tSize) < 0.01)))
        def cSize:double (MdSlidesTest.sizeOf(on "Asiakas10 Oy"))
        c.ok(("the table's text is smaller: " + (to_string cSize)) ((cSize < 20.0) && (cSize >= 11.9)))
        def lSize:double (MdSlidesTest.sizeOf(on "Kymmenen suurinta tuo 41 % summasta."))
        c.ok("the lead keeps the body size" (lSize >= 19.9))
        def many:string "## Iso\n\n| a | b |\n|---|---|\n"
        def k:int 0
        while (k < 40) {
            many = (many + "| rivi" + (to_string k) + " | x |\n")
            k = (k + 1)
        }
        def far:MdLayout (MdSlidesTest.slidesWith(many css 0.8))
        c.ok("a long table is still split" (far.pageCount > 1))
    }

    ; The same document, three ways: the claim `PLAN_SLIDES.md` opens with is
    ; that the deck is a LAYOUT POLICY and not a conversion. One tree, three
    ; calls, and the text is the same text in all three.
    fn oneDocument:void (c:SlideCheck) {
        print "-- one document, three layouts --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 405pt; padding: 36pt }"
        def src:string "# Title\n\nOne.\n\n## Second\n\nTwo.\n"
        def doc:MdNode (MdBlock.parseText(src))
        def sheet:MdCss (new MdCss())
        sheet.addStyleSheet(css)

        def flow:MdLayout (new MdLayout())
        flow.style = (new MdStyle())
        sheet.applyTo(flow.style)
        flow.setStyleSheet(css)
        flow.setDocSource(src)
        flow.layoutContinuous(doc 720.0)

        def paged:MdLayout (new MdLayout())
        paged.style = (new MdStyle())
        sheet.applyTo(paged.style)
        paged.setStyleSheet(css)
        paged.setDocSource(src)
        paged.layoutPaged(doc)

        def deck:MdLayout (MdSlidesTest.asSlides(src css))

        c.eqStr("the words are the same, flowing and paged" (MdSlidesTest.words(flow)) (MdSlidesTest.words(paged)))
        c.eqStr("…and as a deck" (MdSlidesTest.words(flow)) (MdSlidesTest.words(deck)))
        c.eqInt("one column of scroll" flow.pageCount 1)
        c.eqInt("one sheet of print" paged.pageCount 1)
        c.eqInt("and two slides" deck.pageCount 2)
    }

    sfn words:string (l:MdLayout) {
        def out:string ""
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == 0) {
                if ((strlen b.text) > 0) { out = ((out + b.text) + "|") }
            }
            i = (i + 1)
        }
        return out
    }

    sfn sizeOf:double (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.text == want)) {
                return b.size
            }
            i = (i + 1)
        }
        return 0.0
    }

    ; GROW: a slide of three bullets has its text set larger, its title the
    ; deck's title size like every other slide's; a full slide is left as it
    ; was; nothing spills; off means off.
    fn grow:void (c:SlideCheck) {
        print "-- grow --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 405pt; padding: 36pt } document { font-size: 16pt } h2 { font-size: 28pt }"
        def full:string "- rivi yksi joka on aika pitkä ja kiertää varmasti\n- rivi kaksi\n- rivi kolme\n- rivi neljä\n- rivi viisi\n- rivi kuusi\n- rivi seitsemän\n- rivi kahdeksan\n- rivi yhdeksän\n"
        def src:string ("---\nslide-grow: 1.6\n---\n\n## Vähän\n\n- Kate\n- Hinnoittelu\n- Varastointi\n\n## Paljon\n\n" + full)
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        c.eqInt("two slides, as before" l.pageCount 2)
        def body:double (MdSlidesTest.sizeOf(l "Kate"))
        def title:double (MdSlidesTest.sizeOf(l "Vähän"))
        c.ok(("the short list grew: " + (to_string body)) (body > 20.0))
        c.ok(("its title kept the deck's title size: " + (to_string title)) ((title > 27.9) && (title < 28.1)))
        c.ok("the same size as the full slide's title" ((title - (MdSlidesTest.sizeOf(l "Paljon"))) == 0.0))
        c.ok("and is still the larger" (title > body))
        def h3:string "---\nslide-grow: 1.6\n---\n\n## Otsikko\n\n### Väliotsikko\n\nLyhyt.\n"
        def hl:MdLayout (MdSlidesTest.asSlides(h3 css))
        def sub:double (MdSlidesTest.sizeOf(hl "Väliotsikko"))
        c.ok(("a heading inside the slide grows, never past the title: " + (to_string sub)) ((sub <= 28.0) && (sub > (MdSlidesTest.sizeOf((MdSlidesTest.asSlides((h3.replace("slide-grow: 1.6" "slide-grow: off")) css)) "Väliotsikko")))))
        c.ok("the full slide kept its size" ((MdSlidesTest.sizeOf(l "rivi kaksi")) < 16.5))
        c.eqInt("one slide grown" l.slidesGrown 1)
        def lowest:double 0.0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.page == 0) && ((b.y + b.h) > lowest)) { lowest = (b.y + b.h) }
            i = (i + 1)
        }
        c.ok("and stays inside the slide" (lowest <= (405.0 - 36.0)))
        def off:MdLayout (MdSlidesTest.asSlides((src.replace("slide-grow: 1.6" "slide-grow: off")) css))
        c.ok("slide-grow: off keeps the document size" ((MdSlidesTest.sizeOf(off "Kate")) < 16.5))
        ; a title that fits on one line is not grown onto two
        def ts:string "---\nslide-grow: 1.6\n---\n\n## Gemini-botti palaverissa tänä vuonna\n\nLyhyt teksti.\n"
        def tl:MdLayout (MdSlidesTest.asSlides(ts css))
        c.eqInt("the title stays one line" (MdLayout.headingLines(tl.boxes 0 (array_length tl.boxes) 27.0)) 1)
    }

    ; The header's and the footer's box with this text on slide p, or null.
    sfn edgeBox@(optional):MdBox (l:MdLayout want:string p:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.kind == 0) && (b.page == p)) && ((b.text == want) && (b.furniture > 0))) {
                def hit@(optional):MdBox b
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):MdBox
        return miss
    }

    sfn has:boolean (l:MdLayout want:string p:int) {
        def b@(optional):MdBox (MdSlidesTest.edgeBox(l want p))
        return (!null? b)
    }

    ; Header and footer: three places an edge, {page}/{pages}, the first and
    ; the last slide left out, a slide that turns its edge off, the CSS.
    fn edges:void (c:SlideCheck) {
        print "-- header and footer --"
        def css:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 40pt } document { font-size: 20pt }"
        def src:string ("---\nheader-left: ACME\nheader-right: Q4\nfooter-left: Luottamuksellinen\nfooter-right: \"{page} / {pages}\"\nfooter-skip: first last\n---\n\n"
            + "## Kansi\n\nAlku\n\n## Toka\n\nTeksti\n\n## Kolmas {header=off}\n\nLisaa\n\n## Loppu\n\nKiitos\n")
        def l:MdLayout (MdSlidesTest.slidesWith(src css 1.0))
        c.eqInt("four slides" l.pageCount 4)
        c.ok("header on the first slide" (MdSlidesTest.has(l "ACME" 0)))
        c.ok("footer left off the first slide" ((MdSlidesTest.has(l "Luottamuksellinen" 0)) == false))
        c.ok("page number on slide 2" (MdSlidesTest.has(l "2 / 4" 1)))
        c.ok("footer left off the last slide" ((MdSlidesTest.has(l "4 / 4" 3)) == false))
        c.ok("{header=off} drops the header" ((MdSlidesTest.has(l "ACME" 2)) == false))
        c.ok("but keeps that slide's footer" (MdSlidesTest.has(l "3 / 4" 2)))
        def lb@(optional):MdBox (MdSlidesTest.edgeBox(l "ACME" 1))
        def rb@(optional):MdBox (MdSlidesTest.edgeBox(l "Q4" 1))
        if ((!null? lb) && (!null? rb)) {
            def left:MdBox (unwrap lb)
            def right:MdBox (unwrap rb)
            c.ok("left place at the content's left" ((left.x > 39.0) && (left.x < 41.0)))
            c.ok("right place ends at the content's right" (((right.x + right.w) > 919.0) && ((right.x + right.w) < 921.0)))
            c.ok("header above the content" ((left.y + left.h) < 40.0))
        } {
            c.ok("header places found" false)
        }
        def fb@(optional):MdBox (MdSlidesTest.edgeBox(l "2 / 4" 1))
        if (!null? fb) {
            c.ok("footer below the content" ((unwrap fb).y > 500.0))
        }

        ; The theme says it: a band, bold, a centred place, the hairline.
        def css2:string (css + " footer { content-center: \"Sivu {page}\"; background-color: #222244; border-color: #ff8800; font-weight: bold; color: #ffffff }")
        def l2:MdLayout (MdSlidesTest.slidesWith("## Yksi\n\nTeksti\n" css2 1.0))
        def cb@(optional):MdBox (MdSlidesTest.edgeBox(l2 "Sivu 1" 0))
        c.ok("a CSS place" (!null? cb))
        if (!null? cb) {
            def cbox:MdBox (unwrap cb)
            c.ok("centred" ((fabs ((cbox.x + (cbox.w * 0.5)) - 480.0)) < 1.0))
            c.ok("bold" cbox.bold)
            c.eqStr("its colour" cbox.color "#FFFFFF")
        }
        def bands:int 0
        def i:int 0
        while (i < (array_length l2.boxes)) {
            def b:MdBox (itemAt l2.boxes i)
            if ((b.kind == 1) && (b.furniture == 2)) {
                bands = (bands + 1)
            }
            i = (i + 1)
        }
        c.eqInt("band and hairline" bands 2)

        ; A tall header widens a margin too small for it.
        def css3:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 10pt } document { font-size: 20pt } header { content: \"Otsikko\"; font-size: 30pt }"
        def l3:MdLayout (MdSlidesTest.slidesWith("## Yksi\n\nTeksti\n" css3 1.0))
        def hb@(optional):MdBox (MdSlidesTest.edgeBox(l3 "Otsikko" 0))
        def ty:double (MdSlidesTest.yOf(l3 "Yksi"))
        if (!null? hb) {
            c.ok("content starts below a tall header" (ty > ((unwrap hb).y + (unwrap hb).h)))
        } {
            c.ok("tall header found" false)
        }
    }

    sfn pictureVfs:Vfs () {
        def v (new Vfs())
        def mem (new VfsMemory())
        mem.put("/small.png" (MdSlidesTest.png(160 90)))
        mem.put("/big.png" (MdSlidesTest.png(2560 1280)))
        ; (the store keeps a file by its bytes: these are not the PNGs')
        def ink (new VfsBlob())
        def raw:string "{\"items\":[]}"
        def buf:buffer (buffer_alloc (strlen raw))
        def k:int 0
        while (k < (strlen raw)) {
            buffer_set buf k (charAt raw k)
            k = (k + 1)
        }
        ink.bytes = buf
        ink.contentType = "application/x-test-overlay"
        mem.put("/drawings/a.ink" ink)
        v.mount("/" mem)
        return v
    }

    sfn png:VfsBlob (w:int h:int) {
        def blob (new VfsBlob())
        def raw:string "PNGBYTES"
        def buf:buffer (buffer_alloc (strlen raw))
        def bi:int 0
        while (bi < (strlen raw)) {
            buffer_set buf bi (charAt raw bi)
            bi = (bi + 1)
        }
        blob.bytes = buf
        blob.contentType = "image/png"
        blob.pixelW = w
        blob.pixelH = h
        return blob
    }

    sfn withPictures:MdLayout (src:string css:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def c:MdCss (new MdCss())
        c.addStyleSheet(css)
        c.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.setImages((MdSlidesTest.pictureVfs()) "/")
        def cw:double (l.style.pageWidth - (l.style.margin * 2.0))
        MdDiagram.prepare(doc l.embeds cw "default")
        l.layoutSlides(doc)
        if (MdDiagram.refit(doc l.embeds cw "default")) {
            l.layoutSlides(doc)
        }
        return l
    }

    ; the text of the first fence in `src`, as the cache keys it
    sfn fenceOf:string (src:string) {
        def doc:MdNode (MdBlock.parseText(src))
        def i:int 0
        while (i < (doc.childCount())) {
            def c:MdNode (doc.childAt(i))
            if (c.kind == "embed") { return c.literal }
            i = (i + 1)
        }
        return ""
    }

    sfn boxOfKind@(optional):MdBox (l:MdLayout kind:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (b.kind == kind) {
                def hit@(optional):MdBox b
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):MdBox
        return miss
    }

    sfn textBox@(optional):MdBox (l:MdLayout want:string) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && ((indexOf b.text want) == 0)) {
                def hit@(optional):MdBox b
                return hit
            }
            i = (i + 1)
        }
        def miss@(optional):MdBox
        return miss
    }

    ; OVERLAY PICTURES: a reference to a file the host draws over the slide
    ; takes no room, draws no box, and says which slide it is on.
    fn overlays:void (c:SlideCheck) {
        print "-- overlay pictures --"
        def css:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 54pt } document { font-size: 20pt } h2 { font-size: 36pt }"
        def src:string "## Yksi\n\nEnsin.\n\n![](drawings/a.ink)\n\nSitten.\n\n## Kaksi\n\n![](drawings/a.ink)\n"
        def plain:MdLayout (MdSlidesTest.withPictures(src css))
        c.eqInt("without the type it is a missing picture's alt text" (array_length plain.overlaySrc) 0)
        def doc:MdNode (MdBlock.parseText(src))
        def l:MdLayout (new MdLayout())
        l.style = (new MdStyle())
        def mc:MdCss (new MdCss())
        mc.addStyleSheet(css)
        mc.applyTo(l.style)
        l.setStyleSheet(css)
        l.applyMeta(doc)
        l.applySlideMeta(doc)
        l.setDocSource(src)
        l.setImages((MdSlidesTest.pictureVfs()) "/")
        push l.overlayTypes "application/x-test-overlay"
        l.layoutSlides(doc)
        c.eqInt("two slides" l.pageCount 2)
        c.eqInt("both references noted" (array_length l.overlaySrc) 2)
        c.eqInt("the first on slide 1" (itemAt l.overlayPage 0) 0)
        c.eqInt("the second on slide 2" (itemAt l.overlayPage 1) 1)
        c.ok("its path" ((itemAt l.overlayPath 0) == "/drawings/a.ink"))
        c.ok("where it is written" ((substring src (itemAt l.overlaySrc 0) ((itemAt l.overlaySrc 0) + 3)) == "![]"))
        def none@(optional):MdBox (MdSlidesTest.boxOfKind(l 4))
        c.ok("no picture box" (null? none))
        ; "Sitten." sits where it would with no reference between
        def wo:MdLayout (MdSlidesTest.withPictures("## Yksi\n\nEnsin.\n\nSitten.\n" css))
        c.ok("it takes no room" ((fabs ((MdSlidesTest.yOf(l "Sitten.")) - (MdSlidesTest.yOf(wo "Sitten.")))) < 0.01))
    }

    ; PICTURES on a slide take their room: a small one is set larger, a
    ; large one leaves the text under it on its slide; a narrow picture or
    ; figure given a width has the text after it beside it (Tero's third
    ; test deck, 2026-10-04).
    fn pictures:void (c:SlideCheck) {
        print "-- pictures and floats --"
        def css:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 54pt } document { font-size: 20pt } h2 { font-size: 36pt }"
        def sl:MdLayout (MdSlidesTest.withPictures("## Kuva\n\n![Pieni](small.png)\n" css))
        def sp:MdBox (unwrap (MdSlidesTest.boxOfKind(sl 4)))
        c.ok(("a 160×90 picture is set larger: " + (to_string sp.w)) ((sp.w > 400.0) && (sp.w <= 640.0)))
        c.ok("and stays inside the slide" ((sp.y + sp.h) <= (540.0 - 54.0 + 0.5)))
        def bl:MdLayout (MdSlidesTest.withPictures("## SVG\n\n![Iso](big.png)\n\nTeksti kuvan alla.\n" css))
        c.eqInt("a large picture and its caption: one slide" bl.pageCount 1)
        def cap:MdBox (unwrap (MdSlidesTest.textBox(bl "Teksti")))
        c.eqInt("the caption is on the picture's slide" cap.page 0)
        def fl:MdLayout (MdSlidesTest.withPictures("## Rinnalla\n\n![Pieni](small.png)\n{width=40%}\n\nTeksti kuvan vieressä.\n" css))
        def fp:MdBox (unwrap (MdSlidesTest.boxOfKind(fl 4)))
        def ft:MdBox (unwrap (MdSlidesTest.textBox(fl "Teksti")))
        c.ok("a picture given a width: the text beside it" ((ft.x >= (fp.x + fp.w)) && (ft.y < (fp.y + fp.h))))
        def pr:string "## Kapea\n\n```process\n- Pyyntö: käyttäjä kirjoittaa\n- Esitys: tekoäly tekee\n- Tarkistus: renderöinti\n```\n{width=60%}\n\nKapea pohja jättää tilaa tälle selitykselle.\n\nToinen kappale.\n"
        def pl:MdLayout (MdSlidesTest.withPictures(pr css))
        def pe:MdBox (unwrap (MdSlidesTest.boxOfKind(pl 3)))
        def pt:MdBox (unwrap (MdSlidesTest.textBox(pl "Kapea pohja")))
        c.ok(("a figure at 60%: the text beside it: " + (to_string pt.x)) ((pt.x >= (pe.x + pe.w)) && (pt.y < (pe.y + pe.h))))
        c.eqInt("on the same slide" pt.page pe.page)
        ; a chart centred (a host's default) and given a width: its box
        ; starts the column, so its takeaway goes beside it, on its slide
        def ch:string "## Kaavio\n\n```vega-lite\n{\"usermeta\": {\"presAlign\": \"center\"}, \"data\": {\"values\": [{\"m\": \"a\", \"n\": 3}, {\"m\": \"b\", \"n\": 5}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}\n```\n{width=60%}\n\n- Kärki: b\n- Pienin: a\n{container=box}\n"
        def cl:MdLayout (MdSlidesTest.withPictures(ch css))
        def ce:MdBox (unwrap (MdSlidesTest.boxOfKind(cl 3)))
        def ctx:MdBox (unwrap (MdSlidesTest.textBox(cl "Kärki")))
        c.ok(("a centred chart at 60%: the box beside it: " + (to_string ctx.x)) ((ctx.x >= (ce.x + ce.w)) && (ctx.y < (ce.y + ce.h))))
        c.eqInt("a centred chart at 60%: one slide" cl.pageCount 1)
        ; a chart taller than its room keeps the line written under it on
        ; its slide (Tero's cloud run 2026-10-06: a source line went to a
        ; slide of its own)
        def tall:string "## Korkea\n\nJohdanto.\n\n```vega-lite\n{\"height\": 420, \"data\": {\"values\": [{\"m\": \"a\", \"n\": 3}, {\"m\": \"b\", \"n\": 5}]}, \"mark\": \"bar\", \"encoding\": {\"x\": {\"field\": \"m\", \"type\": \"nominal\"}, \"y\": {\"field\": \"n\", \"type\": \"quantitative\"}}}\n```\n\nLähde: testi.\n"
        def tl:MdLayout (MdSlidesTest.withPictures(tall css))
        def te:MdBox (unwrap (MdSlidesTest.boxOfKind(tl 3)))
        def ts:MdBox (unwrap (MdSlidesTest.textBox(tl "Lähde")))
        c.eqInt("a tall chart and the line under it: one slide" tl.pageCount 1)
        c.ok("the line is under the chart" (ts.y >= (te.y + te.h)))
        c.ok("…inside the slide" ((ts.y + ts.h) <= (540.0 - 54.0 + 0.5)))
        ; …and the chart is DRAWN in its box, not only laid out in it
        def drawnH:double (tl.embeds.heightFor("vega-lite" (MdSlidesTest.fenceOf(tall)) te.w))
        c.ok(("the chart is drawn for its box: " + (to_string drawnH) + " in " + (to_string te.h)) (drawnH <= (te.h + 0.5)))
        def wide:MdLayout (MdSlidesTest.withPictures((pr.replace("{width=60%}\n" "")) css))
        def wt:MdBox (unwrap (MdSlidesTest.textBox(wide "Kapea pohja")))
        def we:MdBox (unwrap (MdSlidesTest.boxOfKind(wide 3)))
        c.ok("a full-width figure: the text under it" (wt.y >= (we.y + we.h)))
        ; a width or height asked on a slide is the size it is shown at,
        ; larger than its pixels too (the slide's handles set them)
        def cw:double (960.0 - 108.0)
        def wl:MdLayout (MdSlidesTest.withPictures("## Leveä

![Pieni](small.png)
{width=60%}
" css))
        def wp:MdBox (unwrap (MdSlidesTest.boxOfKind(wl 4)))
        c.ok(("width=60% of a 160 px picture: " + (to_string wp.w)) (((wp.w - (cw * 0.6)) * ((wp.w - (cw * 0.6)))) < 1.0))
        c.ok("its shape kept" ((((wp.h / wp.w) - (90.0 / 160.0)) * (((wp.h / wp.w) - (90.0 / 160.0)))) < 0.0001))
        def hl:MdLayout (MdSlidesTest.withPictures("## Korkea

![Pieni](small.png)
{height=50%}
" css))
        def hp:MdBox (unwrap (MdSlidesTest.boxOfKind(hl 4)))
        c.ok(("height=50% of a 90 px picture: " + (to_string hp.h)) (((hp.h - 216.0) * (hp.h - 216.0)) < 1.0))
        def xl:MdLayout (MdSlidesTest.withPictures("## Liian

![Pieni](small.png)
{width=250%}
" css))
        def xp:MdBox (unwrap (MdSlidesTest.boxOfKind(xl 4)))
        c.ok(("never wider than the column: " + (to_string xp.w)) (xp.w <= (cw + 0.5)))
    }

    ; how many text boxes say `want` on slide `p`
    sfn countOn:int (l:MdLayout want:string p:int) {
        def k:int 0
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if (((b.kind == 0) && (b.page == p)) && (b.text == want)) {
                k = (k + 1)
            }
            i = (i + 1)
        }
        return k
    }

    ; rows "r0".."r{n-1}" per slide, as "a+b+c"
    sfn rowCounts:string (l:MdLayout n:int) {
        def out:string ""
        def p:int 0
        while (p < l.pageCount) {
            def k:int 0
            def r:int 0
            while (r < n) {
                if ((MdSlidesTest.slideOf(l ("r" + (to_string r)))) == p) {
                    k = (k + 1)
                }
                r = (r + 1)
            }
            if (k > 0) {
                if ((strlen out) > 0) {
                    out = (out + "+")
                }
                out = (out + (to_string k))
            }
            p = (p + 1)
        }
        return out
    }

    sfn spread:int (counts:string) {
        def parts:[string] (strsplit counts "+")
        def lo:int 1000
        def hi:int 0
        def i:int 0
        while (i < (array_length parts)) {
            def v@(optional):int (str2int (itemAt parts i))
            def k:int (?? v 0)
            if (k < lo) { lo = k }
            if (k > hi) { hi = k }
            i = (i + 1)
        }
        return (hi - lo)
    }

    ; A table taller than its slide: the header row again at the top of each
    ; continuation, the rows spread evenly, and the title said again in the
    ; heading's own colour rather than dimmed.
    fn longTable:void (c:SlideCheck) {
        print "-- a long table --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 220pt; padding: 20pt } document { font-size: 14pt }"
        def md:string "## Data\n\nSome text above the table.\n\n| Name | Value |\n|---|--:|\n"
        def html:string "## Data\n\nSome text above the table.\n\n<table><thead><tr><th>Name</th><th>Value</th></tr></thead><tbody>\n"
        def bare:string "## Data\n\nSome text above the table.\n\n<table><tr><th>Name</th><th>Value</th></tr>\n"
        def r:int 0
        while (r < 16) {
            md = (md + "| r" + (to_string r) + " | " + (to_string (r * 10)) + " |\n")
            html = (html + "<tr><td>r" + (to_string r) + "</td><td>" + (to_string (r * 10)) + "</td></tr>\n")
            bare = (bare + "<tr><td>r" + (to_string r) + "</td><td>" + (to_string (r * 10)) + "</td></tr>\n")
            r = (r + 1)
        }
        html = (html + "</tbody></table>\n")
        bare = (bare + "</table>\n")
        ; no <thead>: a row of <th> cells is the header
        def kinds:[string] ([] _:string ("markdown" "html" "html without thead"))
        def srcs:[string] ([] _:string (md html bare))
        def k:int 0
        while (k < 3) {
            def kind:string (itemAt kinds k)
            def l:MdLayout (MdSlidesTest.asSlides((itemAt srcs k) css))
            c.ok((kind + ": the table takes more than one slide") (l.pageCount > 1))
            def missing:int 0
            def p:int 0
            while (p < l.pageCount) {
                if ((MdSlidesTest.countOn(l "Name" p)) != 1) {
                    missing = (missing + 1)
                }
                p = (p + 1)
            }
            c.eqInt((kind + ": the header row is on every slide") missing 0)
            def counts:string (MdSlidesTest.rowCounts(l 16))
            c.ok(((kind + ": rows spread evenly ") + counts) ((MdSlidesTest.spread(counts)) <= 1))
            ; the continuation title is the heading's ink
            def dim:int 0
            def i:int 0
            while (i < (array_length l.boxes)) {
                def b:MdBox (itemAt l.boxes i)
                if (((b.kind == 0) && (b.page > 0)) && (b.text == "Data")) {
                    if (b.color == l.style.mutedColor) {
                        dim = (dim + 1)
                    }
                }
                i = (i + 1)
            }
            c.eqInt((kind + ": the continuation title is not dimmed") dim 0)
            k = (k + 1)
        }
    }

    ; Text and a table that run over by the last row and the sentence after
    ; it: the slide is set a little smaller rather than given a continuation
    ; for those two.
    ; A table on a slide spans its column, or the `width` it was given with
    ; the text after it beside it; `table { font-size }` sets its text
    ; (Tero's cloud run 2026-10-06: a top-10 table filled half the slide).
    fn tableWidth:void (c:SlideCheck) {
        print "-- a table's width --"
        def css:string "deck { split-level: 2 } page { width: 960pt; height: 540pt; padding: 54pt } document { font-size: 20pt } h2 { font-size: 36pt }"
        def md:string "## Taulukko\n\n| # | Nimi |\n|---|---|\n| 1 | Lyhyt |\n| 2 | Toinen |\n"
        def l:MdLayout (MdSlidesTest.withPictures(md css))
        def right:double 0.0
        def k:int 0
        while (k < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes k)
            if ((b.y > 120.0) && ((b.x + b.w) > right)) { right = (b.x + b.w) }
            k = (k + 1)
        }
        c.ok(("a short table spans the slide's column: " + (to_string right)) (right >= (960.0 - 54.0 - 1.0)))
        def side:string (md + "{width=60%}\n\n- Huomio yksi\n- Huomio kaksi\n{container=box}\n")
        def sl:MdLayout (MdSlidesTest.withPictures(side css))
        def cell:MdBox (unwrap (MdSlidesTest.textBox(sl "Lyhyt")))
        def note:MdBox (unwrap (MdSlidesTest.textBox(sl "Huomio yksi")))
        c.ok(("a table at 60%: the list beside it: " + (to_string note.x)) ((note.x > (54.0 + ((960.0 - 108.0) * 0.6))) && (note.y < (cell.y + cell.h))))
        c.eqInt("a table at 60% and its list: one slide" sl.pageCount 1)
        ; a table at 60% too long for one slide: the list goes beside its
        ; last part, not on a slide of its own under the title in its plate
        def rows:string ""
        def r:int 0
        while (r < 16) {
            rows = (rows + "| " + (to_string r) + " | Rivi " + (to_string r) + " |\n")
            r = (r + 1)
        }
        def long:string ("## Taulukko\n\n| # | Nimi |\n|---|---|\n" + rows + "{width=60%}\n\n- Huomio yksi\n- Huomio kaksi\n{container=box}\n")
        def ll:MdLayout (MdSlidesTest.withPictures(long css))
        def lastRow:MdBox (unwrap (MdSlidesTest.textBox(ll "Rivi 15")))
        def lnote:MdBox (unwrap (MdSlidesTest.textBox(ll "Huomio yksi")))
        c.ok(("the long table goes on: " + (to_string lastRow.page)) (lastRow.page > 0))
        c.eqInt("its list is on the table's last slide" lnote.page lastRow.page)
        c.ok(("…beside it: " + (to_string lnote.x)) (lnote.x > (54.0 + ((960.0 - 108.0) * 0.6))))
        ; a boxed list that goes on to a second slide: its plate there
        ; starts under the title said again, not around it
        def items:string ""
        def r3:int 0
        while (r3 < 24) {
            items = (items + "- Kohta " + (to_string r3) + "\n")
            r3 = (r3 + 1)
        }
        def bl:MdLayout (MdSlidesTest.withPictures(("## Lista\n\n" + items + "{container=box}\n") css))
        def tail:MdBox (unwrap (MdSlidesTest.textBox(bl "Kohta 23")))
        c.ok(("the boxed list goes on: " + (to_string tail.page)) (tail.page > 0))
        def titleY:double 1000.0
        def plateY:double 1000.0
        def q:int 0
        while (q < (array_length bl.boxes)) {
            def pb:MdBox (itemAt bl.boxes q)
            if (pb.page == tail.page) {
                if (pb.retold && (pb.y < titleY)) { titleY = pb.y }
                if ((pb.kind == 1) && (pb.y < plateY)) { plateY = pb.y }
            }
            q = (q + 1)
        }
        c.ok(("…its plate there starts under the title said again: " + (to_string plateY)) ((titleY < 1000.0) && (plateY > titleY)))
        def fl:MdLayout (MdSlidesTest.withPictures(md (css + " table { font-size: 12pt }")))
        def small:MdBox (unwrap (MdSlidesTest.textBox(fl "Lyhyt")))
        c.ok(("table { font-size: 12pt } sets its text: " + (to_string small.size)) ((fabs (small.size - 12.0)) < 0.01))
        def body:MdBox (unwrap (MdSlidesTest.textBox(l "Lyhyt")))
        c.ok("…and without it the body's size" (body.size >= 20.0))
    }

    fn tableSpill:void (c:SlideCheck) {
        print "-- a table that spills a row --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 260pt; padding: 20pt } document { font-size: 14pt }"
        def head:string "## Mix\n\nA paragraph of text above the table.\n\n| Name | Value |\n|---|--:|\n"
        def n:int 1
        def body:string ""
        def spilled:boolean false
        while ((n < 30) && (spilled == false)) {
            body = ""
            def r:int 0
            while (r < n) {
                body = (body + "| r" + (to_string r) + " | " + (to_string r) + " |\n")
                r = (r + 1)
            }
            ; the table's own last row over, not just the note under it
            def off:MdLayout (MdSlidesTest.slidesWith((head + body + "\nThe closing note.\n") css 1.0))
            if ((MdSlidesTest.slideOf(off ("r" + (to_string (n - 1))))) == 1) {
                spilled = true
            }
            n = (n + 1)
        }
        c.ok("some row count spills its last row without shrinking" spilled)
        def on:MdLayout (MdSlidesTest.slidesWith((head + body + "\nThe closing note.\n\n## Next\n\nText\n") css 0.8))
        c.eqInt("with it, the table and the note stay on one slide" (MdSlidesTest.slideOf(on "The closing note.")) 0)
        c.eqInt("…its last row too" (MdSlidesTest.slideOf(on ("r" + (to_string (n - 2))))) 0)
        c.eqInt("and the next slide is the second" (MdSlidesTest.slideOf(on "Text")) 1)
        c.eqInt("one slide was shrunk" on.slidesShrunk 1)
        ; the slides after the shrunk one moved up a page, and so does a
        ; hidden title written there: it names its own slide, not the one
        ; below it
        def hidSrc:string (head + body + "\nThe closing note.\n\n## Hidden {heading=hidden}\n\nUnder it.\n\n## Last\n\nEnd.\n")
        def hid:MdLayout (MdSlidesTest.slidesWith(hidSrc css 0.8))
        c.eqInt("the slide before a hidden title is shrunk" hid.slidesShrunk 1)
        c.eqInt("what is under the hidden title is on the second slide" (MdSlidesTest.slideOf(hid "Under it.")) 1)
        c.eqInt("…and the hidden title names that slide" (hid.pageOfHidden((indexOf hidSrc "## Hidden"))) 1)
        ; a table far too long is still split, evenly
        def big:string ""
        def r2:int 0
        while (r2 < (n * 2)) {
            big = (big + "| r" + (to_string r2) + " | " + (to_string r2) + " |\n")
            r2 = (r2 + 1)
        }
        def far:MdLayout (MdSlidesTest.slidesWith((head + big) css 0.8))
        c.ok("a long table is still split" (far.pageCount > 1))
        ; a table at 60% with a card beside it, one row over: the slide set
        ; smaller keeps the card beside the table (laid out again, the card
        ; went under it, and the slide never fitted)
        def card:string "{width=60%}\n\n- A note\n- Another note\n{container=box}\n"
        def m:int 1
        def rowsW:string ""
        def over:boolean false
        while ((m < 30) && (over == false)) {
            rowsW = ""
            def r3:int 0
            while (r3 < m) {
                rowsW = (rowsW + "| r" + (to_string r3) + " | " + (to_string r3) + " |\n")
                r3 = (r3 + 1)
            }
            def off2:MdLayout (MdSlidesTest.slidesWith((head + rowsW + card) css 1.0))
            if ((MdSlidesTest.slideOf(off2 ("r" + (to_string (m - 1))))) == 1) {
                over = true
            }
            m = (m + 1)
        }
        c.ok("some row count spills a 60% table" over)
        def on2:MdLayout (MdSlidesTest.slidesWith((head + rowsW + card) css 0.8))
        c.eqInt("set smaller, the 60% table stays on one slide" (MdSlidesTest.slideOf(on2 ("r" + (to_string (m - 2))))) 0)
        c.eqInt("…its card too" (MdSlidesTest.slideOf(on2 "A note")) 0)
        def r0:MdBox (unwrap (MdSlidesTest.textBox(on2 "r0")))
        def note2:MdBox (unwrap (MdSlidesTest.textBox(on2 "A note")))
        c.ok(("…beside the table: " + (to_string note2.y)) (note2.y < (r0.y + 40.0)))
    }

    ; ----------------------------------------------------------------------
    ; Where a slide with sections breaks, and what its continuations say.
    ; A `##` slide with `###` sections under it (markdown-it's demo deck,
    ; "Plugins") overflowed with its breaks wherever the room ran out, so a
    ; continuation began with the last line of "Footnotes" and "### Definition
    ; lists" started under it; a continuation that began with a sub-heading
    ; had no title at all, the others had the slide's. And a slide of six
    ; heading lines put its sixth on a slide of its own with half the room
    ; left, because a deeper heading below the middle always broke.
    fn sections:void (c:SlideCheck) {
        print "-- sections, and what a continuation says --"
        def css:string "deck { split-level: 2 } page { width: 720pt; height: 300pt; padding: 20pt } document { font-size: 14pt }"
        ; six heading lines fit: none of them is sent on alone
        def hs:string "## h2 Heading\n### h3 Heading\n#### h4 Heading\n##### h5 Heading\n###### h6 Heading\n\n## Horizontal Rules\n\n---\n"
        def hl:MdLayout (MdSlidesTest.asSlides(hs css))
        c.eqInt("a heading that fits stays on its slide" (MdSlidesTest.slideOf(hl "h6 Heading")) 0)
        c.eqInt("…and the next title is the next slide" (MdSlidesTest.slideOf(hl "Horizontal Rules")) 1)

        ; three sections, the second too tall for the room the first leaves
        def src:string "## Plugins\n\nIntro line.\n\n### Alpha\n\nA one.\n\nA two.\n\nA three.\n\n### Beta\n\nB one.\n\nB two.\n\nB three.\n\nB four.\n\n### Gamma\n\nG one.\n\n## Next\n\nText.\n"
        def l:MdLayout (MdSlidesTest.asSlides(src css))
        def sa:int (MdSlidesTest.slideOf(l "Alpha"))
        def sb:int (MdSlidesTest.slideOf(l "Beta"))
        c.eqInt("the first section is on the title's slide" sa 0)
        c.eqInt("the section that does not fit starts the next slide" sb 1)
        c.eqInt("…whole" (MdSlidesTest.slideOf(l "B four.")) sb)
        c.eqInt("…and nothing of it was left behind" (MdSlidesTest.slideOf(l "B one.")) sb)
        c.ok("a continuation that begins with a sub-heading says the title" (MdSlidesTest.repeatedOn(l "Plugins" sb)))
        c.ok("…above the sub-heading" ((MdSlidesTest.yOnOf(l "Plugins" sb)) < (MdSlidesTest.yOf(l "Beta"))))
        c.ok("…and does not say the section before it" ((MdSlidesTest.repeatedOn(l "Alpha" sb)) == false))
        c.eqInt("no slide ends on a heading" (MdSlidesTest.slidesEndingOnAHeading(l)) 0)

        ; a section taller than any slide is cut where it runs over, and the
        ; continuation says the title and the section's heading again
        def long:string "## Plugins\n\nIntro line.\n\n### Footnotes\n\n"
        def i:int 0
        while (i < 24) {
            long = ((long + "Note ") + (to_string i)) + ".\n\n"
            i = (i + 1)
        }
        long = (long + "### Tail\n\nT one.\n\nT two.\n\nT three.\n\nT four.\n\nLast.\n")
        def ll:MdLayout (MdSlidesTest.asSlides(long css))
        c.eqInt("a section too tall for a slide stays where it starts" (MdSlidesTest.slideOf(ll "Footnotes")) 0)
        c.ok("…and is cut" (ll.pageCount > 1))
        c.ok("its continuation says the title" (MdSlidesTest.repeatedOn(ll "Plugins" 1)))
        c.ok("…and the section's heading under it" (MdSlidesTest.repeatedOn(ll "Footnotes" 1)))
        c.ok("…in that order" ((MdSlidesTest.yOnOf(ll "Plugins" 1)) < (MdSlidesTest.yOnOf(ll "Footnotes" 1))))
        c.ok("…set as the section's heading is" ((MdSlidesTest.sizeOnOf(ll "Footnotes" 1)) == (MdSlidesTest.sizeOf(ll "Footnotes"))))
        c.ok("…above the text that goes on" ((MdSlidesTest.yOnOf(ll "Footnotes" 1)) < (MdSlidesTest.firstBodyY(ll 1))))
        def tail:int (MdSlidesTest.slideOf(ll "Tail"))
        c.ok("the next section, which fits a slide, starts one" ((tail > (MdSlidesTest.slideOf(ll "Note 23."))) && ((MdSlidesTest.slideOf(ll "Last.")) == tail)))
        c.ok("a slide that begins with the next section says the title" (MdSlidesTest.repeatedOn(ll "Plugins" tail)))
        c.ok("…and not the section before it" ((MdSlidesTest.repeatedOn(ll "Footnotes" tail)) == false))
        c.eqInt("no slide ends on a heading" (MdSlidesTest.slidesEndingOnAHeading(ll)) 0)

        ; a continuation that is laid out again larger keeps its title
        def gsrc:string ("---\nslide-grow: 1.6\n---\n\n" + src)
        def gl:MdLayout (MdSlidesTest.asSlides(gsrc css))
        def gb:int (MdSlidesTest.slideOf(gl "Beta"))
        c.ok("a grown continuation keeps its title" (MdSlidesTest.repeatedOn(gl "Plugins" gb)))
    }

    ; Whether `want` was said again (no source behind it) on slide `p`.
    sfn repeatedOn:boolean (l:MdLayout want:string p:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.page == p) && (b.segSrc < 0) && (b.text == want)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }

    sfn yOnOf:double (l:MdLayout want:string p:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.page == p) && (b.text == want)) {
                return b.y
            }
            i = (i + 1)
        }
        return (0.0 - 1.0)
    }

    sfn sizeOnOf:double (l:MdLayout want:string p:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.page == p) && (b.text == want)) {
                return b.size
            }
            i = (i + 1)
        }
        return 0.0
    }

    ; The top of the first box on slide `p` that came from the source.
    sfn firstBodyY:double (l:MdLayout p:int) {
        def i:int 0
        while (i < (array_length l.boxes)) {
            def b:MdBox (itemAt l.boxes i)
            if ((b.kind == 0) && (b.page == p) && (b.segSrc >= 0)) {
                return b.y
            }
            i = (i + 1)
        }
        return (0.0 - 1.0)
    }

    fn run:void () {
        def c:SlideCheck (new SlideCheck())
        print "== MdSlidesTest =="
        this.columns(c)
        this.breaks(c)
        this.keepWithNext(c)
        this.bigTitle(c)
        this.exactFit(c)
        this.overflow(c)
        this.wholeItems(c)
        this.shrinkToFit(c)
        this.tableShrinks(c)
        this.oneDocument(c)
        this.grow(c)
        this.edges(c)
        this.pictures(c)
        this.overlays(c)
        this.longTable(c)
        this.tableSpill(c)
        this.tableWidth(c)
        this.sections(c)
        print ""
        print (("passed=" + (to_string c.passed)) + (" failed=" + (to_string c.failed)))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "FAILURES"
        }
    }
}
