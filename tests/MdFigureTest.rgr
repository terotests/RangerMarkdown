; ============================================================================
; MdFigureTest.rgr — ```process, ```swot, ```timeline, ```stats and ```cards,
; as geometry.
; ============================================================================
;
;   npm run markdown:figure:test
;
; What is checked is the scene, not the picture: the items read out of the
; fence, every shape and every line of text inside the scene's own box, the
; theme's colours on the shapes, a figure that is not allowed left undrawn
; with the host's note, and a theme change drawing the figure again.
;
; `node MdFigureTest.js <dir>` also writes each figure as SVG there, to look at.
; ============================================================================

Import "../src/MdFigure.rgr"
Import "../src/MdEmbedKinds.rgr"
Import "../src/MdDiagram.rgr"
Import "../src/MdNode.rgr"
Import "../src/MdBlock.rgr"

class FigureCheck {
    def passed:int 0
    def failed:int 0

    Constructor () {
    }

    fn ok:void (name:string cond:boolean) {
        if cond {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
        }
    }

    fn eqStr:void (name:string got:string want:string) {
        if (got == want) {
            passed = (passed + 1)
        } {
            failed = (failed + 1)
            print ("  FAIL " + name)
            print ("    got  [" + (got + "]"))
            print ("    want [" + (want + "]"))
        }
    }

    ; every item inside the scene, and how many of each kind
    fn inside:void (name:string sc:FlowScene) {
        def bad:int 0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 0) || (s.kind == 1)) {
                if ((s.x < -0.5) || ((s.x + s.w) > (sc.worldW + 0.5))) {
                    bad = (bad + 1)
                }
                if ((s.y < -0.5) || ((s.y + s.h) > (sc.worldH + 0.5))) {
                    bad = (bad + 1)
                }
            }
            if (s.kind == 2) {
                def k:int 0
                while (k < (array_length s.pts)) {
                    def px:double (itemAt s.pts k)
                    def py:double (itemAt s.pts (k + 1))
                    if ((px < -0.5) || (px > (sc.worldW + 0.5))) {
                        bad = (bad + 1)
                    }
                    if ((py < -0.5) || (py > (sc.worldH + 0.5))) {
                        bad = (bad + 1)
                    }
                    k = (k + 2)
                }
            }
            i = (i + 1)
        }
        if (bad > 0) {
            print ("    " + name + ": " + (to_string bad) + " coordinate(s) outside " + (to_string sc.worldW) + "x" + (to_string sc.worldH))
        }
        this.ok((name + ": everything inside the scene") (bad == 0))
    }

    ; No text item cut ("…") or drawn over another: each line's ink box
    ; from its measured width and its alignment in its column.
    fn textsClear:void (name:string sc:FlowScene) {
        def v (new FlowView)
        def xs:[double]
        def ws:[double]
        def ys:[double]
        def hs:[double]
        def cut:int 0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 1) && ((strlen s.text) > 0)) {
                if ((indexOf s.text "…") >= 0) {
                    cut = (cut + 1)
                }
                def mw:double (v.textWidthBold(s.text s.fontSize s.bold))
                def x0:double s.x
                if (s.align == "center") {
                    x0 = (s.x + ((s.w - mw) * 0.5))
                }
                if (s.align == "right") {
                    x0 = ((s.x + s.w) - mw)
                }
                push xs x0
                push ws mw
                push ys s.y
                push hs (s.fontSize * 1.2)
            }
            i = (i + 1)
        }
        def hits:int 0
        def a:int 0
        while (a < (array_length xs)) {
            def b:int (a + 1)
            while (b < (array_length xs)) {
                def ox:boolean (((itemAt xs a) < (((itemAt xs b) + (itemAt ws b)) - 0.5)) && ((itemAt xs b) < (((itemAt xs a) + (itemAt ws a)) - 0.5)))
                def oy:boolean (((itemAt ys a) < (((itemAt ys b) + (itemAt hs b)) - 0.5)) && ((itemAt ys b) < (((itemAt ys a) + (itemAt hs a)) - 0.5)))
                if (ox && oy) {
                    hits = (hits + 1)
                }
                b = (b + 1)
            }
            a = (a + 1)
        }
        this.ok((name + ": no text cut (" + (to_string cut) + ") or over another (" + (to_string hits) + ")") ((cut == 0) && (hits == 0)))
    }

    ; the top edge of every polygon (chevron), in order
    fn polyTops:[double] (sc:FlowScene) {
        def out:[double]
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if (s.kind == 2) {
                push out (itemAt s.pts 1)
            }
            i = (i + 1)
        }
        return out
    }

    ; the largest bold text
    fn titleSize:double (sc:FlowScene) {
        def most:double 0.0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 1) && s.bold && (s.fontSize > most)) {
                most = s.fontSize
            }
            i = (i + 1)
        }
        return most
    }

    fn widestPoly:double (sc:FlowScene) {
        def most:double 0.0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if (s.kind == 2) {
                def lo:double 100000.0
                def hi:double -100000.0
                def k:int 0
                while (k < (array_length s.pts)) {
                    def px:double (itemAt s.pts k)
                    if (px < lo) {
                        lo = px
                    }
                    if (px > hi) {
                        hi = px
                    }
                    k = (k + 2)
                }
                if ((hi - lo) > most) {
                    most = (hi - lo)
                }
            }
            i = (i + 1)
        }
        return most
    }

    fn count:int (sc:FlowScene kind:int) {
        def n:int 0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if (s.kind == kind) {
                n = (n + 1)
            }
            i = (i + 1)
        }
        return n
    }

    fn texts:string (sc:FlowScene) {
        def out:string ""
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if (s.kind == 1) {
                out = (out + s.text + "|")
            }
            i = (i + 1)
        }
        return out
    }

    ; the largest minus the smallest size of the plain (not bold) text
    fn plainSpread:double (sc:FlowScene) {
        def lo:double 9999.0
        def hi:double 0.0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 1) && (s.bold == false)) {
                if (s.fontSize < lo) {
                    lo = s.fontSize
                }
                if (s.fontSize > hi) {
                    hi = s.fontSize
                }
            }
            i = (i + 1)
        }
        if (hi <= 0.0) {
            return 0.0
        }
        return (hi - lo)
    }

    ; the lowest WCAG ratio of any text over the last rectangle under its
    ; middle drawn before it (the paper where there is none), as a share of
    ; what it needs: 4.5:1, large text (24, or 18.66 bold) 3:1; 1 = enough
    fn lowestContrast:double (sc:FlowScene paper:string) {
        def low:double 99.0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 1) && ((strlen (trim s.text)) > 0)) {
                def px:double (s.x + (s.fontSize * 0.4))
                if (s.align == "center") {
                    px = (s.x + (s.w * 0.5))
                }
                def py:double (s.y + (s.fontSize * 0.6))
                def under:string paper
                def k:int 0
                while (k < i) {
                    def r:SceneItem (itemAt sc.items k)
                    if ((r.kind == 0) && ((((px >= r.x) && (px <= (r.x + r.w))) && (py >= r.y)) && (py <= (r.y + r.h)))) {
                        under = r.fill
                    }
                    k = (k + 1)
                }
                def need:double 4.5
                if ((s.fontSize >= 24.0) || (s.bold && (s.fontSize >= 18.66))) {
                    need = 3.0
                }
                def q:double ((MdFigure.ratio(s.fill under)) / need)
                if (q < low) {
                    low = q
                }
            }
            i = (i + 1)
        }
        return low
    }

    ; the lowest WCAG ratio of any text over what is under it, as is (no
    ; allowance for large text)
    ; How many filled shapes of the art cover the point (x, y): polygons by
    ; their bounding box, dots by theirs.
    fn artAt:int (sc:FlowScene x:double y:double) {
        def n:int 0
        for sc.items s:SceneItem i {
            if ((s.kind == 0) && ((((x >= s.x) && (x <= (s.x + s.w))) && (y >= s.y)) && (y <= (s.y + s.h)))) {
                n = (n + 1)
            }
            if ((s.kind == 2) && ((strlen s.fill) > 0)) {
                ; a ray to the right crosses the outline an odd number of times
                def inside:boolean false
                def m:int (idiv (array_length s.pts) 2)
                def k:int 0
                while (k < m) {
                    def q:int (k - 1)
                    if (q < 0) {
                        q = (m - 1)
                    }
                    def ax:double (itemAt s.pts (k * 2))
                    def ay:double (itemAt s.pts ((k * 2) + 1))
                    def bx:double (itemAt s.pts (q * 2))
                    def by:double (itemAt s.pts ((q * 2) + 1))
                    if ((ay > y) != (by > y)) {
                        def cx:double (ax + (((y - ay) * (bx - ax)) / (by - ay)))
                        if (x < cx) {
                            inside = (inside == false)
                        }
                    }
                    k = (k + 1)
                }
                if inside {
                    n = (n + 1)
                }
            }
        }
        return n
    }

    fn lowestRatio:double (sc:FlowScene paper:string) {
        def low:double 99.0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 1) && ((strlen (trim s.text)) > 0)) {
                def px:double (s.x + (s.fontSize * 0.4))
                if (s.align == "center") {
                    px = (s.x + (s.w * 0.5))
                }
                def py:double (s.y + (s.fontSize * 0.6))
                def under:string paper
                def k:int 0
                while (k < i) {
                    def r:SceneItem (itemAt sc.items k)
                    if ((r.kind == 0) && ((((px >= r.x) && (px <= (r.x + r.w))) && (py >= r.y)) && (py <= (r.y + r.h)))) {
                        under = r.fill
                    }
                    k = (k + 1)
                }
                def q:double (MdFigure.ratio(s.fill under))
                if (q < low) {
                    low = q
                }
            }
            i = (i + 1)
        }
        return low
    }

    ; the round badges (a square rectangle rounded to a circle), in order
    fn badges:[SceneItem] (sc:FlowScene) {
        def out:[SceneItem]
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if (((s.kind == 0) && (s.w > 0.0)) && (((fabs (s.w - s.h)) < 0.01) && (s.radius >= ((s.w * 0.5) - 0.01)))) {
                push out s
            }
            i = (i + 1)
        }
        return out
    }

    ; the cards: rounded rectangles that are not badges, in order
    fn cardsOf:[SceneItem] (sc:FlowScene) {
        def out:[SceneItem]
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if (((s.kind == 0) && (s.radius > 0.0)) && (s.radius < ((s.w * 0.5) - 0.01))) {
                push out s
            }
            i = (i + 1)
        }
        return out
    }

    ; every line of text inside the box it was given (measured, at its
    ; alignment), and inside a card when it starts in one
    fn textsFit:void (name:string sc:FlowScene) {
        def v (new FlowView)
        def over:int 0
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((s.kind == 1) && ((strlen s.text) > 0)) {
                def mw:double (v.textWidthBold(s.text s.fontSize s.bold))
                if (mw > (s.w + 0.5)) {
                    over = (over + 1)
                    print ("    " + name + ": [" + s.text + "] " + (to_string mw) + " > " + (to_string s.w))
                }
                def k:int 0
                while (k < i) {
                    def r:SceneItem (itemAt sc.items k)
                    if ((r.kind == 0) && ((r.radius > 0.0) && (r.radius < ((r.w * 0.5) - 0.01)))) {
                        if ((((s.x >= r.x) && (s.x < (r.x + r.w))) && (s.y >= r.y)) && (s.y < (r.y + r.h))) {
                            if (((s.x + mw) > ((r.x + r.w) + 0.5)) || ((s.y + (s.fontSize * 1.2)) > ((r.y + r.h) + 0.5))) {
                                over = (over + 1)
                                print ("    " + name + ": [" + s.text + "] out of its card")
                            }
                        }
                    }
                    k = (k + 1)
                }
            }
            i = (i + 1)
        }
        this.ok((name + ": every text inside its box (" + (to_string over) + " over)") (over == 0))
    }

    fn hasFill:boolean (sc:FlowScene fill:string) {
        def i:int 0
        while (i < (array_length sc.items)) {
            def s:SceneItem (itemAt sc.items i)
            if ((to_lowercase s.fill) == (to_lowercase fill)) {
                return true
            }
            i = (i + 1)
        }
        return false
    }
}

class MdFigureTest {
    sfn main:void () {
        def c (new FigureCheck())
        def outDir:string ""
        if ((shell_arg_cnt) > 0) {
            outDir = (shell_arg 0)
        }

        ; --- the table
        c.eqStr("process is a figure" (MdEmbedKinds.notationOf("process")) "figure")
        c.eqStr("swot is a figure" (MdEmbedKinds.notationOf("swot")) "figure")
        c.eqStr("timeline is a figure" (MdEmbedKinds.notationOf("timeline")) "figure")
        c.ok("a figure is a drawing" (MdEmbedKinds.isDrawing("swot")))

        ; --- items
        def its:[MdFigureItem] (MdFigure.items("- Plan: goals and schedule\n  - kick-off\n  - budget\n- Build\n  code and tests\n3. Ship: at 12:30 sharp\n"))
        c.ok("three items" ((array_length its) == 3))
        if ((array_length its) == 3) {
            def a:MdFigureItem (itemAt its 0)
            c.eqStr("title" a.title "Plan")
            c.eqStr("body" a.body "goals and schedule")
            c.ok("two bullets" ((array_length a.bullets) == 2))
            c.eqStr("text" (a.text()) "goals and schedule\n• kick-off\n• budget")
            def b:MdFigureItem (itemAt its 1)
            c.eqStr("indented line continues" b.body "code and tests")
            def d:MdFigureItem (itemAt its 2)
            c.eqStr("numbered" d.title "Ship")
            c.eqStr("12:30 stays" d.body "at 12:30 sharp")
        }
        def plain:[MdFigureItem] (MdFigure.items("Strengths:\nWeaknesses: few\n"))
        c.ok("a title alone" (((array_length plain) == 2) && ((itemAt plain 0).title == "Strengths")))

        def st (new MdFigureStyle)
        def cols:[string] ([] _:string ("#ff6600" "#0066cc"))
        st.colors = cols
        st.paper = "#ffffff"
        st.ink = "#222222"

        ; --- process
        def p:FlowScene (MdFigure.sceneOf("process" "- Plan: goals and the schedule for the whole year\n- Build: code and tests\n- Test\n- Ship: in use" st 960.0 10.0))
        c.ok("process: as wide as asked" (p.worldW == 960.0))
        c.ok("process: has height" (p.worldH > 80.0))
        c.ok("process: four chevrons" ((c.count(p 2)) == 4))
        c.ok("process: titles and descriptions" ((indexOf (c.texts(p)) "Plan|") >= 0))
        c.ok("process: last step in the theme colour" (c.hasFill(p "#ff6600")))
        c.inside("process" p)
        def p2:FlowScene (MdFigure.sceneOf("process" "- A\n- B\n- C" st 960.0 10.0))
        c.ok("process: no descriptions, no room under" (p2.worldH < p.worldH))

        ; --- swot
        def s:FlowScene (MdFigure.sceneOf("swot" "Vahvuudet: vahva brändi\n  - kokenut tiimi\nHeikkoudet: pieni tiimi\nMahdollisuudet: uudet markkinat\nUhat: kilpailijat" st 960.0 10.0))
        c.ok("swot: has height" (s.worldH > 100.0))
        def tx:string (c.texts(s))
        c.ok("swot: Finnish letters" (((indexOf tx "V|") >= 0) && ((indexOf tx "U|") >= 0)))
        c.ok("swot: colours by quadrant" ((c.hasFill(s "#ff6600")) && (c.hasFill(s "#0066cc"))))
        c.inside("swot" s)

        ; --- stats: key figures, one card each, the number large
        def ks:FlowScene (MdFigure.sceneOf("stats" "- 91: asiakasta\n- 50 292: transaktiot yhteensä\n- 552,66: keskiarvo / asiakas" st 960.0 10.0))
        c.ok("stats is a figure" ((MdEmbedKinds.notationOf("stats")) == "figure"))
        c.ok("stats: has height" (ks.worldH > 60.0))
        def kt:string (c.texts(ks))
        c.ok("stats: numbers and labels" (((indexOf kt "50 292|") >= 0) && ((indexOf kt "asiakasta|") >= 0)))
        c.inside("stats" ks)
        ; white cards with a soft shadow (`cardFill`, `cardShadow`): the
        ; cards take the fill, three fainter layers lie under each
        def wst:MdFigureStyle (st.sized(st.size))
        wst.cardFill = "#ffffff"
        wst.cardShadow = "#2e3a63"
        def wk:FlowScene (MdFigure.sceneOf("stats" "- 91: asiakasta\n- 21: maata\n- 69: kaupunkia" wst 960.0 10.0))
        c.ok("stats: white cards" (c.hasFill(wk "#ffffff")))
        def shadowLayers:int 0
        for wk.items si:SceneItem sii {
            if ((indexOf si.fill "rgba(46,58,99,") == 0) {
                shadowLayers = (shadowLayers + 1)
            }
        }
        c.ok(("stats: three shadow layers under each card, got " + shadowLayers) (shadowLayers == 9))
        def wc:FlowScene (MdFigure.sceneOf("cards" "- Suojaa: 23 asiakasta\n- Kasvata: 49 asiakasta" wst 960.0 10.0))
        c.ok("cards: white cards" (c.hasFill(wc "#ffffff")))
        ; a dark theme's light text on white cards (`figure { card-background:
        ; #fff }` under a page of #101a2e): every text on a card turns dark
        ; rather than staying light on white
        def dst:MdFigureStyle (st.sized(st.size))
        dst.cardFill = "#ffffff"
        dst.ink = "#f0f4ff"
        dst.muted = "#f0f4ff"
        dst.paper = "#101a2e"
        dst.colors = ([] _:string ("#ff3d7f" "#ff9f43" "#7ee0ff"))
        for ([] _:string ("cards" "stats" "swot" "timeline")) dk:string dki {
            def dtext:string "- Yksi: valkoinen kortti\n- Kaksi: varjolla\n- Kolme: figure colors\n- Neljä: neljäs"
            if (dk == "timeline") {
                dtext = "2023: Founded\n2024: First\n2025: Abroad"
            }
            def dsc:FlowScene (MdFigure.sceneOf(dk dtext dst 960.0 10.0))
            def dlow:double (c.lowestRatio(dsc dst.paper))
            c.ok((dk + ": light ink on white cards turns dark, lowest " + (to_string dlow)) (dlow >= 4.4))
        }
        ; five figures: three to a row, two rows
        def k5:FlowScene (MdFigure.sceneOf("stats" "- 1: a\n- 2: b\n- 3: c\n- 4: d\n- 5: e" st 960.0 10.0))
        c.ok("stats: five go on two rows" (k5.worldH > (ks.worldH * 1.6)))
        c.inside("stats five" k5)

        ; --- timeline
        def t:FlowScene (MdFigure.sceneOf("timeline" "2023: Founded\n2024: First product in the hands of customers\n2025\n2026: Abroad" st 960.0 10.0))
        c.ok("timeline: has height" (t.worldH > 60.0))
        c.ok("timeline: years" ((indexOf (c.texts(t)) "2024|") >= 0))
        c.inside("timeline" t)
        def narrow:FlowScene (MdFigure.sceneOf("timeline" "2023: Founded with a long description that wraps\n2024: First" st 300.0 10.0))
        c.inside("timeline narrow" narrow)

        ; --- fitted to a slide's room
        def small:FlowScene (MdFigure.sceneOf("swot" "A: a\nB: b\nC: c\nD: d" st 960.0 10.0))
        def fit:FlowScene (MdFigure.sceneFit("swot" "A: a\nB: b\nC: c\nD: d" st 960.0 10.0 500.0))
        c.ok("fit: the grid fills the room" ((fit.worldH > (small.worldH + 50.0)) && (fit.worldH <= 426.0)))
        def pf:FlowScene (MdFigure.sceneFit("process" "- A: a\n- B: b" st 960.0 10.0 500.0))
        def p0:FlowScene (MdFigure.sceneOf("process" "- A: a\n- B: b" st 960.0 10.0))
        c.ok("fit: steps set larger" ((pf.worldH > p0.worldH) && (pf.worldH <= 425.0)))
        ; a slide's room (Tero's test deck: 852 wide, 312 high) is filled,
        ; not left as a strip at the top
        def tlText:string "- 2024: Ranger-kääntäjä ja EVG\n- 2025: Ensimmäinen Sliqtly-versio\n- 2026 kevät: MCP-palvelin\n- 2026 syksy: SmartArt ja yrityspalvelin"
        def tf:FlowScene (MdFigure.sceneFit("timeline" tlText st 852.0 10.0 312.0))
        c.ok(("fit: the timeline takes its room: " + (to_string tf.worldH)) (tf.worldH >= ((312.0 * 0.85) - 1.0)))
        c.inside("timeline fitted" tf)
        c.ok(("timeline: every description one size: " + (to_string (c.plainSpread(tf)))) ((c.plainSpread(tf)) < 0.01))
        def t0:FlowScene (MdFigure.sceneOf("timeline" tlText st 852.0 10.0))
        c.ok("timeline unfitted: every description one size" ((c.plainSpread(t0)) < 0.01))
        def prText:string "- Suunnittele: tavoitteet ja aikataulu\n- Rakenna: koodi ja sisältö\n- Testaa: asettelu ja data\n- Julkaise: linkki jakoon"
        def pr:FlowScene (MdFigure.sceneFit("process" prText st 852.0 10.0 312.0))
        c.ok(("fit: the steps take their room: " + (to_string pr.worldH)) (pr.worldH >= ((312.0 * 0.85) - 1.0)))
        c.inside("process fitted" pr)
        ; every text reads over what is under it (WCAG), in a dark
        ; theme and a light one, with Tero's colours and aurora's: a swot's
        ; letters on their discs, its titles on their cards, a timeline's
        ; years on the page
        def swText:string "- Vahvuudet: tekstipohjainen\n- Heikkoudet: pieni käyttäjäkunta\n- Mahdollisuudet: yrityskäyttö\n- Uhat: isot toimijat"
        def palettes:[string] ([] _:string ("#e63946 #2a9d8f #e9c46a #8d5cf6" "#B96926 #59C3C4 #A321D9 #59C339 #C2291B #C6C640 #4949FF"))
        def papers:[string] ([] _:string ("#0b1030" "#ffffff"))
        def inks:[string] ([] _:string ("#e8ecff" "#16202c"))
        def pi:int 0
        while (pi < 2) {
            def qi:int 0
            while (qi < 2) {
                def cs (new MdFigureStyle)
                def cols:[string] (strsplit (itemAt palettes pi) " ")
                cs.colors = cols
                cs.paper = (itemAt papers qi)
                cs.ink = (itemAt inks qi)
                def tag:string ((itemAt palettes pi) + " on " + cs.paper)
                def sw:FlowScene (MdFigure.sceneOf("swot" swText cs 852.0 10.0))
                c.ok(("swot reads, " + tag + ": " + (to_string (c.lowestContrast(sw cs.paper)))) ((c.lowestContrast(sw cs.paper)) >= 1.0))
                def tli:FlowScene (MdFigure.sceneOf("timeline" tlText cs 852.0 10.0))
                c.ok(("timeline reads, " + tag + ": " + (to_string (c.lowestContrast(tli cs.paper)))) ((c.lowestContrast(tli cs.paper)) >= 1.0))
                qi = (qi + 1)
            }
            pi = (pi + 1)
        }
        def none0:FlowScene (MdFigure.sceneFit("process" "- A: a" st 960.0 10.0 0.0))
        c.ok("fit: no room given, as asked" (none0.worldH == (MdFigure.sceneOf("process" "- A: a" st 960.0 10.0)).worldH))

        ; --- a portrait slide (Tero's deck: six steps, long words): too
        ; narrow for a strip, so the steps go down the room
        def upText:string "- UI: excavator-ui, IPC Share\n- MAS: MachineApplicationService, Project\n- Upload: SharePublisher, MQTT + S3 PUT\n- Manage: pilvikatalogi\n- Download: ShareReceiver, import Project DB\n- Republish: ShareReceiver -> MAS, listat + 3D"
        def upIts:[MdFigureItem] (MdFigure.items(upText))
        c.ok("portrait process goes down" (MdFigure.stacks("process" upIts st 460.0 10.0)))
        def pd:FlowScene (MdFigure.sceneFit("process" upText st 460.0 10.0 700.0))
        def pdTops:[double] (c.polyTops(pd))
        c.ok("portrait process: six chevrons, each under the last" (((array_length pdTops) == 6) && ((itemAt pdTops 5) > (itemAt pdTops 4)) && ((itemAt pdTops 1) > (itemAt pdTops 0))))
        c.ok(("portrait process: within its room: " + (to_string pd.worldH)) (pd.worldH <= 700.0))
        c.inside("portrait process" pd)
        c.textsClear("portrait process" pd)
        c.ok(("portrait process: titles at full size: " + (to_string (c.titleSize(pd)))) ((c.titleSize(pd)) >= st.size))
        ; the strip it would have been cut titles and ran descriptions
        ; into each other
        def across (st.sized(st.size))
        across.stack = 1
        def pa:FlowScene (MdFigure.sceneOf("process" upText across 460.0 10.0))
        c.ok("forced across: the same steps are cramped" across.cramped)
        ; a landscape slide keeps the strip
        c.ok("landscape process stays across" ((MdFigure.stacks("process" (MdFigure.items(prText)) st 852.0 10.0)) == false))
        c.ok("three short steps in portrait stay across" ((MdFigure.stacks("process" (MdFigure.items("- Plan\n- Build\n- Ship")) st 460.0 10.0)) == false))
        c.textsClear("landscape process" pr)
        ; without descriptions the chevrons take the whole width
        def forced (st.sized(st.size))
        forced.stack = 2
        def pn:FlowScene (MdFigure.sceneOf("process" "- A\n- B\n- C" forced 460.0 10.0))
        c.ok("down, titles only: chevrons the whole width" ((c.widestPoly(pn)) >= 439.0))
        ; the timeline the same way
        def tlLong:string "- 2019: Founded in a garage\n- 2020: First customer\n- 2021: MachineApplicationService\n- 2022: Series A\n- 2023: Abroad\n- 2024: 10 000 users"
        c.ok("portrait timeline goes down" (MdFigure.stacks("timeline" (MdFigure.items(tlLong)) st 460.0 10.0)))
        def td:FlowScene (MdFigure.sceneFit("timeline" tlLong st 460.0 10.0 700.0))
        c.inside("portrait timeline" td)
        c.textsClear("portrait timeline" td)
        c.ok("landscape timeline stays across" ((MdFigure.stacks("timeline" (MdFigure.items(tlText)) st 852.0 10.0)) == false))
        c.textsClear("landscape timeline" tf)

        ; --- the badge model (```timeline, ```cards)
        c.eqStr("cards is a figure" (MdEmbedKinds.notationOf("cards")) "figure")
        c.ok("cards: a fence word" ((indexOf (MdFigure.kinds()) "cards") >= 0))
        def bq:[MdFigureItem] (MdFigure.items("- Q1 Avainasiakkaat: Nimetty vastuuhenkilö\n- Q2: Kasvuohjelma: Lisämyyntikampanja\n- 2023: Founded\n- Kickoff: team named\n- 2026 kevät: MCP-palvelin\n- Vaihe 1: alku\n- 2024\n  - a point"))
        def lbl:string ""
        def ttl:string ""
        def txt:string ""
        def bi:int 0
        while (bi < (array_length bq)) {
            def it:MdFigureItem (itemAt bq bi)
            lbl = (lbl + (MdFigure.stepLabel(it bi)) + "|")
            ttl = (ttl + (MdFigure.stepTitle(it)) + "|")
            txt = (txt + (MdFigure.stepText(it)) + "|")
            bi = (bi + 1)
        }
        c.eqStr("badge: the title's short token, else the number" lbl "Q1|Q2|2023|4|2026|6|2024|")
        c.eqStr("badge: the card's title without the token" ttl "Avainasiakkaat|Kasvuohjelma|Founded|Kickoff|kevät|Vaihe 1||")
        c.eqStr("badge: the card's text" txt "Nimetty vastuuhenkilö|Lisämyyntikampanja||team named|MCP-palvelin|alku|• a point|")
        c.ok("token: Q1, 2027, v2" (((MdFigure.isToken("Q1")) && (MdFigure.isToken("2027"))) && (MdFigure.isToken("v2"))))
        c.ok("token: not a word, not a long one" (((MdFigure.isToken("Vaihe")) == false) && ((MdFigure.isToken("2026-2027")) == false)))
        ; a badge's letters read on it: a mid-tone gold reaches 4.5 only
        ; when the fill is taken a little darker
        def golds:[string] ([] _:string ("#c4943a" "#e9c46a" "#8b2240" "#2a9d8f" "#59C3C4" "#C6C640" "#4949FF" "#777777" "#ff6600"))
        def gi:int 0
        def worstDisc:double 99.0
        while (gi < (array_length golds)) {
            def f:string (MdFigure.discFill((itemAt golds gi)))
            def q:double (MdFigure.ratio((MdFigure.onColor(f)) f))
            if (q < worstDisc) {
                worstDisc = q
            }
            gi = (gi + 1)
        }
        c.ok(("badge fill: its letters 4.5 off it: " + (to_string worstDisc)) (worstDisc >= 4.5))
        c.eqStr("badge fill: a colour that reads already stays" (MdFigure.discFill("#8b2240")) "#8b2240")
        c.ok("cards to a row: three of three, four of four, three of five, four of eight" ((((MdFigure.cardColsWanted(3)) == 3) && ((MdFigure.cardColsWanted(4)) == 4)) && (((MdFigure.cardColsWanted(5)) == 3) && ((MdFigure.cardColsWanted(8)) == 4))))

        ; --- cards: Tero's three recommendations (wine, gold), 16:9 and
        ; portrait
        def wine (new MdFigureStyle)
        def wc:[string] ([] _:string ("#8b2240" "#c4943a"))
        wine.colors = wc
        wine.paper = "#f8f4ee"
        wine.ink = "#2b2b2b"
        wine.muted = "#8a8077"
        wine.titleFont = "Georgia"
        def recText:string "- Käynnistä avainasiakasohjelma: 23 asiakasta ≥ 800 tuo 41 % summasta – nimetty vastuuhenkilö Q1:llä.\n- Kasvata keskikokoisia asiakkaita: 49 asiakasta luokissa 300–799: lisämyyntiohjelma Q2:lla.\n- Panosta kolmeen kohdemarkkinaan: USA, Iso-Britannia ja Brasilia tuovat 34 % summasta – kumppanit Q3:lla."
        def cd:FlowScene (MdFigure.sceneFit("cards" recText wine 852.0 10.0 312.0))
        def cdB:[SceneItem] (c.badges(cd))
        def cdC:[SceneItem] (c.cardsOf(cd))
        c.ok(("cards: three badges, three cards: " + (to_string (array_length cdB)) + " " + (to_string (array_length cdC))) (((array_length cdB) == 3) && ((array_length cdC) == 3)))
        c.ok("cards: numbered 1 2 3" ((((indexOf (c.texts(cd)) "1|") >= 0) && ((indexOf (c.texts(cd)) "2|") >= 0)) && ((indexOf (c.texts(cd)) "3|") >= 0)))
        if (((array_length cdB) == 3) && ((array_length cdC) == 3)) {
            def b0:SceneItem (itemAt cdB 0)
            def b1:SceneItem (itemAt cdB 1)
            def b2:SceneItem (itemAt cdB 2)
            c.ok("cards: badges alternate (wine, gold, wine)" ((b0.fill == b2.fill) && (b0.fill != b1.fill)))
            def k0:SceneItem (itemAt cdC 0)
            def k1:SceneItem (itemAt cdC 1)
            def k2:SceneItem (itemAt cdC 2)
            c.ok("cards: tints alternate" ((k0.fill == k2.fill) && (k0.fill != k1.fill)))
            c.ok("cards: one row, one height" ((((fabs (k0.y - k2.y)) < 0.01) && ((fabs (k0.h - k1.h)) < 0.01)) && (k1.x > k0.x)))
            c.ok("cards: the badge at the card's top left" (((b0.x > k0.x) && (b0.y > k0.y)) && ((b0.x + b0.w) < (k0.x + (k0.w * 0.5)))))
        }
        c.ok(("cards: take the slide's room: " + (to_string cd.worldH)) (cd.worldH >= ((312.0 * 0.85) - 1.0)))
        c.inside("cards 16:9" cd)
        c.textsClear("cards 16:9" cd)
        c.textsFit("cards 16:9" cd)
        c.ok(("cards: every text 4.5 off what is under it: " + (to_string (c.lowestRatio(cd wine.paper)))) ((c.lowestRatio(cd wine.paper)) >= 4.5))
        c.ok("cards: three across on 16:9" ((MdFigure.cardCols((MdFigure.items(recText)) wine 852.0 10.0)) == 3))
        def cp:FlowScene (MdFigure.sceneFit("cards" recText wine 460.0 10.0 700.0))
        c.ok(("cards: fewer to a row in portrait: " + (to_string (MdFigure.cardCols((MdFigure.items(recText)) wine 460.0 10.0)))) ((MdFigure.cardCols((MdFigure.items(recText)) wine 460.0 10.0)) < 3))
        c.ok(("cards portrait: three badges: " + (to_string (array_length (c.badges(cp))))) ((array_length (c.badges(cp))) == 3))
        c.ok(("cards portrait: within its room: " + (to_string cp.worldH)) (cp.worldH <= 700.0))
        c.inside("cards portrait" cp)
        c.textsClear("cards portrait" cp)
        c.textsFit("cards portrait" cp)
        c.ok(("cards portrait: contrast " + (to_string (c.lowestRatio(cp wine.paper)))) ((c.lowestRatio(cp wine.paper)) >= 4.5))
        ; seven cards: two rows (four and a centred three)
        def c7:FlowScene (MdFigure.sceneOf("cards" "- A: a\n- B: b\n- C: c\n- D: d\n- E: e\n- F: f\n- G: g" wine 960.0 10.0))
        def c7C:[SceneItem] (c.cardsOf(c7))
        c.ok("cards: seven on two rows" (((array_length c7C) == 7) && ((itemAt c7C 4).y > ((itemAt c7C 0).y + 1.0))))
        c.inside("cards seven" c7)
        ; a host that stacks: one to a row, the badge beside the text
        def cst (wine.sized(wine.size))
        cst.stack = 2
        def c1:FlowScene (MdFigure.sceneOf("cards" recText cst 460.0 10.0))
        def c1B:[SceneItem] (c.badges(c1))
        def c1C:[SceneItem] (c.cardsOf(c1))
        c.ok("cards stacked: one to a row" (((array_length c1C) == 3) && ((itemAt c1C 1).y > ((itemAt c1C 0).y + (itemAt c1C 0).h))))
        c.inside("cards stacked" c1)
        c.textsClear("cards stacked" c1)
        c.textsFit("cards stacked" c1)
        ; the palettes and papers the other figures are read in
        def cpi:int 0
        while (cpi < 2) {
            def cqi:int 0
            while (cqi < 2) {
                def cs2 (new MdFigureStyle)
                def cols2:[string] (strsplit (itemAt palettes cpi) " ")
                cs2.colors = cols2
                cs2.paper = (itemAt papers cqi)
                cs2.ink = (itemAt inks cqi)
                def tag2:string ((itemAt palettes cpi) + " on " + cs2.paper)
                def cc:FlowScene (MdFigure.sceneOf("cards" recText cs2 852.0 10.0))
                c.ok(("cards read, " + tag2 + ": " + (to_string (c.lowestRatio(cc cs2.paper)))) ((c.lowestRatio(cc cs2.paper)) >= 4.5))
                def tc:FlowScene (MdFigure.sceneOf("timeline" tlText cs2 852.0 10.0))
                c.ok(("timeline reads 4.5, " + tag2 + ": " + (to_string (c.lowestRatio(tc cs2.paper)))) ((c.lowestRatio(tc cs2.paper)) >= 4.5))
                cqi = (cqi + 1)
            }
            cpi = (cpi + 1)
        }

        ; --- timeline across: a line, a badge per item on it, a card under
        ; each (Tero's quarters)
        def qText:string "- Q1 Avainasiakkaat: Nimetty vastuuhenkilö kaikille 23 asiakkaalle, joiden summa ≥ 800.\n- Q2 Kasvuohjelma: Lisämyyntikampanja 49 asiakkaalle luokissa 300–799.\n- Q3 Kohdemarkkinat: Myyntikumppani ja kampanja kohdemarkkinoille: USA, Iso-Britannia ja Brasilia.\n- Q4 Maaportfolio: Pienten maiden (3 yhden asiakkaan maata) jatko ja budjetti 2028."
        def qt:FlowScene (MdFigure.sceneFit("timeline" qText wine 852.0 10.0 312.0))
        def qB:[SceneItem] (c.badges(qt))
        def qC:[SceneItem] (c.cardsOf(qt))
        c.ok(("timeline: four badges, four cards: " + (to_string (array_length qB)) + " " + (to_string (array_length qC))) (((array_length qB) == 4) && ((array_length qC) == 4)))
        def qx:string (c.texts(qt))
        c.ok("timeline: badges Q1..Q4, titles without them" ((((indexOf qx "Q1|") >= 0) && ((indexOf qx "Q4|") >= 0)) && ((indexOf qx "Avainasiakkaat|") >= 0)))
        c.ok("timeline: one line across" ((c.count(qt 2)) == 1))
        if (((array_length qB) == 4) && ((array_length qC) == 4)) {
            def q0:SceneItem (itemAt qB 0)
            def q1:SceneItem (itemAt qB 1)
            def q2:SceneItem (itemAt qB 2)
            def q3:SceneItem (itemAt qB 3)
            c.ok("timeline: badges alternate" (((q0.fill == q2.fill) && (q1.fill == q3.fill)) && (q0.fill != q1.fill)))
            c.ok("timeline: badges on one line, evenly spaced" (((fabs (q0.y - q3.y)) < 0.01) && ((fabs (((q1.x - q0.x) - (q3.x - q2.x)))) < 0.01)))
            def cc0:SceneItem (itemAt qC 0)
            def cc1:SceneItem (itemAt qC 1)
            c.ok("timeline: a card under each badge" ((cc0.y > (q0.y + q0.h)) && ((fabs (((cc0.x + (cc0.w * 0.5)) - (q0.x + (q0.w * 0.5))))) < 0.01)))
            c.ok("timeline: card tints alternate" (cc0.fill != cc1.fill))
        }
        c.ok(("timeline: takes the slide's room: " + (to_string qt.worldH)) (qt.worldH >= ((312.0 * 0.85) - 1.0)))
        c.inside("quarters 16:9" qt)
        c.textsClear("quarters 16:9" qt)
        c.textsFit("quarters 16:9" qt)
        c.ok(("quarters: contrast " + (to_string (c.lowestRatio(qt wine.paper)))) ((c.lowestRatio(qt wine.paper)) >= 4.5))
        c.textsFit("timeline 16:9" tf)
        ; portrait: down the room, every text in its box
        def qp:FlowScene (MdFigure.sceneFit("timeline" qText wine 460.0 10.0 700.0))
        c.ok("quarters portrait: down" (MdFigure.stacks("timeline" (MdFigure.items(qText)) wine 460.0 10.0)))
        c.inside("quarters portrait" qp)
        c.textsClear("quarters portrait" qp)
        c.textsFit("quarters portrait" qp)
        ; a title with no token: numbered
        def tn:FlowScene (MdFigure.sceneOf("timeline" "- Plan: goals\n- Build: code\n- Ship: in use" wine 852.0 10.0))
        def tnx:string (c.texts(tn))
        c.ok("timeline: no token, numbered badges" ((((indexOf tnx "1|") >= 0) && ((indexOf tnx "3|") >= 0)) && ((indexOf tnx "Plan|") >= 0)))

        ; --- art
        def w1:FlowScene (MdFigure.art("waves" st 1280.0 720.0 1))
        c.ok("waves: a page of lines" ((c.count(w1 2)) > 40))
        c.inside("waves" w1)
        def w2:FlowScene (MdFigure.art("waves" st 1280.0 720.0 2))
        def p1:SceneItem (itemAt w1.items 5)
        def p2:SceneItem (itemAt w2.items 5)
        c.ok("waves: the seed moves the lines" ((itemAt p1.pts 41) != (itemAt p2.pts 41)))
        ; the light themes' shapes: on the page, on every target the same,
        ; and the middle of a landscape page left to the text
        def kinds:[string] ([] _:string ("honeycomb" "lattice" "corners" "glow" "halftone" "tide" "blocks"))
        for kinds kn:string ki {
            c.ok((kn + ": a known art") (MdFigure.isArt(kn)))
            def ak:FlowScene (MdFigure.art(kn st 960.0 540.0 1))
            c.ok((kn + ": drawn") ((array_length ak.items) > 2))
            c.inside(kn ak)
            def tall:FlowScene (MdFigure.art(kn st 540.0 960.0 1))
            c.inside((kn + " portrait") tall)
            c.ok((kn + ": the middle stays clear") ((c.artAt(ak 480.0 270.0)) == 0))
        }
        def cn:FlowScene (MdFigure.art("corners" st 960.0 540.0 1))
        c.ok("corners: a slide's title corner (padding 60pt) is clear" ((c.artAt(cn 62.0 62.0)) == 0))
        c.ok("corners: the corner itself is filled" ((c.artAt(cn 4.0 4.0)) > 0))
        def bl:FlowScene (MdFigure.art("blocks" st 960.0 540.0 1))
        c.ok("blocks: the right edge is a band" ((c.artAt(bl 958.0 100.0)) > 0))
        c.ok("blocks: inside a slide's side padding (60pt) it is clear" ((c.artAt(bl 896.0 100.0)) == 0))
        c.ok("blocks: the bar along the bottom left" ((c.artAt(bl 20.0 538.0)) > 0))
        def cut:[double] (MdFigure.clipPage(([] _:double (-10.0 -10.0 50.0 -10.0 50.0 50.0 -10.0 50.0)) 100.0 100.0))
        c.ok("clipPage: a square over the corner ends at the edges" (((array_length cut) == 8) && ((itemAt cut 0) >= 0.0)))
        def none:FlowScene (MdFigure.art("nope" st 100.0 100.0 1))
        c.ok("unknown art: nothing" ((array_length none.items) == 0))

        ; --- an empty fence
        def e:FlowScene (MdFigure.sceneOf("swot" "\n\n" st 960.0 10.0))
        c.ok("empty: nothing drawn" (e.worldW <= 0.0))

        ; --- through the cache
        def cache (new MdEmbedCache())
        def doc:MdNode (MdNode.create("document"))
        def fence:MdNode (MdNode.create("embed"))
        fence.info = "timeline"
        fence.literal = "2023: Founded\n2024: Product"
        doc.add(fence)
        MdDiagram.prepare(doc cache 800.0 "default")
        c.ok("cache: drawn" ((cache.heightFor("timeline" fence.literal 800.0)) > 0.0))
        def h0:double (cache.heightFor("timeline" fence.literal 800.0))
        cache.figure.size = 30.0
        MdDiagram.prepare(doc cache 800.0 "default")
        c.ok("cache: a new style draws again" ((cache.heightFor("timeline" fence.literal 800.0)) > h0))
        cache.figure.allowed = false
        cache.figure.lockedNote = "PRO"
        MdDiagram.prepare(doc cache 800.0 "default")
        c.ok("cache: not allowed, not drawn" ((cache.heightFor("timeline" fence.literal 800.0)) < 0.0))
        c.eqStr("cache: the host's note" (cache.noteFor("timeline" fence.literal 800.0)) "PRO")

        ; --- the room comes from the page: a turned page draws the figure
        ; again for its own height (a portrait room kept on a landscape page
        ; ran the swot over the slide's bottom edge)
        def rc (new MdEmbedCache())
        rc.chartRoomKept = 120.0
        def rd:MdNode (MdNode.create("document"))
        def rf:MdNode (MdNode.create("embed"))
        rf.info = "swot"
        rf.literal = "Strengths: strong brand\nWeaknesses: small team\nOpportunities: new markets\nThreats: competitors"
        rd.add(rf)
        rc.fitPage(960.0 40.0)
        c.ok("room: from the tall page" ((fabs (rc.chartMaxH - 760.0)) < 0.01))
        MdDiagram.prepare(rd rc 460.0 "default")
        def tallH:double (rc.heightFor("swot" rf.literal 460.0))
        rc.fitPage(540.0 40.0)
        c.ok("room: from the turned page" ((fabs (rc.chartMaxH - 340.0)) < 0.01))
        MdDiagram.prepare(rd rc 880.0 "default")
        def wideH:double (rc.heightFor("swot" rf.literal 880.0))
        c.ok("room: tall page, tall swot" (tallH > 500.0))
        c.ok("room: the turned page's swot fits it" ((wideH > 0.0) && (wideH <= (340.0 + 20.0 + 0.5))))
        ; the same width, a shorter page: drawn again, not kept
        MdDiagram.prepare(rd rc 460.0 "default")
        c.ok("room: same width, shorter page, drawn again" ((rc.heightFor("swot" rf.literal 460.0)) < tallH))
        ; under a heading below the split level (the editorial theme: `##`
        ; on an A4 page with several sections) a figure is a part of its
        ; page: at most 0.7 of its width tall, not the page's room
        def sec (new MdEmbedCache())
        sec.chartRoomKept = 120.0
        sec.fitPage(842.0 64.0)
        def sd:MdNode (MdBlock.parseText("# Title\n\n## Section\n\n```swot\nStrengths: strong brand\nWeaknesses: small team\nOpportunities: new markets\nThreats: competitors\n```\n"))
        def sf:MdNode (sd.childAt(2))
        sec.splitLevel = 1
        MdDiagram.prepare(sd sec 467.0 "default")
        def inSection:double (sec.heightFor("swot" sf.literal 467.0))
        c.ok(("section: a part of the page: " + (to_string inSection)) ((inSection > 0.0) && (inSection <= ((467.0 * 0.7) + 20.5))))
        sec.splitLevel = 2
        MdDiagram.prepare(sd sec 467.0 "default")
        def onSlide:double (sec.heightFor("swot" sf.literal 467.0))
        c.ok(("slide: the slide's room, drawn again: " + (to_string onSlide)) (onSlide > (inSection + 50.0)))
        def hc (new MdEmbedCache())
        hc.chartMaxH = 300.0
        hc.fitPage(960.0 40.0)
        c.ok("room: none kept, the host's number stays" ((fabs (hc.chartMaxH - 300.0)) < 0.01))

        ; --- a plain list with `{list-style=swot}` under it
        def lc (new MdEmbedCache())
        def ld:MdNode (MdBlock.parseText("- Vahvuudet: brändi\n- Heikkoudet: tiimi\n  - pieni\n  - uusi\n{list-style=swot}\n\n- Tavallinen lista\n"))
        MdDiagram.prepare(ld lc 800.0 "default")
        def l0:MdNode (ld.childAt(0))
        c.eqStr("list-style: the list is a figure" l0.kind "embed")
        c.eqStr("list-style: its word" l0.info "swot")
        c.eqStr("list-style: the items as the fence's text" l0.literal "Vahvuudet: brändi\nHeikkoudet: tiimi\n  - pieni\n  - uusi\n")
        c.ok("list-style: drawn" ((lc.heightFor("swot" l0.literal 800.0)) > 0.0))
        def l1:MdNode (ld.childAt(1))
        c.eqStr("list-style: a list without one stays a list" l1.kind "list")
        ; …and from the sheet: a class, then a heading's anchor
        def sc2 (new MdEmbedCache())
        sc2.listSheet.addStyleSheet(".vaiheet { list-style: process } ul { list-style: disc }")
        def ld2:MdNode (MdBlock.parseText("- A\n- B\n{.vaiheet}\n\n## Aikajana\n\n- 2024: X\n- 2025: Y\n"))
        push sc2.listScopes "aikajana"
        push sc2.listScopeStyles "timeline"
        MdDiagram.prepare(ld2 sc2 800.0 "default")
        def m0:MdNode (ld2.childAt(0))
        def m2:MdNode (ld2.childAt(2))
        c.eqStr("sheet: a class's list-style" m0.info "process")
        c.eqStr("sheet: a heading's list-style" m2.info "timeline")
        ; ```cards from a plain list
        def lc3 (new MdEmbedCache())
        def ld3:MdNode (MdBlock.parseText("- Käynnistä: ohjelma\n- Kasvata: asiakkaat\n- Panosta: markkinat\n{list-style=cards}\n"))
        MdDiagram.prepare(ld3 lc3 800.0 "default")
        def n3:MdNode (ld3.childAt(0))
        c.eqStr("list-style=cards: its word" n3.info "cards")
        c.ok("list-style=cards: drawn" ((lc3.heightFor("cards" n3.literal 800.0)) > 0.0))

        if ((strlen outDir) > 0) {
            def dark (new MdFigureStyle)
            def dc:[string] ([] _:string ("#ffa546" "#5ce1ff"))
            dark.colors = dc
            dark.paper = "#0b1030"
            dark.ink = "#e8ecff"
            dark.muted = "#9aa3c7"
            MdFigureTest.save(outDir "waves" w1 "#ffffff")
            MdFigureTest.save(outDir "waves-dark" (MdFigure.art("waves" dark 1280.0 720.0 3)) "#0b1030")
            MdFigureTest.save(outDir "process" p "#ffffff")
            MdFigureTest.save(outDir "timeline-fitted" tf "#ffffff")
            MdFigureTest.save(outDir "process-fitted" pr "#ffffff")
            MdFigureTest.save(outDir "process-portrait" pd "#ffffff")
            MdFigureTest.save(outDir "process-portrait-across" pa "#ffffff")
            MdFigureTest.save(outDir "process-portrait-titles" pn "#ffffff")
            MdFigureTest.save(outDir "timeline-portrait" td "#ffffff")
            MdFigureTest.save(outDir "swot" s "#ffffff")
            MdFigureTest.save(outDir "timeline" t "#ffffff")
            MdFigureTest.save(outDir "cards" cd "#f8f4ee")
            MdFigureTest.save(outDir "cards-portrait" cp "#f8f4ee")
            MdFigureTest.save(outDir "cards-stacked" c1 "#f8f4ee")
            MdFigureTest.save(outDir "cards-seven" c7 "#f8f4ee")
            MdFigureTest.save(outDir "quarters" qt "#f8f4ee")
            MdFigureTest.save(outDir "quarters-portrait" qp "#f8f4ee")
            MdFigureTest.save(outDir "cards-dark" (MdFigure.sceneOf("cards" recText dark 960.0 10.0)) "#0b1030")
            MdFigureTest.save(outDir "timeline-numbered" tn "#f8f4ee")
            MdFigureTest.save(outDir "swot-dark" (MdFigure.sceneOf("swot" "Strengths: strong brand\nWeaknesses: small team\nOpportunities: new markets\n  - Nordics\n  - Germany\nThreats: competitors" dark 960.0 10.0)) "#0b1030")
            MdFigureTest.save(outDir "process-dark" (MdFigure.sceneOf("process" "- Plan: goals and schedule\n- Build: code and tests\n- Ship: in use" dark 960.0 10.0)) "#0b1030")
            MdFigureTest.save(outDir "timeline-dark" (MdFigure.sceneOf("timeline" "2023: Founded\n2024: First product\n2025: 10 000 users\n2026: Abroad" dark 960.0 10.0)) "#0b1030")
        }

        print ("")
        print ("passed=" + (to_string c.passed) + " failed=" + (to_string c.failed))
        if (c.failed == 0) {
            print "ALL PASS"
        } {
            print "SOME FAILED"
        }
    }

    sfn save:void (dir:string name:string sc:FlowScene bg:string) {
        def svg:string (sc.toSvg())
        def at:int (indexOf svg ">")
        def body:string ((substring svg 0 (at + 1)) + "<rect width=\"100%\" height=\"100%\" fill=\"" + bg + "\"/>" + (substring svg (at + 1) (strlen svg)))
        write_file dir (name + ".svg") body
    }
}
