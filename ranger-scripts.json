    "markdown:test:python": "node dist/rgrc.js -l=python ./gallery/markdown/tests/MarkdownTest.rgr -d=./gallery/markdown/bin -o=MarkdownTest.py -nodecli && python3 ./gallery/markdown/bin/MarkdownTest.py",
