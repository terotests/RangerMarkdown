    "markdown:srcmap:spec": "npm run --silent markdown:srcmap:build && node gallery/markdown/tools/markdown-srcmap.mjs",
    "markdown:srcmap:test": "bash scripts/rgr-suite.sh ./gallery/markdown/tests/MdSrcMapTest.rgr ./gallery/markdown/bin MdSrcMapTest.js",
